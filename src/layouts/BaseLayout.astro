---
import '../styles/global.css';
import '../styles/tokens.css';
import Navigation from '../components/Navigation';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object | object[];
  noindex?: boolean;
  pagefind?: boolean;
}

const {
  title,
  description,
  canonical,
  schema,
  noindex = false,
  pagefind = false,
} = Astro.props;

const isStaging = import.meta.env.PUBLIC_STAGING === 'true';

const canonicalUrl = canonical
  ? `https://assurmanbouw.be${canonical}`
  : `https://assurmanbouw.be${Astro.url.pathname}`;

const schemaArray = schema
  ? Array.isArray(schema) ? schema : [schema]
  : [];
---

<!DOCTYPE html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#001F3F" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {(noindex || isStaging) && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Assurman" />
    <meta property="og:image" content="https://www.assurman.be/assurman-logo-dark.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/fav-icon-assurmanbouw.png" />

    <!-- JSON-LD schemas -->
    {schemaArray.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="Kenniscentrum bouwverzekeringen: Assurman" href="/rss.xml" />

    <!-- Pagefind UI (alleen op kenniscentrum-pagina's) -->
    {pagefind && (
      <>
        <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
        <script is:inline src="/pagefind/pagefind-ui.js"></script>
      </>
    )}
  </head>
  <body style="margin:0; padding:0;">
    <!-- Assurman global SVG clip-path defs — 1× per pagina geladen, niet per gebruik -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
