---
interface Props {
  color?: string;
  height?: string;
  width?: string;
  direction?: 'down' | 'up' | 'left' | 'right';
  opacity?: number;
  className?: string;
}

const {
  color = 'white',
  height = '80px',
  width = 'auto',
  direction = 'down',
  opacity = 1,
  className = '',
} = Astro.props;

const rotation = {
  down: 0,
  up: 180,
  left: 90,
  right: -90,
}[direction];
---

<svg
  class={`assurman-chevron ${className}`}
  viewBox="0 0 367 255"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style={`color:${color};height:${height};width:${width};opacity:${opacity};transform:rotate(${rotation}deg);display:block;`}
>
  <path
    d="M131.163 6.00001L185.858 58.5616L237.759 8.45212M82.9189 22.083L185.86 121.332L285.283 24.5497M40.1383 46.1806L185.86 186.231L327.817 49.187M6 75.5873L185.86 249L361 78.5107"
    stroke="currentColor"
    stroke-width="12"
    stroke-miterlimit="10"
    stroke-linecap="round"
    stroke-linejoin="round"
  />
</svg>
