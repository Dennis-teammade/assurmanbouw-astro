---
export interface RelatedItem {
  title: string;
  href: string;
  label?: string;
  variant?: 'article' | 'pillar';
}

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

<style>
  .ra-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin: 56px 0 0; }
  .ra-card { background: #fff; padding: 24px; clip-path: polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%); box-shadow: 0 2px 8px rgba(0,31,63,0.06); display: flex; flex-direction: column; text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .ra-card:hover { box-shadow: 0 8px 24px rgba(0,31,63,0.1); transform: translateY(-3px); }
  .ra-card--pillar { background: #3F5767; }
  @media (max-width:1023px) { .ra-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width:639px) { .ra-grid { grid-template-columns: 1fr; } }
</style>

<div class="ra-grid">
  {items.map((item) => (
    <a href={item.href} class={`ra-card${item.variant === 'pillar' ? ' ra-card--pillar' : ''}`}>
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 8px;">
        {item.label ?? 'Gerelateerd'}
      </p>
      <h3 style={`font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;line-height:1.35;color:${item.variant === 'pillar' ? '#FFFFFF' : '#001F3F'};margin:0 0 10px;flex:1;`}>
        {item.title}
      </h3>
      <span style="display:inline-flex;align-items:center;gap:5px;font-family:'Open Sans',sans-serif;font-size:13px;font-weight:700;color:#E5A524;">
        {item.variant === 'pillar' ? 'Lees de gids' : 'Lees meer'}
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
        </svg>
      </span>
    </a>
  ))}
</div>
