---
interface Props {
  headline: string;
  subtext?: string;
  label?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  microcopy?: string;
  theme?: 'dark' | 'gold' | 'compact-dark';
  // dark         = full-width section boven footer, #3F5767, werkwijze-stijl
  // gold         = full-width mid-content sectie, #E9C466
  // compact-dark = inline card, #3F5767 bg
}

const {
  headline, subtext, label,
  primaryLabel, primaryHref,
  secondaryLabel, secondaryHref,
  microcopy,
  theme = 'dark',
} = Astro.props;

const isCompact = theme === 'compact-dark';
const bg         = theme === 'gold' ? '#E9C466' : '#3F5767';
const headColor  = theme === 'gold' ? '#001F3F'  : '#FFFFFF';
const subColor   = theme === 'gold' ? '#3F5767'  : '#CBD5E1';
const labelColor = theme === 'gold' ? '#3F5767'  : '#E5A524';
const primBg     = theme === 'gold' ? '#001F3F'  : '#E5A524';
const primColor  = theme === 'gold' ? '#FFFFFF'  : '#001F3F';
const secStyle   = theme !== 'gold'
  ? 'background:rgba(255,255,255,0.1);color:#FFFFFF;border:1px solid rgba(255,255,255,0.2);'
  : '';
---

<style>
  .ctab-primary { transition: background 0.2s; }
  .ctab-primary:hover { background: #E9C466 !important; }
  .ctab-secondary { transition: background 0.2s; }
  .ctab-secondary:hover { background: rgba(255,255,255,0.18) !important; }
</style>

{isCompact ? (
  <div style={`background:${bg};padding:32px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%);`}>
    {label && <p style={`font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:${labelColor};margin:0 0 10px;`}>{label}</p>}
    <h2 style={`font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2vw,28px);color:${headColor};margin:0 0 12px;line-height:1.2;`}>{headline}</h2>
    {subtext && <p style={`font-family:'Open Sans',sans-serif;font-size:15px;color:${subColor};margin:0 0 20px;line-height:1.6;`}>{subtext}</p>}
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
      <a href={primaryHref} class="ctab-primary" style={`display:inline-flex;align-items:center;gap:8px;background:${primBg};color:${primColor};font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;padding:14px 24px;border-radius:8px;text-decoration:none;`}>
        {primaryLabel}
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="ctab-secondary" style={`display:inline-flex;align-items:center;gap:8px;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;padding:14px 24px;border-radius:8px;text-decoration:none;${secStyle}`}>
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
) : (
  <section style={`background:${bg};padding:${theme === 'dark' ? '100px 0 0' : '56px 0'};text-align:center;position:relative;overflow:hidden;`}>
    <div style={`max-width:${theme === 'dark' ? '740px' : '1280px'};margin:0 auto;padding:0 32px;position:relative;z-index:1;`}>
      {label && <p style={`font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:${labelColor};margin:0 0 16px;`}>{label}</p>}
      <h2 style={`font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(${theme === 'dark' ? '28px,4vw,50px' : '22px,2.5vw,36px'});color:${headColor};margin:0 0 20px;line-height:1.1;letter-spacing:${theme === 'dark' ? '-0.8px' : 'normal'};`}>{headline}</h2>
      {subtext && <p style={`font-family:'${theme === 'dark' ? 'Outfit' : 'Open Sans'}',sans-serif;font-size:${theme === 'dark' ? '18px' : '16px'};line-height:1.65;color:${subColor};max-width:560px;margin:0 auto ${theme === 'dark' ? '48px' : '28px'};`}>{subtext}</p>}
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href={primaryHref} class="ctab-primary" style={`display:inline-flex;align-items:center;gap:10px;background:${primBg};color:${primColor};font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;`}>
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          {primaryLabel}
        </a>
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="ctab-secondary" style={`display:inline-flex;align-items:center;gap:10px;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;${secStyle}`}>
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
            {secondaryLabel}
          </a>
        )}
      </div>
      {microcopy && <p style={`font-family:'Open Sans',sans-serif;font-size:14px;color:${subColor};opacity:0.75;margin:${theme === 'dark' ? '20px 0 80px' : '16px 0 0'};`}>{microcopy}</p>}
      {!microcopy && theme === 'dark' && <div style="margin-bottom:80px;"></div>}
    </div>
    <!-- Slot voor wave SVG of andere content -->
    <slot />
  </section>
)}
