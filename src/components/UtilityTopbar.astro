---
// Utility-topbar — smalle, gedempte balk boven de hoofdnav.
// Doel: secundaire links (Over ons, Bijstand, Maak afspraak) en contactkanalen een
// vaste plek geven, zodat de hoofdnav zuiver blijft.
//
// Volledig statisch: enkel echte <a>-elementen + iconen, hover via CSS. Geen hydratatie.
// Verborgen op mobiel (<=900px), het breekpunt waarop de hoofdnav naar het hamburger-menu
// schakelt. Daar zijn Over ons / Bijstand / Maak afspraak via het hamburger-menu bereikbaar.
//
// Contactgegevens hergebruikt uit de centrale bron (cta-labels.ts) en Footer.astro,
// niet opnieuw verzonnen. Social-URL's komen 1-op-1 uit Footer.astro.
import { CTA_DESTINATIONS } from '../data/cta-labels';

// Social-URL's hergebruikt uit Footer.astro (één bron van waarheid).
const FACEBOOK_URL = 'https://www.facebook.com/www.zakenkantoorkeerman.be';
const INSTAGRAM_URL = 'https://www.instagram.com/assurmanverzekeringen/';
// LET OP: er bestaat (nog) geen bedrijfs-LinkedIn en geen apart WhatsApp-nummer in de
// codebase. Die iconen zijn bewust weggelaten i.p.v. naar een verzonnen bestemming te
// linken. Voeg ze toe zodra de URL's/het nummer bevestigd zijn.
---

<div class="utilbar">
  <div class="utilbar-inner">

    <!-- Links: contact- en social-iconen -->
    <nav class="utilbar-social" aria-label="Contact en social media">
      <a href={CTA_DESTINATIONS.email} class="utilbar-ico" aria-label="Mail ons">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
      </a>
      <a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer" class="utilbar-ico" aria-label="Facebook">
        <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="utilbar-ico" aria-label="Instagram">
        <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
      </a>
    </nav>

    <!-- Rechts: secundaire links + telefoon -->
    <nav class="utilbar-links" aria-label="Secundaire navigatie">
      <a href="/over-assurman/" class="utilbar-link">Over ons</a>
      <span class="utilbar-sep" aria-hidden="true"></span>
      <a href="/bijstand/" class="utilbar-link">Bijstand</a>
      <span class="utilbar-sep" aria-hidden="true"></span>
      <a href={CTA_DESTINATIONS.afspraak} class="utilbar-link">Maak afspraak</a>
      <a href={CTA_DESTINATIONS.tel} class="utilbar-link utilbar-tel" aria-label="Bel ons">
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.79 2.82h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.9a16 16 0 0 0 6.18 6.18l1.24-1.24a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>{CTA_DESTINATIONS.telDisplay}</span>
      </a>
    </nav>

  </div>
</div>

<style>
  .utilbar {
    /* absolute (niet fixed): de topbar staat bovenaan de pagina en scrollt mee weg.
       Enkel de hoofdnav blijft sticky. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 101; /* net boven de hoofdnav (z-index 100) */
    height: 34px;
    background: #3F5767; /* slate — primair merk-donker, gedempt boven de witte nav */
    border-bottom: 1px solid rgba(233, 196, 102, 0.22); /* subtiele gold-haarlijn */
  }
  .utilbar-inner {
    max-width: 1280px;
    height: 100%;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .utilbar-social {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .utilbar-ico {
    display: inline-flex;
    align-items: center;
    color: #FAF2F2;
    opacity: 0.85;
    line-height: 0;
    transition: color 0.18s ease, opacity 0.18s ease;
  }
  .utilbar-ico:hover {
    color: #E9C466; /* gold-accent, ingetogen */
    opacity: 1;
  }
  .utilbar-links {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .utilbar-link {
    font-family: 'Outfit', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    color: #FAF2F2;
    text-decoration: none;
    opacity: 0.9;
    transition: color 0.18s ease, opacity 0.18s ease;
  }
  .utilbar-link:hover {
    color: #E9C466;
    opacity: 1;
  }
  .utilbar-tel {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }
  .utilbar-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(250, 242, 242, 0.4);
  }
  .utilbar-ico:focus-visible,
  .utilbar-link:focus-visible {
    outline: 2px solid #E9C466;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Mobiel: verberg de utility-topbar. De items blijven bereikbaar via het hamburger-menu. */
  @media (max-width: 900px) {
    .utilbar { display: none; }
  }
</style>
