---
interface Heading { slug: string; text: string; depth: number; }

interface Props {
  headings: Heading[];
  spokes: Array<{ slug: string; data: { title: string; tileTitle?: string } }>;
  pillarSlug: string;
}

const { headings, spokes, pillarSlug } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

<style>
  .ptoc { background: #FFFFFF; padding: 28px 32px; margin-bottom: 32px; clip-path: polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%); box-shadow: 0 2px 8px rgba(0,31,63,0.05); }
  .ptoc-grid { display: grid; grid-template-columns: 1fr 1px 1fr; gap: 0; margin-top: 16px; }
  .ptoc-divider { background: rgba(0,31,63,0.1); margin: 0 24px; }
  .ptoc-col { }
  .ptoc-col:first-child { padding-right: 24px; }
  .ptoc-col:last-child  { padding-left: 24px; }
  .ptoc-sub { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; margin: 0 0 12px; }
  .ptoc-ol { list-style: none; padding: 0; margin: 0; counter-reset: ptoc; }
  .ptoc-ol li { counter-increment: ptoc; display: flex; gap: 9px; align-items: baseline; margin-bottom: 8px; }
  .ptoc-ol li::before { content: counter(ptoc) "."; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; color: #E5A524; flex-shrink: 0; min-width: 18px; }
  .ptoc-a { font-family: 'Open Sans', sans-serif; font-size: 14px; line-height: 1.45; color: #3F5767; text-decoration: none; }
  .ptoc-a:hover { color: #E5A524; text-decoration: underline; }
  .ptoc-ul { list-style: none; padding: 0; margin: 0; }
  .ptoc-ul li { display: flex; gap: 7px; align-items: baseline; margin-bottom: 8px; }
  .ptoc-arrow { color: #E5A524; font-size: 13px; flex-shrink: 0; }
  .ptoc-sa { font-family: 'Open Sans', sans-serif; font-size: 14px; line-height: 1.45; color: #3F5767; text-decoration: none; }
  .ptoc-sa:hover { color: #E5A524; text-decoration: underline; }
  @media (max-width: 639px) {
    .ptoc { padding: 20px; }
    .ptoc-grid { grid-template-columns: 1fr; }
    .ptoc-divider { display: block; height: 1px; width: 100%; margin: 16px 0; }
    .ptoc-col:first-child { padding-right: 0; }
    .ptoc-col:last-child  { padding-left: 0; }
  }
</style>

<div class="ptoc">
  <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.6px;text-transform:uppercase;color:#E5A524;margin:0;">In dit thema</p>
  <div class="ptoc-grid">

    <!-- Links: anchor-links naar H2's -->
    <div class="ptoc-col">
      <p class="ptoc-sub" style="margin-top:14px;">Op deze pagina</p>
      {h2s.length > 0 ? (
        <ol class="ptoc-ol">
          {h2s.map((h) => (
            <li>
              <a href={`#${h.slug}`} class="ptoc-a">{h.text}</a>
            </li>
          ))}
        </ol>
      ) : (
        <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:#CBD5E1;font-style:italic;margin:0;">Geen secties gevonden.</p>
      )}
    </div>

    <!-- Verticale scheidingslijn -->
    <div class="ptoc-divider"></div>

    <!-- Rechts: spoke-links -->
    <div class="ptoc-col">
      <p class="ptoc-sub" style="margin-top:14px;">Bijkomende bronnen</p>
      {spokes.length > 0 ? (
        <ul class="ptoc-ul">
          {spokes.map((s) => (
            <li>
              <span class="ptoc-arrow">→</span>
              <a href={`/gids/${pillarSlug}/${s.slug}/`} class="ptoc-sa">
                {s.data.tileTitle ?? s.data.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:#CBD5E1;font-style:italic;margin:0;">Nog geen artikelen.</p>
      )}
    </div>

  </div>
</div>
