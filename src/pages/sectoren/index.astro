---

<BaseLayout
  title="Sectoren | Bouwverzekeringen op maat | Assurman"
  description="Assurman is gespecialiseerd in verzekeringen voor de bouwsector in Vlaanderen: van ruwbouw en afwerking tot technieken, dak, tuin en buitenruimte. Kies jouw sector."
  canonical="/sectoren"
>

<style>
  .dw-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }

  /* Hero image */
  .sectors-hero-img { position:absolute; top:0; left:-5px; height:100%; width:auto; z-index:1; pointer-events:none; }
  .sectors-hero-btns { display:flex; gap:16px; justify-content:center; flex-wrap:wrap; }
  @media (max-width:1023px) { .sectors-hero-img { display:none; } }
  @media (max-width:767px) {
    .sectors-hero-btns { flex-direction:column; align-items:center; }
    .sectors-hero-btns a { width:100%; max-width:400px; justify-content:center; }
  }

  /* Cards grid */
  .sectors-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .sector-card {
    background: #e5a5240f;
    padding: 32px;
    clip-path: polygon(0% 0%, 100% 0%, 100% calc(100% - 32px), calc(100% - 32px) 100%, 0% 100%);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,31,63,0.06);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .sector-card:hover { box-shadow: 0 10px 28px rgba(0,31,63,0.12); transform: translateY(-4px); }
  .sector-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 16px; }
  .sector-tag {
    display: inline-flex; align-items: center;
    background: rgba(255,255,255,0.55);
    border: 1px solid rgba(229,165,36,0.3);
    border-radius: 9999px; padding: 4px 12px;
    font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 11px;
    letter-spacing: 0.5px; color: #8B6A1A;
  }
  .badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213,196,174,0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }

  /* Final CTA buttons */
  .sectors-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  @media (max-width: 1023px) {
    .sectors-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 639px) {
    .sectors-grid { grid-template-columns: 1fr; gap: 16px; }
    .dw-container { padding-left: 15px; padding-right: 15px; }
    .sectors-final-btns { flex-direction: column; align-items: center; }
    .sectors-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
  }
</style>

<!-- HERO -->
<section style="background:#FFFFFF;padding-top:180px;padding-bottom:80px;border-bottom:1px solid rgba(229,165,36,0.12);position:relative;overflow:hidden;min-height:480px;">
  <!-- Background image — linksbovenhoek -->
  <div class="sectors-hero-img assurman-mask assurman-mask--left">
    <img src="/verzekeringen-bouwsector-Bedrijfsvoertuigen­verzekering-left.jpg" alt="" aria-hidden="true" />
  </div>
  <div class="dw-container" style="text-align:center;position:relative;z-index:2;">
    <div class="badge-pill" style="margin-bottom:24px;display:inline-flex;">
      <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
      Assurman • Specialist bouwverzekeringen
    </div>
    <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,5vw,56px);line-height:1.08;letter-spacing:-1px;color:#001F3F;margin-bottom:16px;">
      Bouwverzekeringen op maat<br />van jouw sector
    </h1>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#3F5767;max-width:640px;margin:0 auto 40px;">
      Elke bouwsector heeft eigen risico's. Assurman is gespecialiseerd in verzekeringen voor bouwondernemers in Vlaanderen: van dakwerkers tot loodgieters.
    </p>
    <div class="sectors-hero-btns">
      <a href="/gratis-verzekeringsscan/" class="brand-btn-primary brand-btn-primary--lg">
        Vraag een scan aan
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/contact/" class="brand-btn-secondary">Plan een adviesgesprek</a>
    </div>
  </div>
</section>

<!-- SECTORS GRID -->
<section style="background:#FFFFFF;padding:80px 0;">
  <div class="dw-container">
    <div style="text-align:center;margin-bottom:56px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:16px;">Kies jouw sector</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.05;color:#001F3F;margin:0 auto;max-width:640px;">
        Voor welke bouwprofessional zoek je informatie?
      </h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#3F5767;margin:16px auto 0;max-width:560px;">
        Klik op je sector voor alle informatie over verplichte en aanbevolen verzekeringen, cases en veelgestelde vragen.
      </p>
    </div>

    {sectorGroepen.map((groep) => (
      <div style="margin-bottom:56px;">
        <!-- Categorie-kop (sober, slate) -->
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,2.5vw,30px);line-height:1.1;color:#3F5767;margin:0 0 6px;">{groep.label}</h2>
        <div style="width:48px;height:3px;background:#E5A524;margin-bottom:24px;"></div>

        <div class="sectors-grid">
          {groep.sectors.map((sector) => (
            <a href={`/sectoren/${sector.slug}/`} class="sector-card">
              <!-- Icon -->
              <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:14px;display:inline-flex;align-self:flex-start;margin-bottom:20px;">
                <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={sector.iconPath}/></svg>
              </div>
              <!-- Title -->
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:10px;">{sector.title}</h3>
              <!-- Gold accent bar -->
              <div style="width:40px;height:3px;background:#E5A524;margin-bottom:14px;"></div>
              <!-- Description -->
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.6;color:#001F3F;margin:0;flex:1;">{sector.description}</p>
              <!-- Tags -->
              <div class="sector-tags">
                {sector.tags.map((tag) => (
                  <span class="sector-tag">{tag}</span>
                ))}
              </div>
              <!-- CTA -->
              <div style="display:inline-flex;align-items:center;gap:8px;font-family:'Open Sans',sans-serif;font-weight:700;font-size:14px;color:#E5A524;margin-top:20px;">
                Meer info
                <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- USP STRIP -->
<section style="background:#E9C466;padding:64px 0;">
  <div class="dw-container">
    <div style="text-align:center;margin-bottom:48px;">
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(24px,3vw,40px);line-height:1.1;color:#001F3F;margin:0;">
        Waarom Assurman voor elke bouwsector werkt
      </h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:20px;">
      {[
        { value: 'Bouwspecialist', label: 'Focus', text: 'Na jaren ervaring met bouwbedrijven zijn we nu sectorspecialist.' },
        { value: 'Modulair pakket', label: 'Maatwerk', text: 'Enkel de dekkingen die jij nodig hebt: niets meer, niets minder.' },
        { value: 'Grondige audit', label: 'Offerte', text: 'Je offerte volgt na een persoonlijke risicoanalyse door een ervaren expert.' },
        { value: 'FSMA 0805.250.547', label: 'Erkend', text: 'Onafhankelijk makelaar, erkend door de FSMA bij alle maatschappijen.' },
      ].map((item) => (
        <div style="background:#3F5767;border:1px solid rgba(255,255,255,0.1);padding:28px;text-align:center;clip-path:polygon(24px 0%,100% 0%,100% 100%,0% 100%,0% 24px);">
          <div style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:11px;letter-spacing:1.4px;text-transform:uppercase;color:#FFFFFF;margin-bottom:8px;">{item.label}</div>
          <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:18px;color:#E5A524;margin-bottom:8px;">{item.value}</div>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:13px;line-height:1.5;color:#FFFFFF;margin:0;min-height:calc(13px * 1.5 * 2);">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section style="background:#3F5767;padding-top:96px;padding-bottom:0;position:relative;text-align:center;">
  <div class="dw-container" style="position:relative;z-index:2;">
    <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:16px;">Klaar om te starten?</p>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3.5vw,48px);line-height:1.1;color:#FFFFFF;max-width:727px;margin:0 auto 20px;">
      Doe de gratis verzekeringsscan in 2 minuten
    </h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,2vw,22px);line-height:1.4;color:#CBD5E1;max-width:832px;margin:0 auto 40px;">
      Kies je sector, beantwoord enkele vragen en krijg een voorstel op maat van jouw activiteiten.
    </p>
    <div class="sectors-final-btns">
      <a href="/gratis-verzekeringsscan/" style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;box-shadow:0px 10px 15px -3px rgba(0,0,0,0.1);">
        Start de scan
