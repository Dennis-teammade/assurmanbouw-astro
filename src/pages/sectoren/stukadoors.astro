---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'rechtsbijstand', 'alle-bouwplaats-risicos', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'vervoerde-goederen', 'vapz']);

const caseStudies = [
  {
    category: 'PLEISTERWERK',
    title: 'Krimpscheuren in nieuwe wanden leiden tot €14.000 herstelclaim',
    businessName: 'Plamuur & Plafond',
    ownerName: 'Wim Dewulf',
    cityName: 'Tielt',
    description: 'Enkele weken na oplevering verschenen haarscheuren in verschillende gepleisterde wanden van een nieuwbouwwoning. De klant weet dit aan slecht uitgevoerd werk en eiste een volledige herstelbeurt op kosten van de stukadoor.',
    action: 'Via de rechtsbijstand werd een onafhankelijke expert ingeschakeld die de droogomstandigheden, het ondergrondtype en de uitvoering beoordeelde. De expertise toonde dat de scheurvorming deels te wijten was aan een te snel ingezette verwarming. Op basis daarvan werd een gedeelde regeling bereikt en bleef de financiële impact voor de stukadoor beperkt.',
    image: '/images/cases/case-stukadoors-1.jpg',
  },
  {
    category: 'PLEISTERWERK',
    title: 'Waterschade aan klantvloer tijdens pleisterwerk kost €9.500',
    businessName: 'Strak Stucwerk',
    ownerName: 'Nadia Vermeersch',
    cityName: 'Lokeren',
    description: 'Tijdens het opmengen van pleister liep water over een net geplaatste parketvloer in een bewoonde woning. Het parket trok krom en moest deels vervangen worden.',
    action: 'De schade aan de eigendom van de klant viel onder de BA-onderneming. De verzekeraar nam de vervangingskosten van het beschadigde parket op zich. De relatie met de klant bleef goed en het project werd zonder verder conflict afgerond.',
    image: '/images/cases/case-stukadoors-2.jpg',
  },
  {
    category: 'GEVELPLEISTER',
    title: 'Discussie over kleurverschil in gevelpleister: €11.000 in het geding',
    businessName: 'GevelFijn',
    ownerName: 'Bert Maes',
    cityName: 'Deinze',
    description: 'Na het afwerken van een buitengevel met sierpleister klaagde de bouwheer over zichtbare kleurverschillen tussen verschillende vlakken. Hij weigerde de laatste schijf te betalen en dreigde met herstel door derden.',
    action: 'Via de rechtsbijstand werd technisch advies ingewonnen over de invloed van droogomstandigheden op de uitkleuring van minerale pleister. Na bemiddeling werd een deeltoegeving gedaan en kwam er een betalingsregeling. Een dure procedure werd vermeden.',
    image: '/images/cases/case-stukadoors-3.jpg',
  },
  {
    category: 'PLEISTERWERK',
    title: 'Loslatend pleisterwerk in badkamer leidt tot €7.800 geschil',
    businessName: 'Plafonneerwerken Cools',
    ownerName: 'Steven Cools',
    cityName: 'Eeklo',
    description: 'In een gerenoveerde badkamer kwam de pleisterlaag op enkele plaatsen los. De klant stelde de stukadoor aansprakelijk, terwijl onduidelijk was of het vochtprobleem van de ondergrond kwam.',
    action: 'De rechtsbijstand liet de oorzaak technisch onderzoeken. De expertise wees op een vochtbron achter de wand die niet door de stukadoor was veroorzaakt. De aansprakelijkheid werd afgewend en de herstelkosten kwamen niet voor rekening van de onderneming.',
    image: '/images/cases/case-stukadoors-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een stukadoor het meest?",
    content: "De meeste discussies bij stukadoors gaan over de afwerking zelf:\n\n• Esthetische geschillen: vlakheid, krimpscheuren, kleurverschil in sierpleister.\n\n• Schade aan eigendom van de klant: vloeren, meubels of afwerking die beschadigd raakt tijdens het werk.\n\n• Materiaal & mobiliteit: zonder mengmateriaal en bestelwagen sta je stil.\n\nDaarom is een basis met BA-onderneming en rechtsbijstand voor de meeste stukadoors een logische start.",
  },
  {
    title: 'Ben ik gedekt als een klant klaagt over scheuren of vlakheid?',
    content: 'Dat is precies waar rechtsbijstand voor dient. Bij een geschil over de afwerking kunnen we een onafhankelijke expert inschakelen die de oorzaak beoordeelt. Vaak ligt die deels bij omstandigheden buiten jouw controle, zoals te snel drogen of een gebrekkige ondergrond. Met een goede dekking sta je niet alleen tegenover de klant.',
  },
  {
    title: 'Wat als ik schade maak aan de vloer of meubels van de klant?',
    content: 'Schade aan de eigendom van je klant tijdens het werk valt onder je BA-onderneming. Denk aan een beschadigde parketvloer, bevuilde of beschadigde meubels. We stemmen de dekking af op het type werk dat je doet, zeker als je veel in bewoonde woningen werkt.',
  },
  {
    title: 'Heb ik rechtsbijstand echt nodig als ik netjes werk?',
    content: 'Ook bij vakkundig werk ontstaan geschillen, want "mooi afgewerkt" is deels subjectief. Een klant kan een kleurverschil of een lichte oneffenheid afkeuren. Rechtsbijstand zorgt dat je niet meteen zelf advocaat- en expertisekosten draagt en helpt een conflict snel en redelijk op te lossen.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel stukadoors starten met een kernpakket en breiden uit wanneer ze personeel aannemen, meer buitenpleisterwerk doen of grotere werven aanpakken. Assurman bouwt modulair: je groeit zonder telkens opnieuw van nul te starten.',
  },
  {
    title: 'Maakt het uit of ik binnen- of buitenpleisterwerk doe?',
    content: 'Ja. Buitenpleister en gevelafwerking brengen andere risico\'s mee: weersinvloeden, stellingen, kleurstabiliteit en werken op hoogte. In je intake geef je aan wat je doet, en we stemmen de dekking en voorwaarden daarop af.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor stukadoors en plafonneurs | Assurman"
  description="Krimpscheuren, loslatend pleisterwerk, waterschade op de werf: stukadoors hebben specifieke noden. Bekijk het verzekeringspakket op maat van Assurman."
  canonical="/sectoren/stukadoors/"
  schema={schema}
>

<style>
  .stk-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .stk-hero-content { max-width: 52%; padding-top: 100px; }
  .stk-hero-img { position: absolute; top: 0; right: -5px; height: min(85vh, calc(48vw * 709 / 594)); width: auto; z-index: 1; pointer-events: none; }
  .stk-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .stk-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .stk-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .stk-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .stk-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .stk-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .stk-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .stk-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .stk-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .stk-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .stk-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .stk-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .stk-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .stk-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .stk-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .stk-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .stk-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .stk-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .stk-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .stk-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .stk-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .stk-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .stk-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .stk-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .stk-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .stk-hero-img { display: none; }
    .stk-features-grid { grid-template-columns: repeat(2, 1fr); }
    .stk-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .stk-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .stk-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .stk-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .stk-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .stk-intro-grid { grid-template-columns: 1fr; }
    .stk-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .stk-container { padding-left: 15px; padding-right: 15px; }
    .stk-hero-content { max-width: 100%; padding-top: 16px; }
    .stk-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .stk-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .stk-benefits-grid { grid-template-columns: 1fr; }
    .stk-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .stk-cards3-grid { grid-template-columns: 1fr; }
    .stk-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .stk-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .stk-testimonials-grid { grid-template-columns: 1fr; }
    .stk-cert-grid { grid-template-columns: 1fr 1fr; }
    .stk-btn-primary { font-size: 16px; padding: 16px 24px; }
    .stk-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .stk-hero-btns { flex-direction: column; }
    .stk-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .stk-cta-btns { flex-direction: column; align-items: center; }
    .stk-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .stk-final-btns { flex-direction: column; align-items: center; }
    .stk-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .stk-step-number { font-size: 56px; }
    .stk-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .stk-waarom-mask-img,
    .stk-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="stk-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:100vh;">
  <div class="stk-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/stukadoors-hero.jpg" alt="Stukadoor brengt pleisterlaag aan op een binnenmuur" />
  </div>
  <div class="stk-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="stk-hero-content">
      <div class="stk-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor stukadoors
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Strak afgewerkt, correct verzekerd.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als stukadoor of plafonneur staat of valt je reputatie met de afwerking. Een krimpscheur, een plek die loslaat, een kleurverschil in de sierpleister of waterschade tijdens het werk: het leidt snel tot discussie en herstelkosten. Assurman is gespecialiseerd in verzekeringen op maat van afwerkingsondernemers in Vlaanderen.
      </p>
      <div class="stk-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="stk-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="stk-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="stk-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="stk-features-grid">
      {[
        { text: 'Specialist in\nafwerking & pleisterwerk', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Sterk op geschillen\nrond afwerking', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
        { text: 'Dekking voor werk\n+ materiaal + bestelwagen', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="stk-container" style="max-width:1110px;">
    <div class="stk-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een stukadoor een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Pleisterwerk is het zichtbare eindresultaat. Net daar wordt elke onvolkomenheid opgemerkt: een haarscheur na het uitdrogen, een wand die niet perfect vlak aanvoelt, een gevelpleister die anders uitkleurt dan verwacht. Veel discussies gaan niet over instortgevaar, maar over wat de klant esthetisch verwacht had. Dat maakt aansprakelijkheid en rechtsbijstand bij dit beroep extra belangrijk.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: binnen- of buitenwerk, sierpleister, plafonneren, werken in bewoonde woningen, personeel, materiaalwaarde en bestelwagen. Zo ben je gedekt voor de risico's die jouw stiel echt kent.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij levert de afwerking. Wij zorgen dat een discussie geen financieel probleem wordt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Esthetische geschillen', text: 'Rechtsbijstand staat klaar wanneer een klant het werk afkeurt op vlakheid, scheuren of kleur.', iconPath: 'M16 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1zM2 16l3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1zM7 21h10M12 3v18M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2' },
          { title: 'Schade in bewoonde ruimtes', text: 'Met BA dek je schade aan vloeren, meubels of afwerking van de klant tijdens het pleisteren.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
          { title: 'Materiaal & bestelwagen', text: 'Bescherming voor je gereedschap, mengmateriaal en bestelwagen zodat je nooit stilstaat.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
        ].map((card) => (
          <div class="stk-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
