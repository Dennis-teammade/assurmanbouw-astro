---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'bedrijfsvoertuigen', 'machinebreuk', 'arbeidsongevallen', 'rechtsbijstand', 'vervoerde-goederen', 'vapz']);

const caseStudies = [
  {
    category: 'TUINONDERHOUD',
    title: 'Steenworp van maaier verbrijzelt autoruit klant, €3.200 schade',
    businessName: 'Groen & Net',
    ownerName: 'Tom Verhaeghe',
    cityName: 'Deinze',
    description: 'Tijdens het maaien van een oprit sprong een steentje van onder de maaier weg en verbrijzelde de achterruit van de geparkeerde wagen van de klant. De klant eiste meteen vergoeding.',
    action: 'De BA-verzekering ving de schade aan het voertuig van de klant op. De zaakvoerder kon de situatie kalm afhandelen en de klant behouden, zonder zelf voor de rekening op te draaien.',
    image: '/images/cases/case-hoveniers-1.jpg',
  },
  {
    category: 'TUINONDERHOUD',
    title: 'Bosmaaier en kettingzaag gestolen uit bestelwagen, €4.800',
    businessName: 'TuinFris',
    ownerName: 'Nele Dewulf',
    cityName: 'Waregem',
    description: 'Tijdens een onderhoudsronde werd de bestelwagen opengebroken terwijl de zaakvoerder in een tuin werkte. Een bosmaaier, kettingzaag en handgereedschap waren in één klap weg.',
    action: 'Via de dekking voor vervoerde goederen en machinebreuk werd het gestolen materieel vergoed. Binnen enkele dagen lag er nieuw gereedschap klaar en kon de planning grotendeels gerespecteerd worden.',
    image: '/images/cases/case-hoveniers-2.jpg',
  },
  {
    category: 'TUINONDERHOUD',
    title: 'Aangelegd gazon slaat niet aan, klant betwist factuur van €5.500',
    businessName: 'Het Groene Pad',
    ownerName: 'Jurgen Claes',
    cityName: 'Geraardsbergen',
    description: 'Een nieuw aangelegd gazon kleurde na enkele weken bruin en kwam niet goed op. De klant weigerde de eindfactuur te betalen en eiste een volledige heraanleg op kosten van de hovenier.',
    action: 'Met rechtsbijstand werd de discussie onderbouwd met een onafhankelijke beoordeling van de grond en het onderhoud na aanleg. Er werd een redelijk compromis bereikt en de juridische kosten werden gedekt.',
    image: '/images/cases/case-hoveniers-3.jpg',
  },
  {
    category: 'TUINONDERHOUD',
    title: 'Snoeischade aan haag van de buur leidt tot €2.700 claim',
    businessName: 'Hovenij De Wilg',
    ownerName: 'Annick Peeters',
    cityName: 'Zottegem',
    description: 'Bij snoeiwerk in een tuin werd per vergissing een stuk van de aanpalende haag van de buur te ver teruggezet. De buur eiste een vergoeding voor de aangetaste afscherming.',
    action: 'De BA-verzekering ving de schade aan de eigendom van de buur op. Rechtsbijstand begeleidde de afhandeling zodat de zaak vlot en zonder verdere escalatie werd geregeld.',
    image: '/images/cases/case-hoveniers-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een hovenier het meest?",
    content: "De grootste risico's komen meestal uit 4 hoeken:\n\n• Aansprakelijkheid: schade aan de eigendom van je klant of de buren (steenworp, snoeischade, beschadiging).\n\n• Materieel: diefstal van of schade aan je maaiers en gereedschap, vaak onderweg of uit de bestelwagen.\n\n• Geschillen: discussies over een gazon, beplanting of een betwiste factuur.\n\n• Mobiliteit: zonder bestelwagen en aanhanger sta je stil.\n\nDaarom is een basis met BA + materieel + bestelwagen + rechtsbijstand voor veel hoveniers een logische start.",
  },
  {
    title: 'Ben ik gedekt als een steentje van mijn maaier schade veroorzaakt?',
    content: 'Schade die je tijdens je werk aan de eigendom van een klant of derde veroorzaakt, valt doorgaans onder je BA-aansprakelijkheid. Een steenworp tegen een raam of auto is een klassiek voorbeeld. De exacte voorwaarden bekijken we samen bij je intake.',
  },
  {
    title: 'Is mijn materieel verzekerd als het uit mijn bestelwagen gestolen wordt?',
    content: 'Met een combinatie van machinebreuk en een dekking voor vervoerde goederen kan je je maaiers en gereedschap beschermen tegen diefstal en schade, ook onderweg en uit de bestelwagen. We stemmen de dekking af op de waarde van je materieel en hoe je het bewaart.',
  },
  {
    title: 'Heb ik een fytolicentie nodig en heeft dat invloed op mijn verzekering?',
    content: 'Voor het professioneel gebruik van gewasbeschermingsmiddelen geldt in België een fytolicentie-verplichting. Of dit voor jouw activiteiten van toepassing is en wat het betekent voor je dekking, nemen we mee in je intake. Dit is een punt dat we concreet met je nakijken.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel hoveniers starten met een kernpakket en breiden uit wanneer ze personeel aannemen, meer materieel vervoeren of grotere aanplantprojecten doen. Assurman bouwt modulair: je groeit zonder telkens van nul te starten.',
  },
  {
    title: 'Ik werk met seizoenshulp. Telt dat als personeel?',
    content: 'Zodra je mensen voor je laat werken, ook tijdelijk of seizoensgebonden, is een arbeidsongevallenverzekering wettelijk verplicht. Geef je situatie aan bij je intake, dan zorgen we dat je correct in orde bent.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor hoveniers in Vlaanderen"
  description="Maaien, snoeien en beplanten bij de klant thuis: één steenworp of gestolen materieel kost je geld. Assurman bouwt een verzekering op maat van je hoveniersstiel."
  canonical="/sectoren/hoveniers/"
  schema={schema}
>

<style>
  .hov-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .hov-hero-content { max-width: 52%; padding-top: 100px; }
  .hov-hero-img { position: absolute; top: 0; right: -5px; height: min(85vh, calc(48vw * 709 / 594)); width: auto; z-index: 1; pointer-events: none; }
  .hov-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .hov-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .hov-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .hov-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .hov-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .hov-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .hov-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .hov-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .hov-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .hov-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .hov-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .hov-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .hov-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .hov-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .hov-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .hov-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .hov-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .hov-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .hov-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .hov-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .hov-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .hov-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .hov-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .hov-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .hov-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .hov-hero-img { display: none; }
    .hov-features-grid { grid-template-columns: repeat(2, 1fr); }
    .hov-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .hov-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .hov-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .hov-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .hov-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .hov-intro-grid { grid-template-columns: 1fr; }
    .hov-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .hov-container { padding-left: 15px; padding-right: 15px; }
    .hov-hero-content { max-width: 100%; padding-top: 16px; }
    .hov-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .hov-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .hov-benefits-grid { grid-template-columns: 1fr; }
    .hov-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .hov-cards3-grid { grid-template-columns: 1fr; }
    .hov-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .hov-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .hov-testimonials-grid { grid-template-columns: 1fr; }
    .hov-cert-grid { grid-template-columns: 1fr 1fr; }
    .hov-btn-primary { font-size: 16px; padding: 16px 24px; }
    .hov-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .hov-hero-btns { flex-direction: column; }
    .hov-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .hov-cta-btns { flex-direction: column; align-items: center; }
    .hov-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .hov-final-btns { flex-direction: column; align-items: center; }
    .hov-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .hov-step-number { font-size: 56px; }
    .hov-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .hov-waarom-mask-img,
    .hov-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="hov-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:100vh;">
  <div class="hov-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/hoveniers-hero.jpg" alt="Hovenier maait een gazon in een onderhouden tuin" />
  </div>
  <div class="hov-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="hov-hero-content">
      <div class="hov-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor hoveniers
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Beschermd bij de klant en onderweg.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als hovenier werk je dag in dag uit bij mensen thuis: je maait, snoeit, plant en onderhoudt. Eén steentje dat van onder je maaier wegspringt, één gestolen bosmaaier uit de bestelwagen of één discussie over een gazon kan al voor kopzorgen zorgen. Assurman is gespecialiseerd in verzekeringen op maat van bouw- en tuinondernemers in Vlaanderen.
      </p>
      <div class="hov-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="hov-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="hov-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="hov-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="hov-features-grid">
      {[
        { text: 'Specialist in\ntuinonderhoud & groen', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Dekking bij de klant\n+ materieel onderweg', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="hov-container" style="max-width:1110px;">
    <div class="hov-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een hovenier een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Tuinonderhoud lijkt onschuldig, maar je werkt voortdurend in en rond de eigendom van je klant. Een steentje dat van onder je maaier tegen een raam of een geparkeerde auto vliegt, een verkeerde snoei of een beplanting die niet aanslaat: het kan allemaal leiden tot een schadeclaim of een discussie over wie opdraait voor de kosten.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: soort opdrachten (onderhoud, aanplant, snoei), machinepark, personeel, hoeveel je onderweg bent en je risicoprofiel. Zo ben je gedekt waar het er voor een hovenier echt toe doet.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij houdt tuinen in vorm, wij houden je beschermd als er onderweg iets misloopt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Schade bij de klant', text: 'Een steenworp tegen een raam of auto? Met je BA sta je niet zelf voor de rekening.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
          { title: 'Materieel onderweg', text: 'Bescherming voor maaiers, bosmaaiers en gereedschap, ook tijdens transport en bij diefstal.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
          { title: 'Mobiliteit', text: 'Zonder bestelwagen en aanhanger sta je stil. We dekken je voertuig en je verplaatsingen.', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
        ].map((card) => (
          <div class="hov-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;">
    <BrandChevron color="white" height="200px" direction="left" opacity={0.07} />
  </div>
  <div class="hov-container">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="hov-section-label" style="margin-bottom:16px;">Wat hoveniers waarderen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1;color:#FFFFFF;margin:0;">
