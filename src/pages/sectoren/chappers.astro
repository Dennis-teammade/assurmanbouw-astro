---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';
import HeroDeco from '../../components/HeroDeco.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'ba-10', 'rechtsbijstand', 'machinebreuk', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'poz']);

const caseStudies = [
  {
    category: 'DEKVLOEREN',
    title: 'Niet-vlakke chape dwingt herstel van tegelwerk: €16.500 schade',
    businessName: 'Chape Centraal',
    ownerName: 'Davy Lambrecht',
    cityName: 'Aalst',
    description: 'Na het leggen van de tegels bleek de vloer op verschillende plaatsen niet vlak. De tegelzetter wees naar de chape als oorzaak. De bouwheer eiste herstel van zowel de chape als het tegelwerk.',
    action: 'Via de rechtsbijstand en BA-onderneming werd een expert aangesteld die de vlakheidsmetingen en de uitvoering beoordeelde. De aansprakelijkheid werd verdeeld op basis van de meetresultaten. De verzekering nam het toegewezen deel van de herstelkosten op zich.',
    image: '/images/cases/case-chappers-1.jpg',
  },
  {
    category: 'VLOERVERWARMING',
    title: 'Vochtprobleem onder vloerverwarming leidt tot €22.000 gevolgschade',
    businessName: 'Dekvloer De Backer',
    ownerName: 'Tom De Backer',
    cityName: 'Sint-Niklaas',
    description: 'Een parketvloer kwam los doordat de chape rond de vloerverwarming nog te veel restvocht bevatte bij de afwerking. De claim betrof zowel het parket als het uitbreken en heraanleggen.',
    action: 'De rechtsbijstand liet een vochtexpertise uitvoeren. Omdat de aansprakelijkheidsvraag complex was (droogtijd versus opvolging door derden), werd onderhandeld over een gedeelde regeling. De financiële impact voor de chapper bleef beperkt.',
    image: '/images/cases/case-chappers-2.jpg',
  },
  {
    category: 'DEKVLOEREN',
    title: 'Te vroeg belaste chape scheurt: €13.000 in het geding',
    businessName: 'EgaalChape',
    ownerName: 'Kris Vanhecke',
    cityName: 'Dendermonde',
    description: 'Een verse chape werd door andere aannemers betreden en belast voordat ze voldoende was uitgehard. Er ontstonden scheuren en de bouwheer stelde de chapper aansprakelijk.',
    action: 'Via de rechtsbijstand werd aangetoond dat de chape vroegtijdig en zonder toestemming was belast door derden. De aansprakelijkheid werd afgewend en de herstelkosten kwamen niet voor rekening van de chapper.',
    image: '/images/cases/case-chappers-3.jpg',
  },
  {
    category: 'MACHINES',
    title: 'Defecte chapepomp legt planning stil: €8.000 schade en stilstand',
    businessName: 'Chapewerken Verstraete',
    ownerName: 'Ann Verstraete',
    cityName: 'Ninove',
    description: 'Een dure chapepomp gaf er midden in een reeks werven de brui aan door een interne breuk. Naast de herstelkosten dreigde planningverlies omdat geen alternatief direct beschikbaar was.',
    action: 'Via de machinebreukdekking werd de herstelling van de pomp snel afgehandeld. Er kon een vervangoplossing geregeld worden zodat de geplande werven slechts enkele dagen vertraging opliepen.',
    image: '/images/cases/case-chappers-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een chapper het meest?",
    content: "Bij chappers zit het risico vooral in de gevolgen:\n\n• Vlakheid en scheurvorming: een gebrek in de chape werkt door in tegels, parket of gietvloer.\n\n• Vocht en droogtijd: te veel restvocht onder vloerverwarming kan latere schade veroorzaken.\n\n• Te vroeg belasten: vaak door derden, maar de chapper krijgt de schuld.\n\n• Machines: een defecte pomp of menginstallatie legt je planning stil.\n\nDaarom is een basis met BA-onderneming, rechtsbijstand en tienjarige aansprakelijkheid voor veel chappers logisch.",
  },
  {
    title: 'Heb ik tienjarige aansprakelijkheid (BA-10) nodig als chapper?',
    content: 'In veel gevallen wel. De chape maakt structureel deel uit van de vloeropbouw, zeker bij vloerverwarming. Een ernstig gebrek dat de stabiliteit of dichtheid van de constructie raakt, kan onder de tienjarige aansprakelijkheid vallen. In je intake bekijken we of en in welke vorm dit voor jouw werken nodig is.',
  },
  {
    title: 'Wat als de gevolgschade groter is dan mijn eigen werk?',
    content: 'Dat is net het lastige aan chapewerk: de herstelkosten van de afwerking erbovenop (tegels, parket) zijn vaak hoger dan de chape zelf. Je BA-onderneming is bedoeld om die schade aan het werk van anderen mee op te vangen wanneer jij aansprakelijk bent. We stemmen de verzekerde bedragen af op het soort werven dat je doet.',
  },
  {
    title: 'Mijn chape was te vroeg belast door een andere aannemer. Sta ik er alleen voor?',
    content: 'Nee. Bij dit soort discussies helpt rechtsbijstand om de oorzaak technisch te laten vaststellen. Als blijkt dat derden de chape voortijdig hebben belast, kan de aansprakelijkheid afgewend worden. Documenteer altijd je droogtijden en waarschuwingen; dat versterkt je dossier.',
  },
  {
    title: 'Zijn mijn pompen en menginstallatie verzekerd?',
    content: 'Met machinebreuk kan je je eigen materieel beschermen tegen interne defecten en breuk. Voor een chapper is dat vaak waardevol, want stilstand van een pomp legt meteen meerdere werven stil. We bekijken welke machines je hebt en wat de waarde ervan is.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel chappers starten met een kernpakket en breiden uit wanneer ze personeel aannemen, meer vloerverwarming-projecten doen of zwaarder materieel kopen. Assurman bouwt modulair: je groeit zonder telkens opnieuw van nul te starten.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor chappers en dekvloerleggers | Assurman"
  description="Niet-vlakke chape, scheurvorming, vocht onder vloerverwarming, te vroeg belast: chappers dragen reële risico's. Bekijk het pakket op maat van Assurman."
  canonical="/sectoren/chappers/"
  schema={schema}
>

<style>
  .chp-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .chp-hero-content { max-width: 52%; padding-top: 100px; }
  .chp-hero-img { position: absolute; top: 0; right: -5px; width: clamp(420px, 33vw, 620px); height: auto; z-index: 1; pointer-events: none; }
  .chp-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .chp-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .chp-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .chp-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .chp-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .chp-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .chp-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .chp-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .chp-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .chp-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .chp-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .chp-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .chp-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .chp-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .chp-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .chp-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .chp-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .chp-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .chp-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .chp-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .chp-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .chp-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .chp-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .chp-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .chp-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .chp-hero-img { display: none; }
    .chp-features-grid { grid-template-columns: repeat(2, 1fr); }
    .chp-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .chp-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .chp-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .chp-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .chp-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .chp-intro-grid { grid-template-columns: 1fr; }
    .chp-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .chp-container { padding-left: 15px; padding-right: 15px; }
    .chp-hero-content { max-width: 100%; padding-top: 16px; }
    .chp-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .chp-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .chp-benefits-grid { grid-template-columns: 1fr; }
    .chp-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .chp-cards3-grid { grid-template-columns: 1fr; }
    .chp-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .chp-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .chp-testimonials-grid { grid-template-columns: 1fr; }
    .chp-cert-grid { grid-template-columns: 1fr 1fr; }
    .chp-btn-primary { font-size: 16px; padding: 16px 24px; }
    .chp-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .chp-hero-btns { flex-direction: column; }
    .chp-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .chp-cta-btns { flex-direction: column; align-items: center; }
    .chp-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .chp-final-btns { flex-direction: column; align-items: center; }
    .chp-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .chp-step-number { font-size: 56px; }
    .chp-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .chp-waarom-mask-img,
    .chp-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="chp-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:calc(100vh - var(--header-clear));--photo-w:clamp(420px, 33vw, 620px);">
  <HeroDeco containerOffset="max(664px, calc(50vw + 24px))" />
  <div class="chp-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/chappers-hero.jpg" alt="Chapper egaliseert een verse dekvloer" />
  </div>
  <div class="chp-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="chp-hero-content">
      <div class="chp-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor chappers
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Een vlakke basis, een stevige dekking.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Jouw chape is de basis waar de hele vloerafwerking op rust. Een chape die niet vlak ligt, scheurt, te vroeg wordt belast of vocht vasthoudt rond de vloerverwarming kan grote gevolgschade veroorzaken aan tegels, parket of gietvloer. Assurman is gespecialiseerd in verzekeringen op maat van afwerkingsondernemers in Vlaanderen.
      </p>
      <div class="chp-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="chp-btn-primary hero-cta">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="chp-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="chp-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="chp-features-grid">
      {[
        { text: 'Specialist in\nchape & dekvloeren', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Sterk op gevolg-\nschade & geschillen', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
        { text: 'Dekking voor werk\n+ machines + bestelwagen', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="chp-container" style="max-width:1110px;">
    <div class="chp-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een chapper een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          De chape lijkt eenvoudig, maar de gevolgen van een fout zijn dat niet. Ligt de dekvloer niet vlak, dan komt dat pas uit wanneer de tegelzetter of parketlegger begint. Scheurt de chape of wordt ze te vroeg belast, dan kan de schade doorwerken in de volledige vloerafwerking. Omdat de chape structureel deel uitmaakt van de vloeropbouw, kan een gebrek onder de tienjarige aansprakelijkheid vallen.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: gehechte of zwevende chape, vloerverwarming, gietvloer-onderlagen, eigen pompen en menginstallaties, personeel en bestelwagen. Zo ben je gedekt voor de risico's die jouw stiel echt kent.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij legt de basis. Wij zorgen dat een gebrek in de chape je niet jaren later inhaalt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Tienjarige aansprakelijkheid', text: 'Een chape onder vloerverwarming maakt deel uit van de vloeropbouw. BA-10 dekt zware gebreken die later opduiken.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
          { title: 'Gevolgschade aan afwerking', text: 'Met BA dek je schade aan de tegels, het parket of de gietvloer die op jouw chape kwamen.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Machines & bestelwagen', text: 'Bescherming voor je pompen, menginstallatie en bestelwagen zodat je nooit stilstaat.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
        ].map((card) => (
          <div class="chp-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
