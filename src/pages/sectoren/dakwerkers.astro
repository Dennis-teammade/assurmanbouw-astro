---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = [
  {
    title: 'Beroepsaansprakelijkheid (dakwerker)',
    intro: 'Bescherming wanneer jij (of je team) schade veroorzaakt aan derden of wanneer er discussie ontstaat over een fout of gebrek in je werk.',
    bullets: [
      'Schade aan eigendom van klant (bv. waterinsijpeling na werken, beschadigde gevel, doorboring)',
      'Letselschade aan derden (bv. vallend materiaal)',
      'Claims rond beroepsfouten of verkeerd advies',
      'Dekking afgestemd op jouw activiteiten (herstellingen, renovatie, nieuwbouw)',
    ],
    cta: 'Check BA voor dakwerkers',
    link: '/verzekeringen/ba-onderneming/',
    icon: 'shield',
  },
  {
    title: "ABR (Alle Bouwplaats Risico's) – Werfdekking",
    intro: "Voor dakwerkers is de werf vaak de grootste bron van 'onverwachte kosten': schade tijdens uitvoering, beschadigde materialen, incidenten door weer of derden.",
    bullets: [
      'Schade aan werken in uitvoering',
      "Risico's op de werf (afhankelijk van situatie en afspraken)",
      'Extra geruststelling bij grotere projecten of complexe renovaties',
      'Zeker interessant bij meerdere partijen op één werf',
    ],
    cta: 'Check ABR',
    link: '/verzekeringen/alle-bouwplaats-risicos/',
    icon: 'wrench',
  },
  {
    title: 'Bedrijfsvoertuigen',
    intro: 'De bestelwagen is voor de meeste dakwerkers onmisbaar: van gereedschap naar de werf, van werf naar werf. Zonder voertuig sta je letterlijk stil.',
    bullets: [
      'Schade aan bestelwagen door accident, brand of diefstal',
      'Omnium- of mini-omniumdekking op maat van jouw gebruik',
      'Bescherming voor voertuigen ook buiten de standaard rijuren',
      'Snelle afhandeling zodat je snel terug op de werf bent',
    ],
    cta: 'Check bedrijfsvoertuigen',
    link: '/verzekeringen/bedrijfsvoertuigen/',
    icon: 'truck',
  },
  {
    title: 'Machinebreukverzekering',
    intro: 'Dakwerkers werken met gespecialiseerde machines en duur gereedschap: ladders, dakliften, compressoren, zaagmachines en valbeveiliging. Een defect of diefstal stopt je werk.',
    bullets: [
      'Dekking voor machines en gereedschap bij breuk of beschadiging',
      'Diefstal van professioneel materiaal op werf, thuis of in de bestelwagen',
      'Vervanging of herstelling zodat je continuïteit bewaart',
      'Afstembaar op waarde en gebruik van jouw machines',
    ],
    cta: 'Check machinebreuk',
    link: '/verzekeringen/machinebreuk',
    icon: 'wrench',
  },
  {
    title: 'Rechtsbijstand',
    intro: 'Bij dakwerken ontstaan soms discussies over schade, aansprakelijkheid of uitgevoerde werken. Rechtsbijstand helpt je bij juridische conflicten.',
    bullets: [
      'Juridische hulp bij geschillen met klanten of derden',
      'Ondersteuning bij betwiste aansprakelijkheid of klachten',
      'Tussenkomst bij advocaat- en expertkosten volgens de polis',
      'Sterke aanvulling op BA en ABR bij conflictsituaties',
    ],
    cta: 'Check rechtsbijstand',
    link: '/verzekeringen/rechtsbijstand',
    icon: 'users',
  },
  {
    title: 'Arbeidsongevallenverzekering',
    intro: "Voor dakwerkers met personeel is dit een essentiële dekking. Werken op hoogte en op de werf brengt risico's mee.",
    bullets: [
      'Bescherming bij ongevallen op de werf of onderweg',
      'Relevant voor dakwerkers met personeel',
      'Extra belangrijk bij werk op hoogte en stellingen',
      'Meer zekerheid voor werkgever en werknemer',
    ],
    cta: 'Check arbeidsongevallen',
    link: '/verzekeringen/arbeidsongevallen/',
    icon: 'zap',
  },
];

const caseStudies = [
  {
    category: 'DAKWERKEN',
    title: 'Waterinsijpeling na herstelwerken leidt tot €45.000 schadeclaim',
    businessName: 'DakPro Renovaties',
    ownerName: 'Peter Vermeulen',
    cityName: 'Kortrijk',
    description: 'Na voltooiing van een dakrestauratie ontstond een geschil over de afwerking van de aansluitingen met de gevel. De klant claimde dat afspraken niet correct waren nageleefd en eiste kostenloos herstel.',
    action: "Via de BA-verzekering kon een juridische expert worden ingeschakeld die de communicatie, plannen en foto's analyseerde. Na bemiddeling werd een compromis bereikt waarbij een deel van de werken werd uitgevoerd. De verzekering dekte de juridische kosten en een deel van de herstelwerken. Het conflict escaleerde niet verder.",
    image: 'https://images.pexels.com/photos/585419/pexels-photo-585419.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    category: 'DAKWERKEN',
    title: 'Materiaalschade tijdens uitvoering kost €18.000 aan verloren dakpannen en isolatie',
    businessName: 'Dacappo West-Vlaanderen',
    ownerName: 'Johan De Smet',
    cityName: 'Brugge',
    description: "Tijdens renovatie van een industrieel gebouw werden geleverde dakpannen en isolatiemateriaal zwaar beschadigd door een onverwachte storm. De materialen lagen tijdelijk op de werf in afwachting van installatie.",
    action: "Via de ABR-dekking (Alle Bouwplaats Risico's) werd de schade aan materialen snel afgehandeld. Nieuwe leveringen werden versneld georganiseerd en het project liep slechts enkele dagen vertraging op.",
    image: 'https://images.pexels.com/photos/834892/pexels-photo-834892.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    category: 'DAKWERKEN',
    title: 'Inbraak in bestelwagen: €12.000 aan professioneel gereedschap gestolen',
    businessName: 'VandeDak bvba',
    ownerName: 'Marc Claeys',
    cityName: 'Gent',
    description: 'Een eenmanszaak gespecialiseerd in dakherstellingen werd getroffen door een gerichte diefstal. De bestelwagen stond geparkeerd op de oprit thuis. Dieven forceerden de deuren en namen alle essentiële gereedschappen mee.',
    action: 'Dankzij de gereedschapverzekering kon binnen 48 uur een vervangingsorder geplaatst worden bij leveranciers. De verzekering dekte vrijwel de volledige schade. De zaakvoerder verloor slechts één dag werk en kon zijn afspraken grotendeels nakomen.',
    image: 'https://images.pexels.com/photos/1216589/pexels-photo-1216589.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    category: 'DAKWERKEN',
    title: 'Klant eist herstel na discussie over geveldichting bij renovatieproject',
    businessName: 'TopDak Solutions',
    ownerName: 'Stefaan Hoste',
    cityName: 'Roeselare',
    description: "Na voltooiing van een dakrestauratie ontstond een geschil over de afwerking van de aansluitingen met de gevel. De klant claimde dat afspraken niet correct waren nageleefd en eiste kostenloos herstel.",
    action: "Via de BA-verzekering kon een juridische expert worden ingeschakeld die de communicatie, plannen en foto's analyseerde. Na bemiddeling werd een compromis bereikt waarbij een deel van de werken werd uitgevoerd.",
    image: 'https://images.pexels.com/photos/1249611/pexels-photo-1249611.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een dakwerker het meest?",
    content: "De grootste risico's komen meestal uit 4 hoeken:\n\n• Aansprakelijkheid: schade aan derden of aan eigendom van de klant (bv. beschadigingen, lekkages, discussies over uitvoering).\n\n• Werfrisico's: onvoorziene schade tijdens werken, omstandigheden op de werf, meerdere partijen tegelijk.\n\n• Materiaal & gereedschap: diefstal, schade of verlies veroorzaakt snel stilstand.\n\n• Mobiliteit: zonder bestelwagen sta je stil.\n\nDaarom is een basis met BA + ABR + materiaal/bestelwagen voor veel dakwerkers een logische start.",
  },
  {
    title: 'Wat is het verschil tussen BA en ABR?',
    content: "BA (Burgerlijke Aansprakelijkheid) gaat vooral over schade die je aan anderen veroorzaakt of claims rond je beroepsactiviteit. Denk aan schade aan eigendom van de klant of letselschade.\n\nABR (Alle Bouwplaats Risico's) focust op risico's rond de werf en werken in uitvoering. Het is typisch interessant bij grotere werken, renovaties, of werven met meerdere partijen.\n\nIn de praktijk vullen BA en ABR elkaar aan. Assurman helpt je kiezen wat in jouw situatie écht nodig is.",
  },
  {
    title: 'Is gereedschapverzekering nuttig als ik vooral kleine werven doe?',
    content: "Ook bij kleinere werven kan gereedschapverzekering het verschil maken. De impact zit niet alleen in de aankoopprijs, maar vooral in werkverlies: als je essentiële tools kwijt bent, verlies je dagen planning.\n\nWe stemmen dekking af op: waarde van je tools, waar ze liggen (atelier, camionette, werf), en hoe je beveiliging georganiseerd is.",
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: "Ja. Veel dakwerkers starten met een kernpakket en breiden uit wanneer ze personeel aannemen, grotere werven doen, meer materiaal vervoeren, of vaker onderaannemers inzetten.\n\nAssurman bouwt modulair: je groeit zonder dat je telkens opnieuw van nul moet starten.",
  },
  {
    title: 'Welke verzekeringen zijn het belangrijkst voor dakwerkers?',
    content: "In de praktijk starten veel dakwerkers met BA uitbating/beroepsaansprakelijkheid, aangevuld met ABR (zeker bij grotere of complexere werven) en verzekering voor materiaal, gereedschap en bestelwagen.",
  },
  {
    title: 'Ik werk met onderaannemers. Wat betekent dat voor mijn verzekering?',
    content: "Dat kan invloed hebben op risico's en afspraken rond aansprakelijkheid op de werf. In je intake kan je aangeven dat je met onderaannemers werkt. We bekijken daarna welke dekking en voorwaarden het best passen.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor dakwerkers in West- & Oost-Vlaanderen"
  description="Werken op hoogte, wisselende werven, duur materiaal: dakwerkers hebben specifieke verzekeringsnoden. Bekijk het pakket op maat van Assurman."
  canonical="/sectoren/dakwerkers"
  schema={schema}
>

<style>
  .dw-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .dw-hero-content { max-width: 52%; padding-top: 40px; }
  .dw-hero-img { position: absolute; top: 5%; right: 0; height: 90%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .dw-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .dw-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; align-items: flex-start; }
  .dw-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .dw-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .dw-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dw-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .dw-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .dw-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dw-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .dw-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .dw-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .dw-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .dw-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .dw-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .dw-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .dw-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .dw-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .dw-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .dw-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .dw-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .dw-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .dw-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .dw-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .dw-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .dw-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .dw-hero-img { display: none; }
    .dw-features-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .dw-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .dw-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-intro-grid { grid-template-columns: 1fr; }
    .dw-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .dw-container { padding-left: 15px; padding-right: 15px; }
    .dw-hero-content { max-width: 100%; padding-top: 16px; }
    .dw-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .dw-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .dw-benefits-grid { grid-template-columns: 1fr; }
    .dw-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .dw-cards3-grid { grid-template-columns: 1fr; }
    .dw-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .dw-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .dw-testimonials-grid { grid-template-columns: 1fr; }
    .dw-cert-grid { grid-template-columns: 1fr 1fr; }
    .dw-btn-primary { font-size: 16px; padding: 16px 24px; }
    .dw-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .dw-hero-btns { flex-direction: column; }
    .dw-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .dw-cta-btns { flex-direction: column; align-items: center; }
    .dw-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .dw-final-btns { flex-direction: column; align-items: center; }
    .dw-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .dw-step-number { font-size: 56px; }
    .dw-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .dw-waarom-mask-img,
    .dw-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="dw-hero-section" style="padding-top:120px;background:#FFFFFF;position:relative;overflow:hidden;min-height:480px;">
  <div class="dw-hero-img assurman-mask assurman-mask--hero">
    <img src="/assurman-verzekeringen-bouwsector-dakwerker-hero.jpg" alt="Dakwerker aan het werk op een hellend dak" />
  </div>
  <div class="dw-container" style="padding-top:40px;padding-bottom:64px;position:relative;z-index:2;">
    <div class="dw-hero-content">
      <div class="dw-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor dakwerkers
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Veilig op de werf, op hoogte en onderweg.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als dakwerker neem je elke dag risico's: valgevaar, schade aan eigendom, werfschade, materiaalverlies en discussies over aansprakelijkheid. Assurman is gespecialiseerd in verzekeringen op maat van bouwondernemers in Vlaanderen.
      </p>
      <div class="dw-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="dw-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="dw-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="dw-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="dw-features-grid">
      {[
        { text: 'Specialist in\ndakwerkers & bouw', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
        { text: 'Dekking voor werf\n+ materiaal + mobiliteit', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="dw-container" style="max-width:1110px;">
    <div class="dw-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een dakwerker een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
