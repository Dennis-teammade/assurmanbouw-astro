              <div style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#3F5767;margin-bottom:8px;">{stat.label}</div>
              <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:6px;">{stat.value}</div>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:13px;line-height:1.5;color:#001F3F;margin:0;">{stat.text}</p>
            </a>
          : <div class="hvc-insurance-card" style="padding:24px;text-align:center;clip-path:polygon(32px 0%,100% 0%,100% 100%,0% 100%,0% 32px);">
              <div style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#CBD5E1;margin-bottom:8px;">{stat.label}</div>
              <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#FFFFFF;margin-bottom:6px;">{stat.value}</div>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:13px;line-height:1.5;color:#CBD5E1;margin:0;">{stat.text}</p>
            </div>
      ))}
    </div>

    <div class="hvc-cards3-grid">
      {[
        { title: 'Minder discussies, meer duidelijkheid', text: 'We leggen alles helder uit, geen verrassingen achteraf.' },
        { title: 'Past bij kleine én groeiende teams', text: 'Eénmanszaak? Meerdere ploegen? We schalen je pakket mee met je bedrijf.' },
        { title: 'Klaar voor echte werfrealiteit', text: "Van warmtepomp tot industriële koeling: we denken mee over risico's die typisch zijn voor HVAC-werk." },
      ].map((card) => (
        <div class="hvc-insurance-card" style="padding:28px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 32px),calc(100% - 32px) 100%,0% 100%);">
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;color:#FFFFFF;margin-bottom:10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.6;color:#CBD5E1;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

