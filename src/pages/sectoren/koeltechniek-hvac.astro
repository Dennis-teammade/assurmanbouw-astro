/>

<!-- SECTION 6: WAAROM KIEZEN -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.07) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:0;"></div>
  <div class="assurman-mask assurman-mask--why hvc-waarom-mask-img" style="position:absolute;top:0;right:-5px;width:380px;pointer-events:none;z-index:0;">
