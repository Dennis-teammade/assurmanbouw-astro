        { title: 'Slimme modules', text: 'Voeg toe wat jij nodig hebt: materiaal, machinebreuk, mobiliteit, rechtsbijstand.', iconPath: 'M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5M9 18h6M10 22h4' },
        { title: 'Snelle intake', text: 'Na een audit van onze expert stemmen we alles af op jouw type installaties en onderhoudswerk.', iconPath: 'M10 2L14 2M12 14L15 11M4 14a8 8 0 1 0 16 0a8 8 0 1 0-16 0' },
        { title: 'Bouw-expertise', text: 'We spreken jouw taal: warmtepomp, split-unit, koelmiddel, condensafvoer, debiet, COP.', iconPath: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z' },
