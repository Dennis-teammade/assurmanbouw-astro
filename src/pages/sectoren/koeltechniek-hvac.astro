  </div>
  <div class="hvc-container" style="position:relative;z-index:1;">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="hvc-section-label" style="margin-bottom:16px;">Waarom Assurman</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3.5vw,48px);line-height:1;color:#FFFFFF;margin:0 auto;max-width:762px;">
        Waarom koeltechnici en HVAC-installateurs voor Assurman kiezen
      </h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.6;color:#CBD5E1;margin-top:16px;">
        Omdat je een verzekeringspartner wil die de bouwsector begrijpt en snel schakelt.
      </p>
    </div>

    <div class="hvc-stats-grid">
      {[
        { label: 'Focus', value: 'Bouwsector', text: 'Geen algemene aanpak, maar afgestemd op jouw stiel.' },
        { label: 'Maatwerk', value: 'Modulair pakket', text: 'Jij kiest: basis + opties. Niet te veel, niet te weinig.' },
        { label: 'Efficiënt', value: 'Scan in 2 min', text: 'Start snel, ontdek of je correct en volledig bent beschermd.', href: CTA_DESTINATIONS.scan },
        { label: 'Ondersteuning', value: 'Duidelijk contact', text: 'Je krijgt uitleg waar je iets aan hebt.' },
      ].map((stat) => (
        stat.href
