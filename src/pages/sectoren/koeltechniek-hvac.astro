---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'vervoerde-goederen', 'machinebreuk', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'rechtsbijstand']);

const caseStudies = [
  {
    category: 'KOELTECHNIEK & HVAC',
    title: 'Koelmiddellek na installatie leidt tot €16.000 herstel- en gevolgschade',
    businessName: 'Klimaat Coolservice',
    ownerName: 'Bart Wauters',
    cityName: 'Hasselt',
    description: 'Na de plaatsing van een airco-installatie in een winkelpand ontstond een lek in het koelmiddelcircuit. De installatie viel uit en de klant claimde naast het herstel ook de schade door het stilvallen van de koeling tijdens een warme periode.',
    action: 'De BA Na Levering dekte de gevolgschade die aan de uitvoeringsfout werd toegeschreven. Een expert beoordeelde de oorzaak en de installateur kon het geschil afronden zonder zelf de volledige kost te dragen.',
    image: '/images/cases/case-koeltechniek-hvac-1.jpg',
  },
  {
    category: 'KOELTECHNIEK & HVAC',
    title: 'Geschil over verkeerd gedimensioneerde warmtepomp loopt op tot €22.000',
    businessName: 'WarmteWise',
    ownerName: 'Dieter Cools',
    cityName: 'Leuven',
    description: 'Een klant stelde dat de geplaatste warmtepomp de woning onvoldoende verwarmde en eiste vervanging plus schadevergoeding. Er ontstond discussie over de berekende warmtebehoefte en wat er in de offerte was afgesproken.',
    action: 'Via de rechtsbijstand werd een onafhankelijke expert ingeschakeld die de dimensionering en de offerte beoordeelde. Na bemiddeling kwam er een regeling en bleven de juridische kosten gedekt.',
    image: '/images/cases/case-koeltechniek-hvac-2.jpg',
  },
  {
    category: 'KOELTECHNIEK & HVAC',
    title: 'Waterschade door lekkende condensafvoer veroorzaakt €13.500 aan plafondschade',
    businessName: 'Aircomfort bvba',
    ownerName: 'Sven Peeters',
    cityName: 'Mechelen',
    description: 'Bij een binnenunit kwam de condensafvoer los waardoor water in het plafond en de gipswanden van de verdieping eronder liep. De gebouweigenaar stelde de installateur aansprakelijk voor de waterschade.',
    action: 'De BA Uitbating dekte de waterschade aan het gebouw van de klant. De claim werd snel afgehandeld en het conflict liep niet uit op een procedure.',
    image: '/images/cases/case-koeltechniek-hvac-3.jpg',
  },
  {
    category: 'KOELTECHNIEK & HVAC',
    title: 'Dure warmtepomp beschadigd bij transport en plaatsing: €8.900',
    businessName: 'Thermflow Technics',
    ownerName: 'Glenn Verhulst',
    cityName: 'Antwerpen',
    description: 'Bij het lossen en hijsen van een buitenunit op een platdak viel de warmtepomp van de pallet en raakte de behuizing en het lamellenpakket beschadigd. De unit was niet meer bruikbaar.',
    action: 'Via de verzekering voor vervoerde goederen werd de beschadigde unit vergoed. Een vervangende unit werd versneld geleverd zodat het project nauwelijks vertraging opliep.',
    image: '/images/cases/case-koeltechniek-hvac-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een koeltechnicus of HVAC-installateur het meest?",
    content: "De grootste risico's komen meestal uit 4 hoeken:\n\n• Koelmiddelen: lekken en fouten brengen aansprakelijkheid en gevolgschade mee.\n\n• Waterschade: lekkende condensafvoer of een leiding die loskomt.\n\n• Materiaal & mobiliteit: dure units en gereedschap, plus je bestelwagen.\n\n• Geschillen: discussie over dimensionering, uitvoering of opbrengst.\n\nDaarom is een basis met BA Onderneming + materiaal/machinebreuk + bestelwagen + rechtsbijstand voor veel technici een logische start.",
  },
  {
    title: 'Mijn werk valt onder de F-gassenregels. Heeft dat invloed op mijn verzekering?',
    content: 'Werken met koelmiddelen valt in België onder de Europese F-gassenverordening, waarvoor erkenning en certificatie geldt. Of een verzekeraar daar voorwaarden aan koppelt, hangt af van je activiteiten. In je intake brengen we dit samen in kaart zodat je dekking aansluit op je manier van werken.',
  },
  {
    title: 'Ben ik gedekt voor waterschade die mijn installatie veroorzaakt?',
    content: 'Waterschade door een lekkende condensafvoer of een leiding is een typische HVAC-claim. Schade aan het gebouw van je klant valt doorgaans onder je BA Uitbating, en gebreken die na de oplevering opduiken onder BA Na Levering. We bekijken samen of jouw dekking dit correct opvangt.',
  },
  {
    title: 'Wat als een klant klaagt dat de warmtepomp niet goed werkt?',
    content: "Discussies over dimensionering en prestaties komen vaak voor. Wat je in je offerte belooft en hoe de berekening is gemaakt, weegt zwaar door. Een rechtsbijstandsverzekering helpt je om zo'n geschil correct te laten beoordelen en de juridische kosten op te vangen.",
  },
  {
    title: 'Zijn mijn units en gereedschap verzekerd onderweg en op de werf?',
    content: 'Dat kan, via een verzekering voor vervoerde goederen en een machinebreukdekking. Warmtepompen en airco-units zijn duur en kwetsbaar bij transport en plaatsing. We stemmen de dekking af op wat je vervoert, waar het ligt en hoe je beveiliging geregeld is.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel technici starten met een kernpakket en breiden uit wanneer ze personeel aannemen, onderhoudscontracten opnemen, grotere of industriële installaties doen of vaker met onderaannemers werken. Assurman bouwt modulair: je groeit zonder telkens van nul te starten.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor koeltechniek & HVAC | Assurman"
  description="Warmtepompen, airco, koeling en ventilatie: koeltechnici en HVAC-installateurs werken met koelmiddelen, dure units en waterleidingen. Ontdek je pakket bij Assurman."
  canonical="/sectoren/koeltechniek-hvac/"
  schema={schema}
>

<style>
  .hvc-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .hvc-hero-content { max-width: 52%; padding-top: 40px; }
  .hvc-hero-img { position: absolute; top: 5%; right: 0; height: 90%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .hvc-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .hvc-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .hvc-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .hvc-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .hvc-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .hvc-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .hvc-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .hvc-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .hvc-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .hvc-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .hvc-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .hvc-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .hvc-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .hvc-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .hvc-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .hvc-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .hvc-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .hvc-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .hvc-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .hvc-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .hvc-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .hvc-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .hvc-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .hvc-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .hvc-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .hvc-hero-img { display: none; }
    .hvc-features-grid { grid-template-columns: repeat(2, 1fr); }
    .hvc-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .hvc-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .hvc-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .hvc-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .hvc-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .hvc-intro-grid { grid-template-columns: 1fr; }
    .hvc-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .hvc-container { padding-left: 15px; padding-right: 15px; }
    .hvc-hero-content { max-width: 100%; padding-top: 16px; }
    .hvc-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .hvc-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .hvc-benefits-grid { grid-template-columns: 1fr; }
    .hvc-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .hvc-cards3-grid { grid-template-columns: 1fr; }
    .hvc-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .hvc-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .hvc-testimonials-grid { grid-template-columns: 1fr; }
    .hvc-cert-grid { grid-template-columns: 1fr 1fr; }
    .hvc-btn-primary { font-size: 16px; padding: 16px 24px; }
    .hvc-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .hvc-hero-btns { flex-direction: column; }
    .hvc-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .hvc-cta-btns { flex-direction: column; align-items: center; }
    .hvc-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .hvc-final-btns { flex-direction: column; align-items: center; }
    .hvc-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .hvc-step-number { font-size: 56px; }
    .hvc-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .hvc-waarom-mask-img,
    .hvc-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="hvc-hero-section" style="padding-top:120px;background:#FFFFFF;position:relative;overflow:hidden;min-height:480px;">
  <div class="hvc-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/koeltechniek-hvac-hero.jpg" alt="Koeltechnicus installeert een warmtepomp aan een gevel" />
  </div>
  <div class="hvc-container" style="padding-top:40px;padding-bottom:64px;position:relative;z-index:2;">
    <div class="hvc-hero-content">
      <div class="hvc-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor koeltechniek & HVAC
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Gedekt bij koelmiddel, klimaat en alles wat je installeert.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als koeltechnicus of HVAC-installateur werk je met warmtepompen, airco, koeling, ventilatie en klimaatinstallaties. Je hanteert koelmiddelen, je sleept dure units en je legt leidingen die water voeren. Eén koelmiddellek, één verkeerd gedimensioneerde warmtepomp of één lekkende condensafvoer kan al leiden tot schadeclaims of stilstand. Assurman is gespecialiseerd in verzekeringen op maat van bouwondernemers in Vlaanderen.
      </p>
      <div class="hvc-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="hvc-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="hvc-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="hvc-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="hvc-features-grid">
      {[
        { text: 'Specialist in\nkoeltechniek & HVAC', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
        { text: 'Dekking voor units\n+ materiaal + mobiliteit', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="hvc-container" style="max-width:1110px;">
    <div class="hvc-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een koeltechnicus een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Koeltechniek en HVAC zijn geen standaardstiel. Je werkt met koelmiddelen die onder strenge regels vallen, met elektriciteit, met dure buiten- en binnenunits en met leidingen die water of condens afvoeren. Eén lek, één unit die verkeerd gedimensioneerd blijkt of één condensafvoer die water laat lopen kan uitmonden in een claim voor gevolgschade aan het gebouw van je klant.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: type installaties (warmtepomp, airco, koeling, ventilatie), residentieel of industrieel, onderhoudscontracten, personeel, onderaannemers, de waarde van je units en gereedschap, en je bestelwagen.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij zorgt voor het klimaat binnen, wij zorgen dat je beschermd bent als de installatie iets veroorzaakt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Koelmiddelen & gevolgschade', text: 'Werken met F-gassen en koelmiddelen brengt aansprakelijkheid mee. Een lek of fout kan leiden tot gevolgschade en betwisting.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Waterschade & condens', text: 'Lekkende condensafvoer of een leiding die loskomt is een typische HVAC-claim. BA Uitbating en BA Na Levering vangen dit op.', iconPath: 'M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z' },
          { title: 'Dure units & mobiliteit', text: 'Bescherming voor warmtepompen, airco-units, gereedschap en bestelwagen zodat één breuk of diefstal je niet stillegt.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
        ].map((card) => (
          <div class="hvc-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;">
