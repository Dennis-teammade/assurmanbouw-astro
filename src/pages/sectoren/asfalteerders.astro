---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'alle-bouwplaats-risicos', 'machinebreuk', 'bedrijfsvoertuigen', 'rechtsbijstand', 'arbeidsongevallen', 'aanvullend-pensioen']);

const caseStudies = [
  {
    category: 'WEGENIS',
    title: 'Geschil over vlakheid parking leidt tot €24.000 herstelclaim',
    businessName: 'Asfaltwerken Verhaeghe',
    ownerName: 'Dirk Verhaeghe',
    cityName: 'Roeselare',
    description: 'Na de aanleg van een grote bedrijfsparking klaagde de opdrachtgever over plassen en oneffenheden in het wegdek. Hij eiste een herasfaltering van de probleemzones.',
    action: 'Via de rechtsbijstand werd een onafhankelijke expert ingeschakeld die de vlakheid en afwatering opmat. Na bemiddeling werd een deel van de zone opnieuw geasfalteerd. De verzekering dekte de juridische kosten en een deel van de herstelwerken. Het conflict escaleerde niet verder.',
    image: '/images/cases/case-asfalteerders-1.jpg',
  },
  {
    category: 'WEGENIS',
    title: 'Schade aan boordstenen en verkeersbord tijdens werken: €11.000',
    businessName: 'Wegeniswerken Tytgat',
    ownerName: 'Frank Tytgat',
    cityName: 'Oudenaarde',
    description: 'Tijdens asfalteringswerken langs een gewestweg raakte de asfalteermachine bestaande boordstenen en een verkeersbord, die hersteld moesten worden voor de heropening van de weg.',
    action: 'Via de burgerlijke aansprakelijkheid werd de schade aan het wegmeubilair gedekt. De herstelling werd snel uitgevoerd zodat de weg op tijd kon heropenen, zonder dat de aannemer de kost volledig zelf droeg.',
    image: '/images/cases/case-asfalteerders-2.jpg',
  },
  {
    category: 'MACHINESCHADE',
    title: 'Asfalteermachine valt uit op lopende werf: €35.000 herstel',
    businessName: 'Asfaltering De Meyer',
    ownerName: 'Luc De Meyer',
    cityName: 'Sint-Niklaas',
    description: 'Op een wegenwerf viel de asfalteermachine uit door een technisch defect. Omdat asfalt op temperatuur moet verwerkt worden, kwam de hele planning onmiddellijk in het gedrang.',
    action: 'Dankzij de machinebreukverzekering werd de herstelling met voorrang goedgekeurd en vergoed. Er kon snel geschakeld worden, waardoor de stilstand en het verlies aan materiaal beperkt bleven.',
    image: '/images/cases/case-asfalteerders-3.jpg',
  },
  {
    category: 'WEGENIS',
    title: 'Beschadigde nutsput in wegdek na asfaltering: €6.500 herstel',
    businessName: 'Asfalt & Wegenis Buyse',
    ownerName: 'Jeroen Buyse',
    cityName: 'Brugge',
    description: 'Bij de afwerking van een wegvak werd een bestaande nutsput in het wegdek beschadigd, waardoor de netbeheerder herstel eiste voordat de weg vrijgegeven werd.',
    action: 'Via de aansprakelijkheid werd de schade aan de nutsput gedekt. Na expertise werd de herstelkost vergoed en kon de weg correct opgeleverd worden, zonder dat de aannemer er zelf voor opdraaide.',
    image: '/images/cases/case-asfalteerders-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een asfalteerder het meest?",
    content: "De grootste risico's komen meestal uit 4 hoeken:\n\n• Aansprakelijkheid & geschillen: discussies over vlakheid en afwatering, of schade aan wegmeubilair en derden.\n\n• Machinepark: een dure asfalteermachine of wals die uitvalt, legt meteen de werf stil.\n\n• Werfrisico's: werken naast verkeer, hete materialen, onvoorziene schade tijdens de werken.\n\n• Mobiliteit & personeel: zonder transport en zonder ploeg sta je stil.\n\nDaarom is een basis met BA + ABR + machinebreuk + rechtsbijstand voor veel asfalteerders een logische start.",
  },
  {
    title: 'Wat als een klant klaagt over de vlakheid of afwatering?',
    content: "Dat is een typische discussie bij asfaltering. De opdrachtgever vindt dat er plassen staan of dat het wegdek niet vlak genoeg ligt, en eist herstel.\n\nRechtsbijstand en burgerlijke aansprakelijkheid zijn hier de kernblokken: rechtsbijstand betaalt de expert en de juridische kosten om vast te stellen wat er aan de hand is, de aansprakelijkheid dekt terecht herstel. We bekijken samen welke dekking past bij jouw werken.",
  },
  {
    title: 'Wie betaalt schade aan wegmeubilair of boordstenen?',
    content: "Raak je tijdens de werken bestaande boordstenen, verkeersborden, nutsputten of ander wegmeubilair, dan valt dat onder schade aan derden.\n\nDe burgerlijke aansprakelijkheid van je onderneming is hier het kernblok. We stemmen de dekking af op het soort werken dat je doet en de locaties waarop je werkt.",
  },
  {
    title: 'Hoe verzeker ik mijn asfalteermachine en walsen?',
    content: "Dat gebeurt typisch via machinebreuk en eventueel voertuig- of werfmateriaaldekking, afhankelijk van het type machine. Een uitgevallen asfalteermachine legt een hele werf stil, zeker omdat asfalt op temperatuur verwerkt moet worden.\n\nWe stemmen de dekking af op de waarde van je machines, of ze ingeschreven zijn, en waar je ze inzet.",
  },
  {
    title: 'Wat is het verschil tussen BA en ABR bij asfaltering?',
    content: "BA (Burgerlijke Aansprakelijkheid) gaat vooral over schade die je aan anderen veroorzaakt: een geraakte boordsteen, beschadigd wegmeubilair, schade aan derden.\n\nABR (Alle Bouwplaats Risico's) focust op de werf zelf en de werken in uitvoering. In de praktijk vullen ze elkaar aan. Assurman helpt je kiezen wat in jouw situatie écht nodig is.",
  },
  {
    title: 'Ik werk vaak op de openbare weg en met onderaannemers. Wat betekent dat?',
    content: "Werken op de openbare weg en met onderaannemers brengt extra aansprakelijkheidsvragen mee, bijvoorbeeld rond signalisatie, verkeer en schade aan wegenis.\n\nIn je intake geef je aan hoe je werkt. We bekijken daarna welke dekking en voorwaarden het best passen bij jouw type werven.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor asfalteerders & wegenis | Assurman"
  description="Wegenis, parkings en asfalteringswerken brengen eigen risico's mee. Assurman bouwt jouw verzekeringspakket op maat van de werf."
  canonical="/sectoren/asfalteerders/"
  schema={schema}
>

<style>
  .asf-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .asf-hero-content { max-width: 52%; padding-top: 40px; }
  .asf-hero-img { position: absolute; top: 5%; right: 0; height: 90%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .asf-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .asf-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .asf-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .asf-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .asf-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .asf-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .asf-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .asf-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .asf-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .asf-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .asf-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .asf-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .asf-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .asf-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .asf-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .asf-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .asf-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .asf-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .asf-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .asf-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .asf-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .asf-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .asf-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .asf-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .asf-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .asf-hero-img { display: none; }
    .asf-features-grid { grid-template-columns: repeat(2, 1fr); }
    .asf-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .asf-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .asf-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .asf-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .asf-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .asf-intro-grid { grid-template-columns: 1fr; }
    .asf-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .asf-container { padding-left: 15px; padding-right: 15px; }
    .asf-hero-content { max-width: 100%; padding-top: 16px; }
    .asf-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .asf-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .asf-benefits-grid { grid-template-columns: 1fr; }
    .asf-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .asf-cards3-grid { grid-template-columns: 1fr; }
    .asf-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .asf-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .asf-testimonials-grid { grid-template-columns: 1fr; }
    .asf-cert-grid { grid-template-columns: 1fr 1fr; }
    .asf-btn-primary { font-size: 16px; padding: 16px 24px; }
    .asf-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .asf-hero-btns { flex-direction: column; }
    .asf-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .asf-cta-btns { flex-direction: column; align-items: center; }
    .asf-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .asf-final-btns { flex-direction: column; align-items: center; }
    .asf-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .asf-step-number { font-size: 56px; }
    .asf-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .asf-waarom-mask-img,
    .asf-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="asf-hero-section" style="padding-top:120px;background:#FFFFFF;position:relative;overflow:hidden;min-height:480px;">
  <div class="asf-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/asfalteerders-hero.jpg" alt="Asfalteerploeg die met een asfalteermachine een nieuw wegdek aanlegt" />
  </div>
  <div class="asf-container" style="padding-top:40px;padding-bottom:64px;position:relative;z-index:2;">
    <div class="asf-hero-content">
      <div class="asf-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor asfalteerders
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Strak afgewerkt, goed verzekerd.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Een parking of wegdek moet vlak liggen, goed afwateren en jaren meegaan. Eén discussie over de vlakheid, schade aan wegmeubilair of een uitgevallen asfalteermachine kan een werf duur maken. Assurman is gespecialiseerd in verzekeringen op maat van asfalteerders en wegenisaannemers in Vlaanderen.
      </p>
      <div class="asf-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="asf-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="asf-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="asf-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="asf-features-grid">
      {[
        { text: 'Specialist in\nasfaltering & wegenis', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Dekking bij\nvlakheid- & afwateringsdiscussies', iconPath: 'M21.3 8.7l-8-8a1 1 0 0 0-1.4 0l-11 11a1 1 0 0 0 0 1.4l8 8a1 1 0 0 0 1.4 0l11-11a1 1 0 0 0 0-1.4zM14 8l-2 2M11 5l-2 2M8 14l-2 2M17 11l-2 2' },
        { text: 'Asfalteermachine\ncorrect verzekerd', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Eén aanspreekpunt\nvoor je hele werf', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="asf-container" style="max-width:1110px;">
    <div class="asf-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een asfalteerder een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Asfalteren is precisiewerk met zware machines op vaak drukke locaties. Je werkt met hete materialen, een dure asfalteermachine en walsen, vlak naast verkeer, wegmeubilair en bestaande infrastructuur. Eén discussie over de vlakheid of de afwatering, of schade aan een verkeersbord of boordsteen, kan een werf flink duurder maken dan voorzien.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: type werken (wegenis, parkings, opritten, herstellingen), je machinepark, personeel, onderaannemers en de regio waarin je werkt.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij legt het vlak en strak. Wij zorgen dat een claim achteraf jou niet onderuit haalt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Vlakheid & afwatering', text: 'De meest voorkomende discussie bij asfaltering. De juiste aansprakelijkheid dekt herstel en geschillen.', iconPath: 'M21.3 8.7l-8-8a1 1 0 0 0-1.4 0l-11 11a1 1 0 0 0 0 1.4l8 8a1 1 0 0 0 1.4 0l11-11a1 1 0 0 0 0-1.4zM14 8l-2 2M11 5l-2 2M8 14l-2 2M17 11l-2 2' },
          { title: 'Schade aan omgeving', text: 'Wegmeubilair, boordstenen en verkeersborden: schade aan derden dek je met je aansprakelijkheid.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Zware machines', text: 'Asfalteermachine en walsen correct verzekerd tegen breuk, zodat je werf niet stilvalt.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
        ].map((card) => (
          <div class="asf-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
