    intro: 'Dekt schade tijdens en na de werken — door je ploegen, onderaannemers en materieel.',
    bullets: [
      'Schade aan eigendommen van klanten of derden tijdens uitvoering',
      'Letselschade aan derden (passanten, buren, andere ploegen)',
      'Schade door werftoestellen en niet-ingeschreven motorvoertuigen',
      'BA Na Levering voor gebreken die pas na oplevering opduiken',
      'Burenhinder door stof, geluid en trillingen',
    ],
    cta: 'Meer over BA Onderneming',
    link: '/verzekeringen/ba-onderneming/',
    icon: 'shield',
  },
  {
    title: 'BA-10 (Tienjarige aansprakelijkheid)',
    intro: 'Wettelijk verplicht voor werken aan de gesloten ruwbouw van vergunningsplichtige woningen.',
    bullets: [
      'Verplicht sinds 1 juli 2018 (Wet-Peeters-Borsus)',
      'Werfpolis per project of jaarpolis voor alle werven',
      'Globale polis: alle bouwactoren samen verzekerd',
      'Verplicht attest vóór de start van de werken',
      'Wettelijk minimum: € 500.000 per schadegeval',
    ],
    cta: 'Meer over BA-10',
    link: '/verzekeringen/ba-10/',
    icon: 'check-circle',
  },
  {
    title: 'Arbeidsongevallenverzekering',
    intro: 'Wettelijk verplicht én operationeel cruciaal — bescherming voor al je werknemers vanaf de eerste werkdag.',
    bullets: [
      'Verplicht vanaf je eerste werknemer',
      'Dekt werknemers op werf én woon-werkverkeer',
      'Loonplafond 2026: € 58.096,10 per werknemer',
      'Aanvulbaar met excedent wet voor hogere lonen',
      'Aandacht voor onderaannemers en hun statuut',
    ],
    cta: 'Meer over arbeidsongevallen',
    link: '/verzekeringen/arbeidsongevallen/',
    icon: 'users',
  },
  {
    title: 'Bedrijfsvoertuigen',
    intro: 'Bestelwagens, vrachtwagens, soms werktuigen — een vlootpolis is doorgaans voordeliger.',
    bullets: [
      'BA Auto wettelijk verplicht voor alle voertuigen',
      'Omnium voor recente bestelwagens en vrachtwagens',
      'Vlootkorting vanaf 5 voertuigen',
      'Verzekering vervoerde goederen voor materiaal',
      'Aandacht voor aanhangwagens > 750 kg MTM',
    ],
    cta: 'Meer over bedrijfsvoertuigen',
    link: '/verzekeringen/bedrijfsvoertuigen/',
    icon: 'truck',
  },
  {
    title: 'Machinebreukverzekering',
    intro: 'Heftrucks, hoogwerkers, betonmolens, gereedschap — één defect kan een hele werf vertragen.',
    bullets: [
      'Dekking voor breuk, schade en vaak diefstal',
      'Vast atelier-materieel én mobiel werfmaterieel',
      'Aanvulbaar met bedrijfsschade voor omzetverlies',
      'Verzekering tijdens transport en op werven',
      'Ook gemonteerde toestellen op voertuigen',
    ],
    cta: 'Meer over machinebreuk',
    link: '/verzekeringen/machinebreuk',
    icon: 'wrench',
