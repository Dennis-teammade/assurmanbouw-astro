---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import BrandChevron from '../../components/BrandChevron.astro';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';

const insuranceCards = [
  {
    title: 'BA Onderneming (loodgieter)',
    intro: 'Bescherming bij waterschade, gasincidenten en andere schade aan derden door jouw werkzaamheden.',
    bullets: [
      'Waterschade na installatie of reparatie',
      'Gasincidenten en lekken door fouten',
      'Letselschade aan bewoners of derden',
      'Claims over gebrekkige uitvoering',
    ],
    cta: 'Check BA',
    link: '/verzekeringen/ba-onderneming',
    icon: 'shield',
  },
  {
    title: 'Bedrijfsvoertuigen',
    intro: 'Jouw bestelwagen is je werkplek op wielen. Snel, mobiel en onmisbaar.',
    bullets: [
      'Omnium voor recente voertuigen',
      'Bescherming bij diefstal of accident',
      'Dekking voor materiaal aan boord',
      'Vlootpolis indien meerdere wagens',
    ],
    cta: 'Check bedrijfsvoertuigen',
    link: '/verzekeringen/bedrijfsvoertuigen',
    icon: 'truck',
  },
  {
    title: 'Machinebreuk & gereedschap',
    intro: 'Snijmachines, perstangen, video-inspectie — duur materiaal dat je dagelijks nodig hebt.',
    bullets: [
      'Dekking bij defect of beschadiging',
      'Diefstal op werf of in bestelwagen',
      'Snelle vervanging zodat je niet stilstaat',
      'Afstembaar op jouw materiaalwaarde',
    ],
    cta: 'Check machinebreuk',
    link: '/verzekeringen/machinebreuk',
    icon: 'wrench',
  },
  {
    title: 'Rechtsbijstand',
    intro: 'Betwistingen over waterschade, facturen of aansprakelijkheid kunnen escaleren.',
    bullets: [
      'Juridische hulp bij geschillen',
      'Ondersteuning bij betwiste aansprakelijkheid',
      'Tussenkomst in kosten advocaat',
      'Aanvulling op BA',
    ],
    cta: 'Check rechtsbijstand',
    link: '/verzekeringen/rechtsbijstand',
    icon: 'zap',
  },
  {
    title: "Alle Bouwplaats Risico's",
    intro: 'Extra werfdekking voor grotere projecten.',
    bullets: [
      "Schade aan werken in uitvoering",
      "Samenwerking met andere aannemers",
      'Interessant bij grote renovaties',
      'Per project of jaarpolis',
    ],
    cta: 'Check ABR',
    link: '/verzekeringen/alle-bouwplaats-risicos',
    icon: 'layers',
  },
  {
    title: 'Arbeidsongevallen',
    intro: 'Verplicht zodra je personeel in dienst neemt.',
    bullets: [
      'Dekt werknemers bij interventies op locatie',
      'Bescherming bij technische ruimtes en renovaties',
      'Verplicht vanaf eerste werknemer',
      'Aanvulbaar voor hogere lonen',
    ],
    cta: 'Check arbeidsongevallen',
    link: '/verzekeringen/arbeidsongevallen',
    icon: 'users',
  },
];

const caseStudies = [
  {
    category: 'SANITAIR & VERWARMING',
    title: 'Waterleiding gesprongen na installatie: €22.000 schade aan parket',
    businessName: 'Hydro Install bvba',
    ownerName: 'Thomas Pieters',
    cityName: 'Antwerpen',
    description: 'Na het plaatsen van een nieuwe badkamer spatte een koppeling los. De waterschade trof de volledig vernieuwde badkamer en het parket van de hal.',
    action: 'De BA-verzekering handelde de schade af na expertise. De loodgieter moest niets zelf bijbetalen. De klant werd volledig vergoed.',
    image: 'https://images.pexels.com/photos/585419/pexels-photo-585419.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    category: 'SANITAIR & VERWARMING',
    title: 'Gaslek door foutieve fitting bij renovatie',
    businessName: 'Sanitair De Groote',
    ownerName: 'Nico De Groote',
    cityName: 'Gent',
    description: 'Na een renovatie van de verwarmingsinstallatie werd een gaslek ontdekt. De bewoners werden geëvacueerd en er dreigde een ernstige situatie.',
    action: 'Via de BA-polis werd de schade onderzocht en werd het slachtoffer vergoed. De oorzaak bleek een fabricagefout aan een koppeling. De verzekeraar verhuurde zich op de leverancier.',
    image: 'https://images.pexels.com/photos/834892/pexels-photo-834892.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
  {
    category: 'SANITAIR & VERWARMING',
    title: 'Diefstal perstang en video-inspectie camera: €7.200',
    businessName: 'Loodgieter Maes',
    ownerName: 'Bram Maes',
    cityName: 'Kortrijk',
    description: 'Een loodgieter verloor zijn duurste uitrusting door inbraak in zijn bestelwagen.',
    action: 'De machinebreukverzekering vergoedde het materiaal volledig. Vervanging werd binnen de week geregeld.',
    image: 'https://images.pexels.com/photos/1216589/pexels-photo-1216589.jpeg?auto=compress&cs=tinysrgb&w=800',
  },
];

const faqItems = [
  {
    title: 'Ben ik aansprakelijk als er waterschade optreedt na mijn werken?',
    content: "In principe wel als er een verband is tussen jouw werkzaamheden en de schade. BA Onderneming dekt dit. De verzekeraar stuurt een expert om de oorzaak te bepalen. Alleen als er sprake is van opzet of grove fout kan er discussie zijn over de vergoeding.",
  },
  {
    title: 'Is BA verplicht voor loodgieters?',
    content: "BA Onderneming is niet wettelijk verplicht, maar in de praktijk onmisbaar. Eén waterlekkage in een bewoond pand kan tienduizenden euro's schade veroorzaken. Zonder BA sta je persoonlijk aansprakelijk.",
  },
  {
    title: 'Dekt mijn BA ook gasincidenten?',
    content: 'Dat hangt af van de polisvoorwaarden. Het is belangrijk om te controleren of gasinstallaties en thermische werken expliciet opgenomen zijn in je dekking. Assurman zorgt dat dit correct wordt geregeld bij het opmaken van je polis.',
  },
  {
    title: 'Heb ik aparte gereedschapverzekering nodig?',
    content: 'Als je werkt met duur gespecialiseerd materiaal (perstangen, camera-inspectie, druktestapparatuur) is een gereedschapverzekering sterk aanbevolen. Diefstal uit de bestelwagen is een frequent risico.',
  },
  {
    title: 'Kan mijn pakket uitbreiden als ik personeel aanneem?',
    content: 'Ja. Je start met een basispacket en breidt modulair uit: arbeidsongevallen zodra je eerste werknemer in dienst treedt, eventueel een vlootpolis bij meerdere voertuigen, enzovoort.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor loodgieters | Assurman"
  description="Verzekeringen op maat voor loodgieters en sanitairtechnici in Vlaanderen: BA, machinebreuk, bedrijfsvoertuigen en rechtsbijstand."
  canonical="/sectoren/loodgieters"
  schema={schema}
>

<style>
  .dw-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .dw-hero-content { max-width: 52%; padding-top: 40px; }
  .dw-hero-img { position: absolute; top: 5%; right: 0; height: 90%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .dw-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .dw-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; align-items: flex-start; }
  .dw-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .dw-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .dw-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dw-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .dw-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .dw-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .dw-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .dw-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .dw-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .dw-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .dw-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .dw-btn-primary:hover { background: #d4941a; transform: translateY(-1px); }
  .dw-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .dw-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .dw-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .dw-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .dw-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .dw-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .dw-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .dw-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .dw-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .dw-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .dw-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .dw-features-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .dw-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .dw-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .dw-intro-grid { grid-template-columns: 1fr; }
    .dw-container { padding-left: 24px; padding-right: 24px; }
    .dw-hero-img { display: none; }
  }
  @media (max-width: 767px) {
    .dw-container { padding-left: 15px; padding-right: 15px; }
    .dw-hero-content { max-width: 100%; padding-top: 16px; }
    .dw-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .dw-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .dw-benefits-grid { grid-template-columns: 1fr; }
    .dw-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .dw-cards3-grid { grid-template-columns: 1fr; }
    .dw-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .dw-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .dw-testimonials-grid { grid-template-columns: 1fr; }
    .dw-cert-grid { grid-template-columns: 1fr 1fr; }
    .dw-btn-primary { font-size: 16px; padding: 16px 24px; }
    .dw-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .dw-hero-btns { flex-direction: column; }
    .dw-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .dw-cta-btns { flex-direction: column; align-items: center; }
    .dw-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .dw-final-btns { flex-direction: column; align-items: center; }
    .dw-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .dw-step-number { font-size: 56px; }
    .dw-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .dw-waarom-mask-img,
    .dw-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="dw-hero-section" style="padding-top:120px;background:#FFFFFF;position:relative;overflow:hidden;min-height:480px;">
  <div class="dw-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-loodgieter-hero.jpg" alt="Loodgieter aan het werk" />
  </div>
  <div class="dw-container" style="padding-top:40px;padding-bottom:64px;position:relative;z-index:2;">
    <div class="dw-hero-content">
      <div class="dw-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor loodgieters
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Beschermd bij elke installatie, reparatie en interventie.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als loodgieter werk je in bewoonde panden, met water en gas — twee elementen die bij een fout ernstige schade kunnen veroorzaken. Assurman verzekert loodgieters op maat van hun activiteiten in Vlaanderen.
      </p>
      <div class="dw-hero-btns">
        <a href="/gratis-verzekeringsscan" class="dw-btn-primary">
          Vraag een scan aan
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/contact" class="dw-btn-secondary">Plan een adviesgesprek</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="dw-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="dw-features-grid">
      {[
        { text: 'Specialist in\nsanitair & verwarming', iconPath: 'M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05zM12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
        { text: 'Dekking: water + gas\n+ materiaal + mobiliteit', iconPath: 'M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="dw-container" style="max-width:1110px;">
    <div class="dw-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een loodgieter een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Als loodgieter werk je dagelijks met water en gas in bewoonde panden. Eén foutief geplaatste koppeling, een vergeten afsluiting of een gaslek — en de gevolgen zijn meteen zichtbaar. Waterschade aan parket, structurele schade aan muren, of erger nog: een gevaarlijk gasincident.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Assurman bouwt een pakket op maat: BA afgestemd op sanitaire en thermische risico's, gereedschapverzekering voor je dure uitrusting, en eventueel rechtsbijstand bij geschillen.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij houdt alles stromend — wij zorgen dat je beschermd bent als er iets lekt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Waterschade na installatie', text: 'BA Onderneming dekt waterschade die optreedt na jouw werkzaamheden — ook als het pas later ontdekt wordt.', iconPath: 'M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05zM12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97' },
          { title: 'Gas- en thermische risico\'s', text: "Gasinstallaties brengen specifieke risico's mee. We zorgen dat jouw polis dit correct afdekt.", iconPath: 'M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z' },
          { title: 'Diefstal van gespecialiseerd materiaal', text: 'Perstangen, video-inspectiecamera\'s en druktestapparatuur zijn duur. Een gereedschapverzekering houdt je op gang.', iconPath: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z' },
        ].map((card) => (
          <div class="dw-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
