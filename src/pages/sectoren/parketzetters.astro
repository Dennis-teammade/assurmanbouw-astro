---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'rechtsbijstand', 'vervoerde-goederen', 'machinebreuk', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'vapz']);

const caseStudies = [
  {
    category: 'PARKET',
    title: 'Werkend parket door vochtprobleem: €17.000 herstelclaim',
    businessName: 'Parket Vansteenkiste',
    ownerName: 'Lieven Vansteenkiste',
    cityName: 'Kortrijk',
    description: 'Enkele maanden na plaatsing begon een massieve parketvloer te werken en kieren te vertonen. De bouwheer stelde de parketzetter aansprakelijk en eiste een nieuwe vloer.',
    action: 'Via de rechtsbijstand werd een vochtexpertise uitgevoerd op de ondergrond en het binnenklimaat. Daaruit bleek dat een te hoge restvochtigheid van de ondergrond meespeelde. De aansprakelijkheid werd gedeeld en de financiële impact voor de parketzetter bleef beperkt.',
    image: '/images/cases/case-parketzetters-1.jpg',
  },
  {
    category: 'PARKET',
    title: 'Krasschade aan bestaande afwerking bij plaatsing kost €6.500',
    businessName: 'Houtvloer De Clercq',
    ownerName: 'Sofie De Clercq',
    cityName: 'Brugge',
    description: 'Tijdens het binnenbrengen en leggen van parket in een bewoonde woning raakte een bestaande trap en plint beschadigd. De klant vroeg herstel van de schade.',
    action: 'De schade aan de eigendom van de klant viel onder de BA-onderneming. De verzekeraar regelde het herstel van de beschadigde trap en plint. Het project werd zonder verder conflict afgerond.',
    image: '/images/cases/case-parketzetters-2.jpg',
  },
  {
    category: 'AFWERKING',
    title: 'Geschil over lakresultaat na schuren: €8.500 in het geding',
    businessName: 'Parket & Lak Mortier',
    ownerName: 'Jürgen Mortier',
    cityName: 'Oostende',
    description: 'Na het schuren en lakken van een parketvloer klaagde de klant over zichtbare strepen en een ongelijkmatige glansgraad. Hij weigerde de eindfactuur te betalen.',
    action: 'Via de rechtsbijstand werd het lakresultaat technisch beoordeeld op uitvoering en op factoren zoals stof en droogcondities. Na bemiddeling kwam er een gedeeltelijke herwerking en een betalingsregeling. Een dure procedure werd vermeden.',
    image: '/images/cases/case-parketzetters-3.jpg',
  },
  {
    category: 'MACHINES',
    title: 'Defecte parketschuurmachine legt werven stil: €5.500 schade',
    businessName: 'Schuurwerken Tytgat',
    ownerName: 'Pieter Tytgat',
    cityName: 'Veurne',
    description: 'Een dure bandschuurmachine viel uit door een interne breuk midden in een drukke periode. Naast de herstelkosten dreigde planningverlies omdat het werk stillag.',
    action: 'Via de machinebreukdekking werd de herstelling snel afgehandeld en een vervangtoestel geregeld. De geplande werven liepen slechts beperkt vertraging op.',
    image: '/images/cases/case-parketzetters-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een parketzetter het meest?",
    content: "Bij parketzetters zitten de risico's vooral hier:\n\n• Werkend hout: parket dat krimpt, kiert of bol staat door vocht of binnenklimaat.\n\n• Afwerkingsgeschillen: discussies over schuren, lakken en glansgraad.\n\n• Kras- en stootschade: aan het parket zelf of aan eigendom van de klant tijdens het werk.\n\n• Materiaal en machines: duur parket en eigen schuurmachines.\n\nDaarom is een basis met BA-onderneming en rechtsbijstand voor de meeste parketzetters een logische start.",
  },
  {
    title: 'Parket dat werkt door vocht. Ben ik daar aansprakelijk voor?',
    content: 'Dat hangt af van de oorzaak: het hout, de ondergrond, het binnenklimaat of de plaatsing. Bij een geschil laat rechtsbijstand een vochtexpertise uitvoeren om de oorzaak vast te stellen. Vaak speelt restvocht in de ondergrond of het binnenklimaat mee, en dan ligt de aansprakelijkheid niet volledig bij jou. Documenteer altijd je vochtmetingen.',
  },
  {
    title: 'Een klant is niet tevreden over het lak- of schuurresultaat. Wat dan?',
    content: 'Afwerking is deels subjectief, dus discussies over glansgraad of strepen komen voor. Rechtsbijstand helpt het resultaat technisch te laten beoordelen en het geschil redelijk op te lossen, zonder dat je meteen zelf expertise- en advocaatkosten draagt.',
  },
  {
    title: 'Wat als ik schade maak aan de woning tijdens het leggen of schuren?',
    content: 'Kras- en stootschade aan eigendom van de klant, zoals trappen, plinten of bestaande vloeren, valt onder je BA-onderneming. Zeker bij werken in bewoonde woningen is dat waardevol. We stemmen de dekking af op het type werk dat je doet.',
  },
  {
    title: 'Zijn mijn schuurmachines verzekerd?',
    content: 'Met machinebreuk kan je je eigen materieel beschermen tegen interne defecten en breuk. Voor een parketzetter is dat vaak waardevol: een uitgevallen schuurmachine legt je werf meteen stil. We bekijken welke machines je hebt en wat de vervangwaarde is.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel parketzetters starten met een kernpakket en breiden uit wanneer ze personeel aannemen, meer schuur- en lakwerk doen of duurder parket verwerken. Assurman bouwt modulair: je groeit zonder telkens opnieuw van nul te starten.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor parketzetters | Assurman"
  description="Werkend parket door vocht, krasschade bij plaatsing, geschillen over lak en afwerking: parketzetters dragen reële risico's. Pakket op maat van Assurman."
  canonical="/sectoren/parketzetters/"
  schema={schema}
>

<style>
  .prk-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .prk-hero-content { max-width: 52%; padding-top: 100px; }
  .prk-hero-img { position: absolute; top: 0; right: -5px; height: min(85vh, calc(48vw * 709 / 594)); width: auto; z-index: 1; pointer-events: none; }
  .prk-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .prk-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .prk-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .prk-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .prk-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .prk-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .prk-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .prk-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .prk-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .prk-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .prk-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .prk-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .prk-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .prk-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .prk-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .prk-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .prk-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .prk-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .prk-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .prk-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .prk-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .prk-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .prk-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .prk-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .prk-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .prk-hero-img { display: none; }
    .prk-features-grid { grid-template-columns: repeat(2, 1fr); }
    .prk-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .prk-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .prk-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .prk-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .prk-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .prk-intro-grid { grid-template-columns: 1fr; }
    .prk-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .prk-container { padding-left: 15px; padding-right: 15px; }
    .prk-hero-content { max-width: 100%; padding-top: 16px; }
    .prk-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .prk-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .prk-benefits-grid { grid-template-columns: 1fr; }
    .prk-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .prk-cards3-grid { grid-template-columns: 1fr; }
    .prk-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .prk-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .prk-testimonials-grid { grid-template-columns: 1fr; }
    .prk-cert-grid { grid-template-columns: 1fr 1fr; }
    .prk-btn-primary { font-size: 16px; padding: 16px 24px; }
    .prk-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .prk-hero-btns { flex-direction: column; }
    .prk-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .prk-cta-btns { flex-direction: column; align-items: center; }
    .prk-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .prk-final-btns { flex-direction: column; align-items: center; }
    .prk-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .prk-step-number { font-size: 56px; }
    .prk-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .prk-waarom-mask-img,
    .prk-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="prk-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:100vh;">
  <div class="prk-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/parketzetters-hero.jpg" alt="Parketzetter legt een houten vloer" />
  </div>
  <div class="prk-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="prk-hero-content">
      <div class="prk-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor parketzetters
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Warm hout, koele zekerheid.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als parketzetter werk je met een natuurlijk materiaal dat leeft. Parket dat werkt of krimpt door vocht, een kras of beschadiging bij de plaatsing, of een discussie over het lak- en afwerkingsresultaat: het kan snel tot herstel en discussie leiden. Assurman is gespecialiseerd in verzekeringen op maat van afwerkingsondernemers in Vlaanderen.
      </p>
      <div class="prk-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="prk-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="prk-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="prk-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="prk-features-grid">
      {[
        { text: 'Specialist in\nparket & houten vloeren', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Sterk op geschillen\nrond afwerking', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
        { text: 'Dekking voor werk\n+ duur materiaal + machines', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="prk-container" style="max-width:1110px;">
    <div class="prk-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een parketzetter een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Hout is een levend materiaal. Te veel of te weinig vocht en het parket gaat werken, krimpen of bol staan. Komt dat na de plaatsing aan het licht, dan volgt vaak een discussie: lag het aan het hout, aan de ondergrond, aan het binnenklimaat of aan de plaatsing. Daarbovenop komen kras- en stootschade tijdens het werk en geschillen over het eindresultaat van schuren en lakken.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: massief parket, meerlaags, laminaat, schuren en afwerken, werken in bewoonde woningen, eigen schuurmachines, personeel en bestelwagen. Zo ben je gedekt voor de risico's die jouw stiel echt kent.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij brengt warmte met hout. Wij zorgen dat een discussie geen financieel probleem wordt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Esthetische geschillen', text: 'Rechtsbijstand staat klaar bij discussies over werkend parket, kleur of het lak- en afwerkingsresultaat.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Duur materiaal & machines', text: 'Bescherming voor je parket in transport en je eigen schuurmachines tegen breuk en defect.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
          { title: 'Schade bij de klant', text: 'Met BA dek je kras- en stootschade aan eigendom van de klant tijdens het leggen en schuren.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
        ].map((card) => (
          <div class="prk-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;">
    <BrandChevron color="white" height="200px" direction="left" opacity={0.07} />
  </div>
  <div class="prk-container">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="prk-section-label" style="margin-bottom:16px;">Wat parketzetters waarderen</p>
