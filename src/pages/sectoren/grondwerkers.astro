---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'ba-10', 'alle-bouwplaats-risicos', 'machinebreuk', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'groepsverzekering']);

const caseStudies = [
  {
    category: 'GRONDWERK',
    title: 'Geraakte gasleiding tijdens sleufwerk leidt tot €60.000 gevolgschade',
    businessName: 'Grondwerken De Backer',
    ownerName: 'Wim De Backer',
    cityName: 'Roeselare',
    description: 'Tijdens het graven van een sleuf voor nutsleidingen raakte de kraan een niet correct ingetekende gasleiding. De straat moest afgesloten worden en de netbeheerder eiste vergoeding voor het noodherstel.',
    action: 'Via de BA-onderneming werd de aansprakelijkheid onderzocht en de gevolgschade aan de netbeheerder vergoed. De verzekering nam de herstel- en expertisekosten op zich. Het dossier werd afgehandeld zonder dat de zaakvoerder zelf voor de volledige rekening opdraaide.',
    image: '/images/cases/case-grondwerkers-1.jpg',
  },
  {
    category: 'GRONDWERK',
    title: 'Verzakking beschadigt aanpalend pand: €38.000 herstelkosten',
    businessName: 'Aardewerk Vlaanderen',
    ownerName: 'Koen Maes',
    cityName: 'Aalst',
    description: 'Bij een uitgraving voor een nieuwe kelder ontstond een verzakking waardoor scheuren verschenen in de gevel van het buurpand. De buur stelde de aannemer aansprakelijk voor de herstelling.',
    action: "Via de ABR-dekking (Alle Bouwplaats Risico's) en de aansprakelijkheid werd de schade aan het aanpalend pand opgevangen. Een expert stelde de oorzaak vast en de herstelwerken aan de buurwoning werden gedekt. Het conflict met de buur escaleerde niet verder.",
    image: '/images/cases/case-grondwerkers-2.jpg',
  },
  {
    category: 'MACHINESCHADE',
    title: 'Hydraulische breuk legt graafmachine stil: €22.000 herstel',
    businessName: 'Grondwerken Vandenberghe',
    ownerName: 'Stijn Vandenberghe',
    cityName: 'Brugge',
    description: 'Op een lopende werf viel de hoofdgraafmachine uit door een plotse hydraulische breuk. Zonder die machine lag de planning van meerdere werven stil.',
    action: 'Dankzij de machinebreukverzekering werd de herstelling snel goedgekeurd en vergoed. Er kon meteen een herstelling ingepland worden, waardoor de stilstand beperkt bleef en de andere werven niet in het gedrang kwamen.',
    image: '/images/cases/case-grondwerkers-3.jpg',
  },
  {
    category: 'GRONDWERK',
    title: 'Beschadigde oprit van buur tijdens afbraakwerken kost €9.500',
    businessName: 'De Clerck Grond- en Afbraakwerken',
    ownerName: 'Tom De Clerck',
    cityName: 'Sint-Niklaas',
    description: 'Tijdens afbraakwerken reed de rupskraan over de oprit van de buurwoning, die daardoor scheurde en verzakte. De buur eiste een volledige heraanleg.',
    action: 'Via de burgerlijke aansprakelijkheid werd de schade aan de oprit van de buur gedekt. Na expertise werd een correcte vergoeding voor de heraanleg uitbetaald. De aannemer kon de werf afronden zonder zelf voor de schade op te draaien.',
    image: '/images/cases/case-grondwerkers-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een grondwerker het meest?",
    content: "De grootste risico's komen meestal uit 4 hoeken:\n\n• Aansprakelijkheid: geraakte nutsleidingen, verzakkingen, schade aan aanpalende panden of de openbare weg.\n\n• Machinepark: een dure graafmachine of kraan die uitvalt, legt meteen werven stil.\n\n• Werfrisico's: onvoorziene schade tijdens het graven, instabiele grond, meerdere partijen op de werf.\n\n• Mobiliteit & personeel: zonder transport en zonder ploeg sta je stil.\n\nDaarom is een basis met BA + ABR + machinebreuk + bestelwagen voor veel grondwerkers een logische start.",
  },
  {
    title: 'Wat als ik een nutsleiding of kabel raak tijdens het graven?',
    content: "Dat is een van de meest typische schadegevallen in grondwerk. De gevolgschade (herstel van de leiding, noodinterventie van de netbeheerder, gevolgschade voor derden) kan fors oplopen.\n\nDe burgerlijke aansprakelijkheid van je onderneming is hier het kernblok. We bekijken samen of je dekking aansluit bij het soort graafwerk dat je doet en de zones waarin je werkt.",
  },
  {
    title: 'Moet ik graafwerken vooraf melden via KLIP?',
    content: "In Vlaanderen vraag je voor graafwerken vooraf informatie op over kabels en leidingen via het KLIP (Kabel- en Leidinginformatieplatform). Dat is een wettelijke informatieplicht: je dient een planaanvraag in zodat de netbeheerders je de ligging van hun leidingen bezorgen.\n\nDie melding is geen verzekering, maar wel een belangrijke voorzorg. Of en hoe je die naleeft, kan meespelen in een schadedossier. Bij je intake bekijken we hoe jouw werkwijze zich verhoudt tot je dekking.",
  },
  {
    title: 'Hoe verzeker ik mijn graafmachine of kraan?',
    content: "Dat gebeurt typisch via machinebreuk (technische defecten, breuk) en eventueel via voertuig- of werfmateriaaldekking, afhankelijk van het type machine en waar hij ingezet wordt.\n\nWe stemmen de dekking af op de waarde van je machines, of ze ingeschreven zijn, en waar ze staan (werf, stelplaats, transport).",
  },
  {
    title: 'Wat is het verschil tussen BA en ABR bij grondwerk?',
    content: "BA (Burgerlijke Aansprakelijkheid) gaat vooral over schade die je aan anderen veroorzaakt: een geraakte leiding, een beschadigd buurpand, schade aan de openbare weg.\n\nABR (Alle Bouwplaats Risico's) focust op de werf zelf en de werken in uitvoering, zoals verzakkingen of onvoorziene schade tijdens het graven. In de praktijk vullen ze elkaar aan. Assurman helpt je kiezen wat in jouw situatie écht nodig is.",
  },
  {
    title: 'Ik werk met onderaannemers en op de openbare weg. Wat betekent dat?',
    content: "Werken op de openbare weg en met onderaannemers brengt extra aansprakelijkheidsvragen mee, bijvoorbeeld rond schade aan wegenis, signalisatie of derden.\n\nIn je intake geef je aan hoe je werkt. We bekijken daarna welke dekking en voorwaarden het best passen bij jouw type werven.",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor grondwerkers in de bouw | Assurman"
  description="Graafmachines, geraakte nutsleidingen, verzakkingen: grondwerk kent zware risico's. Assurman bouwt jouw verzekeringspakket op maat van de werf."
  canonical="/sectoren/grondwerkers/"
  schema={schema}
>

<style>
  .gw-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .gw-hero-content { max-width: 52%; padding-top: 40px; }
  .gw-hero-img { position: absolute; top: 5%; right: 0; height: 90%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .gw-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .gw-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .gw-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .gw-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .gw-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .gw-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .gw-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .gw-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .gw-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .gw-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .gw-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .gw-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .gw-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .gw-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .gw-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .gw-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .gw-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .gw-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .gw-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .gw-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .gw-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .gw-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .gw-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .gw-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .gw-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .gw-hero-img { display: none; }
    .gw-features-grid { grid-template-columns: repeat(2, 1fr); }
    .gw-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .gw-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .gw-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .gw-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .gw-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .gw-intro-grid { grid-template-columns: 1fr; }
    .gw-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .gw-container { padding-left: 15px; padding-right: 15px; }
    .gw-hero-content { max-width: 100%; padding-top: 16px; }
    .gw-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .gw-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .gw-benefits-grid { grid-template-columns: 1fr; }
    .gw-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .gw-cards3-grid { grid-template-columns: 1fr; }
    .gw-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .gw-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .gw-testimonials-grid { grid-template-columns: 1fr; }
    .gw-cert-grid { grid-template-columns: 1fr 1fr; }
    .gw-btn-primary { font-size: 16px; padding: 16px 24px; }
    .gw-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .gw-hero-btns { flex-direction: column; }
    .gw-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .gw-cta-btns { flex-direction: column; align-items: center; }
    .gw-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .gw-final-btns { flex-direction: column; align-items: center; }
    .gw-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .gw-step-number { font-size: 56px; }
    .gw-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .gw-waarom-mask-img,
    .gw-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="gw-hero-section" style="padding-top:120px;background:#FFFFFF;position:relative;overflow:hidden;min-height:480px;">
  <div class="gw-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/grondwerkers-hero.jpg" alt="Grondwerker met graafmachine die een sleuf graaft op een bouwwerf" />
  </div>
  <div class="gw-container" style="padding-top:40px;padding-bottom:64px;position:relative;z-index:2;">
    <div class="gw-hero-content">
      <div class="gw-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor grondwerkers
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Stevig verzekerd, van eerste schop tot oplevering.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Bij grondwerk zit het risico letterlijk onder de grond. Eén geraakte kabel, een verzakking, een dure graafmachine die uitvalt: de schade loopt snel op. Assurman is gespecialiseerd in verzekeringen op maat van grondwerkers en infrastructuuraannemers in Vlaanderen.
      </p>
      <div class="gw-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="gw-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="gw-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="gw-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="gw-features-grid">
      {[
        { text: 'Specialist in\ngrondwerk & infrastructuur', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Dure machines\ncorrect verzekerd', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Dekking voor\ngeraakte leidingen & kabels', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
        { text: 'Eén aanspreekpunt\nvoor je hele werf', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="gw-container" style="max-width:1110px;">
    <div class="gw-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een grondwerker een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Grondwerk is geen standaard stiel. Je werkt met zware machines, in de buurt van ondergrondse nutsleidingen, vlak naast bestaande gebouwen en vaak op de openbare weg. Eén verkeerde graafbeweging kan een gasleiding, waterleiding of telecomkabel raken. De gevolgschade en de stilstand die daarbij komt kijken, zijn vaak veel groter dan de werken zelf.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: type werken (graafwerk, funderingen, nutssleuven, afbraak), je machinepark, personeel, onderaannemers, de regio en je risicoprofiel. Zo betaal je voor wat je nodig hebt en sta je sterk als het misloopt.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Onder de grond zie je het risico niet. Wij zorgen dat je er wel tegen beschermd bent."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Graven nabij leidingen', text: 'Raak je een kabel of leiding, dan dekt de juiste aansprakelijkheid de gevolgschade en het herstel.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Zwaar machinepark', text: 'Machinebreuk en schade aan je graafmachine of kraan, zodat een defect je werf niet stillegt.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
          { title: 'Werf & omgeving', text: 'Met ABR dek je verzakkingen, schade aan aanpalende panden en onvoorziene werfrisico\'s.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
        ].map((card) => (
          <div class="gw-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
