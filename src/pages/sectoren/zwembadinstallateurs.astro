---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-10', 'alle-bouwplaats-risicos', 'ba-onderneming', 'bedrijfsschade', 'rechtsbijstand', 'arbeidsongevallen']);

const caseStudies = [
  {
    category: 'ZWEMBADBOUW',
    title: 'Scheur in betonbad veroorzaakt lek, €34.000 herstel twee jaar na oplevering',
    businessName: 'AquaBouw Vlaanderen',
    ownerName: 'Geert Dewaele',
    cityName: 'Roeselare',
    description: 'Twee jaar na de oplevering ontstond een scheur in de betonkuip waardoor het bad water verloor. De klant stelde de installateur aansprakelijk voor een constructiegebrek en eiste volledig herstel.',
    action: 'Via de tienjarige aansprakelijkheid (BA-10) werd het constructiegebrek beoordeeld door een expert en werd het herstel grotendeels gedekt. Rechtsbijstand begeleidde de discussie over de oorzaak, zodat de zaakvoerder niet zelf voor de volledige factuur stond.',
    image: '/images/cases/case-zwembadinstallateurs-1.jpg',
  },
  {
    category: 'ZWEMBADBOUW',
    title: 'Lek in technische ruimte richt €12.500 waterschade aan',
    businessName: 'PoolTech West',
    ownerName: 'Hannelore Vlaeminck',
    cityName: 'Izegem',
    description: 'Een lekkende koppeling in de technische ruimte zorgde voor wateroverlast die de pompinstallatie en een deel van de afwerking aantastte. De klant claimde herstel en gederfd gebruik van het zwembad.',
    action: 'De BA-verzekering ving de schade op en met de bedrijfsschadedekking werd de impact van de stilstand verzacht. Het herstel werd snel georganiseerd, zodat het bad weer in gebruik kon worden genomen.',
    image: '/images/cases/case-zwembadinstallateurs-2.jpg',
  },
  {
    category: 'ZWEMBADBOUW',
    title: 'Geschil over waterdichtheid liner blokkeert eindfactuur van €18.000',
    businessName: 'Zwembaden De Meyer',
    ownerName: 'Frank De Meyer',
    cityName: 'Waregem',
    description: 'Na de aanleg betwistte de klant de waterdichtheid van de afwerking en hield een groot deel van de eindfactuur in tot er volgens hem een sluitende oplossing was.',
    action: 'Met rechtsbijstand werd een onafhankelijke beoordeling van de waterdichtheid en de afwerking opgestart. Op basis daarvan werd een redelijk compromis bereikt en werden de juridische kosten gedekt.',
    image: '/images/cases/case-zwembadinstallateurs-3.jpg',
  },
  {
    category: 'ZWEMBADBOUW',
    title: 'Storm beschadigt zwembad in aanbouw en geleverd materiaal, €15.000',
    businessName: 'BlueLine Pools',
    ownerName: 'Steven Carlier',
    cityName: 'Kortrijk',
    description: 'Tijdens de ruwbouwfase van een zwembad zorgde een hevige storm met wateroverlast voor schade aan de kuip in uitvoering en aan geleverde technische installaties die klaar lagen op de werf.',
    action: 'Via de ABR-dekking werd de schade aan de werken in uitvoering en de materialen op de werf vergoed. Nieuwe leveringen werden versneld geregeld zodat het project beperkt vertraging opliep.',
    image: '/images/cases/case-zwembadinstallateurs-4.jpg',
  },
];

const faqItems = [
  {
    title: 'Waarom is tienjarige aansprakelijkheid (BA-10) zo belangrijk bij zwembaden?',
    content: 'Omdat de typische gebreken bij een zwembad zich vaak laat tonen. Een scheur, een lek of een fout in de waterdichting kan pas na één of meerdere seizoenen opduiken, soms jaren na de oplevering. Tienjarige aansprakelijkheid dekt net dat soort stabiliteits- en soliditeitsgebreken over een lange periode. Voor jouw stiel is dat geen detail, maar een kern.',
  },
  {
    title: 'Ben ik verplicht om een BA-10 te hebben?',
    content: 'De tienjarige aansprakelijkheid is in België verplicht voor werken die de stabiliteit of soliditeit van een woning raken. Of en in welke mate dat op jouw zwembadwerken van toepassing is, hangt af van het type werk en de verbondenheid met het gebouw. Dit is een punt dat we concreet met je nakijken bij je intake.',
  },
  {
    title: 'Wat is het verschil tussen BA, ABR en BA-10?',
    content: "BA (Burgerlijke Aansprakelijkheid) gaat over schade aan derden tijdens je werk. ABR (Alle Bouwplaatsrisico's) dekt onvoorziene schade aan het bad in uitvoering op de werf. BA-10 (tienjarige aansprakelijkheid) komt pas later in beeld: voor zware constructie- en waterdichtheidsgebreken tot tien jaar na de oplevering. Bij zwembaden vullen die drie elkaar aan.",
  },
  {
    title: 'Wat als de klant de waterdichtheid betwist?',
    content: 'Dat is een klassiek geschil bij zwembaden. Met rechtsbijstand kan je een onafhankelijke beoordeling laten opstarten en worden je juridische kosten gedekt. Vaak leidt dat tot een onderbouwd compromis in plaats van een slepende procedure.',
  },
  {
    title: 'Wat als een schadegeval mijn werf stillegt?',
    content: 'Loopt een schadegeval uit op stilstand, dan kan een bedrijfsschadeverzekering je omzetverlies en vaste kosten mee opvangen. Zo blijft een tegenslag op één werf niet je hele werking en cashflow raken.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel zwembadinstallateurs starten met een kernpakket rond aansprakelijkheid en werf, en breiden uit wanneer ze personeel aannemen, meer renovaties doen of complexere installaties plaatsen. Assurman bouwt modulair: je groeit zonder telkens van nul te starten.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor zwembadinstallateurs in Vlaanderen"
  description="Een lekkend bad of betwiste waterdichtheid kan jaren later opduiken. Assurman dekt zwembadinstallateurs met tienjarige aansprakelijkheid en een pakket op maat."
  canonical="/sectoren/zwembadinstallateurs/"
  schema={schema}
>

<style>
  .zwb-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .zwb-hero-content { max-width: 52%; padding-top: 40px; }
  .zwb-hero-img { position: absolute; top: 5%; right: 0; height: 90%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .zwb-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .zwb-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .zwb-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .zwb-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .zwb-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .zwb-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .zwb-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .zwb-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .zwb-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .zwb-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .zwb-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .zwb-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .zwb-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .zwb-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .zwb-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .zwb-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .zwb-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .zwb-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .zwb-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .zwb-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .zwb-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .zwb-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .zwb-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .zwb-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .zwb-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .zwb-hero-img { display: none; }
    .zwb-features-grid { grid-template-columns: repeat(2, 1fr); }
    .zwb-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .zwb-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .zwb-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .zwb-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .zwb-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .zwb-intro-grid { grid-template-columns: 1fr; }
    .zwb-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .zwb-container { padding-left: 15px; padding-right: 15px; }
    .zwb-hero-content { max-width: 100%; padding-top: 16px; }
    .zwb-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .zwb-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .zwb-benefits-grid { grid-template-columns: 1fr; }
    .zwb-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .zwb-cards3-grid { grid-template-columns: 1fr; }
    .zwb-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .zwb-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .zwb-testimonials-grid { grid-template-columns: 1fr; }
    .zwb-cert-grid { grid-template-columns: 1fr 1fr; }
    .zwb-btn-primary { font-size: 16px; padding: 16px 24px; }
    .zwb-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .zwb-hero-btns { flex-direction: column; }
    .zwb-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .zwb-cta-btns { flex-direction: column; align-items: center; }
    .zwb-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .zwb-final-btns { flex-direction: column; align-items: center; }
    .zwb-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .zwb-step-number { font-size: 56px; }
    .zwb-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .zwb-waarom-mask-img,
    .zwb-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="zwb-hero-section" style="padding-top:120px;background:#FFFFFF;position:relative;overflow:hidden;min-height:480px;">
  <div class="zwb-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/zwembadinstallateurs-hero.jpg" alt="Zwembadinstallateur werkt aan de afwerking van een nieuw aangelegd zwembad" />
  </div>
  <div class="zwb-container" style="padding-top:40px;padding-bottom:64px;position:relative;z-index:2;">
    <div class="zwb-hero-content">
      <div class="zwb-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor zwembadinstallateurs
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Waterdicht verzekerd, jaren na de oplevering.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als zwembadinstallateur bouw je iets dat waterdicht moet blijven en jaren mee moet. Een scheur in het bad, een lek in de technische ruimte of een discussie over de afwerking kan opduiken lang nadat je de werf verlaten hebt. Daarom is tienjarige aansprakelijkheid voor jouw stiel geen detail. Assurman is gespecialiseerd in verzekeringen op maat van bouwondernemers in Vlaanderen.
      </p>
      <div class="zwb-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="zwb-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="zwb-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="zwb-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="zwb-features-grid">
      {[
        { text: 'Specialist in\nzwembadbouw & bouw', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Tienjarige dekking\nop constructie & waterdichtheid', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="zwb-container" style="max-width:1110px;">
    <div class="zwb-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een zwembadinstallateur een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Een zwembad aanleggen is geen gewone bouwklus. Je werkt met constructie, waterdichting, technische ruimtes, leidingen, pompen en waterbehandeling. En het bijzondere: een gebrek toont zich vaak niet meteen. Een scheurtje, een lekkende doorvoer of een fout in de waterdichting kan pas na één of meerdere seizoenen aan het licht komen, soms jaren na de oplevering.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: type baden (inox, polyester, beton), aandeel renovatie, technische installaties, personeel en je risicoprofiel. Voor zwembaden staat de tienjarige aansprakelijkheid (BA-10) centraal, omdat constructie- en waterdichtheidsgebreken nu net het soort risico zijn dat zich laat in de tijd kan tonen.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij levert een bad dat jaren mee moet, wij zorgen dat je ook jaren later beschermd bent."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Tienjarige aansprakelijkheid', text: 'Constructie- en waterdichtheidsgebreken kunnen jaren later opduiken. BA-10 staat hier centraal.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
          { title: 'Werf & uitvoering', text: 'Met BA en ABR dek je de schade en risico\'s tijdens de aanleg zelf.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Stilstand & herstel', text: 'Loopt een schadegeval uit op stilstand of herstel? We denken mee over bedrijfsschade en machines.', iconPath: 'M3 3v16a2 2 0 0 0 2 2h16M7 16l4-4 4 4 5-5' },
        ].map((card) => (
          <div class="zwb-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;">
    <BrandChevron color="white" height="200px" direction="left" opacity={0.07} />
  </div>
  <div class="zwb-container">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="zwb-section-label" style="margin-bottom:16px;">Wat zwembadinstallateurs waarderen</p>
