---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'arbeidsongevallen', 'gewaarborgd-inkomen', 'machinebreuk', 'bedrijfsvoertuigen', 'rechtsbijstand', 'vapz']);

const caseStudies = [
  {
    category: 'BOOMVERZORGING',
    title: 'Vallende tak beschadigt dak van de buur, €16.000 herstelclaim',
    businessName: 'Boomzorg Vandeput',
    ownerName: 'Dirk Vandeput',
    cityName: 'Hasselt',
    description: 'Bij het inkorten van een grote beuk brak een zware tak anders af dan voorzien en kwam op het dak van de aanpalende woning terecht. Dakpannen en een dakgoot raakten zwaar beschadigd.',
    action: 'De BA-verzekering ving de schade aan de eigendom van de buur op. Rechtsbijstand begeleidde de afhandeling met de buur en hun verzekeraar, zodat het herstel vlot werd geregeld en de zaakvoerder zijn reputatie behield.',
    image: '/images/cases/case-boomverzorgers-1.jpg',
  },
  {
    category: 'BOOMVERZORGING',
    title: 'Klimongeval legt zaakvoerder 5 maanden plat, inkomen weg',
    businessName: 'Arbo Climb',
    ownerName: 'Stijn Goossens',
    cityName: 'Genk',
    description: 'Tijdens een kroonreductie viel de zaakvoerder ongelukkig en liep een ernstige beenbreuk op. Maandenlang klimwerk was onmogelijk en de inkomsten vielen grotendeels stil.',
    action: 'De arbeidsongevallendekking ving de medische kosten op en het gewaarborgd inkomen zorgde voor een maandelijks vervangingsinkomen. Daardoor bleven de vaste lasten en het gezinsbudget overeind tijdens het herstel.',
    image: '/images/cases/case-boomverzorgers-2.jpg',
  },
  {
    category: 'BOOMVERZORGING',
    title: 'Velling beschadigt serre op naburig perceel, €8.900',
    businessName: 'De Boomklever',
    ownerName: 'Liesbeth Maes',
    cityName: 'Sint-Truiden',
    description: 'Een geplande velling van een aangetaste populier liep mis door een onverwachte windvlaag. De boom kwam deels op de serre van het naburige perceel terecht en vernielde een groot deel van de constructie en de beplanting erin.',
    action: 'Via de BA-verzekering werd de schade aan het naburige perceel vergoed. Rechtsbijstand hielp de aansprakelijkheid correct af te bakenen, zodat het geschil zonder escalatie werd opgelost.',
    image: '/images/cases/case-boomverzorgers-3.jpg',
  },
  {
    category: 'BOOMVERZORGING',
    title: 'Versnipperaar valt uit en kettingzaag gestolen, €6.300 impact',
    businessName: 'TreeCare Limburg',
    ownerName: 'Pieter Aerts',
    cityName: 'Tongeren',
    description: 'Een hydraulisch defect legde de versnipperaar stil midden in een grote snoeiopdracht, en kort daarna werd een professionele kettingzaag uit de aanhanger gestolen. De combinatie zette de planning onder druk.',
    action: 'Via de machinebreukdekking werden de herstelling en het gestolen materieel afgehandeld. Met vervangmateriaal kon de opdracht doorgaan en bleef de vertraging beperkt.',
    image: '/images/cases/case-boomverzorgers-4.jpg',
  },
];

const faqItems = [
  {
    title: "Waarom is boomverzorging zo'n risicoberoep voor verzekeringen?",
    content: "Omdat twee risico's hier samenkomen die elders zelden zo zwaar wegen:\n\n• Schade aan derden: je werkt op hoogte vlak bij daken, wagens en serres. Een tak die verkeerd valt, veroorzaakt snel grote schade aan andermans eigendom.\n\n• Fysiek risico: klimwerk is lichamelijk zwaar en gevaarlijk. Een ongeval raakt niet alleen je gezondheid, maar ook je inkomen.\n\nDaarom leggen we de nadruk op BA, arbeidsongevallen en gewaarborgd inkomen.",
  },
  {
    title: 'Ben ik gedekt als een tak op een dak of auto valt?',
    content: 'Schade die je tijdens je werk aan de eigendom van een klant of een derde veroorzaakt, zoals een vallende tak op een dak, wagen of serre, valt doorgaans onder je BA-aansprakelijkheid. De exacte voorwaarden, zeker bij vellingen en risicovol klimwerk, bekijken we samen bij je intake.',
  },
  {
    title: 'Wat gebeurt er met mijn inkomen als ik zelf uitval?',
    content: 'Als zelfstandige val je bij arbeidsongeschiktheid vaak terug op een beperkte uitkering. Met een gewaarborgd inkomen krijg je een maandelijks vervangingsinkomen, zodat je je vaste lasten en gezinsuitgaven kunt blijven betalen terwijl je herstelt. Bij een fysiek beroep als het jouwe is dat geen luxe.',
  },
  {
    title: 'Heeft een ETW- of klimcertificaat invloed op mijn dossier?',
    content: 'Certificaten zoals ETW (European Tree Worker) tonen je vakbekwaamheid en kunnen meespelen in hoe je dossier en je risicoprofiel beoordeeld worden. Of en hoe dit voor jouw situatie meetelt, nemen we mee in je intake. Dit is een punt dat we concreet met je nakijken.',
  },
  {
    title: 'Is arbeidsongevallenverzekering verplicht als ik alleen werk?',
    content: 'Als zuivere eenmanszaak zonder personeel ben je niet onderworpen aan de wettelijke arbeidsongevallenverzekering voor werknemers, maar je eigen fysieke risico blijft hoog. Daarom kijken we naar passende dekkingen voor jezelf, zoals een ongevallenverzekering en gewaarborgd inkomen. Werk je met helpers of personeel, dan is arbeidsongevallen wel verplicht.',
  },
  {
    title: 'Zijn mijn klimmateriaal en kettingzagen verzekerd?',
    content: 'Met een machinebreukpolis dek je plotse defecten, beschadiging en diefstal van je materieel, van kettingzaag tot versnipperaar en klimuitrusting. We stemmen de dekking af op de waarde en op waar je het bewaart.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel boomverzorgers starten met een kernpakket en breiden uit wanneer ze personeel aannemen of grotere vellingen aanpakken. Assurman bouwt modulair: je groeit zonder telkens van nul te starten.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor boomverzorgers in Vlaanderen"
  description="Klimmen, snoeien op hoogte en vellen: boomverzorgers lopen het hoogste fysieke risico. Assurman dekt je aansprakelijkheid, je mensen en je inkomen op maat."
  canonical="/sectoren/boomverzorgers/"
  schema={schema}
>

<style>
  .bmv-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .bmv-hero-content { max-width: 52%; padding-top: 100px; }
  .bmv-hero-img { position: absolute; top: 0; right: -5px; height: min(85vh, calc(48vw * 709 / 594)); width: auto; z-index: 1; pointer-events: none; }
  .bmv-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .bmv-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .bmv-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .bmv-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .bmv-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .bmv-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .bmv-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .bmv-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .bmv-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .bmv-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .bmv-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .bmv-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .bmv-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .bmv-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .bmv-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .bmv-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .bmv-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .bmv-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .bmv-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .bmv-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .bmv-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .bmv-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .bmv-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .bmv-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .bmv-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .bmv-hero-img { display: none; }
    .bmv-features-grid { grid-template-columns: repeat(2, 1fr); }
    .bmv-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .bmv-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .bmv-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .bmv-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .bmv-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .bmv-intro-grid { grid-template-columns: 1fr; }
    .bmv-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .bmv-container { padding-left: 15px; padding-right: 15px; }
    .bmv-hero-content { max-width: 100%; padding-top: 16px; }
    .bmv-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .bmv-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .bmv-benefits-grid { grid-template-columns: 1fr; }
    .bmv-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .bmv-cards3-grid { grid-template-columns: 1fr; }
    .bmv-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .bmv-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .bmv-testimonials-grid { grid-template-columns: 1fr; }
    .bmv-cert-grid { grid-template-columns: 1fr 1fr; }
    .bmv-btn-primary { font-size: 16px; padding: 16px 24px; }
    .bmv-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .bmv-hero-btns { flex-direction: column; }
    .bmv-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .bmv-cta-btns { flex-direction: column; align-items: center; }
    .bmv-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .bmv-final-btns { flex-direction: column; align-items: center; }
    .bmv-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .bmv-step-number { font-size: 56px; }
    .bmv-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .bmv-waarom-mask-img,
    .bmv-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="bmv-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:100vh;">
  <div class="bmv-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/boomverzorgers-hero.jpg" alt="Boomverzorger zekert zich in de kruin van een boom tijdens snoeiwerk" />
  </div>
  <div class="bmv-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="bmv-hero-content">
      <div class="bmv-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor boomverzorgers
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Beschermd op hoogte, in de boom en eronder.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als boomverzorger doe je werk waar weinig anderen aan beginnen: klimmen, snoeien op hoogte, vellen en rooien. Het is fysiek het zwaarste en risicovolste werk in de groensector. Eén vallende tak op een dak of een geparkeerde wagen, één misstap in de boom: de gevolgen kunnen groot zijn, voor jezelf en voor anderen. Assurman is gespecialiseerd in verzekeringen op maat van bouw- en groenondernemers in Vlaanderen.
      </p>
      <div class="bmv-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="bmv-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="bmv-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="bmv-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="bmv-features-grid">
      {[
        { text: 'Specialist in\nboomverzorging & groen', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Dekking op hoogte\n+ je inkomen beschermd', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="bmv-container" style="max-width:1110px;">
    <div class="bmv-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een boomverzorger een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Boomverzorging is geen standaard groenwerk. Je werkt op hoogte, in de kruin, met klimtechniek en kettingzagen, vaak vlak bij gebouwen, daken, serres en geparkeerde wagens. Eén tak die verkeerd valt of één misrekening bij een velling kan grote schade veroorzaken aan andermans eigendom. En omdat je het met je lichaam doet, raakt een ongeval niet alleen je werk, maar ook je inkomen.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: type werken (snoei, velling, rooiing), klimwerk, personeel, machinepark en je risicoprofiel. Bij boomverzorging leggen we extra nadruk op je aansprakelijkheid voor vallende takken, op je arbeidsongevallendekking en op een gewaarborgd inkomen als je zelf uitvalt.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij werkt op hoogte met risico, wij zorgen dat één val je bedrijf en je inkomen niet meesleurt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Vallende takken & bomen', text: 'Een tak op een dak, wagen of serre? Je BA dekt de schade die je aan andermans eigendom veroorzaakt.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Werken op hoogte', text: 'Klimwerk is fysiek het zwaarst. Arbeidsongevallen en valbeveiliging staan hier centraal.', iconPath: 'M18 9L12 3L6 9M12 3v14M5 21h14' },
          { title: 'Je inkomen beschermd', text: 'Val je zelf uit door een ongeval? Met gewaarborgd inkomen blijft je gezinsbudget overeind.', iconPath: 'M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6' },
        ].map((card) => (
          <div class="bmv-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
