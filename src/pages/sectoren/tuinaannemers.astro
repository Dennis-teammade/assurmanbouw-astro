---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import type { CaseStudy } from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';
import HeroDeco from '../../components/HeroDeco.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'alle-bouwplaats-risicos', 'machinebreuk', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'rechtsbijstand', 'groepsverzekering']);

// Nog geen echt klantverhaal voor deze sector. Afspraak met Maaike (11/8/2026):
// liever geen sectie dan verzonnen voorbeelden. Zodra er een echte case binnenkomt,
// zetten we die hier en verschijnt de sectie automatisch weer.
// Aanleveren via de gedeelde sheet (zie clients/assurman/docs/FEEDBACK-MAAIKE-2026-08-06.md).
const caseStudies: CaseStudy[] = [];

const faqItems = [
  {
    title: "Welke risico's heeft een tuinaannemer het meest?",
    content: "De grootste risico's komen meestal uit 4 hoeken:\n\n• Aansprakelijkheid: schade aan eigendom van de klant of de buren (verzakking, beschadigde verharding, een geraakte leiding).\n\n• Werfrisico's: onvoorziene schade aan je werk in uitvoering, zeker bij grotere totaalprojecten.\n\n• Machines: een defecte of gestolen minigraver legt je grondwerk meteen stil.\n\n• Mobiliteit: zonder bestelwagen of aanhanger met je materieel sta je stil.\n\nDaarom is een basis met BA + ABR + machines + bestelwagen voor veel tuinaannemers een logische start.",
  },
  {
    title: 'Wat is het verschil tussen BA en ABR?',
    content: "BA (Burgerlijke Aansprakelijkheid) gaat over schade die je aan anderen veroorzaakt: aan eigendom van de klant, aan buren of aan derden op de werf.\n\nABR (Alle Bouwplaatsrisico's) focust op je werk in uitvoering: onvoorziene schade aan de werken zelf en aan materialen op de werf. Dat is vooral interessant bij grotere of langere projecten.\n\nIn de praktijk vullen ze elkaar aan. Assurman helpt je kiezen wat in jouw situatie écht nodig is.",
  },
  {
    title: 'Ben ik gedekt als ik een ondergrondse leiding raak?',
    content: 'Schade aan nutsleidingen valt doorgaans onder je BA-aansprakelijkheid tegenover derden. De exacte voorwaarden hangen af van je polis en of je de nodige opzoekingen deed. Dit is een punt dat we bij je intake concreet nakijken, zodat je weet waar je staat voor je de eerste schop in de grond zet.',
  },
  {
    title: 'Zijn mijn machines verzekerd tegen pech en diefstal?',
    content: 'Met een machinebreukpolis dek je plotse defecten, beschadiging en diefstal van je materieel, of het nu op de werf, in de bestelwagen of in het atelier staat. We stemmen de dekking af op de waarde van je machinepark en waar je het bewaart.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel tuinaannemers starten met een kernpakket en breiden uit wanneer ze personeel aannemen, grotere werven doen of meer machines vervoeren. Assurman bouwt modulair: je groeit zonder telkens van nul te starten.',
  },
  {
    title: 'Ik werk met onderaannemers. Wat betekent dat?',
    content: 'Dat kan invloed hebben op de afspraken rond aansprakelijkheid op de werf. Geef het aan bij je intake, dan bekijken we welke dekking en voorwaarden het best passen.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor tuinaannemers in Vlaanderen"
  description="Graafwerk, terrassen, opritten en zware machines: tuinaannemers lopen specifieke risico's. Assurman bouwt een bouwverzekering op maat van jouw stiel."
  canonical="/sectoren/tuinaannemers/"
  schema={schema}
>

<style>
  .tun-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .tun-hero-content { max-width: 52%; padding-top: 100px; }
  .tun-hero-img { position: absolute; top: 0; right: -5px; width: clamp(420px, 33vw, 620px); height: auto; z-index: 1; pointer-events: none; }
  .tun-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .tun-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .tun-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .tun-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .tun-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .tun-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .tun-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .tun-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .tun-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .tun-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .tun-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .tun-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .tun-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .tun-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .tun-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .tun-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .tun-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .tun-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .tun-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .tun-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .tun-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .tun-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .tun-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .tun-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .tun-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .tun-hero-img { display: none; }
    .tun-features-grid { grid-template-columns: repeat(2, 1fr); }
    .tun-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .tun-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .tun-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .tun-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .tun-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .tun-intro-grid { grid-template-columns: 1fr; }
    .tun-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .tun-container { padding-left: 15px; padding-right: 15px; }
    .tun-hero-content { max-width: 100%; padding-top: 16px; }
    .tun-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .tun-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .tun-benefits-grid { grid-template-columns: 1fr; }
    .tun-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .tun-cards3-grid { grid-template-columns: 1fr; }
    .tun-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .tun-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .tun-testimonials-grid { grid-template-columns: 1fr; }
    .tun-cert-grid { grid-template-columns: 1fr 1fr; }
    .tun-btn-primary { font-size: 16px; padding: 16px 24px; }
    .tun-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .tun-hero-btns { flex-direction: column; }
    .tun-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .tun-cta-btns { flex-direction: column; align-items: center; }
    .tun-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .tun-final-btns { flex-direction: column; align-items: center; }
    .tun-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .tun-step-number { font-size: 56px; }
    .tun-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .tun-waarom-mask-img,
    .tun-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="tun-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:calc(100vh - var(--header-clear));--photo-w:clamp(420px, 33vw, 620px);">
  <HeroDeco containerOffset="max(664px, calc(50vw + 24px))" />
  <div class="tun-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/tuinaannemers-hero.jpg" alt="Tuinaannemer legt een terras aan met een minigraver op de achtergrond" />
  </div>
  <div class="tun-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="tun-hero-content">
      <div class="tun-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor tuinaannemers
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Stevig verzekerd, van graafwerk tot afwerking.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als tuinaannemer werk je met zwaar materieel, graaf je in onbekende grond en lever je projecten op die jaren mee moeten. Eén geraakte leiding, een verzakkend terras of een dag stilstand door machinepech kan je flink wat kosten. Assurman is gespecialiseerd in verzekeringen op maat van bouwondernemers in Vlaanderen.
      </p>
      <div class="tun-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="tun-btn-primary hero-cta">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="tun-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="tun-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="tun-features-grid">
      {[
        { text: 'Specialist in\ntuinaanleg & bouw', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Dekking voor werf\n+ machines + graafwerk', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Duidelijke uitleg,\nsnelle service', iconPath: 'M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="tun-container" style="max-width:1110px;">
    <div class="tun-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een tuinaannemer een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Tuinaanleg is geen standaard tuinwerk. Je graaft funderingen voor terrassen en opritten, legt drainage en kabelgoten, en je manoeuvreert met minigravers, trilplaten en kranen op terreinen die je niet altijd kent. Eén ondergrondse leiding die je raakt of één terras dat na een natte winter verzakt, kan al leiden tot een schadeclaim of dagenlange stilstand.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: type projecten (terras, oprit, totaaltuin), machinepark, personeel, onderaannemers, regio en risicoprofiel. Zo betaal je voor wat je echt nodig hebt, niet voor wat je nooit gebruikt.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij legt aan, wij zorgen dat één tegenslag op de werf je project niet onderuithaalt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Graafwerk & ondergrond', text: 'Raak je een nutsleiding of zorgt slechte afwatering voor schade? Met BA + rechtsbijstand sta je niet alleen.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Zware machines', text: 'Bescherming voor minigraver, trilplaat en kraan, zodat machinepech je planning niet stillegt.', iconPath: 'M15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9M18 15L22 11M21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5' },
          { title: 'Werf & aansprakelijkheid', text: 'Met BA en ABR dek je de risico\'s die je het vaakst tegenkomt tijdens de uitvoering.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
        ].map((card) => (
          <div class="tun-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;">
    <BrandChevron color="white" height="200px" direction="left" opacity={0.07} />
  </div>
  <div class="tun-container">
    <div style="text-align:center;margin-bottom:48px;">
      <p class="tun-section-label" style="margin-bottom:16px;">Wat tuinaannemers waarderen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1;color:#FFFFFF;margin:0;">
        Wat tuinaannemers vooral waarderen aan Assurman
      </h2>
    </div>
    <div class="tun-benefits-grid">
      {[
        { title: 'Heldere dekking', text: 'Geen wollige taal. Je weet waarvoor je verzekerd bent en waarom.', iconPath: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M16 13H8M16 17H8M10 9H8' },
        { title: 'Slimme modules', text: 'Voeg toe wat jij nodig hebt: werfdekking, machines, mobiliteit, rechtsbijstand.', iconPath: 'M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5M9 18h6M10 22h4' },
        { title: 'Snelle intake', text: 'Na een audit van onze expert stemmen we alles af op jouw projecten.', iconPath: 'M10 2L14 2M12 14L15 11M4 14a8 8 0 1 0 16 0a8 8 0 1 0-16 0' },
        { title: 'Bouw-expertise', text: 'We spreken jouw taal: terras, fundering, drainage, klinkers, beplanting.', iconPath: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z' },
      ].map((item) => (
        <div class="tun-insurance-card" style="padding:32px;display:flex;flex-direction:column;align-items:center;text-align:center;clip-path:polygon(32px 0%,100% 0%,100% 100%,0% 100%,0% 32px);">
          <div style="margin-bottom:20px;">
