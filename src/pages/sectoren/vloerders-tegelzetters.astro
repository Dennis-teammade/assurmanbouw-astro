---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import CaseStudyCarousel from '../../components/islands/CaseStudyCarousel';
import FaqAccordion from '../../components/islands/FaqAccordion';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_BEL, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const insuranceCards = kaartenVoor(['ba-onderneming', 'rechtsbijstand', 'vervoerde-goederen', 'bedrijfsvoertuigen', 'arbeidsongevallen', 'alle-bouwplaats-risicos', 'poz']);

const caseStudies = [
  {
    category: 'TEGELWERK',
    title: 'Loskomende vloertegels in woonkamer: €15.500 herstelclaim',
    businessName: 'Tegelhuis Vandamme',
    ownerName: 'Geert Vandamme',
    cityName: 'Roeselare',
    description: 'Enkele maanden na oplevering kwamen verschillende vloertegels los en klonken andere hol bij aankloppen. De bouwheer eiste dat de volledige vloer opnieuw gelegd werd.',
    action: 'Via de rechtsbijstand en BA-onderneming werd een expert aangesteld die de lijmlaag en de ondergrond beoordeelde. Op basis van de bevindingen werd de aansprakelijkheid bepaald en nam de verzekering het toegewezen deel van de herstelkosten op zich.',
    image: '/images/cases/case-vloerders-tegelzetters-1.jpg',
  },
  {
    category: 'NATUURSTEEN',
    title: 'Discussie over kleurverschil in natuursteen: €12.000 in het geding',
    businessName: 'SteenStijl',
    ownerName: 'Isabelle Goossens',
    cityName: 'Gent',
    description: 'Na het leggen van een natuurstenen vloer klaagde de klant over duidelijke kleur- en structuurverschillen tussen de platen. Hij weigerde een deel van de factuur te betalen.',
    action: 'Via de rechtsbijstand werd technisch advies ingewonnen over de natuurlijke variatie die eigen is aan natuursteen. Na bemiddeling kwam er een betalingsregeling waarbij de natuurlijke aard van het materiaal werd erkend. Een procedure werd vermeden.',
    image: '/images/cases/case-vloerders-tegelzetters-2.jpg',
  },
  {
    category: 'MATERIAAL',
    title: 'Breuk van grootformaat tegels tijdens transport: €9.000 schade',
    businessName: 'Vloeren Coppens',
    ownerName: 'Rik Coppens',
    cityName: 'Lokeren',
    description: 'Een set dure grootformaat keramische platen brak tijdens het vervoer naar de werf. De levering moest opnieuw besteld worden, met planningverlies tot gevolg.',
    action: 'Via de dekking voor vervoerde goederen werd de waarde van de gebroken platen vergoed. Een nieuwe levering werd versneld geregeld zodat het project slechts beperkt vertraging opliep.',
    image: '/images/cases/case-vloerders-tegelzetters-3.jpg',
  },
  {
    category: 'TEGELWERK',
    title: 'Beschadigde natuursteenplaat bij plaatsing kost €7.500',
    businessName: 'Tegel & Natuursteen Peeters',
    ownerName: 'Marleen Peeters',
    cityName: 'Wetteren',
    description: 'Tijdens het inpassen van een dure natuursteenplaat ontstond een barst. Het stuk was op maat besteld en kon niet zomaar vervangen worden zonder extra kosten en wachttijd.',
    action: 'De schade aan het materiaal in uitvoering werd binnen de werfdekking opgevangen. Er kon een nieuwe plaat besteld worden en het project werd zonder verder conflict afgewerkt.',
    image: '/images/cases/case-vloerders-tegelzetters-4.jpg',
  },
];

const faqItems = [
  {
    title: "Welke risico's heeft een tegelzetter het meest?",
    content: "Bij vloerders en tegelzetters draait het vaak om twee dingen:\n\n• Esthetische geschillen: loskomende of hol klinkende tegels, kleurverschil natuursteen, voegen die afgekeurd worden.\n\n• Duur materiaal: natuursteen en grootformaat tegels zijn kwetsbaar bij transport en plaatsing.\n\n• Schade bij de klant: in bewoonde woningen raakt er snel iets beschadigd.\n\nDaarom is een basis met BA-onderneming, rechtsbijstand en dekking voor vervoerde goederen voor veel tegelzetters logisch.",
  },
  {
    title: 'Ben ik gedekt als tegels loskomen of hol klinken?',
    content: 'Bij een geschil over loskomende of hol klinkende tegels schakelen we via rechtsbijstand een expert in die de lijmlaag, de ondergrond en de uitvoering beoordeelt. Vaak speelt ook de chape of de ondergrond een rol. Met BA-onderneming en rechtsbijstand sta je niet alleen tegenover de klant.',
  },
  {
    title: 'Wat als duur materiaal beschadigt onderweg of bij het leggen?',
    content: 'Daarvoor dient de dekking voor vervoerde goederen, eventueel aangevuld met werfdekking. Natuursteen en grootformaat tegels zijn breekbaar en duur. Of het nu tijdens transport naar de werf is of bij de plaatsing, we zorgen dat de materiaalwaarde mee verzekerd is.',
  },
  {
    title: 'Een klant klaagt over kleurverschil in natuursteen. Sta ik er alleen voor?',
    content: 'Nee. Kleur- en structuurvariatie is eigen aan natuursteen, maar niet elke klant weet dat. Rechtsbijstand laat dit technisch onderbouwen en helpt je het geschil redelijk op te lossen zonder dat je meteen zelf expertise- en advocaatkosten draagt.',
  },
  {
    title: 'Werk ik veel in bewoonde woningen. Maakt dat een verschil?',
    content: 'Ja. In bewoonde woningen is de kans op schade aan bestaande afwerking, meubels of andere vloeren groter. Dat valt onder je BA-onderneming. In je intake geef je aan hoeveel je in bewoonde ruimtes werkt, zodat we de dekking daarop afstemmen.',
  },
  {
    title: 'Kan ik mijn pakket later uitbreiden?',
    content: 'Ja. Veel tegelzetters starten met een kernpakket en breiden uit wanneer ze personeel aannemen, grotere of duurdere projecten doen of meer natuursteen verwerken. Assurman bouwt modulair: je groeit zonder telkens opnieuw van nul te starten.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content.replace(/\n/g, ' ') }
  }))
};
---

<BaseLayout
  title="Verzekeringen voor vloerders en tegelzetters | Assurman"
  description="Loskomende tegels, hol klinkend werk, kleurverschil natuursteen, beschadigd duur materiaal: tegelzetters hebben specifieke noden. Pakket op maat van Assurman."
  canonical="/sectoren/vloerders-tegelzetters/"
  schema={schema}
>

<style>
  .vlt-container { max-width: 1280px; margin: 0 auto; padding-left: 32px; padding-right: 32px; }
  .vlt-hero-content { max-width: 52%; padding-top: 100px; }
  .vlt-hero-img { position: absolute; top: 0; right: -5px; height: min(85vh, calc(48vw * 709 / 594)); width: auto; z-index: 1; pointer-events: none; }
  .vlt-features-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .vlt-intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: flex-start; }
  .vlt-benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .vlt-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 48px; }
  .vlt-cards3-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .vlt-process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; margin-bottom: 64px; }
  .vlt-testimonials-header { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; margin-bottom: 64px; }
  .vlt-testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .vlt-cert-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .vlt-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .vlt-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .vlt-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }

  .vlt-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .vlt-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .vlt-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213, 196, 174, 0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .vlt-btn-secondary:hover { border-color: #E5A524; background: rgba(229, 165, 36, 0.05); }
  .vlt-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213, 196, 174, 0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }
  .vlt-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }
  .vlt-step-number { font-family: 'Open Sans', sans-serif; font-weight: 800; font-size: 80px; line-height: 1; color: rgba(229, 165, 36, 0.18); position: absolute; top: 0; left: -4px; user-select: none; pointer-events: none; }
  .vlt-insurance-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); backdrop-filter: blur(2px); transition: background 0.2s, transform 0.2s; }
  .vlt-insurance-card:hover { background: rgba(255,255,255,0.1); transform: translateY(-4px); }
  .vlt-why-card { background: #FFFFFF; border-left: 4px solid #E5A524; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .vlt-why-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }
  .vlt-testimonial-card { background: #FFFFFF; box-shadow: 0px 1px 2px rgba(0,0,0,0.05); transition: box-shadow 0.2s, transform 0.2s; }
  .vlt-testimonial-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  @media (max-width: 1023px) {
    .vlt-hero-img { display: none; }
    .vlt-features-grid { grid-template-columns: repeat(2, 1fr); }
    .vlt-benefits-grid { grid-template-columns: repeat(2, 1fr); }
    .vlt-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .vlt-process-grid { grid-template-columns: repeat(2, 1fr); gap: 24px; }
    .vlt-testimonials-header { grid-template-columns: 1fr; gap: 32px; }
    .vlt-testimonials-grid { grid-template-columns: repeat(2, 1fr); }
    .vlt-intro-grid { grid-template-columns: 1fr; }
    .vlt-container { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 767px) {
    .vlt-container { padding-left: 15px; padding-right: 15px; }
    .vlt-hero-content { max-width: 100%; padding-top: 16px; }
    .vlt-features-grid { grid-template-columns: 1fr; gap: 12px; }
    .vlt-intro-grid { grid-template-columns: 1fr; gap: 24px; }
    .vlt-benefits-grid { grid-template-columns: 1fr; }
    .vlt-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .vlt-cards3-grid { grid-template-columns: 1fr; }
    .vlt-process-grid { grid-template-columns: 1fr; gap: 32px; }
    .vlt-testimonials-header { grid-template-columns: 1fr; gap: 24px; }
    .vlt-testimonials-grid { grid-template-columns: 1fr; }
    .vlt-cert-grid { grid-template-columns: 1fr 1fr; }
    .vlt-btn-primary { font-size: 16px; padding: 16px 24px; }
    .vlt-btn-secondary { font-size: 16px; padding: 14px 24px; }
    .vlt-hero-btns { flex-direction: column; }
    .vlt-hero-btns a { width: 100%; justify-content: center; text-align: center; }
    .vlt-cta-btns { flex-direction: column; align-items: center; }
    .vlt-cta-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .vlt-final-btns { flex-direction: column; align-items: center; }
    .vlt-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .vlt-step-number { font-size: 56px; }
    .vlt-hero-section { display: flex; flex-direction: column; min-height: unset !important; }
    .vlt-waarom-mask-img,
    .vlt-cta-mask-img { width: 55% !important; opacity: 0.35 !important; }
  }
</style>

<!-- SECTION 1: HERO -->
<section class="vlt-hero-section" style="background:#FFFFFF;position:relative;overflow:hidden;min-height:100vh;">
  <div class="vlt-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/sectoren/vloerders-tegelzetters-hero.jpg" alt="Tegelzetter legt grootformaat vloertegels" />
  </div>
  <div class="vlt-container" style="padding-top:0;padding-bottom:64px;position:relative;z-index:2;">
    <div class="vlt-hero-content">
      <div class="vlt-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman • Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Verzekeringen voor vloerders en tegelzetters
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin-bottom:20px;">
        Strak gelegd, goed beschermd.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:28px;max-width:520px;">
        Als vloerder of tegelzetter werk je met duur materiaal en een zichtbaar eindresultaat. Een tegel die loskomt of hol klinkt, een kleurverschil in natuursteen of een dure plaat die beschadigd raakt bij het leggen: het leidt snel tot discussie en hoge herstelkosten. Assurman is gespecialiseerd in verzekeringen op maat van afwerkingsondernemers in Vlaanderen.
      </p>
      <div class="vlt-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="vlt-btn-primary">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="vlt-btn-secondary">{CTA_AFSPRAAK.advisoryFull}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTION 2: KEY FEATURES STRIP -->
<section style="background:#e5a52414;padding:48px 0;">
  <div class="vlt-container">
    <p style="font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#8B6A1A;text-align:center;margin:0 0 32px 0;">
      Een goede verzekering begint bij:
    </p>
    <div class="vlt-features-grid">
      {[
        { text: 'Specialist in\ntegel- & natuursteenwerk', iconPath: 'M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5M14 6a6 6 0 0 1 6 6v3M4 15v-3a6 6 0 0 1 6-6M3 15L21 15A1 1 0 0 1 22 16L22 18A1 1 0 0 1 21 19L3 19A1 1 0 0 1 2 18L2 16A1 1 0 0 1 3 15z' },
        { text: 'Modulair pakket:\nenkel wat nodig is', iconPath: 'm6 14 1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2' },
        { text: 'Sterk op geschillen\n& materiaalschade', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
        { text: 'Dekking voor werk\n+ duur materiaal + bestelwagen', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
      ].map((item) => (
        <div style="display:flex;align-items:center;gap:20px;background:#FFFFFF;border:1px solid rgba(229,165,36,0.18);border-radius:12px;padding:20px 24px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
          <svg width="36" height="36" fill="none" stroke="#E5A524" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;"><path d={item.iconPath}/></svg>
          <div style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;line-height:1.45;white-space:pre-line;">{item.text}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- SECTION 3: INTRO + POSITIONERING -->
<section style="background:#FBF8FF;padding:80px 0;">
  <div class="vlt-container" style="max-width:1110px;">
    <div class="vlt-intro-grid">
      <div style="padding-top:40px;padding-right:0;">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3vw,41px);line-height:1.1;color:#001F3F;margin-bottom:16px;">
          Waarom een tegelzetter een specialist nodig heeft
        </h2>
        <div style="width:96px;height:6px;background:#E5A524;margin-bottom:24px;"></div>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:20px;">
          Tegel- en natuursteenwerk is precisiewerk met dure materialen. Een tegel die loskomt of hol klinkt, een voeg die de klant afkeurt, een zichtbaar kleurverschil tussen natuursteenplaten: het zijn klassieke discussiepunten. En omdat het materiaal zelf veel waard is, telt een beschadigde plaat of een breuk bij transport meteen serieus aan.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,1.5vw,20px);line-height:1.6;color:#001F3F;margin-bottom:32px;">
          Daarom werkt Assurman niet met een one-size-fits-all polis. We bouwen een pakket op maat van jouw realiteit: keramiek, natuursteen, grootformaat, wandbekleding, werken in bewoonde woningen, personeel, materiaalwaarde en bestelwagen. Zo ben je gedekt voor de risico's die jouw stiel echt kent.
        </p>
        <blockquote style="border-left:4px solid #E5A524;padding-left:24px;margin:0;">
          <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;line-height:1.55;color:#001F3F;margin:0;">
            "Jij legt het zichtbare eindresultaat. Wij zorgen dat een discussie geen financieel probleem wordt."
          </p>
        </blockquote>
      </div>

      <div style="display:flex;flex-direction:column;gap:20px;padding-top:40px;">
        {[
          { title: 'Esthetische geschillen', text: 'Rechtsbijstand staat klaar wanneer een klant het werk afkeurt op voegen, vlakheid of hol klinken.', iconPath: 'M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01' },
          { title: 'Duur materiaal & transport', text: 'Met dekking voor vervoerde goederen ben je beschermd als natuursteen of grootformaat tegels onderweg of op de werf beschadigen.', iconPath: 'M3 6L21 6A1 1 0 0 1 22 7L22 13A1 1 0 0 1 21 14L3 14A1 1 0 0 1 2 13L2 7A1 1 0 0 1 3 6zM17 14v7M7 14v7M17 3v3M7 3v3M10 14L2.3 6.3M14 6L21.7 13.7M8 6L16 14' },
          { title: 'Schade bij de klant', text: 'Met BA dek je schade aan de eigendom van de klant tijdens het leggen, ook in bewoonde woningen.', iconPath: 'M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z' },
        ].map((card) => (
          <div class="vlt-why-card" style="padding:28px;display:flex;align-items:flex-start;gap:20px;">
            <div style="background:rgba(229,165,36,0.1);border-radius:8px;padding:12px;flex-shrink:0;display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;line-height:1.27;color:#001F3F;margin-bottom:6px;">{card.title}</h3>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.4;color:#001F3F;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- SECTION 4: QUICK BENEFITS - Dark -->
<section style="background:#3F5767;padding:80px 0;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;">
    <BrandChevron color="white" height="200px" direction="left" opacity={0.07} />
  </div>
