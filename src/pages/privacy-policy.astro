    .legal-table th { background:#F1F5F9; color:#001F3F; font-family:'Outfit',sans-serif; font-weight:700; }
    .legal-table td { color:#1f2937; }
    @media (max-width:767px){ .legal-table{ font-size:13px; } .legal-table th,.legal-table td{ padding:8px; } }
    @media (max-width: 767px) {
      .legal-page { padding: 60px 0 50px; }
      .legal-container { padding: 0 20px; font-size: 15px; }
    }
  </style>

