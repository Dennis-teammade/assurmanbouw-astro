const pechBuitenland = [
  { naam: 'AG Insurance',                  nr: '+32 (0)78 05 55 05', tel: '+3278055505' },
  { naam: 'Allianz Belgium',               nr: '+32 (0)2 773 61 41', tel: '+3227736141' },
  { naam: 'AXA Belgium',                   nr: '+32 (0)2 550 05 55', tel: '+3225000555' },
  { naam: 'Baloise',                       nr: '+32 (0)3 870 95 70', tel: '+3238709570' },
  { naam: 'Piette & Partners',             nr: '+32 (0)78 15 01 82', tel: '+3278150182' },
  { naam: 'Europ Assistance',             nr: '+32 (0)2 533 75 75', tel: '+3225337575' },
  { naam: 'Europese Verzekeringen',        nr: '+32 (0)3 253 64 15', tel: '+3232536415' },
  { naam: 'Allianz Global Assistance',     nr: '+32 (0)2 290 61 00', tel: '+3222906100' },
  { naam: 'World Royal Protection (AGA)',  nr: '+32 (0)2 290 65 00', tel: '+3222906500' },
  { naam: 'Touring',                       nr: '+32 (0)2 233 23 45', tel: '+3222332345' },
  { naam: 'VAB',                           nr: '+32 (0)70 34 46 66', tel: '+3270344666' },
