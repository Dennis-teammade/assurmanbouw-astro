---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandChevron from '../components/BrandChevron.astro';
import { CTA_DESTINATIONS } from '../data/cta-labels';

// ── Bijstandspagina ──────────────────────────────────────────────────────────
