      margin: 0 auto;
      padding: 0 32px;
      font-family: 'Open Sans', sans-serif;
      color: #1f2937;
      line-height: 1.7;
      font-size: 16px;
    }
    .legal-container h1 {
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      font-size: clamp(32px, 4vw, 48px);
      line-height: 1.15;
      letter-spacing: -0.5px;
      color: #001F3F;
      margin: 0 0 32px;
    }
    .legal-container h2 {
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: clamp(22px, 2.4vw, 28px);
      color: #001F3F;
      margin: 48px 0 16px;
    }
    .legal-container h3 {
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      font-size: 20px;
      color: #001F3F;
      margin: 32px 0 12px;
    }
    .legal-container h4 {
      font-family: 'Outfit', sans-serif;
