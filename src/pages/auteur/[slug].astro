---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { authors, type AuthorSlug } from '../../data/authors';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../data/cta-labels';

export async function getStaticPaths() {
  return Object.keys(authors).map((slug) => ({
    params: { slug },
    props: { slug: slug as AuthorSlug },
  }));
}

const { slug } = Astro.props;
const author = authors[slug];

const [pillars, clusterPosts] = await Promise.all([
  getCollection('pillars', ({ data }) => data.author === slug && data.status === 'published'),
  getCollection('cluster-posts', ({ data }) => data.author === slug && data.status === 'published'),
]);

const pillarArticles = pillars
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((p) => ({
    title: p.data.title,
    href: `/gids/${p.slug}/`,
    label: 'Gids',
    category: p.data.category,
    readingTime: p.data.readingTime,
    date: p.data.publishDate,
  }));

const spokeArticles = clusterPosts
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .map((s) => ({
    title: s.data.title,
    href: `/gids/${s.data.parentPillar}/${s.slug}/`,
    label: 'Artikel',
    category: s.data.category,
    readingTime: s.data.readingTime,
    date: s.data.publishDate,
  }));

const allArticles = [...pillarArticles, ...spokeArticles];

const siteUrl = 'https://www.assurman.be';
const canonicalPath = author.authorPageUrl;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  jobTitle: author.role,
  image: `${siteUrl}${author.photo}`,
  url: `${siteUrl}${canonicalPath}`,
  sameAs: [author.linkedin],
  worksFor: {
    '@type': 'InsuranceAgency',
    name: author.company,
    url: siteUrl,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Sint-Jorisstraat 96',
      postalCode: '8730',
      addressLocality: 'Beernem',
      addressCountry: 'BE',
    },
  },
  knowsAbout: [...author.expertises],
};

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: personSchema,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Kenniscentrum', item: `${siteUrl}/gids/` },
    { '@type': 'ListItem', position: 3, name: author.name, item: `${siteUrl}${canonicalPath}` },
  ],
};

const schemas = [profilePageSchema, breadcrumbSchema];

const expertiseLinks: Record<string, string> = {
  'BA Onderneming voor bouwondernemers': '/verzekeringen/ba-onderneming/',
  'BA-10 (Wet-Peeters-Borsus, tienjarige aansprakelijkheid)': '/verzekeringen/ba-10/',
  'Arbeidsongevallenverzekering bouwsector': '/verzekeringen/arbeidsongevallen/',
  "Alle Bouwplaats Risico's (ABR)": '/verzekeringen/alle-bouwplaats-risicos/',
  'Bedrijfsvoertuigen en wagenparkbeheer': '/verzekeringen/bedrijfsvoertuigen/',
  'Onderaanneming en Boek 6 BW (2025)': '/gids/verplichte-verzekeringen/',
  "Risicoanalyse voor zelfstandigen en KMO's": '/gratis-verzekeringsscan/',
  'Premieoptimalisatie en polisvergelijking': '/gids/kosten-en-premies/',
};
---

<style>
  .au-container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .au-expertise-grid { display: flex; flex-wrap: wrap; gap: 10px; }
  .au-articles-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; }
  .au-article-card { background: #fff; padding: 14px 18px; clip-path: polygon(0% 0%,100% 0%,100% calc(100% - 14px),calc(100% - 14px) 100%,0% 100%); box-shadow: 0 2px 8px rgba(0,31,63,0.06); display: flex; flex-direction: column; gap: 6px; text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .au-article-card:hover { box-shadow: 0 8px 24px rgba(0,31,63,0.1); transform: translateY(-2px); }
  .au-hero-btn { display: inline-flex; align-items: center; gap: 8px; background: rgba(0,31,63,0.05); color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 14px; padding: 10px 18px; border-radius: 8px; text-decoration: none; border: 1px solid rgba(0,31,63,0.15); transition: background 0.15s, border-color 0.15s; }
  .au-hero-btn:hover { background: #FEF7E6; border-color: rgba(229,165,36,0.5); }
  .au-expertise-pill { display: inline-flex; align-items: center; gap: 8px; background: #FFFFFF; border: 1px solid rgba(229,165,36,0.3); border-radius: 9999px; padding: 8px 18px; font-family: 'Open Sans', sans-serif; font-weight: 600; font-size: 14px; color: #001F3F; clip-path: polygon(12px 0%,100% 0%,100% 100%,0% 100%,0% 12px); text-decoration: none; transition: background 0.15s, border-color 0.15s; }
  .au-expertise-pill:hover { background: #FEF7E6; border-color: #E5A524; }
  .au-final-btns { display: flex; gap: 24px; justify-content: center; margin-bottom: 80px; flex-wrap: wrap; }
  .au-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 20px; padding: 20px 40px; border-radius: 8px; text-decoration: none; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); transition: background 0.2s; }
  .au-btn-primary:hover { background: #E9C466; }
  .au-btn-secondary { display: inline-flex; align-items: center; gap: 12px; background: rgba(255,255,255,0.1); color: #FFFFFF; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 20px; padding: 20px 40px; border-radius: 8px; text-decoration: none; border: 1px solid rgba(255,255,255,0.2); transition: background 0.2s; }
  .au-btn-secondary:hover { background: rgba(255,255,255,0.22); }
  @media (max-width:1023px) { .au-container { padding: 0 24px; } }
  @media (max-width:767px) {
    .au-container { padding: 0 15px; }
    .au-articles-grid { grid-template-columns: 1fr; }
    .au-final-btns { flex-direction: column; align-items: center; }
    .au-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
  }
</style>

<BaseLayout
  title={`${author.name} — ${author.role} | Assurman`}
  description={`${author.name}, ${author.role}. ${author.bioShort.slice(0, 120)}…`}
  canonical={canonicalPath}
  schema={schemas}
>

<!-- Nav clearance + compacte breadcrumb strip -->
<div style="padding-top:110px;">
  <div style="border-bottom:1px solid rgba(0,31,63,0.1);padding:2px 0;">
    <div class="au-container">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Kenniscentrum', href: '/gids/' },
        ]}
        theme="light"
      />
    </div>
  </div>
</div>

<!-- HERO -->
<section style="background:#FFFFFF;padding-top:48px;padding-bottom:20px;">
  <div class="au-container">
    <div style="display:flex;gap:36px;align-items:center;flex-wrap:wrap;">
      <img
        src={author.photo}
        alt={author.photoAlt}
        style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:4px solid #E5A524;flex-shrink:0;"
      />
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 10px;">Auteur · Expert bouwverzekeringen</p>
        <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,48px);line-height:1.08;letter-spacing:-1px;color:#001F3F;margin:0 0 8px;">{author.name}</h1>
        <p style="font-family:'Open Sans',sans-serif;font-size:18px;color:#3F5767;margin:0 0 20px;max-width:820px;">{author.role}</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a href={author.linkedin} target="_blank" rel="noopener noreferrer" class="au-hero-btn">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
            LinkedIn
          </a>
          <a href={CTA_DESTINATIONS.contact} class="au-hero-btn">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Stel hier een vraag
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BIO -->
<section style="background:#FFFFFF;padding:28px 0 72px;">
  <div class="au-container">
    <div style="max-width:820px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Over {author.name.split(' ')[0]}</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,2.5vw,32px);color:#001F3F;margin:0 0 28px;line-height:1.2;">20+ jaar onafhankelijk verzekeringsmakelaar in de bouw</h2>
      {author.bioLong.split('\n\n').map((paragraph) => (
        <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.75;color:#3F5767;margin:0 0 20px;">{paragraph}</p>
      ))}
    </div>
  </div>
</section>

<!-- EXPERTISES -->
<section style="background:#F7F4EF;padding:64px 0;">
  <div class="au-container">
    <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Expertises</p>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,30px);color:#001F3F;margin:0 0 28px;line-height:1.2;">Gespecialiseerde kennis voor de bouwsector</h2>
    <div class="au-expertise-grid">
      {author.expertises.map((expertise) => (
        <a href={expertiseLinks[expertise] ?? '/verzekeringen/'} class="au-expertise-pill">
          <svg width="13" height="13" fill="none" stroke="#E5A524" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          {expertise}
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ARTICLES -->
{allArticles.length > 0 && (
  <section style="background:#FFFFFF;padding:72px 0;">
    <div class="au-container">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Artikelen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,2.5vw,32px);color:#001F3F;margin:0 0 36px;line-height:1.2;">
        Alle artikelen van {author.name.split(' ')[0]}
      </h2>
      <div class="au-articles-grid">
        {allArticles.map((article) => (
          <a href={article.href} class="au-article-card">
            <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;">{article.category}</span>
            <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;line-height:1.35;color:#001F3F;margin:0;">{article.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CTA -->
<section style="background:#3F5767;padding-top:96px;padding-bottom:0;position:relative;text-align:center;">
  <div class="au-container" style="position:relative;z-index:2;">
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3.5vw,48px);line-height:1.1;color:#FFFFFF;max-width:700px;margin:0 auto 20px;">
      Plan een gratis adviesgesprek met {author.name.split(' ')[0]}
    </h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,2vw,22px);line-height:1.4;color:#CBD5E1;max-width:580px;margin:0 auto 40px;">
      Eerlijk advies op maat van jouw stiel. Geen verrassingen achteraf.
    </p>
    <div class="au-final-btns">
      <a href={CTA_DESTINATIONS.scan} class="au-btn-primary">
        {CTA_SCAN.doIt}
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href={CTA_DESTINATIONS.afspraak} class="au-btn-secondary">
        {CTA_AFSPRAAK.advisory}
      </a>
    </div>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;color:#CBD5E1;margin-bottom:64px;opacity:0.75;">
      Geen verplichting. We helpen je kiezen wat écht nodig is voor jouw stiel.
    </p>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;">
    <polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" />
  </svg>
</section>

</BaseLayout>
