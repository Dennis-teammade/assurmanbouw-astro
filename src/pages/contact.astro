---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandChevron from '../components/BrandChevron.astro';
import { CTA_DESTINATIONS } from '../data/cta-labels';
---

<BaseLayout
  title="Contact — Praat met een bouwverzekeringsexpert"
  description="Bereik Assurman voor persoonlijk advies over verzekeringen voor bouwondernemers in West- en Oost-Vlaanderen."
  canonical="/contact"
>

<style>
  .contact-hero-img {
    position: absolute;
    top: 5%;
    right: -5px;
    height: 90%;
    width: auto;
    max-width: 48%;
    z-index: 1;
    pointer-events: none;
  }
  .contact-hero-text { max-width: 52%; }
  .contact-hero-btns { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .contact-main-grid { display: grid; grid-template-columns: 1fr 1.55fr; gap: 64px; align-items: start; }
  .contact-action-boxes { display: flex; gap: 16px; }

  @media (max-width: 1023px) {
    .contact-hero-img { display: none; }
    .contact-hero-text { max-width: 100% !important; }
    .contact-main-grid { grid-template-columns: 1fr !important; gap: 48px !important; }
    .contact-action-boxes { flex-direction: column !important; }
  }
  @media (max-width: 767px) {
    .contact-hero-btns { flex-direction: column; }
    .contact-hero-btns a { width: 100%; justify-content: center; }
  }
</style>

<!-- SECTIE 1: HERO -->
<section style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:480px;">
  <div class="contact-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-contact-hero.jpg" alt="Assurman bouwverzekeringsadviseur aan de telefoon" />
  </div>
  <div style="max-width:1280px;margin:0 auto;padding:48px 32px 64px;position:relative;z-index:2;">
    <div class="contact-hero-text">
      <p class="brand-section-label" style="margin-bottom:16px;">Contact</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,4.5vw,60px);line-height:1.06;letter-spacing:-1px;color:#001F3F;margin-bottom:20px;">
        We helpen u graag verder
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin-bottom:32px;max-width:480px;">
        Heeft u een vraag, wilt u een offerte of gewoon even overleggen? Vul het formulier in of contacteer ons direct.
      </p>
      <div class="contact-hero-btns">
        <a href="tel:003250361693" class="brand-btn-primary brand-btn-primary--lg">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Bel ons op
        </a>
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-secondary">
          Gratis verzekeringsscan
        </a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- SECTIE 2: MAIN — contactgegevens + formulier -->
<section style="background:#FFFFFF;padding:80px 0 120px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:50%;right:-110px;transform:translateY(-50%);pointer-events:none;z-index:0;">
    <BrandChevron color="#E5A524" height="400px" direction="left" opacity={0.18} />
  </div>
  <div style="max-width:1280px;margin:0 auto;padding:0 32px;position:relative;z-index:1;">
    <div class="contact-main-grid">

      <!-- Linker kolom: contactgegevens -->
      <div>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:28px;color:#001F3F;margin-bottom:16px;">Contactgegevens</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.6;color:#3F5767;margin-bottom:32px;">
          Bel, mail of kom langs. We staan klaar voor al uw vragen over bouwverzekeringen.
        </p>

        {[
          {
            iconPath: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z',
            label: 'TELEFOON',
            value: '050 36 16 93',
            href: 'tel:003250361693',
          },
          {
            iconPath: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6',
            label: 'E-MAIL',
            value: 'info@assurman.be',
            href: 'mailto:info@assurman.be',
          },
          {
            iconPath: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0zM12 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z',
            label: 'ADRES',
            value: 'Sint-Jorisstraat 96\n8730 Beernem',
            href: 'https://maps.google.com/?q=Sint-Jorisstraat+96,+8730+Beernem',
          },
          {
            iconPath: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
            label: 'OPENINGSUREN',
            value: 'Ma – Vr: 9u–12u & 13u–17u\nZa – Zo: gesloten',
            href: null,
          },
        ].map((row, i, arr) => (
          <div style={`display:flex;align-items:flex-start;gap:16px;padding:20px 0;${i < arr.length - 1 ? 'border-bottom:1px solid rgba(0,31,63,0.08);' : ''}`}>
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(229,165,36,0.10);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d={row.iconPath}/>
              </svg>
            </div>
            <div>
              <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1px;color:#E5A524;margin:0 0 4px;text-transform:uppercase;">{row.label}</p>
              {row.href
                ? <a href={row.href} style="font-family:'Outfit',sans-serif;font-weight:600;font-size:16px;color:#001F3F;text-decoration:none;white-space:pre-line;display:block;" target={row.href.startsWith('http') ? '_blank' : undefined} rel={row.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{row.value}</a>
                : <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:16px;color:#001F3F;margin:0;white-space:pre-line;">{row.value}</p>
              }
            </div>
          </div>
        ))}
      </div>

      <!-- Rechter kolom: contactformulier -->
      <div>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:28px;color:#001F3F;margin-bottom:12px;">Stuur ons een bericht</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.6;color:#3F5767;margin-bottom:28px;">
          Wij antwoorden u zo snel mogelijk, normaal gezien binnen de 24u op werkdagen.
        </p>
        <iframe
          src="https://api.teammade.ai/widget/form/e2zc8zxcyRKWB62Qz4M2"
          style="width:100%;height:460px;border:none;display:block;"
          id="inline-e2zc8zxcyRKWB62Qz4M2"
          data-layout="{'id':'INLINE'}"
          data-trigger-type="alwaysShow"
          data-form-name="Contactformulier assurman"
          data-form-id="e2zc8zxcyRKWB62Qz4M2"
          title="Contactformulier assurman"
        ></iframe>
        <script src="https://api.teammade.ai/js/form_embed.js" async></script>
      </div>

    </div>
  </div>
</section>

<!-- SECTIE 3: ACTION BOXES -->
<section style="background:#FFFFFF;padding:60px 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
    <div class="contact-action-boxes">

      <!-- Box 1: Gratis scan (goudgetint) -->
      <div style="flex:1;background:rgba(229,165,36,0.08);border:1px solid rgba(229,165,36,0.25);border-radius:8px;padding:22px;">
        <div style="width:32px;height:32px;background:rgba(229,165,36,0.15);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;">
          <svg width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:16px;color:#001F3F;margin-bottom:8px;">Liever meteen een scan?</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.6;color:#3F5767;margin-bottom:18px;">Doe onze gratis verzekeringsscan in 2 minuten en ontdek waar u staat.</p>
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary" style="font-size:15px;padding:12px 20px;">
          Gratis scan starten
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Box 2: Gesprek (grijsgetint) -->
      <div style="flex:1;background:rgba(0,31,63,0.04);border:1px solid rgba(0,31,63,0.10);border-radius:8px;padding:22px;">
        <div style="width:32px;height:32px;background:rgba(0,31,63,0.08);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;">
          <svg width="16" height="16" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:16px;color:#001F3F;margin-bottom:8px;">Liever een gesprek?</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.6;color:#3F5767;margin-bottom:18px;">Plan een vrijblijvend adviesgesprek en kies zelf een moment dat past.</p>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary" style="font-size:15px;padding:12px 20px;">
          Plan een afspraak 📅
        </a>
      </div>

      <!-- Box 3: Dringende vraag (goudgetint) -->
      <div style="flex:1;background:rgba(229,165,36,0.08);border:1px solid rgba(229,165,36,0.25);border-radius:8px;padding:22px;">
        <div style="width:32px;height:32px;background:rgba(229,165,36,0.15);border-radius:8px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;">
          <svg width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:16px;color:#001F3F;margin-bottom:8px;">Dringende vraag</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.6;color:#3F5767;margin-bottom:18px;">Heb je een probleem of dringende vraag, bel ons dan op en krijg direct een antwoord.</p>
        <a href="tel:003250361693" class="brand-btn-primary" style="font-size:15px;padding:12px 20px;">
          Bel ons op 📞
        </a>
      </div>

    </div>
  </div>
</section>

<!-- SECTIE 4: FINAL CTA -->
<section style="background:#3F5767;padding-top:100px;padding-bottom:0;position:relative;text-align:center;">
  <div style="max-width:800px;margin:0 auto;padding:0 32px;position:relative;z-index:2;">
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,4vw,46px);line-height:1.15;color:#FFFFFF;margin-bottom:20px;">
      Iedere klant is bij ons een VIP
    </h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,2vw,20px);line-height:1.6;color:#CBD5E1;margin-bottom:40px;">
      We gaan steeds tot het uiterste voor al onze klanten. Verzamel al je vragen over verzekeringen en bel ons of maak een afspraak. Wij gaan steeds voor een betere service aan een goedkopere prijs.
    </p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:24px;">
      <a href="tel:003250361693" style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;transition:background 0.2s,transform 0.15s;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        Bel ons op
      </a>
      <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.25);transition:background 0.2s;">
        Maak een afspraak
      </a>
    </div>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;color:#CBD5E1;opacity:0.75;margin-bottom:64px;">
      Geen verplichting. Onze experts helpen u graag verder en geven vrijblijvend advies.
    </p>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;">
    <polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" />
  </svg>
</section>

</BaseLayout>
