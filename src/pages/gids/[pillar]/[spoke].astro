---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScrollProgress from '../../../components/islands/ScrollProgress';
import FaqAccordion from '../../../components/islands/FaqAccordion';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TLDR from '../../../components/TLDR.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import { authors, type AuthorSlug } from '../../../data/authors';
import SpokeCard from '../../../components/SpokeCard.astro';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../../data/cta-labels';
import { SITE_URL } from '../../../data/site';

export async function getStaticPaths() {
  const allSpokes = await getCollection('cluster-posts', ({ data }) => data.status === 'published');
  const allPillars = await getCollection('pillars');

  return allSpokes.map((spoke) => {
    const pillar = allPillars.find((p) => p.slug === spoke.data.parentPillar);
    const siblings = allSpokes
      .filter((s) => s.data.parentPillar === spoke.data.parentPillar)
      .sort((a, b) => {
        const order = pillar?.data.spokes ?? [];
        const ia = order.indexOf(a.slug);
        const ib = order.indexOf(b.slug);
        return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
      });

    const relatedSlugs = spoke.data.relatedSpokes ?? [];
    const fromDefined = relatedSlugs.length
      ? allSpokes.filter((s) => relatedSlugs.includes(s.slug))
      : [];
    const usedSlugs = new Set([spoke.slug, ...fromDefined.map((r) => r.slug)]);
    const fill = siblings
      .filter((s) => !usedSlugs.has(s.slug))
      .slice(0, Math.max(0, 5 - fromDefined.length));
    const related = [...fromDefined, ...fill].slice(0, 5);

    return {
      params: { pillar: spoke.data.parentPillar, spoke: spoke.slug },
      props: { spoke, pillar, siblings, related },
    };
  });
}

const { spoke, pillar, siblings, related } = Astro.props;
const { Content, headings } = await spoke.render();
const h2Headings = headings.filter((h) => h.depth === 2);

const author = authors[spoke.data.author as AuthorSlug];
const faqItems = (spoke.data.faq ?? []).map((item) => ({ title: item.q, content: item.a }));

const siteUrl = SITE_URL;
const canonicalPath = `/gids/${spoke.data.parentPillar}/${spoke.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: spoke.data.title,
  description: spoke.data.metaDescription,
  image: `${siteUrl}${spoke.data.heroImage}`,
  author: {
    '@type': 'Person',
    name: author.name,
    jobTitle: author.role,
    url: `${siteUrl}${author.authorPageUrl}`,
    sameAs: [author.linkedin],
  },
  publisher: { '@type': 'InsuranceAgency', name: 'Assurman', url: siteUrl },
  datePublished: spoke.data.publishDate,
  dateModified: spoke.data.publishDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${canonicalPath}` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Kenniscentrum', item: `${siteUrl}/gids/` },
    { '@type': 'ListItem', position: 3, name: pillar?.data.category ?? spoke.data.category, item: `${siteUrl}/gids/${spoke.data.parentPillar}/` },
    { '@type': 'ListItem', position: 4, name: spoke.data.title, item: `${siteUrl}${canonicalPath}` },
  ],
};

const faqSchema = faqItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (spoke.data.faq ?? []).map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];

---

<style>
  /* ── Twee-koloms layout ───────────────────────── */
  .gs-grid { max-width: 1280px; margin: 0 auto; padding: 56px 32px; display: grid; grid-template-columns: 280px 1fr; gap: 52px; }
  .gs-sidebar { display: flex; flex-direction: column; gap: 14px; }
  .gs-sidebar-block { background: #fff; clip-path: polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%); padding: 20px 22px; box-shadow: 0 2px 8px rgba(0,31,63,0.06); }

  /* ── Inhoudsopgave (details/summary) ─────────── */
  .gs-toc-details summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
  .gs-toc-details summary::-webkit-details-marker { display: none; }
  .gs-toc-chevron { transition: transform 0.2s; flex-shrink: 0; }
  .gs-toc-details[open] .gs-toc-chevron { transform: rotate(180deg); }
  .gs-toc-link { display: block; font-family: 'Open Sans', sans-serif; font-size: 13px; color: #3F5767; text-decoration: none; padding: 5px 0; border-bottom: 1px solid rgba(0,31,63,0.05); line-height: 1.4; }
  .gs-toc-link:last-child { border-bottom: none; }
  .gs-toc-link:hover { color: #E9C466; }

  /* ── Cluster navigatie links ─────────────────── */
  .gs-cluster-link { display: flex; align-items: center; gap: 8px; font-family: 'Open Sans', sans-serif; font-size: 14px; color: #3F5767; text-decoration: none; padding: 7px 0; border-bottom: 1px solid rgba(0,31,63,0.06); line-height: 1.3; }
  .gs-cluster-link:last-child { border-bottom: none; }
  .gs-cluster-link:hover { color: #E9C466; }
  .gs-cluster-link.active { color: #001F3F; font-weight: 700; }

  /* ── Direct regelen links ────────────────────── */
  .gs-direct-link { display: flex; align-items: center; gap: 8px; font-family: 'Open Sans', sans-serif; font-size: 14px; color: #FFFFFF; text-decoration: none; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.1); transition: color 0.15s; }
  .gs-direct-link:last-child { border-bottom: none; }
  .gs-direct-link:hover { color: #E9C466 !important; }

  /* ── Prose ───────────────────────────────────── */
  .gs-main { min-width: 0; }
  .gs-prose :global(h2) { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: clamp(20px,2.5vw,26px); color: #001F3F; margin: 52px 0 16px; line-height: 1.2; letter-spacing: -0.3px; }
  .gs-prose :global(h3) { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: clamp(17px,2vw,21px); color: #001F3F; margin: 32px 0 10px; line-height: 1.3; }
  .gs-prose :global(p) { font-family: 'Open Sans', sans-serif; font-size: 17px; line-height: 1.75; color: #3F5767; margin: 0 0 20px; }
  .gs-prose :global(strong) { color: #001F3F; font-weight: 700; }
  .gs-prose :global(a) { color: #E5A524; text-decoration: underline; text-underline-offset: 2px; }
  .gs-prose :global(a:hover) { color: #001F3F; }
  .gs-prose :global(ul) { padding-left: 24px; margin: 0 0 20px; }
  .gs-prose :global(ol) { padding-left: 24px; margin: 0 0 20px; }
  .gs-prose :global(li) { font-family: 'Open Sans', sans-serif; font-size: 17px; line-height: 1.75; color: #3F5767; margin-bottom: 8px; }
  .gs-prose :global(table) { width: 100%; border-collapse: collapse; margin: 28px 0; font-size: 15px; }
  .gs-prose :global(th) { background: #001F3F; color: #fff; padding: 12px 16px; text-align: left; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 14px; }
  .gs-prose :global(td) { padding: 10px 16px; border-bottom: 1px solid rgba(0,31,63,0.08); font-family: 'Open Sans', sans-serif; color: #3F5767; }
  .gs-prose :global(tr:nth-child(even) td) { background: #F7F4EF; }
  .gs-prose :global(blockquote) { border-left: 4px solid #E5A524; margin: 28px 0; padding: 16px 24px; background: rgba(229,165,36,0.05); font-style: italic; }
  .gs-prose :global(hr) { border: none; border-top: 1px solid rgba(0,31,63,0.1); margin: 48px 0; }

  /* ── Hero image in prose ─────────────────────── */
  .gs-hero-img { width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; display: block; margin-bottom: 36px; clip-path: polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%); }

  /* ── Lees hoofdartikel link ──────────────────── */
  .gs-pillar-link { display: inline-flex; align-items: center; gap: 8px; font-family: 'Open Sans', sans-serif; font-size: 15px; font-weight: 700; color: #E5A524; text-decoration: none; transition: color 0.15s; }
  .gs-pillar-link:hover { color: #001F3F; }

  /* ── Artikelgrid ─────────────────────────────── */
  .gs-cards-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; }
  .gs-pillar-card { background: #3F5767; padding: 28px; clip-path: polygon(28px 0%,100% 0%,100% 100%,0% 100%,0% 28px); box-shadow: 0 2px 8px rgba(0,31,63,0.15); display: flex; flex-direction: column; text-decoration: none; transition: box-shadow 0.2s, transform 0.2s; }
  .gs-pillar-card:hover { box-shadow: 0 10px 28px rgba(0,31,63,0.25); transform: translateY(-3px); }

  /* ── Full-width onder het grid ───────────────── */
  .gs-below { max-width: 1280px; margin: 0 auto; padding: 0 32px 64px; }

  /* ── Final CTA knoppen ───────────────────────── */
  .gs-final-btns { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px; }

  /* ── Mobile-only TOC + Direct regelen (default hidden) ── */
  .gs-mobile-toc    { display: none; }
  .gs-mobile-direct { display: none; }

  /* ── FAQ → Conclusie gap ── */
  .gs-faq-wrap { margin-top: 56px; }
  .gs-conclusion-wrap { margin-top: 56px; padding-top: 40px; border-top: 1px solid rgba(0,31,63,0.1); }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 1023px) {
    .gs-grid    { grid-template-columns: 1fr; padding: 32px 24px; gap: 0; }
    .gs-sidebar { display: none; }
    .gs-below   { padding: 0 24px 48px; }
    .gs-cards-grid { grid-template-columns: repeat(2,1fr); }
    .gs-mobile-toc    { display: block; margin-bottom: 20px; }
    .gs-mobile-direct { display: block; }
    .gs-faq-wrap { margin-top: 32px; }
    .gs-faq-wrap :global(section) { padding-bottom: 0 !important; }
    .gs-conclusion-wrap { margin-top: 24px !important; padding-top: 24px !important; }
  }
  @media (max-width: 639px) {
    .gs-grid  { padding: 32px 15px; }
    .gs-below { padding: 0 15px 40px; }
    .gs-cards-grid { grid-template-columns: 1fr; }
    .gs-final-btns { flex-direction: column; align-items: center; }
    .gs-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
  }
</style>

<BaseLayout
  title={spoke.data.seoTitle}
  description={spoke.data.metaDescription}
  canonical={canonicalPath}
  schema={schemas}
  pagefind={true}
>

<ScrollProgress client:load />

<!-- Nav clearance + compacte breadcrumb strip -->
<div style="padding-top:110px;">
  <div style="border-bottom:1px solid rgba(0,31,63,0.1);padding:2px 0;">
    <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Kenniscentrum', href: '/gids/' },
          { label: pillar?.data.category ?? spoke.data.category, href: `/gids/${spoke.data.parentPillar}/` },
        ]}
        theme="light"
      />
    </div>
  </div>
</div>

<!-- TWEE-KOLOMS GRID: sidebar stopt aan het einde van de conclusie -->
<div class="gs-grid">

  <!-- ── SIDEBAR ─────────────────────────────── -->
  <aside class="gs-sidebar" aria-label="Navigatie">

    <!-- 1. In dit artikel (ToC, standaard gesloten) -->
    {h2Headings.length > 0 && (
      <details class="gs-toc-details gs-sidebar-block" style="padding-top:0;">
        <summary>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;">In dit artikel</span>
          <svg class="gs-toc-chevron" width="14" height="14" fill="none" stroke="#3F5767" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <nav style="margin-top:12px;">
          {h2Headings.map((h) => (
            <a href={`#${h.slug}`} class="gs-toc-link">{h.text}</a>
          ))}
        </nav>
      </details>
    )}

    <!-- 2. X artikelen in deze reeks + Lees volledige gids -->
    <div class="gs-sidebar-block">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 14px;">
        {siblings.length} artikel{siblings.length !== 1 ? 'en' : ''} in deze reeks
      </p>
      {siblings.map((s) => (
        <a
          href={`/gids/${spoke.data.parentPillar}/${s.slug}/`}
          class={`gs-cluster-link${s.slug === spoke.slug ? ' active' : ''}`}
        >
          <svg width="10" height="10" fill={s.slug === spoke.slug ? '#E5A524' : 'none'} stroke={s.slug === spoke.slug ? '#E5A524' : '#CBD5E1'} stroke-width="2.5" stroke-linecap="round" viewBox="0 0 24 24">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
          {s.data.title}
        </a>
      ))}
      <a href={`/gids/${spoke.data.parentPillar}/`} class="gs-cluster-link" style="margin-top:10px;padding-top:12px;border-top:1px solid rgba(0,31,63,0.1);border-bottom:none;color:#E5A524;font-weight:600;">
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Lees het hoofdartikel
      </a>
    </div>

    <!-- 3. Direct regelen (sticky) -->
    <div class="gs-sidebar-block" style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%);position:sticky;top:100px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#E9C466;margin:0 0 14px;">Direct regelen</p>
      <a href="/gratis-verzekeringsscan/" class="gs-direct-link">
        <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        Gratis verzekeringsscan
      </a>
      <a href="/contact/" class="gs-direct-link">
        <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
        Plan adviesgesprek
      </a>
      <a href="/contact/" class="gs-direct-link">
        <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Stel een vraag
      </a>
    </div>

  </aside>

  <!-- ── MAIN CONTENT (incl. FAQ + Conclusie) ── -->
  <main class="gs-main">

    <!-- Header + auteur meta -->
    <div style="margin-bottom:32px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">{spoke.data.category}</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(26px,3.5vw,42px);line-height:1.1;letter-spacing:-0.8px;color:#001F3F;margin:0 0 20px;">{spoke.data.title}</h1>
      <AuthorByline author={author} variant="compact" publishDate={spoke.data.publishDate} readingTime={spoke.data.readingTime} />
    </div>

    <!-- TL;DR boven afbeelding -->
    <TLDR text={spoke.data.tldr} />

    <!-- Mobile: TOC accordion (verborgen op desktop) -->
    {h2Headings.length > 0 && (
      <details class="gs-toc-details gs-mobile-toc" style="background:#fff;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 16px),calc(100% - 16px) 100%,0% 100%);padding:14px 18px;box-shadow:0 2px 8px rgba(0,31,63,0.06);">
        <summary>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;">In dit artikel</span>
          <svg class="gs-toc-chevron" width="14" height="14" fill="none" stroke="#3F5767" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <nav style="margin-top:10px;">
          {h2Headings.map((h) => (
            <a href={`#${h.slug}`} class="gs-toc-link">{h.text}</a>
          ))}
        </nav>
      </details>
    )}

    <!-- Body — afbeelding staat bovenaan, JS verplaatst hem na de eerste alinea -->
    <div class="gs-prose" data-pagefind-body>
      <span style="display:none;" data-pagefind-filter="type">Artikel</span>
      <span style="display:none;" data-pagefind-filter="categorie">{spoke.data.category}</span>
      <img src={spoke.data.heroImage} alt={spoke.data.heroImageAlt} class="gs-hero-img" />
      <Content />
    </div>

    <!-- Mid-content image (optioneel) -->
    {spoke.data.midContentImage && (
      <img
        src={spoke.data.midContentImage}
        alt={spoke.data.midContentImageAlt ?? ''}
        style="width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;display:block;margin:48px 0;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);"
      />
    )}

    <!-- FAQ boven de conclusie -->
    {faqItems.length > 0 && (
      <div class="gs-faq-wrap">
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 14px;">Veelgestelde vragen</p>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,2.5vw,30px);color:#001F3F;margin:0 0 32px;line-height:1.15;">Antwoorden op de meest gestelde vragen</h2>
        <FaqAccordion client:visible items={faqItems} hideHeader={true} />
      </div>
    )}

    <!-- Conclusie -->
    {spoke.data.conclusion && (
      <div class="gs-conclusion-wrap">
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,26px);color:#001F3F;margin:0 0 20px;line-height:1.2;">Conclusie</h2>
        {spoke.data.conclusion.split('\n\n').map((para: string) => (
          <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.75;color:#3F5767;margin:0 0 20px;">{para}</p>
        ))}
      </div>
    )}

    <!-- Mobile: Direct regelen CTA (verborgen op desktop) -->
    <div class="gs-mobile-direct" style="margin-top:32px;">
      <div style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%);padding:20px 22px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#E9C466;margin:0 0 14px;">Direct regelen</p>
        <a href="/gratis-verzekeringsscan/" class="gs-direct-link">
          <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          Gratis verzekeringsscan
        </a>
        <a href="/maak-afspraak" class="gs-direct-link">
          <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
          Plan adviesgesprek
        </a>
        <a href="/contact/" class="gs-direct-link">
          <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          Stel een vraag
        </a>
      </div>
    </div>

    <!-- Lees het hoofdartikel (onder conclusie) -->
    {pillar && (
      <div style="margin-top:40px;padding-top:28px;border-top:1px solid rgba(0,31,63,0.1);">
        <a href={`/gids/${spoke.data.parentPillar}/`} class="gs-pillar-link">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Lees het hoofdartikel: {pillar.data.title}
        </a>
      </div>
    )}

  </main>
</div>

<!-- Author byline -->
<div class="gs-below">
  <AuthorByline author={author} variant="full" />
</div>

<!-- Bijkomende bronnen grid -->
{(related.length > 0 || pillar) && (
  <section id="bronnen" style="background:#F7F4EF;padding:80px 0;">
    <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
      <div style="text-align:center;margin-bottom:52px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Bijkomende bronnen</p>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,40px);line-height:1.1;color:#001F3F;margin:0 auto;max-width:560px;">Meer relevante onderwerpen</h2>
      </div>
      <div class="gs-cards-grid">

        {related.map((r) => (
          <SpokeCard
            href={`/gids/${r.data.parentPillar}/${r.slug}/`}
            title={r.data.title}
            tileTitle={r.data.tileTitle}
            tldr={r.data.tldr}
          />
        ))}

        {pillar && (
          <a href={`/gids/${spoke.data.parentPillar}/`} class="gs-pillar-card">
            <div style="background:rgba(255,255,255,0.15);border-radius:8px;padding:12px;display:inline-flex;align-self:flex-start;margin-bottom:16px;">
              <svg width="28" height="28" fill="none" stroke="#E9C466" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="8" y1="13" x2="16" y2="13"/>
                <line x1="8" y1="17" x2="12" y2="17"/>
              </svg>
            </div>
            <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;line-height:1.3;color:#FFFFFF;margin:0 0 8px;">{pillar.data.hubTitle ?? pillar.data.title}</h3>
            <div style="width:32px;height:3px;background:#E9C466;margin-bottom:12px;"></div>
            <p style="font-family:'Open Sans',sans-serif;font-size:14px;line-height:1.6;color:rgba(255,255,255,0.8);margin:0;flex:1;">{pillar.data.metaDescription}</p>
            <div style="display:inline-flex;align-items:center;gap:6px;font-family:'Open Sans',sans-serif;font-weight:700;font-size:14px;color:#E9C466;margin-top:16px;">
              Lees de complete gids
              <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </div>
          </a>
        )}

      </div>
    </div>
  </section>
)}

<!-- Werkwijze-stijl finale CTA -->
<section style="background:#3F5767;padding:100px 0 0;text-align:center;position:relative;overflow:hidden;">
  <div style="max-width:740px;margin:0 auto;padding:0 32px;position:relative;z-index:1;">
    <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:16px;">Vrijblijvend starten</p>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,4vw,50px);line-height:1.1;letter-spacing:-0.8px;color:#FFFFFF;margin:0 0 20px;">
      Klaar om te starten?
    </h2>
    <p style="font-family:'Outfit',sans-serif;font-size:18px;line-height:1.65;color:#CBD5E1;max-width:560px;margin:0 auto 48px;">
      Doe de gratis scan in 2 minuten, of plan een adviesgesprek als je eerst wil praten. Beide routes zijn vrijblijvend.
    </p>
    <div class="gs-final-btns">
      <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        Start je gratis scan (2 min)
      </a>
      <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.2);">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
        Plan adviesgesprek
      </a>
    </div>
    <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:#CBD5E1;opacity:0.75;margin-bottom:80px;">
      Geen verplichting. We helpen je kiezen wat écht nodig is voor jouw stiel.
    </p>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;">
    <polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" />
  </svg>
</section>

</BaseLayout>

<script>
  // Verplaats hero-afbeelding na de eerste alinea in de prose
  const heroImg = document.querySelector<HTMLElement>('.gs-hero-img');
  const firstP  = document.querySelector('.gs-prose p');
  if (heroImg && firstP) {
    firstP.insertAdjacentElement('afterend', heroImg);
  }
</script>
