<script>
  // Verplaats hero-afbeelding naar net boven de eerste H2 in de prose
  const featImg = document.querySelector<HTMLImageElement>('.gp-feat-img');
  const firstH2 = document.querySelector('.gp-prose h2');
  if (featImg && firstH2) {
    firstH2.insertAdjacentElement('beforebegin', featImg);
  }

  // Injecteer FAQ accordion na de FAQ h2 in de prose; verberg plain FAQ-tekst
  const inlineFaq = document.getElementById('gp-faq-inline');
  const proseDiv = document.querySelector<HTMLElement>('.gp-prose');
  if (inlineFaq && proseDiv) {
    const proseH2s = Array.from(proseDiv.querySelectorAll<HTMLElement>('h2'));
    const faqH2 = proseH2s.find(h =>
      h.textContent?.toLowerCase().includes('veelgesteld') ||
      (h.id && h.id.toLowerCase().includes('veelgesteld'))
    );
    if (faqH2) {
      // Verberg plain FAQ-inhoud (h3 + p tussen FAQ h2 en volgende h2)
      let el = faqH2.nextElementSibling as HTMLElement | null;
      while (el && el.tagName !== 'H2') {
        el.style.display = 'none';
        el = el.nextElementSibling as HTMLElement | null;
      }
      // Verplaats en toon de accordion
      faqH2.insertAdjacentElement('afterend', inlineFaq);
      inlineFaq.style.removeProperty('display');
    }
  }

  // Wissel sidebar box op basis van H2-positie (groepen van 3, altijd eindigen op scan)
  const h2els = Array.from(document.querySelectorAll<HTMLElement>('.gp-prose h2'));
  const authorBox = document.querySelector<HTMLElement>('.gp-sidebar-author');
  const scanBox   = document.querySelector<HTMLElement>('.gp-sidebar-scan');

  if (window.innerWidth >= 1024 && h2els.length && authorBox && scanBox) {
    const n = h2els.length;
    const getBox = (i: number): 'author' | 'scan' => {
      if (i === n - 1) return 'scan';
      return Math.floor(i / 3) % 2 === 0 ? 'author' : 'scan';
    };

    // Initialiseer via inline styles — overschrijft CSS-specificiteit conflict
    authorBox.style.display = 'flex';
    authorBox.style.opacity = '1';
    scanBox.style.display   = 'none';
    scanBox.style.opacity   = '1';

    let current: 'author' | 'scan' = 'author';
    let busy = false;

    const setBox = (box: 'author' | 'scan') => {
      if (box === current || busy) return;
      busy = true;
      current = box;
      const hide = box === 'author' ? scanBox   : authorBox;
      const show = box === 'author' ? authorBox : scanBox;
      // Fade out
      hide.style.opacity = '0';
      setTimeout(() => {
        hide.style.display  = 'none';
        show.style.opacity  = '0';
        show.style.display  = 'flex';
        void show.offsetHeight;        // force reflow zodat transitie triggert
        show.style.opacity  = '1';
        setTimeout(() => { busy = false; }, 320);
      }, 300);
    };

    const update = () => {
      const threshold = window.innerHeight * 0.45;
      let active = -1;
      for (let i = 0; i < n; i++) {
        if (h2els[i].getBoundingClientRect().top < threshold) active = i;
      }
      setBox(active >= 0 ? getBox(active) : 'author');
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Mobile tab system: Op deze pagina / Bijkomende bronnen
  const tabTocBtn = document.getElementById('gp-tab-toc');
  const tabBronnenBtn = document.getElementById('gp-tab-bronnen');
  const panelToc = document.getElementById('gp-panel-toc');
  const panelBronnen = document.getElementById('gp-panel-bronnen');

  if (tabTocBtn && tabBronnenBtn && panelToc && panelBronnen) {
    let activeTab: string | null = null;

    const toggleTab = (tab: string, btn: HTMLElement, panel: HTMLElement) => {
      const opening = activeTab !== tab;
      tabTocBtn.classList.remove('is-active');
      tabBronnenBtn.classList.remove('is-active');
      panelToc.classList.remove('is-open');
      panelBronnen.classList.remove('is-open');
      activeTab = null;
      if (opening) {
        btn.classList.add('is-active');
        panel.classList.add('is-open');
        activeTab = tab;
      }
    };

    tabTocBtn.addEventListener('click', () => toggleTab('toc', tabTocBtn, panelToc));
    tabBronnenBtn.addEventListener('click', () => toggleTab('bronnen', tabBronnenBtn, panelBronnen));
  }

  // Scrollspy: markeer actieve H2 in sidebar mini-ToC
  const links = document.querySelectorAll<HTMLAnchorElement>('.gp-stoc-list a');
  if (links.length) {
    const headingEls = Array.from(links).map((a) => {
      const id = a.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    });
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            links.forEach((a) => {
              a.classList.toggle('is-active', a.getAttribute('href') === `#${id}`);
            });
          }
        });
      },
      { rootMargin: '-10% 0px -80% 0px', threshold: 0 }
    );
    headingEls.forEach((el) => el && observer.observe(el));
  }
</script>
