---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ScrollProgress from '../../../components/islands/ScrollProgress';
import FaqAccordion from '../../../components/islands/FaqAccordion';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import TLDR from '../../../components/TLDR.astro';
import AuthorByline from '../../../components/AuthorByline.astro';
import BrandChevron from '../../../components/BrandChevron.astro';
import SpokeCard from '../../../components/SpokeCard.astro';
import { authors, type AuthorSlug } from '../../../data/authors';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../../data/cta-labels';
import { SITE_URL } from '../../../data/site';

export async function getStaticPaths() {
  const pillars = await getCollection('pillars', ({ data }) => data.status === 'published');
  const allSpokes = await getCollection('cluster-posts', ({ data }) => data.status === 'published');

  return pillars.map((pillar) => {
    const spokes = allSpokes
      .filter((s) => s.data.parentPillar === pillar.slug)
      .sort((a, b) => {
        const ia = pillar.data.spokes.indexOf(a.slug);
        const ib = pillar.data.spokes.indexOf(b.slug);
        return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
      });
    return {
      params: { pillar: pillar.slug },
      props: { pillar, spokes },
    };
  });
}

const { pillar, spokes } = Astro.props;
const { Content, headings } = await pillar.render();

const author = authors[pillar.data.author as AuthorSlug];
const h2s = headings.filter((h) => h.depth === 2);
const faqItems = (pillar.data.faq ?? []).map((item) => ({ title: item.q, content: item.a }));

const formattedDate = pillar.data.publishDate
  ? new Date(pillar.data.publishDate).toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;

const siteUrl = SITE_URL;
const canonicalPath = `/gids/${pillar.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: pillar.data.title,
  description: pillar.data.metaDescription,
  image: `${siteUrl}${pillar.data.heroImage}`,
  author: {
    '@type': 'Person',
    name: author.name,
    jobTitle: author.role,
    url: `${siteUrl}${author.authorPageUrl}`,
    sameAs: [author.linkedin],
  },
  publisher: { '@type': 'InsuranceAgency', name: 'Assurman', url: siteUrl },
  datePublished: pillar.data.publishDate,
  dateModified: pillar.data.publishDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${canonicalPath}` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Kenniscentrum', item: `${siteUrl}/gids/` },
    { '@type': 'ListItem', position: 3, name: pillar.data.title, item: `${siteUrl}${canonicalPath}` },
  ],
};

const faqSchema = faqItems.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (pillar.data.faq ?? []).map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
} : null;

const itemListSchema = spokes.length ? {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Artikelen in: ${pillar.data.title}`,
  itemListElement: spokes.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.data.title,
    url: `${siteUrl}/gids/${pillar.slug}/${s.slug}/`,
  })),
} : null;

const schemas = [articleSchema, breadcrumbSchema, ...(itemListSchema ? [itemListSchema] : []), ...(faqSchema ? [faqSchema] : [])];
---

<style>
  /* ── Container ── */
  .gp-container { max-width:1280px; margin:0 auto; padding:0 32px; }

  /* ── Hero ── */
  .gp-hero-img { position:absolute; top:0; right:0; height:100%; width:40%; z-index:1; pointer-events:none; }
  .gp-hero-content { max-width:50%; }
  /* ── Sectie 1: intro-grid (content links | bronnen rechts) ── */
  .gp-intro-grid { display:grid; grid-template-columns:1fr 320px; gap:48px; align-items:start; }

  /* TOC in sectie 1 */
  .gp-toc-wrap { padding:22px 0 0; }
  .gp-toc-label { font-family:'Outfit',sans-serif; font-weight:700; font-size:15px; letter-spacing:1.4px; text-transform:uppercase; color:#E5A524; margin:0 0 14px; }
  .gp-toc-list { list-style:none; padding:0; margin:0; columns:2; column-gap:24px; column-rule:1px solid rgba(0,31,63,0.1); }
  .gp-toc-list li { display:block; margin-bottom:6px; break-inside:avoid; }
  .gp-toc-arrow { color:#E5A524; font-size:13px; flex-shrink:0; line-height:1; }
  .gp-toc-link { font-family:'Open Sans',sans-serif; font-size:15px; line-height:1.45; color:#3F5767; text-decoration:none; }
  .gp-toc-link:hover { color:#E5A524; text-decoration:underline; }

  /* Direct regelen block */
  .gp-direct-block { background:#3F5767; padding:18px 22px; clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%); }
  .gp-direct-link { display:flex; align-items:center; gap:8px; font-family:'Open Sans',sans-serif; font-size:14px; color:#FFFFFF; text-decoration:none; padding:8px 0; border-bottom:1px solid rgba(255,255,255,0.1); transition:color 0.15s; }
  .gp-direct-link:last-child { border-bottom:none; }
  .gp-direct-link:hover { color:#E9C466; }

  /* Bronnen kolom (rechts sectie 1) */
  .gp-bronnen-col { background:#FFFFFF; padding:6px 28px 24px; clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%); box-shadow:0 2px 8px rgba(0,31,63,0.05); }
  .gp-bronnen-label { font-family:'Outfit',sans-serif; font-weight:700; font-size:11px; letter-spacing:1.4px; text-transform:uppercase; color:#E5A524; margin:0 0 14px; }
  .gp-bronnen-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:6px; }
  .gp-bronnen-list li { display:flex; gap:7px; align-items:baseline; }
  .gp-bronnen-link { font-family:'Open Sans',sans-serif; font-size:13px; line-height:1.45; color:#3F5767; text-decoration:none; }
  .gp-bronnen-link:hover { color:#E5A524; text-decoration:underline; }

  /* ── Sectie 2: body-grid (sidebar links | content rechts) ── */
  .gp-body-grid { display:grid; grid-template-columns:220px 1fr; gap:48px; align-items:start; }

  /* ── Sidebar ── */
  .gp-sidebar { position:sticky; top:96px; display:flex; flex-direction:column; }
  .gp-sidebar-author, .gp-sidebar-scan { transition:opacity 0.3s ease; }
  .gp-sidebar-scan { display:none; }

  .gp-stoc-list { margin:12px 0 0; padding:0; list-style:none; display:flex; flex-direction:column; gap:2px; }
  .gp-stoc-list a { font-family:'Open Sans',sans-serif; font-size:13px; line-height:1.4; color:#3F5767; text-decoration:none; display:block; padding:5px 0 5px 10px; border-left:2px solid transparent; transition:color 0.15s,border-color 0.15s; }
  .gp-stoc-list a:hover, .gp-stoc-list a.is-active { color:#E5A524; border-left-color:#E5A524; }

  /* Author box */
  .gp-help { background:#E9C466; padding:20px; clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 16px),calc(100% - 16px) 100%,0% 100%); display:flex; flex-direction:column; min-height:300px; }
  .gp-help-btn-primary { display:block; width:100%; text-align:center; font-family:'Open Sans',sans-serif; font-weight:700; font-size:13px; padding:12px 16px; border-radius:6px; text-decoration:none; box-sizing:border-box; background:#3F5767; color:#FFFFFF; transition:background 0.2s; margin-bottom:8px; }
  .gp-help-btn-primary:hover { background:#2d3f4f; }
  .gp-help-btn-secondary { display:block; width:100%; text-align:center; font-family:'Open Sans',sans-serif; font-weight:700; font-size:13px; padding:12px 16px; border-radius:6px; text-decoration:none; box-sizing:border-box; background:transparent; color:#3F5767; border:1.5px solid #3F5767; transition:background 0.2s; }
  .gp-help-btn-secondary:hover { background:rgba(63,87,103,0.1); }

  /* Scan CTA box */
  .gp-scan-cta { background:#3F5767; padding:20px; clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 16px),calc(100% - 16px) 100%,0% 100%); display:flex; flex-direction:column; min-height:300px; }
  .gp-scan-cta-btn { display:flex; align-items:center; justify-content:center; gap:8px; background:#E9C466; color:#001F3F; font-family:'Open Sans',sans-serif; font-weight:700; font-size:13px; padding:12px 16px; border-radius:6px; text-decoration:none; transition:background 0.2s; }
  .gp-scan-cta-btn:hover { background:#f0ca5a; }

  /* ── Main prose ── */
  .gp-main { min-width:0; }
  .gp-prose :global(h2) { font-family:'Outfit',sans-serif; font-weight:800; font-size:clamp(20px,2.5vw,28px); color:#001F3F; margin:52px 0 16px; line-height:1.2; letter-spacing:-0.3px; }
  .gp-prose :global(h3) { font-family:'Outfit',sans-serif; font-weight:700; font-size:clamp(17px,2vw,22px); color:#001F3F; margin:32px 0 10px; line-height:1.3; }
  .gp-prose :global(p) { font-family:'Open Sans',sans-serif; font-size:17px; line-height:1.75; color:#3F5767; margin:0 0 20px; }
  .gp-prose :global(strong) { color:#001F3F; font-weight:700; }
  .gp-prose :global(em) { font-style:italic; }
  .gp-prose :global(a) { color:#E5A524; text-decoration:underline; text-underline-offset:2px; }
  .gp-prose :global(a:hover) { color:#001F3F; }
  .gp-prose :global(ul) { padding-left:24px; margin:0 0 20px; }
  .gp-prose :global(ol) { padding-left:24px; margin:0 0 20px; }
  .gp-prose :global(li) { font-family:'Open Sans',sans-serif; font-size:17px; line-height:1.75; color:#3F5767; margin-bottom:8px; }
  .gp-prose :global(table) { width:100%; border-collapse:collapse; margin:28px 0; font-size:15px; }
  .gp-prose :global(th) { background:#001F3F; color:#fff; padding:12px 16px; text-align:left; font-family:'Outfit',sans-serif; font-weight:700; font-size:14px; }
  .gp-prose :global(td) { padding:10px 16px; border-bottom:1px solid rgba(0,31,63,0.08); font-family:'Open Sans',sans-serif; color:#3F5767; }
  .gp-prose :global(tr:nth-child(even) td) { background:#F7F4EF; }
  .gp-prose :global(blockquote) { border-left:4px solid #E5A524; margin:28px 0; padding:16px 24px; background:rgba(229,165,36,0.05); font-style:italic; }
  .gp-prose :global(hr) { border:none; border-top:1px solid rgba(0,31,63,0.1); margin:48px 0; }

  /* ── Featured image (mid-content) ── */
  .gp-feat-img { width:100%; aspect-ratio:16/9; object-fit:cover; clip-path:polygon(28px 0%,100% 0%,100% 100%,0% 100%,0% 28px); display:block; margin-bottom:40px; }

  /* ── Inline author card ── */
  .gp-author-card { background:#F7F4EF; padding:28px 32px; clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%); margin-top:52px; }
  .gp-author-card-links { display:flex; flex-wrap:wrap; gap:10px; margin-top:20px; }
  .gp-author-card-link { display:inline-flex; align-items:center; gap:6px; font-family:'Open Sans',sans-serif; font-weight:700; font-size:14px; color:#001F3F; text-decoration:none; padding:9px 16px; border-radius:6px; border:1px solid rgba(0,31,63,0.15); transition:background 0.15s,border-color 0.15s; }
  .gp-author-card-link:hover { background:#FEF7E6; border-color:rgba(229,165,36,0.45); }
  .gp-author-card-link--primary { background:#3F5767; color:#FFFFFF; border-color:#3F5767; }
  .gp-author-card-link--primary:hover { background:#001F3F; border-color:#001F3F; }

  /* ── Spoke grid ── */
  .gp-spokes-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }

  /* ── Mid-CTA button hovers ── */
  .gp-midcta-primary { transition:background 0.2s; }
  .gp-midcta-primary:hover { background:#001F3F !important; }
  .gp-midcta-secondary { transition:background 0.2s; }
  .gp-midcta-secondary:hover { background:rgba(0,31,63,0.08) !important; }

  /* ── Mobile help block (hidden on desktop, shown on tablet/mobile) ── */
  .gp-mobile-help { display:none; }

  /* ── Mobile tab system (TOC + Bijkomende bronnen, verborgen op desktop) ── */
  .gp-mobile-tabs { display:none; margin-top:16px; }
  .gp-tab-bar { display:flex; border-bottom:2px solid rgba(0,31,63,0.1); }
  .gp-tab-btn { flex:1; padding:11px 8px; font-family:'Open Sans',sans-serif; font-weight:700; font-size:14px; color:#3F5767; background:none; border:none; border-bottom:3px solid transparent; margin-bottom:-2px; cursor:pointer; transition:color 0.2s,border-color 0.2s; text-align:center; }
  .gp-tab-btn.is-active { color:#E5A524; border-bottom-color:#E5A524; }
  .gp-tab-panel { overflow:hidden; max-height:0; transition:max-height 0.3s ease; }
  .gp-tab-panel.is-open { max-height:800px; }
  .gp-tab-panel-inner { padding:16px 0 4px; }

  /* ── Final CTA knoppen ── */
  .gp-final-btns { display:flex; gap:20px; justify-content:center; flex-wrap:wrap; margin-bottom:24px; }

  /* ── Responsive ── */
  /* ── Tab panel bronnen: zelfde grootte/padding als TOC-items ── */
  .gp-tab-panel-inner .gp-bronnen-link { font-size:15px; line-height:1.45; }
  .gp-tab-panel-inner .gp-bronnen-list li { margin-bottom:6px; }

  @media (max-width:1023px) {
    .gp-container { padding:0 24px; }
    .gp-hero-img { display:none; }
    .gp-hero-section { min-height:auto !important; }
    .gp-hero-content { max-width:100% !important; }
    .gp-hero-inner { padding-bottom:32px !important; }
    .gp-intro-grid { grid-template-columns:1fr; }
    .gp-section-divider { display:none; }
    .gp-toc-wrap { display:none; }
    .gp-direct-block { display:none; }
    .gp-bronnen-col { display:none; }
    .gp-mobile-tabs { display:block; }
    .gp-spokes-grid { grid-template-columns:repeat(2,1fr); }
    .gp-body-grid { grid-template-columns:1fr; gap:0; }
    .gp-sidebar { display:none; }
    .gp-cta-mask-img { height:60% !important; opacity:0.15 !important; }
  }
  @media (max-width:767px) {
    .gp-container { padding:0 15px; }
    .gp-spokes-grid { grid-template-columns:1fr; }
    .gp-final-btns { flex-direction:column; align-items:center; }
    .gp-final-btns a { width:100%; max-width:400px; justify-content:center; }
  }
</style>

<BaseLayout
  title={pillar.data.seoTitle}
  description={pillar.data.metaDescription}
  canonical={canonicalPath}
  schema={schemas}
  pagefind={true}
>

<ScrollProgress client:load />

<!-- Compacte breadcrumb strip — nav-clearance zit nu centraal op <main> (global.css) -->
<div style="padding-top:16px;">
  <div style="border-bottom:1px solid rgba(0,31,63,0.1);padding:2px 0;">
    <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Kenniscentrum', href: '/gids/' },
        ]}
        theme="light"
      />
    </div>
  </div>
</div>

<!-- ═══ 1. HERO ═══ -->
<section class="gp-hero-section" style="background:#FFFFFF;padding-top:0;position:relative;overflow:hidden;min-height:540px;">
  <div class="gp-hero-img assurman-mask assurman-mask--hero">
    <img src={pillar.data.heroImage} alt={pillar.data.title} />
  </div>
  <div class="gp-hero-inner" style="max-width:1280px;margin:0 auto;padding:100px 32px 64px;position:relative;z-index:2;">
    <div class="gp-hero-content">

      <!-- Section-label -->
      <p class="brand-section-label" style="margin-bottom:16px;">{pillar.data.category.toUpperCase()} · HOOFDARTIKEL</p>

      <!-- H1 (zelfde stijl als contact.astro) -->
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,4.5vw,60px);line-height:1.06;letter-spacing:-1px;color:#001F3F;margin-bottom:16px;">{pillar.data.title}</h1>

      <!-- Auteur-byline (lichte achtergrond) -->
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:28px;">
        <img src={author.photo} alt={author.photoAlt} style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid #E5A524;" />
        <span style="font-family:'Open Sans',sans-serif;font-size:13px;color:#3F5767;">
          <strong style="color:#001F3F;">{author.name}</strong>
          {pillar.data.readingTime && <span>&nbsp;·&nbsp;{pillar.data.readingTime} min leestijd</span>}
          {formattedDate && <span>&nbsp;·&nbsp;{formattedDate}</span>}
        </span>
      </div>

      <!-- Meta-omschrijving als intro -->
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.6;color:#3F5767;max-width:560px;">
        {pillar.data.metaDescription}
      </p>

    </div>
  </div>
</section>

<!-- ═══ SECTIE 1: TLDR + TOC (links) | BRONNEN (rechts) ═══ -->
<section style="background:#FFFFFF;padding:16px 0 40px;">
  <div class="gp-container">
    <div class="gp-intro-grid">

      <!-- Links: Het korte antwoord + Op deze pagina -->
      <div>
        <TLDR text={pillar.data.tldr} margin="0 0 28px" />

        <div class="gp-toc-wrap">
          <p class="gp-toc-label">Op deze pagina</p>
          {h2s.length > 0 ? (
            <ul class="gp-toc-list">
              {h2s.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="gp-toc-link">{h.text}</a>
                </li>
              ))}
            </ul>
          ) : null}
        </div>

        <!-- Mobile: TOC + Bijkomende bronnen als tabs (verborgen op desktop) -->
        <div class="gp-mobile-tabs" id="gp-mobile-tabs">
          <div class="gp-tab-bar">
            <button class="gp-tab-btn" id="gp-tab-toc" type="button">Op deze pagina</button>
            <button class="gp-tab-btn" id="gp-tab-bronnen" type="button">Bijkomende bronnen</button>
          </div>
          <div class="gp-tab-panel" id="gp-panel-toc">
            <div class="gp-tab-panel-inner">
              {h2s.length > 0 && (
                <ul class="gp-toc-list" style="columns:1;column-rule:none;">
                  {h2s.map((h) => (
                    <li><a href={`#${h.slug}`} class="gp-toc-link">{h.text}</a></li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          <div class="gp-tab-panel" id="gp-panel-bronnen">
            <div class="gp-tab-panel-inner">
              {spokes.length > 0 && (
                <ul class="gp-bronnen-list">
                  {spokes.map((s) => (
                    <li>
                      <span class="gp-toc-arrow">→</span>
                      <a href={`/gids/${pillar.slug}/${s.slug}/`} class="gp-bronnen-link">
                        {s.data.tileTitle ?? s.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      </div>

      <!-- Rechts: Direct regelen + Bijkomende bronnen -->
      <div style="display:flex;flex-direction:column;gap:20px;">

        <!-- Direct regelen -->
        <div class="gp-direct-block">
          <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.4px;text-transform:uppercase;color:#E9C466;margin:0 0 14px;">Direct regelen</p>
          <a href={CTA_DESTINATIONS.scan} class="gp-direct-link">
            <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            Gratis verzekeringsscan
          </a>
          <a href={CTA_DESTINATIONS.afspraak} class="gp-direct-link">
            <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
            Plan adviesgesprek
          </a>
          <a href={CTA_DESTINATIONS.contact} class="gp-direct-link">
            <svg width="12" height="12" fill="none" stroke="#E9C466" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            Stel een vraag
          </a>
        </div>

        <!-- Bijkomende bronnen -->
        <div class="gp-bronnen-col">
          <p class="gp-bronnen-label">Bijkomende bronnen</p>
          {spokes.length > 0 && (
            <ul class="gp-bronnen-list">
              {spokes.map((s) => (
                <li>
                  <span class="gp-toc-arrow">→</span>
                  <a href={`/gids/${pillar.slug}/${s.slug}/`} class="gp-bronnen-link">
                    {s.data.tileTitle ?? s.data.title}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Scheidingslijn op content-breedte -->
<div class="gp-container gp-section-divider"><div style="border-bottom:1px solid rgba(0,31,63,0.1);"></div></div>

<!-- ═══ SECTIE 2: SIDEBAR (links) | CONTENT (rechts) ═══ -->
<section style="background:#FFFFFF;padding:40px 0 88px;">
  <div class="gp-container">
    <div class="gp-body-grid">

      <!-- ── Sidebar (desktop only) ── -->
      <aside class="gp-sidebar">

        <!-- Blok 1: Hulp nodig? (author) -->
        <div class="gp-help gp-sidebar-author">
