---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchBar from '../../components/islands/SearchBar';
import CTABlock from '../../components/CTABlock.astro';

const pillars = (await getCollection('pillars', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.pillarId.localeCompare(b.data.pillarId));

const allSpokes = await getCollection('cluster-posts', ({ data }) => data.status === 'published');

const pillarData = pillars.map((pillar) => ({
  pillar,
  spokes: allSpokes
    .filter((s) => s.data.parentPillar === pillar.slug)
    .sort((a, b) => {
      const ia = pillar.data.spokes.indexOf(a.slug);
      const ib = pillar.data.spokes.indexOf(b.slug);
      return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
    }),
}));

// Kleur + SVG per pillar — niet in frontmatter om schema-wijzigingen te vermijden
const PILLAR_META: Record<string, { bg: string; svg: string }> = {
  P1: { bg: '#3F5767', svg: '/images/gids/bouwverzekeringen-gids2026.svg' },
  P2: { bg: '#2874FC', svg: '/images/gids/verzekeringen-bouw-maatwerk.svg' },
  P3: { bg: '#C73E1D', svg: '/images/gids/schadegevallen-bouw.svg' },
  P4: { bg: '#E5A524', svg: '/images/gids/premies-bouwbedrijf-2026.svg' },
  P5: { bg: '#512DA8', svg: '/images/gids/verzekeringsfouten-bouw-assurman.svg' },
};

const siteUrl = 'https://www.assurman.be';

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Kenniscentrum bouwverzekeringen — Assurman',
  description: 'Gidsen en artikelen over verzekeringen voor bouwbedrijven, aannemers en zelfstandigen in Vlaanderen.',
  url: `${siteUrl}/gids/`,
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Gidsen in het kenniscentrum bouwverzekeringen',
  itemListElement: pillars.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.data.title,
    url: `${siteUrl}/gids/${p.slug}/`,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Kenniscentrum', item: `${siteUrl}/gids/` },
  ],
};

const schemas = [collectionPageSchema, itemListSchema, breadcrumbSchema];
---

<style>
  /* ── Container ─────────────────────────────────────── */
  .hub-wrap { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

  /* ── Hero ──────────────────────────────────────────── */
  .hub-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .hub-hero-img { width: 100%; height: auto; max-width: 520px; display: block; }

  /* ── Badge pill (identiek aan dakwerkers) ──────────── */
  .hub-badge-pill { display: inline-flex; align-items: center; gap: 8px; background: #F5F2FF; border: 1px solid rgba(213,196,174,0.2); border-radius: 9999px; padding: 6px 16px; font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 1.2px; text-transform: uppercase; color: #001F3F; }

  /* ── Knoppen (identiek aan dakwerkers) ─────────────── */
  .hub-hero-btns { display: flex; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
  .hub-btn-primary { display: inline-flex; align-items: center; gap: 10px; background: #E5A524; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 18px 32px; border-radius: 8px; border: none; cursor: pointer; text-decoration: none; transition: background 0.2s, transform 0.15s; white-space: nowrap; }
  .hub-btn-primary:hover { background: #E9C466; transform: translateY(-1px); }
  .hub-btn-secondary { display: inline-flex; align-items: center; gap: 10px; background: transparent; color: #001F3F; font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 18px; padding: 16px 32px; border-radius: 8px; border: 2px solid rgba(213,196,174,0.5); cursor: pointer; text-decoration: none; transition: border-color 0.2s, background 0.2s; white-space: nowrap; }
  .hub-btn-secondary:hover { border-color: #E5A524; background: rgba(229,165,36,0.05); }

  /* ── Search bar wrapper ────────────────────────────── */
  .hub-search-wrap { margin-top: 24px; max-width: 440px; }

  /* ── Pillar rows ───────────────────────────────────── */
  .hub-rows { display: flex; flex-direction: column; gap: 64px; }
  .hub-row { display: grid; grid-template-columns: 360px 1fr 360px; min-height: 440px; background: #FFFFFF; box-shadow: 0 2px 12px rgba(0,0,0,0.07); clip-path: polygon(20px 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%,0% 20px); overflow: hidden; }

  /* Col 1 — gekleurde kaart met SVG */
  .hub-col-img { overflow: hidden; text-decoration: none; display: flex; flex-direction: column; background: var(--pillar-bg); transition: background 0.2s; }
  .hub-col-img:hover { background: #E9C466; }
  .hub-col-title { padding: 28px 22px 0; flex-shrink: 0; text-align: center; }
  .hub-col-title h2 { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 28px; color: #FFFFFF; margin: 10px 0 0; line-height: 1.2; }
  .hub-col-svg-wrap { flex: 1; display: flex; align-items: flex-end; justify-content: center; padding: 0 12px 20px; overflow: hidden; }
  .hub-col-svg { width: 90%; height: auto; display: block; object-fit: contain; }

  /* Col 2 — Wat je leert */
  .hub-col-learn { padding: 28px 32px; display: flex; flex-direction: column; justify-content: flex-start; border-right: 1px solid rgba(0,0,0,0.06); }
  .hub-col-learn p { font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 1.7; color: #3F5767; margin: 12px 0 0; }
  .hub-col-learn-link { display: inline-flex; align-items: center; gap: 5px; font-family: 'Open Sans', sans-serif; font-size: 13px; font-weight: 700; color: #3F5767; text-decoration: none; margin-top: 16px; }
  .hub-col-learn-link:hover { color: #E5A524; }

  /* Col 3 — Artikelen */
  .hub-col-links { padding: 43px 24px 28px; display: flex; flex-direction: column; justify-content: flex-start; }
  .hub-spoke-list { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-direction: column; gap: 5px; }
  .hub-spoke-list li { display: flex; align-items: baseline; gap: 7px; }
  .hub-spoke-list li::before { content: '•'; color: #E5A524; font-size: 18px; flex-shrink: 0; line-height: 1; }
  .hub-spoke-link { font-family: 'Open Sans', sans-serif; font-size: 16px; line-height: 1.45; color: #3F5767; text-decoration: none; }
  .hub-spoke-link:hover { color: #E5A524; text-decoration: underline; }

  /* Section labels */
  .hub-section-label { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 11px; letter-spacing: 1.4px; text-transform: uppercase; color: #E5A524; }

  /* Pillar titel onderaan col 2 */
  .hub-col-pillar-title { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 18px; line-height: 1.3; color: #001F3F; margin: auto 0 0; text-decoration: none; transition: color 0.15s; }
  .hub-col-pillar-title:hover { color: #E5A524; }

  /* Insight block */
  .hub-insight { background: #FFFFFF; border-left: 4px solid #E5A524; padding: 24px 32px; margin-top: 48px; clip-path: polygon(0% 0%,100% 0%,100% calc(100% - 16px),calc(100% - 16px) 100%,0% 100%); }

  /* Responsive */
  @media (max-width: 1023px) {
    .hub-wrap { padding: 0 24px; }
    .hub-hero { grid-template-columns: 1fr; gap: 40px; }
    .hub-hero-img { max-width: 360px; margin: 0 auto; }
    .hub-row { grid-template-columns: 1fr; min-height: unset; }
    .hub-col-img { min-height: 200px; }
    .hub-col-learn { border-right: none; border-bottom: 1px solid rgba(0,0,0,0.06); }
  }
  @media (max-width: 639px) {
    .hub-wrap { padding: 0 15px; }
  }
</style>

<BaseLayout
  title="Kenniscentrum bouwverzekeringen — Gidsen en artikelen | Assurman"
  description="Alles over verzekeringen voor de bouwsector. Gidsen voor aannemers, starters, zelfstandigen en onderaannemers. Verplichte polissen, premies, schadegevallen en meer."
  canonical="/gids/"
  schema={schemas}
  pagefind={true}
>

<!-- ── HERO ────────────────────────────────────────── -->
<section style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:680px;border-bottom:1px solid rgba(0,31,63,0.07);">
  <div class="hub-wrap" style="padding-top:64px;padding-bottom:80px;position:relative;z-index:2;">
    <div class="hub-hero">

      <!-- Links: tekst + CTA + zoekbalk — identiek aan dakwerkers hero -->
      <div>
        <div class="hub-badge-pill" style="margin-bottom:20px;">
          <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
          Assurman • Kenniscentrum bouwverzekeringen
        </div>
        <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin:0 0 8px;">
          Info en advies over verzekeringen in
        </h1>
        <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3.5vw,52px);line-height:1.1;letter-spacing:-1px;color:#E5A524;margin:0 0 20px;">
          de bouwsector
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#001F3F;margin:0 0 28px;max-width:520px;">
          Praktische thema's voor bouwondernemers — van starters tot groeiende aannemers. Schrijf je nooit meer in op een polis die niet past.
        </p>
        <div class="hub-hero-btns">
          <a href="#gidsen" class="hub-btn-primary">
            Bekijk alle thema's
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="/gratis-verzekeringsscan/" class="hub-btn-secondary">Gratis scan aanvragen</a>
        </div>
        <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
          Geen verplichting. We finaliseren je pakket samen na je intake.
        </p>
        <!-- Zoekbalk -->
        <div class="hub-search-wrap" data-pagefind-ignore>
          <SearchBar client:load />
        </div>
      </div>

      <!-- Rechts: illustratie -->
      <div style="display:flex;justify-content:center;align-items:flex-start;padding-top:48px;">
        <img
          src="/images/gids/assurman-verzekeringen-bouwsector-kenniscentrum.svg"
          alt="Kenniscentrum bouwverzekeringen illustratie"
          class="hub-hero-img"
        />
      </div>

    </div>
  </div>
</section>

<!-- ── PILLAR RIJEN ─────────────────────────────────── -->
<section id="gidsen" style="background:#F0EDE8;padding:72px 0 80px;">
  <div class="hub-wrap">

    <!-- Sectie-intro -->
    <div style="margin-bottom:40px;">
      <p class="hub-section-label" style="margin:0 0 8px;">5 hoofdthema's</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,2.5vw,32px);color:#001F3F;margin:0;line-height:1.2;">
        Kies het thema dat bij jouw vraag past
      </h2>
    </div>

    <div class="hub-rows">
      {pillarData.map(({ pillar, spokes }, i) => {
        const meta = PILLAR_META[pillar.data.pillarId] ?? PILLAR_META['P1'];
        const intro = pillar.data.hubIntro ?? pillar.data.metaDescription.slice(0, 130) + '…';
        return (
          <>
          <div class="hub-row">

            <!-- Col 1: Gekleurde kaart met SVG -->
            <a href={`/gids/${pillar.slug}/`} class="hub-col-img" style={`--pillar-bg:${meta.bg};`}>
              <div class="hub-col-title">
                <h2>{pillar.data.hubTitle ?? pillar.data.title}</h2>
              </div>
              <div class="hub-col-svg-wrap">
                <img
                  src={meta.svg}
                  alt=""
                  aria-hidden="true"
                  class="hub-col-svg"
                />
              </div>
            </a>

            <!-- Col 2: Wat je leert -->
            <div class="hub-col-learn">
              <p class="hub-section-label">Wat vind je hier</p>
              <p>{intro}</p>
              <a href={`/gids/${pillar.slug}/`} class="hub-col-learn-link">
                Lees het hoofdartikel
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href={`/gids/${pillar.slug}/`} class="hub-col-pillar-title">{pillar.data.title}</a>
            </div>

            <!-- Col 3: Bronnen -->
            <div class="hub-col-links">
              <p class="hub-section-label" style="font-size:14px;">Bijkomende bronnen</p>
              <ul class="hub-spoke-list">
                {spokes.slice(0, 7).map((s) => (
                  <li>
                    <a href={`/gids/${pillar.slug}/${s.slug}/`} class="hub-spoke-link">
                      {s.data.tileTitle ?? s.data.title}
                    </a>
                  </li>
                ))}
              </ul>
              <a href={`/gids/${pillar.slug}/#bronnen`} class="hub-col-learn-link">
                Bekijk alle {Math.min(spokes.length, 7)} bronnen
                <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
            </div>

          </div>
          {i === 1 && (
            <CTABlock
              theme="compact-dark"
              label="Nog vragen over je polissen?"
              headline="Krijg meteen professioneel advies"
              subtext="Geen standaard antwoorden. Concreet advies, afgestemd op jouw bouwactiviteit."
              primaryLabel="Start je gratis scan"
              primaryHref="/gratis-verzekeringsscan/"
              secondaryLabel="Plan adviesgesprek"
              secondaryHref="/contact/"
            />
          )}
          </>
        );
      })}
    </div>

    <!-- Insight block -->
    <div class="hub-insight">
      <p class="hub-section-label" style="margin:0 0 8px;">Wist je dat?</p>
      <p style="font-family:'Open Sans',sans-serif;font-size:16px;line-height:1.7;color:#001F3F;margin:0 0 14px;">
        <strong>Ongeveer 1 op de 3 bouwbedrijven is onderverzekerd of verkeerd verzekerd</strong> — niet uit slordigheid, maar omdat polissen niet meegroeien met het bedrijf en activiteitscodes niet worden bijgehouden.
      </p>
      <a href="/gratis-verzekeringsscan/" style="display:inline-flex;align-items:center;gap:6px;font-family:'Open Sans',sans-serif;font-size:14px;font-weight:700;color:#E5A524;text-decoration:none;">
        Start de gratis verzekeringsscan
        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>

  </div>
</section>

<!-- ── FINAL CTA ────────────────────────────────────── -->
<section style="background:#3F5767;padding:100px 0 0;text-align:center;position:relative;overflow:hidden;">
  <div class="hub-wrap" style="position:relative;z-index:1;">
    <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Vrijblijvend starten</p>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,4vw,46px);line-height:1.1;letter-spacing:-0.8px;color:#FFFFFF;margin:0 0 20px;">
      Klaar om te starten?
    </h2>
    <p style="font-family:'Outfit',sans-serif;font-size:18px;line-height:1.65;color:#CBD5E1;max-width:520px;margin:0 auto 44px;">
      Doe de gratis scan in 2 minuten, of plan een adviesgesprek als je eerst wil praten. Beide routes zijn vrijblijvend.
    </p>
    <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;margin-bottom:20px;">
      <a href="/gratis-verzekeringsscan/" style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        Start je gratis scan (2 min)
      </a>
      <a href="/contact/" style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 36px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.2);">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18"/></svg>
        Plan adviesgesprek
      </a>
    </div>
    <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:#CBD5E1;opacity:0.75;margin-bottom:80px;">
      Geen verplichting. We helpen je kiezen wat écht nodig is voor jouw stiel.
    </p>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;">
    <polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" />
  </svg>
</section>

</BaseLayout>
