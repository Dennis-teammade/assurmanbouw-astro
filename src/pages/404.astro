---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pagina niet gevonden | Assurman"
  description="De pagina die u zocht bestaat niet of is verplaatst."
  canonical="/404/"
>
  <section style="background:#FFFFFF;min-height:80vh;display:flex;align-items:center;justify-content:center;padding:var(--hero-gap) 24px 80px;position:relative;overflow:hidden;">
    <!-- Large 404 background -->
    <div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;pointer-events:none;">
      <span style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(180px,30vw,360px);color:#E5A524;opacity:0.15;line-height:1;user-select:none;">404</span>
    </div>

    <!-- Content -->
    <div style="position:relative;z-index:1;text-align:center;max-width:640px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 20px;">Pagina niet gevonden</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,4.5vw,56px);line-height:1.1;color:#001F3F;margin:0 0 20px;">Oops. Deze pagina bestaat niet.</h1>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 48px;">De pagina die u zocht bestaat niet of is verplaatst. Gebruik de links hieronder om terug te vinden wat u zocht.</p>

      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/" style="display:inline-flex;align-items:center;gap:8px;background:#001F3F;color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;padding:14px 28px;border-radius:4px;text-decoration:none;">
          <span>←</span>
          Terug naar home
        </a>
        <a href="/sectoren" style="display:inline-flex;align-items:center;gap:8px;background:transparent;border:2px solid #001F3F;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;padding:14px 28px;border-radius:4px;text-decoration:none;">
          Sectoren
        </a>
        <a href="/verzekeringen" style="display:inline-flex;align-items:center;gap:8px;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;padding:14px 28px;border-radius:4px;text-decoration:none;">
          Verzekeringen
        </a>
      </div>

      <div style="margin-top:64px;padding-top:40px;border-top:1px solid #E5E8ED;">
        <p style="font-family:'Open Sans',sans-serif;font-size:15px;color:#3F5767;margin:0 0 16px;">Of start direct met de gratis risicoscan:</p>
        <a href="/gratis-verzekeringsscan/" style="display:inline-block;background:transparent;border:2px solid #E5A524;color:#E5A524;font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;padding:12px 24px;border-radius:4px;text-decoration:none;">Gratis scan starten</a>
      </div>
    </div>
  </section>
</BaseLayout>
