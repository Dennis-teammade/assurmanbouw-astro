---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/islands/FaqAccordion';
import ScrollProgress from '../components/islands/ScrollProgress';
import { CTA_DESTINATIONS, CTA_SCAN, CTA_AFSPRAAK } from '../data/cta-labels';

const faqItems = [
  {
    title: 'Welke verzekeringen zijn verplicht voor bouwbedrijven?',
    content: 'In België zijn de volgende verzekeringen verplicht voor bouwbedrijven: (1) Arbeidsongevallenverzekering: verplicht vanaf de eerste werknemer. (2) BA Auto: verplicht voor alle voertuigen op de openbare weg. (3) BA-10: verplicht voor aannemers bij werken aan de gesloten ruwbouw van vergunningsplichtige woningen. Naast deze verplichte verzekeringen zijn BA Onderneming en andere dekkingen sterk aanbevolen.'
  },
  {
    title: 'Hoe vraag ik een offerte aan bij Assurman?',
    content: 'Je kan starten via de gratis risicoscan op deze website. In 2 minuten geef je ons de basisinformatie over je bedrijf. Daarna contacteert Assurman je voor een gesprek en een voorstel op maat. Je kan ook rechtstreeks een afspraak plannen via de afsprakentool.'
  },
  {
    title: 'Hoe lang duurt het voordat ik een polis heb?',
    content: 'Dat hangt af van je situatie.\n\nNieuw bedrijf, nog niet verzekerd:\nZodra alle nodige documenten binnen zijn, gaat het snel. We bezorgen je een voorstel op maat en activeren je polis kort daarna, zodat je zonder uitstel kan starten.\n\nAl verzekerd elders:\nJe nieuwe dekking start bij de eerstvolgende vervaldag van je huidige polis. In de bouwsector zijn 3-jaarlijkse contracten gangbaar, dus dat moment kan tot drie jaar in de toekomst liggen. We bekijken samen welke polissen wanneer overgenomen kunnen worden, zodat je nooit zonder dekking valt.'
  },
  {
    title: 'Kan Assurman ook mijn bestaande polissen bekijken?',
    content: 'Ja. Assurman doet ook een analyse van jouw bestaande polissen. We kijken waar je onderverzekerd bent, waar je dubbel betaalt en of er betere alternatieven zijn. Dit is onderdeel van de gratis risicoscan.'
  },
  {
    title: 'Is Assurman gebonden aan een bepaalde verzekeraar?',
    content: 'Nee. Assurman is een onafhankelijk verzekeringsmakelaar. We zijn niet gebonden aan één maatschappij en vergelijken meer dan 20 erkende verzekeraars. Dat geeft ons de vrijheid om altijd het beste product te kiezen voor jouw situatie.'
  },
  {
    title: 'Wat is het verschil tussen een makelaar en een verzekeringsagent?',
    content: 'Een verzekeringsagent werkt voor één verzekeraar en vertegenwoordigt de belangen van die maatschappij. Een onafhankelijk makelaar zoals Assurman werkt voor jou als klant en vergelijkt meerdere maatschappijen. Je hebt recht op de beste prijs-kwaliteitverhouding, niet op wat het meest oplevert voor de verzekeraar.'
  },
  {
    title: 'Wat gebeurt er bij een schadeaangifte?',
    content: 'Bij schade contacteer je Assurman. Wij begeleiden je door de aangifte, communiceren met de verzekeraar en volgen het dossier op tot afsluiting. Je hoeft niet zelf te onderhandelen of procedurele stappen te doorlopen.'
  },
  {
    title: 'Werkt Assurman voor alle bouwsectoren?',
    content: 'Ja. Assurman werkt voor alle bouwprofessionals: aannemers, dakwerkers, elektriciens, loodgieters, schilders, schrijnwerkers, metsers en meer. De risicoprofielen verschillen per sector; Assurman stelt een polis samen die past bij jouw specifieke beroepsactiviteit.'
  },
  {
    title: 'Wat is de gratis risicoscan?',
    content: 'De gratis risicoscan is een online tool waarmee je in 2 minuten een overzicht krijgt van jouw bouwverzekeringen: wat je al hebt, wat je mist en waar je dubbel betaalt. De scan is gratis, vrijblijvend en volledig zonder verplichtingen.'
  },
  {
    title: 'Kan ik als zelfstandige ook terecht bij Assurman?',
    content: 'Absoluut. Assurman werkt voor eenmanszaken, vennootschappen en grotere bouwbedrijven. De aanpak is modulair: je kiest welke dekkingen je nodig hebt, ook als dat maar één polis is.'
  },
  {
    title: 'Is mijn premie fiscaal aftrekbaar?',
    content: 'De meeste beroepsverzekeringspremies zijn volledig aftrekbaar als beroepskosten, waaronder de arbeidsongevallenverzekering, BA Onderneming, BA-10 en bedrijfsvoertuigen. Assurman geeft je bij de offerte een duidelijk overzicht.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.title,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.content
    }
  }))
};
---

<BaseLayout
  title="FAQ | Veelgestelde vragen over bouwverzekeringen | Assurman"
  description="Antwoorden op de meest gestelde vragen over verzekeringen voor bouwprofessionals."
  canonical="/faq"
  schema={schema}
>
  <ScrollProgress client:load />

  <!-- HERO -->
  <section style="background:#3F5767;padding-top:var(--hero-gap);padding-bottom:80px;">
    <div style="max-width:800px;margin:0 auto;padding:0 24px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">FAQ</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,68px);line-height:1.05;color:#FFFFFF;margin:0 0 24px;">Veelgestelde vragen</h1>
      <p style="font-family:'Open Sans',sans-serif;font-size:20px;line-height:1.7;color:rgba(255,255,255,0.75);margin:0;">Antwoorden op de meest gestelde vragen over bouwverzekeringen.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#FFFFFF;padding:80px 0 100px;">
    <div style="max-width:900px;margin:0 auto;padding:0 24px;">
      <FaqAccordion client:visible items={faqItems} />
    </div>
  </section>

  <!-- STILL QUESTIONS -->
  <section style="background:#F8F9FA;padding:80px 0;">
    <div style="max-width:800px;margin:0 auto;padding:0 24px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Geen antwoord gevonden?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,40px);line-height:1.1;color:#001F3F;margin:0 0 20px;">Stel je vraag rechtstreeks</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0 0 32px;">Assurman beantwoordt persoonlijk elke vraag over je bouwverzekeringen.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href={CTA_DESTINATIONS.contact} style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 32px;border-radius:8px;text-decoration:none;transition:background 0.2s,transform 0.15s;">Contacteer ons</a>
        <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:10px;background:transparent;border:2px solid rgba(63,87,103,0.4);color:#3F5767;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 32px;border-radius:8px;text-decoration:none;transition:border-color 0.2s;">{CTA_AFSPRAAK.hero}</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:#3F5767;padding:100px 0 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px 80px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Klaar om te starten?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,52px);line-height:1.1;color:#FFFFFF;margin:0 0 20px;">Gratis scan of direct contact</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);max-width:560px;margin:0 auto 40px;">Assurman adviseert, vergelijkt en regelt jouw bouwverzekeringen.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href={CTA_DESTINATIONS.scan} style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">{CTA_SCAN.band}</a>
        <a href={CTA_DESTINATIONS.afspraak} style="display:inline-block;background:transparent;border:2px solid rgba(255,255,255,0.3);color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">{CTA_AFSPRAAK.band}</a>
      </div>
    </div>
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
  </section>
</BaseLayout>
