---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollProgress from '../components/islands/ScrollProgress';

const articles = [
  {
    title: 'Arbeidsongevallenverzekering',
    category: 'Verplichte verzekeringen',
    desc: 'Verplicht vanaf de eerste werknemer. Ontdek wat gedekt is, hoe de premie berekend wordt en wat u moet doen bij een arbeidsongeval.',
    link: '/verzekeringen/arbeidsongevallen/',
    badge: 'Verplicht',
    badgeColor: '#DC2626'
  },
  {
    title: 'BA Onderneming',
    category: 'Aansprakelijkheid',
    desc: 'Bescherming tegenover derden bij schade tijdens of na uw werken. BA Uitbating, BA Na Levering en burenhinder uitgelegd.',
    link: '/verzekeringen/ba-onderneming/',
    badge: 'Essentieel',
    badgeColor: '#E5A524'
  },
  {
    title: 'BA-10 Tienjarige aansprakelijkheid',
    category: 'Verplichte verzekeringen',
    desc: 'Verplicht bij woningbouw. Alles over de Wet Peeters-Borsus, wanneer u verplicht bent en het verschil tussen werfpolis en jaarpolis.',
    link: '/verzekeringen/ba-10/',
    badge: 'Verplicht woningbouw',
    badgeColor: '#DC2626'
  },
  {
    title: 'Bedrijfsvoertuigen',
    category: 'Voertuigen & materieel',
    desc: 'Van BA verplicht tot omnium en vlootpolis. Ontdek welke dekking past bij uw wagenpark en wanneer een vlootpolis loont.',
    link: '/verzekeringen/bedrijfsvoertuigen/',
    badge: 'Verplicht (BA)',
    badgeColor: '#DC2626'
  },
  {
    title: 'Machinebreuk & gereedschap',
    category: 'Voertuigen & materieel',
    desc: 'Uw machines en gereedschap zijn een grote investering. Ontdek hoe u ze beschermt tegen breuk, diefstal en schade.',
    link: '/verzekeringen/machinebreuk',
    badge: 'Sterk aanbevolen',
    badgeColor: '#3F5767'
  },
  {
    title: "Alle Bouwplaats Risico's (ABR)",
    category: 'Werfverzekeringen',
    desc: "Beschermt het werk in uitvoering, ongeacht de oorzaak. Storm, brand, diefstal, vandalisme: uw werf is gedekt van start tot oplevering.",
    link: '/verzekeringen/alle-bouwplaats-risicos/',
    badge: 'Projectspecifiek',
    badgeColor: '#3F5767'
  }
];
---

<BaseLayout
  title="Kenniscentrum: Alles over bouwverzekeringen | Assurman"
  description="Praktische gidsen, uitleg en tips over verzekeringen voor bouwprofessionals. Begrijp uw dekking en maak weloverwogen keuzes."
  canonical="/kenniscentrum"
>
  <ScrollProgress client:load />

  <!-- HERO -->
  <section style="background:#001F3F;padding-top:140px;padding-bottom:80px;">
    <div style="max-width:900px;margin:0 auto;padding:0 24px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Kenniscentrum</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,68px);line-height:1.05;color:#FFFFFF;margin:0 0 24px;">Alles over bouwverzekeringen</h1>
      <p style="font-family:'Open Sans',sans-serif;font-size:20px;line-height:1.7;color:rgba(255,255,255,0.75);margin:0;">Praktische gidsen en uitleg, geschreven voor bouwprofessionals. Geen jargon, wel duidelijkheid.</p>
    </div>
  </section>

  <!-- ARTICLES GRID -->
  <section style="background:#F8F9FA;padding:80px 0 100px;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Verzekeringsguides</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,42px);line-height:1.1;color:#001F3F;margin:0 0 48px;">Diepgaande uitleg per verzekering</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:28px;">
        {articles.map((article) => (
          <a href={article.link} style="display:block;text-decoration:none;background:#FFFFFF;border:1px solid #E5E8ED;border-radius:10px;overflow:hidden;box-shadow:0 2px 20px rgba(0,31,63,0.06);">
            <div style="background:#001F3F;padding:28px 28px 20px;">
              <p style={`display:inline-block;font-family:'Outfit',sans-serif;font-weight:700;font-size:11px;padding:4px 12px;border-radius:20px;margin:0 0 12px;background:${article.badgeColor};color:#FFFFFF;`}>{article.badge}</p>
              <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:13px;color:#E5A524;margin:0 0 6px;text-transform:uppercase;letter-spacing:0.8px;">{article.category}</p>
              <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#FFFFFF;margin:0;">{article.title}</h3>
            </div>
            <div style="padding:24px 28px 28px;">
              <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0 0 20px;">{article.desc}</p>
              <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;color:#E5A524;display:flex;align-items:center;gap:6px;">Lees meer →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CATEGORIES BAND -->
  <section style="background:#FFFFFF;padding:80px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Meer informatie</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,42px);line-height:1.1;color:#001F3F;margin:0 0 40px;">Snel naar</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
        {[
          {title:'Alle verzekeringen',link:'/verzekeringen',icon:'🛡️'},
          {title:'Onze werkwijze',link:'/werkwijze',icon:'⚙️'},
          {title:'FAQ',link:'/faq',icon:'❓'},
          {title:'Contact',link:'/contact/',icon:'📞'},
          {title:'Gratis scan',link:'/gratis-verzekeringsscan/',icon:'⚡'},
          {title:'Afspraak',link:'/maak-afspraak',icon:'📅'}
        ].map((item) => (
          <a href={item.link} style="display:flex;align-items:center;gap:12px;background:#F8F9FA;border:1px solid #E5E8ED;border-radius:8px;padding:16px 20px;text-decoration:none;">
            <span style="font-size:20px;">{item.icon}</span>
            <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#001F3F;">{item.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:#001F3F;padding:100px 0 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px 80px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Gratis en vrijblijvend</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,52px);line-height:1.1;color:#FFFFFF;margin:0 0 20px;">Ontdek uw blinde vlekken</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);max-width:560px;margin:0 auto 40px;">In 2 minuten een volledig overzicht van uw bouwverzekeringen. Gratis, vrijblijvend, snel.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/gratis-verzekeringsscan/" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Start gratis scan</a>
        <a href="/maak-afspraak" style="display:inline-block;background:transparent;border:2px solid rgba(255,255,255,0.3);color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Afspraak maken</a>
      </div>
    </div>
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
  </section>
</BaseLayout>
