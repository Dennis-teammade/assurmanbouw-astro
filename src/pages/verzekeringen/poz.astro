        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:6px;">Belastingvermindering</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:48px;color:#FFFFFF;letter-spacing:-1px;line-height:1;">30%</div>
        <div style="font-family:'Outfit',sans-serif;font-size:14px;color:#94a3b8;margin-top:6px;">op je gestorte premie, binnen de 80%-regel</div>
      </div>
    </div>
  </div>
</section>

<!-- AANVULLENDE WAARBORGEN -->
<section id="pz-aanvulling" style="background:#3F5767;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="white" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding:100px 32px 0;position:relative;z-index:1;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Aanvullen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Vijf manieren om meer uit je POZ te halen</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0;">De basis is pensioenopbouw, maar rond je POZ heen kan je extra bescherming en optimalisatie regelen. Vijf zaken die in de praktijk telkens terugkomen.</p>
    </div>
    <div class="pz-aanvulling-grid">
      {[
        {i:'ac',title:'Overlijdensdekking',                      text:'Je kan een overlijdensdekking koppelen aan je POZ, zodat een begunstigde, vaak je partner of kinderen, een kapitaal ontvangt als je overlijdt vóór je pensioen. Zo bescherm je je gezin naast je eigen opbouw.'},
        {i:'sd',title:'Arbeidsongeschiktheid en premievrijstelling', text:'Met een aanvullende waarborg neemt de verzekeraar je premie over als je langdurig arbeidsongeschikt wordt, zodat je pensioenopbouw blijft doorlopen. Zinvol in een fysiek zwaar bouwberoep.'},
        {i:'tr',title:'Tak21 of tak23',                         text:'Een tak21-POZ geeft je een gewaarborgd rendement, soms aangevuld met een winstdeelname: veiligheid voorop. Een tak23-POZ belegt in fondsen met meer rendementskansen, maar zonder kapitaalgarantie. Je kan ook combineren.'},
        {i:'st',title:'Eerst VAPZ, dan POZ',                    text:'Je VAPZ is voordeliger en vrij van premietaks. Vul dat eerst volledig op, en bouw daarna bij met een POZ binnen je 80%-ruimte. Die volgorde levert je het hoogste fiscale rendement op.'},
        {i:'br',title:'Fiscale optimalisatie binnen de 80%-regel', text:'Hoeveel je voordelig kan storten, hangt af van je referentie-inkomen en wat je al opbouwde. Wij rekenen je 80%-ruimte uit, zodat elke euro die je in je POZ stort fiscaal blijft meetellen.'},
      ].map(card=>(
        <div class="pz-ins-card" style="padding:28px;">
          <div style="background:rgba(229,165,36,0.15);border-radius:10px;padding:10px;display:inline-flex;margin-bottom:16px;">
            {card.i==='ac'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>}
            {card.i==='sd'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {card.i==='tr'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>}
            {card.i==='st'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            {card.i==='br'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#FFFFFF;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#94A3B8;margin:0;">{card.text}</p>
        </div>
      ))}
      <div style="background:#E5A524;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:32px;display:flex;flex-direction:column;justify-content:center;">
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#001F3F;margin:0 0 12px;">Hoeveel POZ-ruimte heb jij nog?</h3>
        <p style="font-family:'Outfit',sans-serif;font-size:15px;color:rgba(0,31,63,0.75);line-height:1.55;margin:0 0 20px;">Doe de scan: we bekijken je VAPZ, je referentie-inkomen en je 80%-ruimte, en berekenen hoeveel je nog voordelig kan bijstorten in een POZ.</p>
        <a href={CTA_DESTINATIONS.scan} class="pz-scan-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#3F5767;color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;padding:12px 24px;border-radius:8px;text-decoration:none;transition:background 0.2s;width:100%;">
          {CTA_SCAN.start} <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PREMIE -->
<section id="premie" style="background:#F7F4EF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:56px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Prijs &amp; berekening</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Hoeveel kan ik storten in mijn POZ?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:560px;margin:0 auto;">Je bepaalt zelf hoeveel je stort, tot je 80%-grens bereikt is. Die grens hangt af van je referentie-inkomen en van wat je al opbouwde in je wettelijk en aanvullend pensioen. Het rekensommetje maken we samen.</p>
    </div>
    <div class="pz-formule">
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">1. Referentie-inkomen</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:8px;">Je beroepsinkomen</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#3F5767;line-height:1.4;">gemiddelde van je belastbaar beroepsinkomen over de voorbije jaren</div>
      </div>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">×</div>
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">2. 80%-ruimte</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:8px;">Max 80%</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#3F5767;line-height:1.4;">wettelijk + aanvullend pensioen samen, min wat je al opbouwde</div>
      </div>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">=</div>
      <div style="background:#3F5767;border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 8px 32px rgba(63,87,103,0.3);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">Jouw premie</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#FFFFFF;margin-bottom:8px;">Binnen je 80%-ruimte</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#94a3b8;line-height:1.4;">met 30% belastingvermindering, premietaks 4,40% inbegrepen</div>
      </div>
    </div>
    <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:22px;color:#001F3F;text-align:center;margin-bottom:32px;">4 factoren die je premie bepalen</h3>
    <div class="pz-factors-grid">
      {[
        {num:'1',title:'Je referentie-inkomen',  text:'Je 80%-ruimte wordt berekend op het gemiddelde van je belastbaar beroepsinkomen over de voorbije jaren. Hoe hoger dat inkomen, hoe meer ruimte je hebt om voordelig te storten.'},
        {num:'2',title:'Wat je al opbouwde',     text:'Je reeds opgebouwde wettelijk en aanvullend pensioen (waaronder je VAPZ) telt mee in de 80%-regel. Hoe meer je al hebt, hoe kleiner je resterende POZ-ruimte.'},
        {num:'3',title:'De gekozen waarborgen',  text:'Voeg je een overlijdensdekking of een waarborg arbeidsongeschiktheid toe, dan bepaalt dat mee je premie. Meer bescherming betekent een hogere premie, maar ook meer zekerheid.'},
        {num:'4',title:'Je leeftijd en horizon', text:'Hoe vroeger je start, hoe langer je kapitaal kan groeien. De looptijd tot je pensioen weegt zwaar door op wat je uiteindelijk opbouwt.'},
      ].map(f=>(
        <div class="brand-why-card" style="padding:20px 24px;display:flex;gap:18px;align-items:flex-start;">
          <div style="width:36px;height:36px;border-radius:50%;background:#E5A524;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><span style="font-family:'Outfit',sans-serif;font-weight:900;font-size:16px;color:#001F3F;">{f.num}</span></div>
          <div>
            <h4 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 4px;">{f.title}</h4>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.65;color:#3F5767;margin:0;">{f.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div style="max-width:680px;margin:0 auto;">
      <div style="background:rgba(229,165,36,0.10);padding:20px 28px;clip-path:polygon(24px 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%,0% 24px);border:1px solid rgba(229,165,36,0.3);">
        <div style="display:flex;gap:14px;align-items:flex-start;">
          <svg style="flex-shrink:0;margin-top:2px;" width="18" height="18" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#001F3F;margin:0;"><strong>Fiscaal:</strong> je POZ-premie levert een <strong>belastingvermindering van 30%</strong> op in je personenbelasting, een federaal voordeel zolang je binnen de <strong>80%-regel</strong> blijft. Anders dan een VAPZ is een POZ <strong>niet vrijgesteld van de premietaks van 4,40%</strong>: net zoals bij een IPT is die taks op je POZ-premie verschuldigd. Daarom vul je je VAPZ best eerst op. Bij de uitkering op je wettelijke pensioenleeftijd geldt een gunstige eindbelasting.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA BAND -->
<section id="pz-cta-band" style="background:#E9C466;padding:80px 0 100px;position:relative;overflow:hidden;">
  <div class="assurman-mask assurman-mask--cta pz-cta-mask-img" style="position:absolute;top:0;right:-4px;width:380px;pointer-events:none;z-index:1;">
    <img src="/images/verzekeringen/poz-band.jpg" alt="Zelfstandige zonder vennootschap met een POZ-pensioen">
  </div>
  <div style="position:absolute;top:-30px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="white" height="100px" direction="down" /></div>
  <div class="pz-cta-deco" style="position:absolute;right:-130px;top:40%;transform:translateY(-50%);pointer-events:none;z-index:2;"><BrandChevron color="white" height="240px" direction="left" /></div>
  <div style="max-width:1100px;margin:0 auto;text-align:center;position:relative;z-index:4;padding:0 32px;">
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(36px,4vw,56px);line-height:1.15;color:#FFFFFF;margin-bottom:16px;">Zelfstandige zonder vennootschap?<br />Bouw bovenop je VAPZ verder met een POZ.</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:22px;line-height:1.4;color:#3F5767;margin-bottom:40px;opacity:0.9;">Start nu in 2 minuten of kies meteen voor persoonlijk advies.</p>
    <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:12px;background:#3F5767;color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 40px;border-radius:10px;text-decoration:none;">{CTA_SCAN.requestNow} <Fragment set:html={svgArr18} /></a>
  </div>
</section>

<!-- PER BEROEP TABS -->
<section id="pz-beroep" style="background:#e5a52414;padding:96px 32px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Per beroep</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Een POZ voor jouw stiel</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:560px;margin:0 auto;">Werk je zonder vennootschap, dan is de POZ jouw formule bovenop het VAPZ. Hieronder de aanpak per discipline.</p>
    </div>
    <div class="pz-tabs-row" style="display:flex;gap:0;border-bottom:2px solid rgba(0,31,63,0.12);margin-bottom:40px;justify-content:center;">
      {beroepTabs.map((tab,i)=>(<button class={`pz-tab-btn${i===0?' active':''}`} data-tab-btn={tab.id}>{tab.label}</button>))}
    </div>
    {beroepTabs.map((tab,i)=>(
      <div data-tab-content={tab.id} style={`display:${i===0?'block':'none'};max-width:860px;margin:0 auto;`}>
      <div class="pz-tab-inner" style="background:#FFFFFF;border-radius:12px;padding:36px 40px;">
        <div style="background:rgba(229,165,36,0.12);border-radius:12px;padding:18px;flex-shrink:0;">
          <svg width="32" height="32" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>
        </div>
        <div style="flex:1;">
          <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#001F3F;margin:0 0 12px;">{tab.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:17px;line-height:1.65;color:#001F3F;margin:0 0 20px;">{tab.text}</p>
          <a href={tab.link} style="display:inline-flex;align-items:center;gap:6px;font-family:'Open Sans',sans-serif;font-weight:700;font-size:14px;color:#E5A524;text-decoration:none;">Bekijk sectorpagina <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
      </div>
      </div>
    ))}
  </div>
</section>

<!-- MIJN SITUATIE ACCORDION -->
<section id="pz-statuten" style="background:#3F5767;padding:96px 32px;position:relative;overflow:hidden;">
  <div style="max-width:840px;margin:0 auto;position:relative;z-index:1;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Mijn situatie</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Welke aanpak past bij jouw POZ?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0 0 40px;">Drie typische situaties uit de Belgische bouwsector. Vind de jouwe en zie wat dat concreet betekent voor je POZ.</p>

    <div class="pz-stat-panel" data-stat-panel>
      <button class="pz-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Mijn VAPZ-ruimte is vol</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Je hebt je VAPZ-plafond bereikt en wil meer opbouwen. Dan is de <strong style="color:#FFFFFF;">POZ</strong> de logische volgende stap: je bouwt verder binnen je 80%-ruimte, met een belastingvermindering van 30% op je premie. Zo benut je je volledige fiscale ruimte als zelfstandige zonder vennootschap.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: VAPZ eerst tot het maximum, want dat is de voordeligste laag en vrij van premietaks, en daarna bijbouwen met een POZ. Bekijk de details op de pagina over <a href="/verzekeringen/vapz/" style="color:#E5A524;text-decoration:underline;">VAPZ</a>, of doe de scan en wij rekenen je resterende 80%-ruimte voor je uit.</p>
      </div>
    </div>

    <div class="pz-stat-panel" data-stat-panel>
      <button class="pz-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik heb geen vennootschap</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Je werkt als natuurlijk persoon: een eenmanszaak, een vrij beroep of als meewerkende echtgenoot. Een IPT is voor jou niet mogelijk, want die loopt via een vennootschap. De <strong style="color:#FFFFFF;">POZ is jouw equivalent</strong>: je betaalt de premie privé en krijgt er een belastingvermindering van 30% voor in de plaats.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: de POZ dicht het gat dat zelfstandigen zonder vennootschap vroeger hadden. Samen bekijken we hoeveel je voordelig kan storten binnen de 80%-regel.</p>
      </div>
    </div>

    <div class="pz-stat-panel" data-stat-panel>
      <button class="pz-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik twijfel tussen een POZ en een vennootschap oprichten</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Je overweegt om een vennootschap op te richten, onder meer voor de fiscale hefboom van een <strong style="color:#FFFFFF;">IPT</strong>. Tot het zover is, hoef je niet stil te zitten: met een <strong style="color:#FFFFFF;">POZ</strong> bouw je nu al fiscaal voordelig pensioen op als natuurlijk persoon.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: start vandaag met een POZ en richt later eventueel een vennootschap op. Schakel je dan over naar een <a href="/verzekeringen/ipt/" style="color:#E5A524;text-decoration:underline;">IPT</a>, dan bekijken we hoe je opgebouwde POZ daarbij meegaat. Een vennootschap oprichten is een bredere beslissing dan pensioen alleen; dat wegen we samen af, zonder je tot iets te verplichten.</p>
      </div>
    </div>
  </div>
</section>

<!-- OPBOUW EN UITKERING -->
<section id="procedure" style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:60px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Opbouw en uitkering</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Hoe verloopt het van aansluiting tot pensioen?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:520px;margin:0 auto;">Een POZ is een traject van jaren. Hieronder zie je hoe het loopt, van je aansluiting tot de uitkering bij je pensioen.</p>
    </div>
    <div class="pz-procedure-grid">
      <div class="pz-procedure-line" style="position:absolute;top:36px;left:12.5%;right:12.5%;height:2px;background:linear-gradient(to right,#E5A524,rgba(229,165,36,0.2));z-index:0;"></div>
      {[
        {ic:'ph', title:'Aansluiten',                  text:'Je sluit een POZ af bij een verzekeraar of pensioeninstelling. Samen bepalen we het rendementstype (tak21, tak23 of een combinatie) en welke optionele waarborgen je toevoegt, zoals een overlijdensdekking.'},
        {ic:'eu', title:'Storten binnen je 80%-ruimte', text:'Je stort periodiek of jaarlijks, binnen je 80%-ruimte. Op elke premie krijg je een belastingvermindering van 30%. Anders dan bij een VAPZ is op je POZ-premie wel een premietaks van 4,40% verschuldigd.'},
        {ic:'ey', title:'Opvolgen via MyPension',      text:'Je volgt je opgebouwde reserve op via je jaarlijkse fiche en via MyPension, het officiële platform van de overheid, waar je je volledige aanvullend pensioen samen ziet. We sturen bij waar nodig.'},
        {ic:'gf', title:'Uitkering bij pensioen',      text:'Op je wettelijke pensioenleeftijd wordt het kapitaal uitgekeerd. De belasting verloopt via een gunstregime, waardoor de eindbelasting beperkt blijft. Het nettobedrag hangt af van je loopbaan en situatie.'},
      ].map((s,i)=>(
        <div style="padding:0 20px;text-align:center;position:relative;z-index:1;">
          <div style="width:72px;height:72px;border-radius:50%;background:#E5A524;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;box-shadow:0 4px 16px rgba(229,165,36,0.3);">
            {s.ic==='ph'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>}
            {s.ic==='eu'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
            {s.ic==='ey'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>}
            {s.ic==='gf'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>}
          </div>
          <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#E5A524;margin-bottom:8px;">Stap {i+1}</div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{s.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:840px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Veelgestelde vragen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 12px;">Veelgestelde vragen over de POZ</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;margin:0;">Concrete vragen van zelfstandigen zonder vennootschap: klik open voor het antwoord.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      {faqItems.map((item)=>(
        <div data-faq-item style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.08);border-radius:10px;overflow:hidden;">
          <button data-faq-btn style="width:100%;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;background:none;border:none;cursor:pointer;text-align:left;gap:16px;">
            <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;line-height:1.35;">{item.q}</span>
            <svg data-faq-chevron width="18" height="18" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div data-faq-answer style="display:none;padding:0 24px 20px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#3F5767;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GERELATEERDE VERZEKERINGEN -->
<InsuranceCarousel
  client:only="react"
  cards={insuranceCards}
  sectionLabel="Ook interessant"
  headline="Gerelateerde verzekeringen"
  subheadline="Deze formules sluiten aan bij de opbouw van je aanvullend pensioen als zelfstandige zonder vennootschap."
  background="#F5F2FF"
/>

<!-- PARTNERS -->
<section style="background:#F7F4EF;padding:64px 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;text-align:center;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:36px;">Ondersteund door sterke verzekeringspartners</p>
    <PartnerSlider client:only="react" />
  </div>
</section>

<!-- FINAL CTA -->
<section style="background:#3F5767;padding-top:120px;padding-bottom:0;position:relative;text-align:center;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;"></div>
  <div style="max-width:896px;margin:0 auto;padding:0 32px;position:relative;z-index:2;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;text-align:center;margin-bottom:20px;">Start met Assurman</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(32px,4vw,48px);line-height:1;color:#FFFFFF;max-width:727px;margin:0 auto 24px;">Bouw je pensioen op met een POZ</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:22px;line-height:1.4;color:#CBD5E1;max-width:832px;margin:0 auto 48px;">Werk je als zelfstandige zonder vennootschap in de bouw en is je VAPZ-ruimte vol? Wij rekenen je 80%-ruimte uit en bekijken hoeveel je voordelig kan bijstorten in een POZ, zonder verplichting.</p>
    <div class="pz-final-btns">
      <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;box-shadow:0px 10px 15px -3px rgba(0,0,0,0.1);">{CTA_SCAN.hero} <Fragment set:html={svgArr18} /></a>
      <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.2);">{CTA_AFSPRAAK.advisory}</a>
    </div>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
</section>

</div>

<script>
  const progressBar = document.getElementById('pz-progress-bar') as HTMLElement | null;
  const stickyBtns  = document.querySelectorAll<HTMLElement>('[data-sticky-btn]');
  const sectionIds  = ['watis','verplicht','dekking','premie','procedure','faq'];

  stickyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.stickyBtn!;
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });

  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const total = doc.scrollHeight - doc.clientHeight;
    if (progressBar) progressBar.style.width = total > 0 ? `${(doc.scrollTop / total) * 100}%` : '0%';
    for (let i = sectionIds.length - 1; i >= 0; i--) {
      const el = document.getElementById(sectionIds[i]);
      if (el && el.getBoundingClientRect().top <= 120) {
        stickyBtns.forEach(b => b.classList.toggle('active', b.dataset.stickyBtn === sectionIds[i]));
        break;
      }
    }
  }, { passive: true });

  const exBtn  = document.getElementById('pz-examples-btn')     as HTMLElement | null;
  const exList = document.getElementById('pz-examples-list')    as HTMLElement | null;
  const exChev = document.getElementById('pz-examples-chevron') as HTMLElement | null;
  if (exBtn && exList && exChev) {
    exBtn.addEventListener('click', () => {
      const open = exList.style.display !== 'none';
      exList.style.display = open ? 'none' : 'grid';
      exChev.style.transform = open ? '' : 'rotate(180deg)';
    });
  }

  const tabBtns     = document.querySelectorAll<HTMLElement>('[data-tab-btn]');
  const tabContents = document.querySelectorAll<HTMLElement>('[data-tab-content]');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.tabBtn!;
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      tabContents.forEach(el => { el.style.display = el.dataset.tabContent === t ? 'block' : 'none'; });
    });
  });

  document.querySelectorAll('[data-stat-panel]').forEach(panel => {
    const btn     = panel.querySelector<HTMLElement>('[data-stat-btn]');
    const content = panel.querySelector<HTMLElement>('[data-stat-content]');
    const chevron = panel.querySelector<HTMLElement>('[data-stat-chevron]');
    if (!btn || !content || !chevron) return;
    btn.addEventListener('click', () => {
      const open = content.style.display !== 'none';
      document.querySelectorAll('[data-stat-panel]').forEach(p => {
        const c  = p.querySelector<HTMLElement>('[data-stat-content]');
        const ch = p.querySelector<HTMLElement>('[data-stat-chevron]');
        if (c)  c.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { content.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });

  document.querySelectorAll('[data-faq-item]').forEach(item => {
    const btn     = item.querySelector<HTMLElement>('[data-faq-btn]');
    const answer  = item.querySelector<HTMLElement>('[data-faq-answer]');
    const chevron = item.querySelector<HTMLElement>('[data-faq-chevron]');
    if (!btn || !answer || !chevron) return;
    btn.addEventListener('click', () => {
      const open = answer.style.display !== 'none';
      document.querySelectorAll('[data-faq-item]').forEach(fi => {
        const a  = fi.querySelector<HTMLElement>('[data-faq-answer]');
        const ch = fi.querySelector<HTMLElement>('[data-faq-chevron]');
        if (a)  a.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { answer.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });
</script>

</BaseLayout>
