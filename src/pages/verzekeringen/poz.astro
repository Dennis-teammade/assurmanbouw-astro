<!-- DEKKING -->
<section id="dekking" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:1025px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Dekking</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat zit er in een POZ?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:600px;margin:0 auto;">Een POZ draait om pensioenopbouw met een fiscaal voordeel. Je kan er optioneel bescherming aan koppelen, zoals een overlijdens- of arbeidsongeschiktheidsdekking. Hieronder de hoofdlijnen.</p>
    </div>
    <div class="pz-dekking-grid">
      <div style="background:#FFFFFF;border:2px solid rgba(34,197,94,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(34,197,94,0.08);border-bottom:1px solid rgba(34,197,94,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#15803d;">Wel gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Opbouw van een aanvullend pensioenkapitaal, uitgekeerd bij je wettelijke pensioen','Een belastingvermindering van 30% op je gestorte premie, een federaal voordeel in de personenbelasting','Opbouw binnen de 80%-regel, berekend op je referentie-inkomen als zelfstandige','Een gegarandeerd rendement (tak21) of een rendement uit fondsen (tak23), naar keuze','Een optionele overlijdensdekking en aanvullende waarborgen, zoals premievrijstelling bij arbeidsongeschiktheid','Behoud van het opgebouwde kapitaal: het blijft van jou, ook als je je activiteit stopzet'].map(item=>(
