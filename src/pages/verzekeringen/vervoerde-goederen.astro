<!-- MIJN SITUATIE ACCORDION -->
<section id="vg-statuten" style="background:#3F5767;padding:96px 32px;position:relative;overflow:hidden;">
  <div style="max-width:840px;margin:0 auto;position:relative;z-index:1;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Mijn situatie</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Welke setup past bij jouw bestelwagen?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0 0 40px;">Drie typische situaties uit de Belgische bouw. Vind de jouwe en zie wat dat betekent voor je dekking.</p>

    <div class="vg-stat-panel" data-stat-panel>
      <button class="vg-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik laat mijn gereedschap 's nachts in de bestelwagen</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Veel stielmannen rijden 's avonds naar huis met de volle bestelwagen. Net dan slaan dieven toe. Daarom werken de meeste polissen met een nachtclausule: diefstal 's nachts op de openbare weg is enkel gedekt als je het voertuig in een afgesloten garage of achter een gesloten hek parkeert, of als het is uitgerust met een goedgekeurd alarm.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: controleer de exacte uren en beveiligingseisen van je nachtclausule. Er bestaan polissen zonder nachtclausule, maar de premie ligt daar merkelijk hoger. Vaak is een vaste stallingsplaats de eenvoudigste en goedkoopste oplossing.</p>
      </div>
    </div>

    <div class="vg-stat-panel" data-stat-panel>
      <button class="vg-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik heb één bestelwagen met duur materiaal achterin</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Eén installateur met warmtepompen, camera's en meetapparatuur achterin zit al snel aan een hoog verzekerd bedrag. De waarde van je lading kan de waarde van je bestelwagen overstijgen, terwijl je BA Auto en omnium daar niets van vergoeden.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: kies een verzekerd bedrag per voertuig dat past bij wat je doorgaans meeneemt, en bekijk een uitbreiding naar nieuwwaarde. Zo hoef je bij diefstal of brand de vervanging van je dure apparatuur niet uit eigen zak bij te leggen.</p>
      </div>
    </div>

    <div class="vg-stat-panel" data-stat-panel>
      <button class="vg-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik heb meerdere voertuigen en wissel materiaal uit</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Met een vloot bestelwagens stijgt niet alleen de kans op een schadegeval, maar wissel je ook gereedschap en machines tussen voertuigen en collega's. Toevertrouwd of gehuurd materieel is niet vanzelf mee verzekerd.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: een polis per nummerplaat houdt het beheer overzichtelijk, en een uitbreiding voor gehuurd en toevertrouwd materieel dekt de machines die niet je eigendom zijn. Zo valt niets tussen de mazen wanneer materiaal van de ene wagen op de andere belandt.</p>
      </div>
    </div>
  </div>
</section>

<!-- BIJ EEN SCHADEGEVAL -->
<section id="procedure" style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:60px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Bij een schadegeval</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat moet je doen bij schade, verlies of diefstal?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:520px;margin:0 auto;">Snel en correct melden bepaalt of je vlot vergoed wordt. Vier stappen.</p>
    </div>
    <div class="vg-procedure-grid">
      <div class="vg-procedure-line" style="position:absolute;top:36px;left:12.5%;right:12.5%;height:2px;background:linear-gradient(to right,#E5A524,rgba(229,165,36,0.2));z-index:0;"></div>
      {[
        {ic:'ph', title:'Beperk en beveilig',     text:'Breng jezelf en de lading in veiligheid en voorkom verdere schade. Sluit het voertuig af en zet beschadigde goederen droog of stabiel weg.'},
        {ic:'ac', title:'Bewijs en documenteer',  text:'Maak foto\'s van de schade, de inbraaksporen en de lading. Bij diefstal doe je onmiddellijk aangifte bij de politie en bewaar je het proces-verbaal.'},
        {ic:'ft', title:'Meld aan je makelaar',   text:'Verwittig je makelaar of verzekeraar zo snel mogelijk, doorgaans binnen de termijn die in je polis staat. Bezorg de foto\'s, het pv en de aankoopbewijzen van de goederen.'},
        {ic:'at', title:'Bewaar de bewijsstukken',text:'Hou facturen, aankoopbonnen en de gegevens over stuwing en parkeren bij. Daarmee toont de verzekeraar de waarde aan en gaat de vergoeding sneller.'},
      ].map((s,i)=>(
        <div style="padding:0 20px;text-align:center;position:relative;z-index:1;">
          <div style="width:72px;height:72px;border-radius:50%;background:#E5A524;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;box-shadow:0 4px 16px rgba(229,165,36,0.3);">
            {s.ic==='ph'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {s.ic==='ac'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>}
            {s.ic==='ft'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
            {s.ic==='at'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>}
          </div>
          <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#E5A524;margin-bottom:8px;">Stap {i+1}</div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{s.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:840px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Veelgestelde vragen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 12px;">Veelgestelde vragen over vervoerde goederen</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;margin:0;">12 concrete vragen van bouwondernemers: klik open voor het antwoord.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      {faqItems.map((item,i)=>(
        <div data-faq-item style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.08);border-radius:10px;overflow:hidden;">
          <button data-faq-btn style="width:100%;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;background:none;border:none;cursor:pointer;text-align:left;gap:16px;">
            <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;line-height:1.35;">{item.q}</span>
            <svg data-faq-chevron width="18" height="18" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div data-faq-answer style="display:none;padding:0 24px 20px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#3F5767;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GERELATEERDE VERZEKERINGEN -->
<InsuranceCarousel
  client:only="react"
  cards={insuranceCards}
  sectionLabel="Ook interessant"
  headline="Gerelateerde verzekeringen"
  subheadline="Deze verzekeringen beschermen je materiaal en je voertuigen naast je vervoerde goederen."
  background="#F5F2FF"
/>

<!-- PARTNERS -->
<section style="background:#F7F4EF;padding:64px 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;text-align:center;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:36px;">Ondersteund door sterke verzekeringspartners</p>
    <PartnerSlider client:only="react" />
  </div>
</section>

<!-- FINAL CTA -->
<section style="background:#3F5767;padding-top:120px;padding-bottom:0;position:relative;text-align:center;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;"></div>
  <div style="max-width:896px;margin:0 auto;padding:0 32px;position:relative;z-index:2;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;text-align:center;margin-bottom:20px;">Start met Assurman</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(32px,4vw,48px);line-height:1;color:#FFFFFF;max-width:727px;margin:0 auto 24px;">Is je gereedschap onderweg goed verzekerd?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:22px;line-height:1.4;color:#CBD5E1;max-width:832px;margin:0 auto 48px;">Werk je in de bouwsector en wil je zeker zijn dat je materiaal in de bestelwagen gedekt is tegen diefstal en schade? Wij bekijken met jou wat echt nodig is, zonder verplichting.</p>
    <div class="vg-final-btns">
      <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;box-shadow:0px 10px 15px -3px rgba(0,0,0,0.1);">{CTA_SCAN.hero} <Fragment set:html={svgArr18} /></a>
      <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.2);">{CTA_AFSPRAAK.advisory}</a>
    </div>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
</section>

</div>

<script>
  const progressBar = document.getElementById('vg-progress-bar') as HTMLElement | null;
  const stickyBtns  = document.querySelectorAll<HTMLElement>('[data-sticky-btn]');
  const sectionIds  = ['watis','verplicht','dekking','premie','procedure','faq'];

  stickyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.stickyBtn!;
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });

  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const total = doc.scrollHeight - doc.clientHeight;
    if (progressBar) progressBar.style.width = total > 0 ? `${(doc.scrollTop / total) * 100}%` : '0%';
    for (let i = sectionIds.length - 1; i >= 0; i--) {
      const el = document.getElementById(sectionIds[i]);
      if (el && el.getBoundingClientRect().top <= 120) {
        stickyBtns.forEach(b => b.classList.toggle('active', b.dataset.stickyBtn === sectionIds[i]));
        break;
      }
    }
  }, { passive: true });

  const exBtn  = document.getElementById('vg-examples-btn')     as HTMLElement | null;
  const exList = document.getElementById('vg-examples-list')    as HTMLElement | null;
  const exChev = document.getElementById('vg-examples-chevron') as HTMLElement | null;
  if (exBtn && exList && exChev) {
    exBtn.addEventListener('click', () => {
      const open = exList.style.display !== 'none';
      exList.style.display = open ? 'none' : 'grid';
      exChev.style.transform = open ? '' : 'rotate(180deg)';
    });
  }

  const tabBtns     = document.querySelectorAll<HTMLElement>('[data-tab-btn]');
  const tabContents = document.querySelectorAll<HTMLElement>('[data-tab-content]');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.tabBtn!;
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      tabContents.forEach(el => { el.style.display = el.dataset.tabContent === t ? 'block' : 'none'; });
    });
  });

  document.querySelectorAll('[data-stat-panel]').forEach(panel => {
    const btn     = panel.querySelector<HTMLElement>('[data-stat-btn]');
    const content = panel.querySelector<HTMLElement>('[data-stat-content]');
    const chevron = panel.querySelector<HTMLElement>('[data-stat-chevron]');
    if (!btn || !content || !chevron) return;
    btn.addEventListener('click', () => {
      const open = content.style.display !== 'none';
      document.querySelectorAll('[data-stat-panel]').forEach(p => {
        const c  = p.querySelector<HTMLElement>('[data-stat-content]');
        const ch = p.querySelector<HTMLElement>('[data-stat-chevron]');
        if (c)  c.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { content.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });

  document.querySelectorAll('[data-faq-item]').forEach(item => {
    const btn     = item.querySelector<HTMLElement>('[data-faq-btn]');
    const answer  = item.querySelector<HTMLElement>('[data-faq-answer]');
    const chevron = item.querySelector<HTMLElement>('[data-faq-chevron]');
    if (!btn || !answer || !chevron) return;
    btn.addEventListener('click', () => {
      const open = answer.style.display !== 'none';
      document.querySelectorAll('[data-faq-item]').forEach(fi => {
        const a  = fi.querySelector<HTMLElement>('[data-faq-answer]');
        const ch = fi.querySelector<HTMLElement>('[data-faq-chevron]');
        if (a)  a.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { answer.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });
</script>

</BaseLayout>
