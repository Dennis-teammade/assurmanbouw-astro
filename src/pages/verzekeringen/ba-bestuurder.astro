        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:6px;">Richtwaarde</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:44px;color:#FFFFFF;letter-spacing:-1px;line-height:1;">€ 250.000</div>
        <div style="font-family:'Outfit',sans-serif;font-size:14px;color:#94a3b8;margin-top:6px;">verzekerd kapitaal (indicatief)</div>
      </div>
    </div>
  </div>
</section>

<!-- AANVULLENDE WAARBORGEN -->
<section id="bab-aanvulling" style="background:#3F5767;padding:0 0 96px;position:relative;overflow:hidden;">
