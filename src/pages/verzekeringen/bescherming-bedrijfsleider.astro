---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { kaartenVoor } from '../../data/verzekeringen';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const faqItems = [
  { q: 'Wat is een bescherming bedrijfsleider of keyman-verzekering?', a: 'Het is een dekking op het hoofd van je zaakvoerder of een onmisbare sleutelfiguur. Bij overlijden, en optioneel bij langdurige arbeidsongeschiktheid, keert ze een kapitaal uit aan je vennootschap om de continuïteit te garanderen. De vennootschap is verzekeringnemer én begunstigde.' },
  { q: 'Wie krijgt het geld bij een keyman-verzekering?', a: 'De vennootschap zelf. Het kapitaal gaat dus niet rechtstreeks naar de familie van de zaakvoerder, maar dient om de werking van het bedrijf overeind te houden: een vervanger aanwerven, omzetverlies opvangen of een krediet aflossen.' },
  { q: 'Wat is het verschil met een persoonlijke overlijdensverzekering voor mijn gezin?', a: 'Bij een keyman-verzekering is de vennootschap de begunstigde. Wil je je partner of kinderen beschermen bij je overlijden, dan heb je een aparte persoonlijke overlijdensdekking nodig waarbij zij de begunstigden zijn. De twee vullen elkaar aan.' },
  { q: 'Wat is het verschil met BA Bestuurder?', a: 'BA Bestuurder dekt je persoonlijke aansprakelijkheid als bestuurder voor fouten in je mandaat. Een bescherming bedrijfsleider dekt het wegvallen van een sleutelfiguur en de continuïteit van het bedrijf. Het zijn twee verschillende risico\'s en twee aparte polissen.' },
  { q: 'Wie kan ik als sleutelfiguur verzekeren?', a: 'Iemand wiens wegvallen een directe, zware impact heeft op je bedrijfsvoering: de zaakvoerder, een werfleider, een hoofdberekenaar of een enige gecertificeerde technieker. Een willekeurige medewerker zonder die impact aanvaardt de fiscus niet als verzekerbare sleutelfiguur.' },
  { q: 'Zijn de premies fiscaal aftrekbaar?', a: 'In principe wel, als beroepskost van de vennootschap op basis van artikel 49 WIB92. Voorwaarde is dat de vennootschap de begunstigde is en kan aantonen dat het wegvallen van de sleutelfiguur een reëel financieel risico vormt. Laat dit altijd door je boekhouder bevestigen.' },
  { q: 'Hoe wordt de uitkering belast?', a: 'De uitkering die de vennootschap ontvangt, wordt als een uitzonderlijke opbrengst belast in de vennootschapsbelasting. Het exacte tarief hangt af van je situatie; je boekhouder licht dit toe.' },
  { q: 'Is arbeidsongeschiktheid ook gedekt?', a: 'Overlijden is de basis. Langdurige of blijvende arbeidsongeschiktheid is meestal een optionele uitbreiding, die een kapitaal of een maandelijkse rente aan de vennootschap uitkeert. Er geldt een wachttijd vóór de rente start.' },
  { q: 'Hoeveel kapitaal heb ik nodig?', a: 'Vaak vertrek je van de vaste kosten over één à twee jaar, of van de kostprijs om een gelijkwaardige vervanger te rekruteren en in te werken. In de bouw ligt dat doorgaans tussen € 100.000 en € 500.000, maar het hangt af van je concrete situatie.' },
  { q: 'Kan de verzekering helpen om mede-vennoten uit te kopen?', a: 'Ja. Met een uitkoopclausule dient het kapitaal om de aandelen van een overleden vennoot over te nemen, zodat de overblijvende vennoten de controle houden zonder de werkingsmiddelen aan te spreken of te herfinancieren.' },
  { q: 'Wat is het verschil met een schuldsaldoverzekering?', a: 'Een schuldsaldoverzekering hangt vast aan een specifiek krediet en lost bij overlijden de schuld rechtstreeks bij de bank af. Een keyman-verzekering keert een vrij besteedbaar kapitaal uit aan de vennootschap voor de algemene werking, niet voor één krediet.' },
  { q: 'Hoe hangt dit samen met mijn IPT of groepsverzekering?', a: 'Een IPT of groepsverzekering is in de eerste plaats pensioenopbouw, met soms een overlijdens- of invaliditeitsluik. Een bescherming bedrijfsleider focust op de continuïteit van het bedrijf. We stemmen ze op elkaar af zodat ze elkaar aanvullen in plaats van overlappen.' },
];

const beroepTabs = [
  { id: 'dakwerkers',    label: 'Dakwerkers',        link: '/sectoren/dakwerkers',    title: 'Voor dakwerkers',                    text: 'In een dakwerkersbedrijf draait alles vaak rond de ervaren ploegbaas die de complexe werken inschat en de mannen aanstuurt. Valt die weg, dan liggen de moeilijke daken stil en moet je dringend evenwaardige expertise inkopen. Een keyman-bescherming geeft je de tijd en middelen om dat correct op te lossen.' },
  { id: 'metsers',       label: 'Metsers',            link: '/sectoren/aannemers',     title: 'Voor metsers en algemene aannemers', text: 'Als algemene aannemer hangt je omzet vast aan de zaakvoerder die calculeert, onderhandelt en de planning bewaakt. Overlijdt of valt die langdurig uit, dan dreigen lopende offertes en werven te ontsporen. De uitkering aan de vennootschap financiert een vervanger en houdt je werven recht.' },
  { id: 'loodgieters',   label: 'Loodgieters',        link: '/sectoren/loodgieters',   title: 'Voor loodgieters',                   text: 'Veel loodgietersbedrijven draaien op één gecertificeerde vakman die de installaties keurt en de klanten kent. Zonder hem kan je bepaalde opdrachten wettelijk niet meer uitvoeren. Een bescherming op zijn hoofd overbrugt de zoektocht naar een gelijkwaardige opvolger.' },
  { id: 'elektriciens',  label: 'Elektriciens',       link: '/sectoren/elektriciens',  title: 'Voor elektriciens',                  text: 'Een elektriciensbedrijf leunt vaak op de zaakvoerder of hoofdtechnieker met de juiste attesten en keuringsbevoegdheid. Valt die weg, dan stokken de keuringen en de oplevering van installaties. De keyman-uitkering geeft je bedrijf ademruimte om die kennis opnieuw binnen te halen.' },
  { id: 'schilders',     label: 'Schilders',          link: '/sectoren/schilders',     title: 'Voor schilders',                     text: 'In een schildersvennootschap is het vaak de zaakvoerder die de offertes maakt, de klanten bindt en de planning regelt. Zijn wegvallen legt de commerciële motor stil, ook al kunnen de ploegen blijven werken. Een continuïteitsdekking houdt de zaak rendabel terwijl je herorganiseert.' },
  { id: 'schrijnwerkers',label: 'Schrijnwerkers',     link: '/sectoren/schrijnwerkers',title: 'Voor schrijnwerkers',                text: 'Bij een schrijnwerkerij zit de meerwaarde vaak in de meester-vakman die maatwerk tekent, calculeert en uitvoert. Valt die persoon weg, dan stokken de lopende bestellingen en voorschotten. De uitkering aan de vennootschap financiert de vervanging zonder dat je klanten in de kou staan.' },
];

const insuranceCards = kaartenVoor(['gewaarborgd-inkomen', 'aanvullend-pensioen', 'groepsverzekering', 'ba-bestuurder']);

const schema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const svgCheck16g = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
const svgX16r    = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
const svgArr18   = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout
  title="Bescherming bedrijfsleider: continuïteit bij uitval | Assurman"
  description="Valt je zaakvoerder of sleutelfiguur weg door overlijden of langdurige uitval? Een keyman-verzekering keert een kapitaal uit aan je vennootschap. Doe de scan."
  canonical="/verzekeringen/bescherming-bedrijfsleider/"
  schema={schema}
>

<style is:global>
  .bb-sticky-btn{background:#F7F4EF;border:1px solid rgba(229,165,36,0.2);cursor:pointer;padding:7px 16px;margin:10px 5px;font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border-radius:9999px;transition:background 0.2s,border-color 0.2s;color:#001F3F;}
  .bb-sticky-btn:hover,.bb-sticky-btn.active{background:rgba(229,165,36,0.18);border-color:#E5A524;}
  .bb-sticky-btn .bb-check{color:#94a3b8;flex-shrink:0;transition:color 0.2s;}
  .bb-sticky-btn:hover .bb-check,.bb-sticky-btn.active .bb-check{color:#E5A524;}
  .bb-tab-btn{background:none;border:none;cursor:pointer;padding:14px 24px;white-space:nowrap;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#64748b;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color 0.2s,border-color 0.2s;}
  .bb-tab-btn:hover,.bb-tab-btn.active{color:#E5A524;border-bottom-color:#E5A524;}
  .bb-ins-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);transition:background 0.2s,transform 0.2s;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);}
  .bb-ins-card:hover{background:rgba(255,255,255,0.1);transform:translateY(-4px);}
  .bb-stat-panel{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;margin-bottom:12px;}
  .bb-stat-btn{width:100%;display:flex;align-items:center;gap:14px;background:none;border:none;cursor:pointer;text-align:left;padding:20px 24px;}
  .bb-scan-btn:hover{background:#324554 !important;}
  .bb-badge-pill{display:inline-flex;align-items:center;gap:8px;background:#F5F2FF;border:1px solid rgba(213,196,174,0.2);border-radius:9999px;padding:6px 16px;font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#001F3F;}
</style>

<style>
  .bb-hero-img{position:absolute;top:5vh;right:-5px;height:85vh;width:auto;max-width:48%;z-index:1;pointer-events:none;}
  .bb-hero-content{max-width:620px;}
  .bb-hero-inner{max-width:1280px;margin:0 auto;padding:64px 32px 80px;position:relative;z-index:2;}
  .bb-hero-btns{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:32px;}
  .bb-watis-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:flex-start;}
  .bb-verplicht-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .bb-dekking-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;}
  .bb-plafond-grid{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
  .bb-aanvulling-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .bb-rules-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:32px 0;}
  .bb-formule{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:64px;flex-wrap:wrap;}
  .bb-factors-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:800px;margin:0 auto 40px;}
  .bb-procedure-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
  .bb-tab-inner{display:flex;gap:32px;align-items:flex-start;border-radius:12px;}
  .bb-final-btns{display:flex;gap:24px;justify-content:center;margin-bottom:80px;flex-wrap:wrap;}
  .bb-sticky-nav-bar{position:sticky;top:72px;z-index:90;background:#FFFFFF;border-bottom:1px solid rgba(0,31,63,0.08);overflow:auto;}
  .bb-sticky-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;gap:0;justify-content:center;flex-wrap:wrap;}
  .bb-container{max-width:1280px;margin:0 auto;padding:0 32px;}
  .brand-why-card{background:#FFFFFF;border-left:4px solid #E5A524;box-shadow:0px 1px 2px rgba(0,0,0,0.05);transition:box-shadow 0.2s,transform 0.2s;}
  .brand-why-card:hover{box-shadow:0 8px 24px rgba(0,0,0,0.1);transform:translateY(-2px);}

  @media (max-width:1023px){
    .bb-container{padding:0 24px;}
    .bb-sticky-inner{padding:0 24px;}
    .bb-watis-grid{grid-template-columns:1fr;gap:32px;}
    .bb-verplicht-grid{grid-template-columns:repeat(2,1fr);}
    .bb-aanvulling-grid{grid-template-columns:repeat(2,1fr);}
    .bb-procedure-grid{grid-template-columns:repeat(2,1fr);gap:32px;}
    .bb-factors-grid{grid-template-columns:1fr;}
  }
  @media (max-width:767px){
    .bb-sticky-nav-bar{display:none;}
    .bb-container{padding:0 15px;}
    .bb-hero-content{max-width:100%;}
    .bb-hero-img{display:none;}
    .bb-hero-btns{flex-direction:column;}
    .bb-hero-btns a{width:100%;justify-content:center;text-align:center;}
    #watis{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #verplicht{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #dekking{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #premie{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #procedure{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #faq{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #bb-beroep{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #bb-statuten{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #bb-aanvulling{padding-bottom:56px !important;}
    #bb-cta-band{padding-left:15px !important;padding-right:15px !important;padding-bottom:64px !important;}
    #bb-cta-band h2{font-size:clamp(28px,8vw,48px) !important;}
    #bb-cta-band p{font-size:18px !important;}
    .bb-watis-grid{grid-template-columns:1fr;gap:24px;}
    .bb-verplicht-grid{grid-template-columns:1fr;}
    .bb-dekking-grid{grid-template-columns:1fr;}
    .bb-plafond-grid{grid-template-columns:1fr;}
    .bb-plafond-grid>div:last-child{text-align:center;padding-top:24px;border-top:1px solid rgba(255,255,255,0.15);}
    .bb-aanvulling-grid{grid-template-columns:1fr;}
    .bb-rules-grid{grid-template-columns:1fr;}
    .bb-formule{flex-direction:column;gap:8px;margin-bottom:40px;}
    .bb-factors-grid{grid-template-columns:1fr;}
    .bb-procedure-grid{grid-template-columns:1fr 1fr;gap:32px;}
    .bb-tab-inner{flex-direction:column;gap:20px;padding:24px 20px;}
    .bb-tabs-row{overflow-x:auto;justify-content:flex-start !important;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
    .bb-final-btns{flex-direction:column;align-items:center;}
    .bb-final-btns a{width:100%;max-width:400px;justify-content:center;}
    .bb-cta-deco{display:none;}
    .bb-cta-mask-img{display:none;}
    .bb-procedure-line{display:none !important;}
  }
</style>

<div id="bb-progress-track" style="position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;background:rgba(0,31,63,0.07);">
  <div id="bb-progress-bar" style="height:100%;background:#E5A524;width:0%;transition:width 0.1s linear;"></div>
</div>

<div style="font-family:'Outfit',sans-serif;color:#001F3F;background:#FFFFFF;">

<!-- HERO -->
<section id="bb-hero" style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:100vh;">
  <div class="bb-hero-img assurman-mask assurman-mask--hero">
    <img src="/images/verzekeringen/bescherming-bedrijfsleider-hero.jpg" alt="Zaakvoerder van een bouwbedrijf, beschermd door een keyman-verzekering" />
  </div>
  <div class="bb-hero-inner">
    <div class="bb-hero-content">
      <div class="bb-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman &middot; Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(40px,5vw,64px);line-height:1.08;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">Bescherming bedrijfsleider<br />voor je bouwbedrijf</h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,34px);line-height:1.1;color:#E5A524;margin-bottom:20px;">Hou je zaak recht als de sleutelfiguur wegvalt.</p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:#001F3F;margin-bottom:28px;max-width:520px;">Eén persoon doet de calculaties, kent de klanten en stuurt de werven. Valt die weg door overlijden of langdurige uitval, dan wankelt je hele bedrijf. Een bescherming op het hoofd van die sleutelfiguur keert een kapitaal uit aan je vennootschap, zodat de werking doorloopt.</p>
      <div class="bb-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          {CTA_SCAN.hero}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">{CTA_AFSPRAAK.advisory}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;">Geen verkooppraatjes: we bepalen samen wie of wat je bedrijf echt recht houdt.</p>
    </div>
  </div>
</section>

<!-- STICKY NAV -->
<nav id="bb-sticky-nav" class="bb-sticky-nav-bar">
  <div class="bb-sticky-inner">
    {[{id:'watis',label:'Wat is het?'},{id:'verplicht',label:'Verplicht?'},{id:'dekking',label:'Dekking'},{id:'premie',label:'Premie'},{id:'procedure',label:'Bij uitval'},{id:'faq',label:'FAQ'}].map(item=>(
      <button class="bb-sticky-btn" data-sticky-btn={item.id}>
        <svg class="bb-check" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {item.label}
      </button>
    ))}
  </div>
</nav>

<!-- WAT IS HET -->
<section id="watis" style="background:#FFFFFF;padding:96px 32px;">
  <div class="bb-container">
    <div class="bb-watis-grid">
      <div style="background:#3F5767;padding:32px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);">
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In het kort</span>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
          {[
            {t:'Beschermt de <strong style="color:#FFFFFF;">continuïteit van je vennootschap</strong> als een onmisbare sleutelfiguur of zaakvoerder wegvalt.'},
            {t:'Keert een <strong style="color:#FFFFFF;">kapitaal uit aan de vennootschap</strong> bij overlijden, en optioneel bij langdurige arbeidsongeschiktheid.'},
            {t:'De vennootschap is <strong style="color:#FFFFFF;">verzekeringnemer én begunstigde</strong>: het geld dient om de zaak verder te zetten, niet om je gezin te beschermen.'},
            {t:'Vrij besteedbaar: <strong style="color:#FFFFFF;">vervanger aanwerven, omzetverlies opvangen, krediet aflossen of mede-vennoten uitkopen</strong>.'},
            {t:'Niet wettelijk verplicht, maar <strong style="color:#FFFFFF;">strategisch cruciaal voor kmo\'s</strong> die op één of twee mensen draaien.'},
          ].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.55;color:#CBD5E1;" set:html={item.t}></span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wat is het?</span>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 24px;">De bescherming die je bedrijf overeind houdt</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Bescherming bedrijfsleider is een <strong>verzamelnaam voor de polissen die de continuïteit van je vennootschap beschermen</strong> wanneer een onmisbare persoon wegvalt. De kern is een <strong>keyman- of bedrijfsleidersverzekering</strong>: een dekking op het hoofd van je zaakvoerder of een sleutelfiguur die bij overlijden, en optioneel bij langdurige arbeidsongeschiktheid, een kapitaal aan de vennootschap uitkeert.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Het verschil met een gewone overlijdensverzekering zit in de begunstigde. Hier is <strong>de vennootschap zowel verzekeringnemer als begunstigde</strong>. Het kapitaal dient om de zaak draaiende te houden: een vervanger aanwerven, omzetverlies overbruggen of een mede-vennoot uitkopen. <strong>Wil je je gezin beschermen bij je overlijden, dan heb je een aparte persoonlijke overlijdensdekking nodig</strong> waarbij je partner of kinderen de begunstigde zijn.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 36px;">Let op de term bedrijfsleidersverzekering: sommigen gebruiken die voor deze keyman-bescherming, anderen voor de aansprakelijkheid van de bestuurder (BA Bestuurder). Hier bedoelen we de bescherming van de continuïteit, niet de aansprakelijkheid.</p>
        <div style="display:flex;gap:20px;background:rgba(229,165,36,0.07);border:1px solid rgba(229,165,36,0.22);border-radius:10px;padding:24px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 6px;">Wettelijke basis</p>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">De verzekering valt onder de <strong>Wet van 4 april 2014 betreffende de verzekeringen</strong>, onder toezicht van de FSMA. De fiscale aftrekbaarheid steunt op <strong>artikel 49 van het Wetboek van de Inkomstenbelastingen (WIB92)</strong>: de vennootschap moet aantonen dat het wegvallen van de sleutelfiguur een reëel financieel risico is, en moet zelf de begunstigde zijn.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- IS HET VERPLICHT -->
