---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const faqItems = [
  { q: 'Wanneer is BA-10 wettelijk verplicht?', a: 'Voor woningbouw of -renovatie met tussenkomst van een architect en bouwvergunning vanaf 1 juli 2018. Voor andere werken is ze vrijwillig.' },
  { q: 'Wat is het minimumplafond?', a: '500.000 euro per schadegeval, geïndexeerd via de ABEX-bouwindex. Bij lagere wederopbouwwaarde geldt die waarde als plafond.' },
  { q: 'Wat dekt BA-10 precies?', a: 'Schade aan stabiliteit, soliditeit en waterdichtheid die de stabiliteit raakt. De polis dekt zware structurele schade tot tien jaar na oplevering.' },
  { q: 'Wat valt buiten BA-10?', a: 'Esthetische schade, materiële schade onder 2.500 euro en zuiver immateriële schade zonder structurele oorzaak.' },
  { q: 'Wat als je geen attest kan voorleggen?', a: 'Je mag de werf niet betreden. De wet voorziet bovendien een strafrechtelijke geldboete tot 80.000 euro.' },
  { q: 'Wat is het verschil met BA Onderneming?', a: 'BA Onderneming dekt schade aan derden tijdens je activiteit. BA-10 dekt zware structuurschade tot tien jaar na oplevering. Beide zijn complementair.' },
  { q: 'Is BA-10 voor renovatie ook verplicht?', a: 'Alleen als de tussenkomst van een architect verplicht is voor de renovatie. Voor kleinere renovaties zonder architect is BA-10 niet wettelijk verplicht.' },
  { q: 'Wat is een globale BA-10 polis?', a: 'Eén polis voor al je werven in plaats van een polis per project. Bij meer dan acht werven per jaar vaak voordeliger.' },
  { q: 'Wat als mijn onderaannemer geen BA-10 heeft?', a: 'Je riskeert mee aansprakelijk gehouden te worden voor zijn aandeel. Eis vóór werfstart altijd een actueel attest.' },
  { q: 'Hoe lang loopt de dekking?', a: 'Tien jaar na de voorlopige oplevering van de werf. Schade die in die periode wordt vastgesteld, valt onder de polis.' },
  { q: 'Wat als mijn bedrijf failliet gaat?', a: 'De BA-10 polis blijft lopen voor schade aan reeds opgeleverde werven. De bouwheer behoudt zijn recht op vergoeding.' },
  { q: 'Wordt mijn premie elk jaar herzien?', a: 'Globale polissen worden jaarlijks afgerekend op basis van de werkelijk aangenomen werven. Per-werf polissen lopen door tot het einde van de tienjaarperiode.' },
  { q: 'Wie controleert of je in orde bent?', a: 'De FOD Economie ziet toe op de naleving van de verzekeringsverplichting. De FSMA controleert de verzekeraars zelf.' },
  { q: 'Geldt BA-10 ook voor mijn bestaande werven?', a: 'De wet geldt voor werven met vergunning vanaf 1 juli 2018. Oudere werven volgen de eerdere regels van het Burgerlijk Wetboek.' },
];

const beroepTabs = [
  { id: 'dakwerkers',    label: 'Dakwerkers',    link: '/sectoren/dakwerkers',    title: 'Voor dakwerkers',                    text: 'Daken zijn dragend en bepalen de waterdichtheid van het gebouw. Een dakfout valt vaak onder BA-10 want hij raakt zowel stabiliteit als waterdichtheid. Voor dakwerkers in nieuwbouw woningbouw is BA-10 wettelijk verplicht.' },
  { id: 'metsers',       label: 'Metsers',        link: '/sectoren/aannemers',     title: 'Voor metsers en algemene aannemers', text: 'Funderingen, dragende muren en pleisterwerk vormen de kern van je activiteit. Stabiliteitsproblemen na enkele jaren komen vaker voor dan je denkt. BA-10 is voor metsers in woningbouw met architect altijd verplicht.' },
  { id: 'loodgieters',   label: 'Loodgieters',    link: '/sectoren/loodgieters',   title: 'Voor loodgieters',                   text: 'Een lek dat na jaren de structuur van het gebouw aantast, kan onder BA-10 vallen. Voor zuiver sanitair zonder structurele impact is BA-10 niet wettelijk verplicht. Beoordeel per project of je werk de stabiliteit kan raken.' },
  { id: 'elektriciens',  label: 'Elektriciens',   link: '/sectoren/elektriciens',  title: 'Voor elektriciens',                  text: 'Brandschade door een installatiefout kan jaren later de structuur aantasten. In dat geval valt het stabiliteitsdeel onder BA-10. Voor zuiver elektrisch werk zonder structurele impact is BA-10 niet wettelijk verplicht.' },
  { id: 'schilders',     label: 'Schilders',      link: '/sectoren/schilders',     title: 'Voor schilders',                     text: 'Schilderwerk valt buiten BA-10, want esthetische schade is uitgesloten van de wettelijke dekking. Toch blijft civiele aansprakelijkheid van toepassing op zware uitvoeringsfouten. Voor de meeste schilders is BA-10 niet verplicht.' },
  { id: 'schrijnwerkers',label: 'Schrijnwerkers', link: '/sectoren/schrijnwerkers',title: 'Voor schrijnwerkers',                text: 'Houten dragende structuren vallen onder BA-10 wanneer ze de stabiliteit van het gebouw bepalen. Niet-dragend binnen-schrijnwerk valt buiten de wettelijke verplichting. Beoordeel per project of je werk in scope ligt.' },
];

const insuranceCards = [
  { title: 'BA Onderneming',           icon: 'shield',    intro: 'Bescherming wanneer je bedrijf schade veroorzaakt aan derden tijdens de uitbating of beroepsactiviteit.',  bullets: ['Schade aan eigendommen van derden','Letselschade aan derden','Claims rond beroepsfouten','Aansprakelijkheid tijdens werken'],   link: '/verzekeringen/ba-onderneming',        cta: 'Meer over BA Onderneming' },
  { title: 'Arbeidsongevallen',        icon: 'users',     intro: 'Wettelijk verplicht vanaf je eerste werknemer. Dekt letsel op de werf en woon-werkverkeer.',               bullets: ['Verplicht vanaf dag 1','Medische kosten gedekt','Woon-werkverkeer inbegrepen','Aangifte binnen 8 dagen'],                    link: '/verzekeringen/arbeidsongevallen',      cta: 'Meer over arbeidsongevallen' },
  { title: 'Machinebreuk',             icon: 'wrench',    intro: 'Professionele machines en gereedschap zijn duur. Een defect of diefstal stopt je werk — deze dekking niet.', bullets: ['Machines en gereedschap bij breuk','Diefstal op werf of in bestelwagen','Vervanging of herstelling','Op maat van je materieel'], link: '/verzekeringen/machinebreuk',          cta: 'Meer over machinebreuk' },
  { title: 'Rechtsbijstand',           icon: 'scale',     intro: 'Juridische bescherming bij geschillen met klanten, leveranciers of personeel. Je staat niet alleen.',       bullets: ['Hulp bij juridische conflicten','Vrije advocaatkeuze','Tussenkomst bij advocaatkosten','Aanvulling op BA'],              link: '/verzekeringen/rechtsbijstand',        cta: 'Meer over rechtsbijstand' },
];

const schema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const svgCheck16g = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
const svgX16r    = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
const svgArr18   = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout
  title="BA-10 voor aannemers — verplichte tienjarige aansprakelijkheid | Assurman"
  description="BA-10 is verplicht in de woningbouw. Wat dekt ze, wat kost ze en wat riskeer je zonder attest? Alle uitleg op één pagina."
  canonical="/verzekeringen/ba-10"
  schema={schema}
>

<style is:global>
  .ba10-sticky-btn{background:#F7F4EF;border:1px solid rgba(229,165,36,0.2);cursor:pointer;padding:7px 16px;margin:10px 5px;font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border-radius:9999px;transition:background 0.2s,border-color 0.2s;color:#001F3F;}
  .ba10-sticky-btn:hover,.ba10-sticky-btn.active{background:rgba(229,165,36,0.18);border-color:#E5A524;}
  .ba10-sticky-btn .ba10-check{color:#94a3b8;flex-shrink:0;transition:color 0.2s;}
  .ba10-sticky-btn:hover .ba10-check,.ba10-sticky-btn.active .ba10-check{color:#E5A524;}
  .ba10-tab-btn{background:none;border:none;cursor:pointer;padding:14px 24px;white-space:nowrap;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#64748b;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color 0.2s,border-color 0.2s;}
  .ba10-tab-btn:hover,.ba10-tab-btn.active{color:#E5A524;border-bottom-color:#E5A524;}
  .ba10-ins-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);transition:background 0.2s,transform 0.2s;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);}
  .ba10-ins-card:hover{background:rgba(255,255,255,0.1);transform:translateY(-4px);}
  .ba10-stat-panel{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;margin-bottom:12px;}
  .ba10-stat-btn{width:100%;display:flex;align-items:center;gap:14px;background:none;border:none;cursor:pointer;text-align:left;padding:20px 24px;}
  .ba10-scan-btn:hover{background:#324554 !important;}
  .ba10-badge-pill{display:inline-flex;align-items:center;gap:8px;background:#F5F2FF;border:1px solid rgba(213,196,174,0.2);border-radius:9999px;padding:6px 16px;font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#001F3F;}
</style>

<style>
  .ba10-hero-img{position:absolute;top:5%;right:-5px;height:85%;width:auto;max-width:48%;z-index:1;pointer-events:none;}
  .ba10-hero-content{max-width:620px;}
  .ba10-hero-inner{max-width:1280px;margin:0 auto;padding:64px 32px 80px;position:relative;z-index:2;}
  .ba10-hero-btns{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:32px;}
  .ba10-watis-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:flex-start;}
  .ba10-verplicht-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .ba10-dekking-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;}
  .ba10-plafond-grid{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
  .ba10-aanvulling-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .ba10-formule{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:64px;flex-wrap:wrap;}
  .ba10-factors-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:800px;margin:0 auto 40px;}
  .ba10-procedure-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
  .ba10-tab-inner{display:flex;gap:32px;align-items:flex-start;border-radius:12px;}
  .ba10-final-btns{display:flex;gap:24px;justify-content:center;margin-bottom:80px;flex-wrap:wrap;}
  .ba10-sticky-nav-bar{position:sticky;top:72px;z-index:90;background:#FFFFFF;border-bottom:1px solid rgba(0,31,63,0.08);overflow:auto;}
  .ba10-sticky-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;gap:0;justify-content:center;flex-wrap:wrap;}
  .ba10-container{max-width:1280px;margin:0 auto;padding:0 32px;}
  .brand-why-card{background:#FFFFFF;border-left:4px solid #E5A524;box-shadow:0px 1px 2px rgba(0,0,0,0.05);transition:box-shadow 0.2s,transform 0.2s;}
  .brand-why-card:hover{box-shadow:0 8px 24px rgba(0,0,0,0.1);transform:translateY(-2px);}

  @media (max-width:1023px){
    .ba10-container{padding:0 24px;}
    .ba10-sticky-inner{padding:0 24px;}
    .ba10-watis-grid{grid-template-columns:1fr;gap:32px;}
    .ba10-verplicht-grid{grid-template-columns:repeat(2,1fr);}
    .ba10-aanvulling-grid{grid-template-columns:repeat(2,1fr);}
    .ba10-procedure-grid{grid-template-columns:repeat(2,1fr);gap:32px;}
    .ba10-factors-grid{grid-template-columns:1fr;}
  }
  @media (max-width:767px){
    .ba10-sticky-nav-bar{display:none;}
    .ba10-container{padding:0 15px;}
    .ba10-hero-content{max-width:100%;}
    .ba10-hero-img{display:none;}
    .ba10-hero-btns{flex-direction:column;}
    .ba10-hero-btns a{width:100%;justify-content:center;text-align:center;}
    #watis{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #verplicht{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #dekking{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #premie{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #procedure{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #faq{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #ba10-beroep{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #ba10-statuten{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #ba10-aanvulling{padding-bottom:56px !important;}
    #ba10-cta-band{padding-left:15px !important;padding-right:15px !important;padding-bottom:64px !important;}
    #ba10-cta-band h2{font-size:clamp(28px,8vw,48px) !important;}
    #ba10-cta-band p{font-size:18px !important;}
    .ba10-watis-grid{grid-template-columns:1fr;gap:24px;}
    .ba10-verplicht-grid{grid-template-columns:1fr;}
    .ba10-dekking-grid{grid-template-columns:1fr;}
    .ba10-plafond-grid{grid-template-columns:1fr;}
    .ba10-plafond-grid>div:last-child{text-align:center;padding-top:24px;border-top:1px solid rgba(255,255,255,0.15);}
    .ba10-aanvulling-grid{grid-template-columns:1fr;}
    .ba10-formule{flex-direction:column;gap:8px;margin-bottom:40px;}
    .ba10-factors-grid{grid-template-columns:1fr;}
    .ba10-procedure-grid{grid-template-columns:1fr 1fr;gap:32px;}
    .ba10-tab-inner{flex-direction:column;gap:20px;padding:24px 20px;}
    .ba10-tabs-row{overflow-x:auto;justify-content:flex-start !important;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
    .ba10-final-btns{flex-direction:column;align-items:center;}
    .ba10-final-btns a{width:100%;max-width:400px;justify-content:center;}
    .ba10-cta-deco{display:none;}
    .ba10-cta-mask-img{display:none;}
    .ba10-procedure-line{display:none !important;}
  }
</style>

<div id="ba10-progress-track" style="position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;background:rgba(0,31,63,0.07);">
  <div id="ba10-progress-bar" style="height:100%;background:#E5A524;width:0%;transition:width 0.1s linear;"></div>
</div>

<div style="font-family:'Outfit',sans-serif;color:#001F3F;background:#FFFFFF;">

<!-- HERO -->
<section id="ba10-hero" style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:100vh;">
  <div class="ba10-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-Tienjarige aansprakelijkheid-hero.jpg" alt="Aannemer met BA-10 tienjarige aansprakelijkheid" />
  </div>
  <div class="ba10-hero-inner">
    <div class="ba10-hero-content">
      <div class="ba10-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Verzekering &middot; Tienjarige aansprakelijkheid
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(40px,5vw,64px);line-height:1.08;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">BA-10 tienjarige<br />aansprakelijkheid</h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,34px);line-height:1.1;color:#E5A524;margin-bottom:20px;">De wettelijk verplichte polis voor woningbouw met architect.</p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:#001F3F;margin-bottom:28px;max-width:520px;">Ben je aannemer in de woningbouw met architect? Dan ben je since 1 juli 2018 verplicht om een tienjarige aansprakelijkheidsverzekering te hebben. Zonder attest geen werf, en zonder dekking riskeer je een geldboete tot 80.000 euro.</p>
      <div class="ba10-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          {CTA_SCAN.hero}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">{CTA_AFSPRAAK.advisory}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;">Geen verkooppraatjes. Een scan op maat van je activiteit en je werven.</p>
    </div>
  </div>
</section>

<!-- STICKY NAV -->
<nav id="ba10-sticky-nav" class="ba10-sticky-nav-bar">
  <div class="ba10-sticky-inner">
    {[{id:'watis',label:'Wat is het?'},{id:'verplicht',label:'Voor wie verplicht?'},{id:'dekking',label:'Dekking'},{id:'premie',label:'Looptijd & premie'},{id:'procedure',label:'Schadegeval'},{id:'faq',label:'FAQ'}].map(item=>(
      <button class="ba10-sticky-btn" data-sticky-btn={item.id}>
        <svg class="ba10-check" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {item.label}
      </button>
    ))}
  </div>
</nav>

<!-- WAT IS HET -->
<section id="watis" style="background:#FFFFFF;padding:96px 32px;">
  <div class="ba10-container">
    <div class="ba10-watis-grid">
      <div style="background:#3F5767;padding:32px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);">
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In het kort</span>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
          {[
            {t:'BA-10 dekt de tienjarige aansprakelijkheid van aannemers in de <strong style="color:#FFFFFF;">woningbouw met architect</strong>.'},
            {t:'De polis is wettelijk verplicht since <strong style="color:#FFFFFF;">1 juli 2018 via de Wet Peeters-Borsus</strong>.'},
            {t:'Plafond per schadegeval bedraagt <strong style="color:#FFFFFF;">500.000 euro</strong>, geïndexeerd via ABEX.'},
            {t:'Dekking richt zich op <strong style="color:#FFFFFF;">stabiliteit, soliditeit en waterdichtheid</strong> die de stabiliteit raakt.'},
            {t:'Zonder attest geen werfstart, niet-naleving riskeert een <strong style="color:#FFFFFF;">geldboete tot 80.000 euro</strong>.'},
          ].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.55;color:#CBD5E1;" set:html={item.t}></span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wat is het?</span>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 24px;">De verplichte polis voor zware structuurschade</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">De BA-10 is de verplichte tienjarige aansprakelijkheidsverzekering voor aannemers in de woningbouw. De polis dekt zware structurele schade die zich tot tien jaar na oplevering manifesteert. Het wettelijk minimum is 500.000 euro per schadegeval. Dat bedrag volgt de ABEX-bouwindex en wordt regelmatig herzien.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">De wet legt de verplichting bij elke aannemer die meewerkt aan de gesloten ruwbouw. Ook elke andere aannemer wiens werk de stabiliteit raakt, valt in scope. Je moet vóór werfstart een attest voorleggen aan de architect en de bouwheer. Zonder attest mag je de werf niet betreden.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 36px;">BA-10 is iets anders dan BA Onderneming en dan een verzekering Alle Bouwplaatsrisico's. BA Onderneming dekt schade aan derden tijdens je activiteit. ABR dekt schade aan de werf tijdens de bouw. BA-10 dekt zware schade tot tien jaar na oplevering. De drie polissen werken complementair.</p>
        <div style="display:flex;gap:20px;background:rgba(229,165,36,0.07);border:1px solid rgba(229,165,36,0.22);border-radius:10px;padding:24px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 6px;">Wettelijke basis</p>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">De <strong>Wet Peeters-Borsus van 31 mei 2017</strong> voert deze verplichting in since 1 juli 2018. De <strong>FOD Economie</strong> ziet toe op de naleving en de <strong>FSMA</strong> op de verzekeraars. Niet-naleving kan een strafrechtelijke geldboete tot 80.000 euro opleveren.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VOOR WIE VERPLICHT -->
<section id="verplicht" style="background:#e5a52414;padding:96px 32px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:64px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Voor wie verplicht?</span>
      <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;color:#64748b;margin-bottom:8px;">Is BA-10 wettelijk verplicht voor jou?</p>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(64px,10vw,112px);line-height:0.9;color:#001F3F;letter-spacing:-4px;">Ja.</div>
      <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:20px;color:#3F5767;margin-top:12px;">Als je meewerkt aan woningbouw met architect, vergunning from 1 juli 2018.</p>
    </div>
    <div class="ba10-verplicht-grid">
      {[
        {icon:'ft', title:'Aannemer ruwbouw woningbouw',     text:'Verplicht. BA-10 attest is voorwaarde voor werfstart since 1 juli 2018.'},
        {icon:'cl', title:'Aannemer afwerking woningbouw',   text:'Verplicht zodra je werk de stabiliteit kan raken, anders niet.'},
        {icon:'us', title:'Aannemer renovatie zonder architect', text:'Niet verplicht, maar zware structuurwerken blijven civielrechtelijk tien jaar aansprakelijk.'},
        {icon:'sh', title:'Aannemer niet-residentieel',      text:'Niet verplicht in BA-10 zin. Vrijwillige tienjarige dekking kan wel zinvol zijn.'},
      ].map(card=>(
        <div style="background:#FFFFFF;padding:28px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);box-shadow:0 2px 8px rgba(0,31,63,0.05);">
          <div style="background:rgba(229,165,36,0.1);border-radius:10px;padding:12px;display:inline-flex;margin-bottom:18px;">
            {card.icon==='ft'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
            {card.icon==='cl'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
            {card.icon==='us'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
            {card.icon==='sh'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#64748b;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- VOORBEELDEN -->
<section style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In de praktijk</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 20px;">Per beroep: wanneer is BA-10 voor jou verplicht?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0;">BA-10 geldt voor woningbouw of -renovatie met architect, met stedenbouwkundige vergunning afgeleverd vanaf 1 juli 2018. Voor andere werken is ze niet wettelijk verplicht — maar civielrechtelijk blijf je tien jaar aansprakelijk voor structurele gebreken.</p>
    </div>
    <div style="display:flex;gap:20px;background:rgba(229,165,36,0.07);border:1px solid rgba(229,165,36,0.22);border-radius:12px;padding:28px;margin:32px 0;max-width:840px;">
      <svg style="flex-shrink:0;margin-top:2px;" width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 10px;">De BA-10-test in 3 vragen</p>
        <ol style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;padding-left:20px;">
          <li style="margin-bottom:6px;"><strong>Gaat het om een woning?</strong> (eengezinswoning, appartementsgebouw, gedeelte met woonbestemming)</li>
          <li style="margin-bottom:6px;"><strong>Is er een architect aangesteld?</strong> (verplicht voor stabiliteits- of vergunningsplichtige werken)</li>
          <li style="margin-bottom:10px;"><strong>Is de vergunning afgeleverd vanaf 1 juli 2018?</strong></li>
        </ol>
        <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:15px;color:#001F3F;margin:0;">3× ja → BA-10-attest is verplicht en wordt vóór werfstart bij de notaris of bouwheer neergelegd. Geen attest = geen werfstart en hoofdelijke aansprakelijkheid blijft tien jaar lopen.</p>
      </div>
    </div>
    <div style="display:flex;justify-content:center;">
      <button id="ba10-examples-btn" style="display:flex;align-items:center;gap:10px;background:rgba(0,31,63,0.04);border:1px solid rgba(0,31,63,0.1);border-radius:8px;padding:14px 24px;cursor:pointer;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#001F3F;">
        <span>Bekijk 6 concrete voorbeelden uit de bouw</span>
        <svg id="ba10-examples-chevron" width="18" height="18" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>
    <ul id="ba10-examples-list" style="list-style:none;padding:0;margin:16px 0 0;display:none;grid-template-columns:1fr 1fr;gap:10px;">
      {[
        'Dakwerker plaatst een nieuw dak op een nieuwbouwwoning met architect: BA-10 verplicht.',
        'Metser voert ruwbouw uit voor een verbouwing met architect: BA-10 verplicht.',
        'Loodgieter installeert binnenleidingen zonder impact op stabiliteit: niet wettelijk verplicht.',
        'Elektricien plaatst standaard elektriciteit zonder structurele impact: niet wettelijk verplicht.',
        'Schilder voert binnen-schilderwerk uit: BA-10 niet verplicht.',
        'Schrijnwerker plaatst een dragend houten skelet: BA-10 verplicht.',
      ].map(ex=>(
        <li style="display:flex;gap:10px;align-items:flex-start;background:#F7F4EF;border-radius:8px;padding:12px 16px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{ex}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- DEKKING -->
<section id="dekking" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:1025px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Dekking</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat is wél en niet gedekt?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:580px;margin:0 auto;">BA-10 dekt zware structurele schade. Esthetische gebreken en kleinere schade vallen erbuiten. De plafonds zijn wettelijk vastgelegd.</p>
    </div>
    <div class="ba10-dekking-grid">
      <div style="background:#FFFFFF;border:2px solid rgba(34,197,94,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(34,197,94,0.08);border-bottom:1px solid rgba(34,197,94,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#15803d;">Wel gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Stabiliteit en soliditeit van het bouwwerk','Waterdichtheid die de stabiliteit van de woning raakt','Materiële schade aan dragende delen van het gebouw','Immateriële schade gekoppeld aan stabiliteitsproblemen','Schade ontdekt tot tien jaar na oplevering','Heropbouwkosten tot het wettelijk plafond'].map(item=>(
