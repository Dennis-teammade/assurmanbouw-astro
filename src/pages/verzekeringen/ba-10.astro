        </ul>
      </div>
      <div style="background:#FFFFFF;border:2px solid rgba(239,68,68,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(239,68,68,0.06);border-bottom:1px solid rgba(239,68,68,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#b91c1c;">Niet (of beperkt) gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Esthetische schade zoals kleurverschillen of afwerking','Materiële schade onder 2.500 euro per schadegeval','Zuiver immateriële schade zonder structurele oorzaak','Schade door normale slijtage of gebrekkig onderhoud','Schade aan niet-residentiële gebouwen, tenzij apart verzekerd','Werken zonder verplichte tussenkomst van een architect'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgX16r} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="ba10-plafond-grid" style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);padding:36px 40px;">
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wettelijk minimum</span>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:24px;color:#FFFFFF;margin:0 0 12px;">500.000 euro per schadegeval, geïndexeerd via ABEX</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#CBD5E1;max-width:520px;margin:0;">Het wettelijk minimum is 500.000 euro per schadegeval voor materiële en immateriële schade samen. Bij wederopbouwwaarde lager dan 500.000 euro geldt die wederopbouwwaarde als plafond. De bedragen volgen de ABEX-bouwindex met basis eerste semester 2007.</p>
      </div>
      <div style="text-align:center;flex-shrink:0;">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:6px;">Wettelijk minimum</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:44px;color:#FFFFFF;letter-spacing:-1px;line-height:1;">€ 500.000</div>
        <div style="font-family:'Outfit',sans-serif;font-size:14px;color:#94a3b8;margin-top:6px;">per schadegeval, geïndexeerd via ABEX</div>
      </div>
    </div>
  </div>
</section>

