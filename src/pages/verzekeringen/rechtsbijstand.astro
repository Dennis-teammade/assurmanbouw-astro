---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const faqItems = [
  { q: 'Is een rechtsbijstandsverzekering verplicht voor een aannemer?', a: 'Nee, ze is niet wettelijk verplicht. Maar zodra je facturen verstuurt, contracten ondertekent of personeel inhuurt, is ze in de praktijk onmisbaar. Eén onbetaalde factuur of betwiste oplevering weegt jaren premies op.' },
  { q: 'Wat kost een rechtsbijstand voor een zelfstandige in de bouw?', a: 'Premies starten typisch rond € 200 tot € 400 per jaar voor een eenmanszaak. Voor vennootschappen met personeel of meerdere onderaannemers loopt dat op tot € 800-1.500. De exacte premie hangt af van je omzet, statuut en gekozen modules.' },
  { q: 'Krijg je fiscaal voordeel op je premie?', a: 'Ja. Depuis de Wet Geens van 2019 krijg je 40% belastingvermindering op je premie tot een plafond van € 310 — dat is een teruggave tot € 124 per jaar in je personenbelasting. In een vennootschap is de premie volledig aftrekbaar als beroepskost.' },
  { q: 'Mag je je eigen advocaat kiezen?', a: 'Ja, art. 156 Wet Verzekeringen garandeert vrije advocaatkeuze vanaf het moment dat een gerechtelijke of administratieve procedure start. Geen enkele verzekeraar kan je een advocaat opleggen.' },
  { q: 'Geldt er een wachttijd voor lopende geschillen?', a: 'Voor feiten die zich vóór de afsluitdatum hebben voorgedaan, ja — meestal 1 tot 3 jaar afhankelijk van het type geschil. Sluit je beter af in een rustige periode, niet wanneer er al een conflict speelt.' },
  { q: 'Dekt mijn rechtsbijstand een geschil over mijn eigen verbouwing thuis?', a: 'Niet via je beroepspolis — die sluit geschillen uit waarbij jij zelf de bouwheer bent. Daarvoor heb je een aparte privé-rechtsbijstand of een uitbreiding op je woningverzekering nodig.' },
  { q: 'Wat als de tegenpartij failliet gaat tijdens de procedure?', a: 'Bij insolvabiliteit van de aansprakelijke derde springt de polis bij — meestal tot € 15.000 ter compensatie van de schadevergoeding die je niet meer kunt innen. Een belangrijk vangnet bij faillissement van een onderaannemer of leverancier.' },
  { q: 'Kan de rechtsbijstand ook strafrechtelijke verdediging dekken?', a: 'Ja, bij onopzettelijke feiten (onopzettelijke doding, slagen door onvoorzichtigheid, onopzettelijke brandstichting) is de strafrechtelijke verdediging volledig gedekt tot het plafond. Bij opzettelijke misdrijven enkel als je vrijgesproken wordt.' },
  { q: 'Wat is het verschil met de juridische bijstand bij Securex of Acerta?', a: 'Sociaal-secretariaten geven juridisch advies en stellen documenten op — dat is preventieve juridische dienstverlening. Een rechtsbijstandsverzekering komt erbovenop en betaalt de procedurekosten als er écht een conflict ontstaat.' },
  { q: 'Is bemiddeling via de Verzoeningscommissie Bouw een alternatief?', a: 'Voor technische geschillen is de Verzoeningscommissie Bouw often een snelle, goedkope oplossing als beide partijen akkoord gaan. Vanaf 2027 komt er een federale ombudsdienst voor bouw- en verbouwgeschillen.' },
  { q: 'Komt de polis tussen voor onbetaalde facturen?', a: 'Ja, voor invordering van zowel onbetwiste via IOS-procedure (ca. 1 maand) als betwiste facturen via dagvaarding. Voor onbetwiste facturen gelden meestal een minimumdrempel van € 1.000 en een franchise op de deurwaarderskosten.' },
  { q: 'Hoeveel polissen heb ik nodig — BA Onderneming, BA-10 én rechtsbijstand?', a: 'De drie zijn complementair, niet overlappend. BA Onderneming dekt schade aan derden, BA-10 specifiek de tienjarige aansprakelijkheid, en de rechtsbijstand betaalt de juridische strijd om jouw rechten te verdedigen of schade te verhalen.' },
  { q: 'Wat als ik mijn activiteit stopzet — loopt de dekking dan af?', a: 'De meeste polissen blijven 5 jaar nawerken voor geschillen rond afgesloten dossiers. Verborgen gebreken, BA-10-claims en betwiste opleveringen kunnen jaren later opduiken. Stopzetting zonder nadekking is een vaak onderschat risico.' },
  { q: 'Wie behandelt mijn dossier concreet?', a: 'Niet de verzekeraar zelf, maar een gespecialiseerde rechtsbijstand-entiteit zoals Providis (AG), Legal Village (AXA), DAS of een interne rechtsbijstanddienst. Wij blijven jouw aanspreekpunt en volgen het dossier mee op tot het is afgesloten.' },
];

const beroepTabs = [
  { id: 'dakwerkers',    label: 'Dakwerkers',        link: '/sectoren/dakwerkers',    title: 'Voor dakwerkers',                    text: 'Dakwerken vallen onder de tienjarige aansprakelijkheid. Geschillen draaien meestal rond waterdichtheid, isolatieprestaties en stormschade waarvan de oorzaak betwist wordt. We voegen standaard een module bouwgeschillen toe.' },
  { id: 'metsers',       label: 'Metsers',            link: '/sectoren/aannemers',     title: 'Voor metsers en algemene aannemers', text: 'Hoofdaannemers krijgen het meeste te maken met onderaanneminggeschillen, betwiste opleveringen en ketenaansprakelijkheid. Hier is een uitgebreide formule met onderaanneming-module en sociaalrechtelijke uitbreiding aanbevolen.' },
  { id: 'loodgieters',   label: 'Loodgieters',        link: '/sectoren/loodgieters',   title: 'Voor loodgieters',                   text: 'Lekken, drukschade en geschillen over gas- of CV-installaties komen vaak terug. De combinatie rechtsbijstand en BA Onderneming en BA-10 dekt het volledige risicospectrum tussen werf en oplevering.' },
  { id: 'elektriciens',  label: 'Elektriciens',       link: '/sectoren/elektriciens',  title: 'Voor elektriciens',                  text: 'Brand na elektrische installatie of een afgekeurd AREI-keuringsverslag leidt regelmatig tot strafrechtelijke verdediging. De rechtsbijstand neemt zowel de juridische strijd als de expertkosten op zich.' },
  { id: 'schilders',     label: 'Schilders',          link: '/sectoren/schilders',     title: 'Voor schilders',                     text: 'Geschillen over kleurafwijkingen, hechting en uitvoeringskwaliteit zijn de norm. Een rechtsbijstand met IOS-invordering en bouwgeschillenmodule is voor solo-schilders met veel kleine klanten extra waardevol.' },
  { id: 'schrijnwerkers',label: 'Schrijnwerkers',     link: '/sectoren/schrijnwerkers',title: 'Voor schrijnwerkers',                text: 'Maatwerk leidt often tot interpretatiediscussies over "conform bestek". Geschillen rond opmaat-meubilair, ramen of trappen komen via expertise tot een oordeel — die expertise dekt de polis volledig.' },
];

const insuranceCards = [
  { title: 'BA Onderneming',  icon: 'shield',  intro: 'Bescherming wanneer je bedrijf schade veroorzaakt aan derden tijdens de uitbating of beroepsactiviteit.',    bullets: ['Schade aan eigendommen van derden','Letselschade aan derden','Claims rond beroepsfouten','Aansprakelijkheid tijdens werken'],   link: '/verzekeringen/ba-onderneming',   cta: 'Meer over BA Onderneming' },
  { title: 'Machinebreuk',    icon: 'wrench',  intro: 'Professionele machines en gereedschap zijn duur. Een defect of diefstal stopt je werk — deze dekking niet.', bullets: ['Machines bij breuk of diefstal','Diefstal op werf of in bestelwagen','Vervanging of herstelling','Op maat van je materieel'],            link: '/verzekeringen/machinebreuk',     cta: 'Meer over machinebreuk' },
  { title: 'Bedrijfsvoertuigen',icon: 'car',   intro: 'De bestelwagen is onmisbaar op de werf. De juiste dekking houdt je mobiel bij schade, diefstal of pech.',   bullets: ['BA en omnium voor bestelwagens','Bescherming bij diefstal of brand','Snelle afhandeling bij schade','Afstembaar op jouw wagenpark'],  link: '/verzekeringen/bedrijfsvoertuigen',cta: 'Meer over bedrijfsvoertuigen' },
  { title: 'Arbeidsongevallen',icon: 'users',  intro: 'Wettelijk verplicht vanaf je eerste werknemer. Dekt letsel op de werf en woon-werkverkeer.',                  bullets: ['Verplicht vanaf dag 1','Medische kosten gedekt','Woon-werkverkeer inbegrepen','Aangifte binnen 8 dagen'],                              link: '/verzekeringen/arbeidsongevallen', cta: 'Meer over arbeidsongevallen' },
];

const schema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const svgCheck16g = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
const svgX16r    = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
const svgArr18   = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout
  title="Rechtsbijstandsverzekering bouw — juridische bijstand bij geschillen | Assurman"
  description="Rechtsbijstandsverzekering voor de bouwsector. Tot € 75.000 verdedigingskosten, vrije advocaatkeuze en 40% fiscaal voordeel via Wet Geens. Vraag advies."
  canonical="/verzekeringen/rechtsbijstand"
  schema={schema}
>

<style is:global>
  .rb-sticky-btn{background:#F7F4EF;border:1px solid rgba(229,165,36,0.2);cursor:pointer;padding:7px 16px;margin:10px 5px;font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border-radius:9999px;transition:background 0.2s,border-color 0.2s;color:#001F3F;}
  .rb-sticky-btn:hover,.rb-sticky-btn.active{background:rgba(229,165,36,0.18);border-color:#E5A524;}
  .rb-sticky-btn .rb-check{color:#94a3b8;flex-shrink:0;transition:color 0.2s;}
  .rb-sticky-btn:hover .rb-check,.rb-sticky-btn.active .rb-check{color:#E5A524;}
  .rb-tab-btn{background:none;border:none;cursor:pointer;padding:14px 24px;white-space:nowrap;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#64748b;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color 0.2s,border-color 0.2s;}
  .rb-tab-btn:hover,.rb-tab-btn.active{color:#E5A524;border-bottom-color:#E5A524;}
  .rb-ins-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);transition:background 0.2s,transform 0.2s;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);}
  .rb-ins-card:hover{background:rgba(255,255,255,0.1);transform:translateY(-4px);}
  .rb-stat-panel{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;margin-bottom:12px;}
  .rb-stat-btn{width:100%;display:flex;align-items:center;gap:14px;background:none;border:none;cursor:pointer;text-align:left;padding:20px 24px;}
  .rb-scan-btn:hover{background:#324554 !important;}
  .rb-badge-pill{display:inline-flex;align-items:center;gap:8px;background:#F5F2FF;border:1px solid rgba(213,196,174,0.2);border-radius:9999px;padding:6px 16px;font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#001F3F;}
</style>

<style>
  .rb-hero-img{position:absolute;top:5%;right:-5px;height:85%;width:auto;max-width:48%;z-index:1;pointer-events:none;}
  .rb-hero-content{max-width:620px;}
  .rb-hero-inner{max-width:1280px;margin:0 auto;padding:64px 32px 80px;position:relative;z-index:2;}
  .rb-hero-btns{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:32px;}
  .rb-watis-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:flex-start;}
  .rb-wanneer-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .rb-dekking-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;}
  .rb-plafond-grid{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
  .rb-aanvulling-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .rb-formule{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:64px;flex-wrap:wrap;}
  .rb-factors-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:800px;margin:0 auto 40px;}
  .rb-procedure-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
  .rb-tab-inner{display:flex;gap:32px;align-items:flex-start;border-radius:12px;}
  .rb-final-btns{display:flex;gap:24px;justify-content:center;margin-bottom:80px;flex-wrap:wrap;}
  .rb-sticky-nav-bar{position:sticky;top:72px;z-index:90;background:#FFFFFF;border-bottom:1px solid rgba(0,31,63,0.08);overflow:auto;}
  .rb-sticky-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;gap:0;justify-content:center;flex-wrap:wrap;}
  .rb-container{max-width:1280px;margin:0 auto;padding:0 32px;}
  .brand-why-card{background:#FFFFFF;border-left:4px solid #E5A524;box-shadow:0px 1px 2px rgba(0,0,0,0.05);transition:box-shadow 0.2s,transform 0.2s;}
  .brand-why-card:hover{box-shadow:0 8px 24px rgba(0,0,0,0.1);transform:translateY(-2px);}

  @media (max-width:1023px){
    .rb-container{padding:0 24px;}
    .rb-sticky-inner{padding:0 24px;}
    .rb-watis-grid{grid-template-columns:1fr;gap:32px;}
    .rb-wanneer-grid{grid-template-columns:repeat(2,1fr);}
    .rb-aanvulling-grid{grid-template-columns:repeat(2,1fr);}
    .rb-procedure-grid{grid-template-columns:repeat(2,1fr);gap:32px;}
    .rb-factors-grid{grid-template-columns:1fr;}
  }
  @media (max-width:767px){
    .rb-sticky-nav-bar{display:none;}
    .rb-container{padding:0 15px;}
    .rb-hero-content{max-width:100%;}
    .rb-hero-img{display:none;}
    .rb-hero-btns{flex-direction:column;}
    .rb-hero-btns a{width:100%;justify-content:center;text-align:center;}
    #watis{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #wanneer{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #dekking{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #fiscaal{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #procedure{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #faq{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #rb-beroep{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #rb-statuten{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #rb-aanvulling{padding-bottom:56px !important;}
    #rb-cta-band{padding-left:15px !important;padding-right:15px !important;padding-bottom:64px !important;}
    #rb-cta-band h2{font-size:clamp(28px,8vw,48px) !important;}
    #rb-cta-band p{font-size:18px !important;}
    .rb-watis-grid{grid-template-columns:1fr;gap:24px;}
    .rb-wanneer-grid{grid-template-columns:1fr;}
    .rb-dekking-grid{grid-template-columns:1fr;}
    .rb-plafond-grid{grid-template-columns:1fr;}
    .rb-plafond-grid>div:last-child{text-align:center;padding-top:24px;border-top:1px solid rgba(255,255,255,0.15);}
    .rb-aanvulling-grid{grid-template-columns:1fr;}
    .rb-formule{flex-direction:column;gap:8px;margin-bottom:40px;}
    .rb-factors-grid{grid-template-columns:1fr;}
    .rb-procedure-grid{grid-template-columns:1fr 1fr;gap:32px;}
    .rb-tab-inner{flex-direction:column;gap:20px;padding:24px 20px;}
    .rb-tabs-row{overflow-x:auto;justify-content:flex-start !important;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
    .rb-final-btns{flex-direction:column;align-items:center;}
    .rb-final-btns a{width:100%;max-width:400px;justify-content:center;}
    .rb-cta-deco{display:none;}
    .rb-cta-mask-img{display:none;}
    .rb-procedure-line{display:none !important;}
  }
</style>

<div id="rb-progress-track" style="position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;background:rgba(0,31,63,0.07);">
  <div id="rb-progress-bar" style="height:100%;background:#E5A524;width:0%;transition:width 0.1s linear;"></div>
</div>

<div style="font-family:'Outfit',sans-serif;color:#001F3F;background:#FFFFFF;">

<!-- HERO -->
<section id="rb-hero" style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:100vh;">
  <div class="rb-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-Rechtsbijstands­verzekering-hero.jpg" alt="Aannemer met rechtsbijstandsverzekering voor de bouw" />
  </div>
  <div class="rb-hero-inner">
    <div class="rb-hero-content">
      <div class="rb-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Bescherming &middot; Bouwsector
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(40px,5vw,64px);line-height:1.08;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">Rechtsbijstands&#x2011;<br />verzekering voor de bouw</h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,34px);line-height:1.1;color:#E5A524;margin-bottom:20px;">Wie verdedigt jou als een klant niet betaalt of een onderaannemer een fout maakt?</p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:#001F3F;margin-bottom:28px;max-width:520px;">Een onbetaalde factuur, een betwiste oplevering, een geschil met je onderaannemer of een strafrechtelijke procedure na een werfongeval — als zelfstandige in de bouw kom je sneller in een juridische strijd terecht dan je denkt. Een rechtsbijstandsverzekering betaalt je advocaat, expert en gerechtskosten.</p>
      <div class="rb-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          {CTA_SCAN.hero}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">{CTA_AFSPRAAK.advisory}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;">Onafhankelijk advies &middot; Belgisch recht &middot; Geen bindend voorstel zonder akkoord</p>
    </div>
  </div>
</section>

<!-- STICKY NAV -->
<nav id="rb-sticky-nav" class="rb-sticky-nav-bar">
  <div class="rb-sticky-inner">
    {[{id:'watis',label:'Wat is het?'},{id:'wanneer',label:'Wanneer aansluiten?'},{id:'dekking',label:'Dekking'},{id:'fiscaal',label:'Fiscaal voordeel'},{id:'procedure',label:'Bij een geschil'},{id:'faq',label:'FAQ'}].map(item=>(
      <button class="rb-sticky-btn" data-sticky-btn={item.id}>
        <svg class="rb-check" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {item.label}
      </button>
    ))}
  </div>
</nav>

<!-- WAT IS HET -->
<section id="watis" style="background:#FFFFFF;padding:96px 32px;">
  <div class="rb-container">
    <div class="rb-watis-grid">
      <div style="background:#3F5767;padding:32px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);">
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In het kort</span>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
          {[
            {t:'Dekking tot <strong style="color:#FFFFFF;">€ 75.000</strong> voor verdedigings- en gerechtskosten per geschil.'},
            {t:'<strong style="color:#FFFFFF;">Vrije keuze van advocaat en expert</strong> — wettelijk gegarandeerd door art. 156 Wet Verzekeringen.'},
            {t:'<strong style="color:#FFFFFF;">40% fiscaal voordeel</strong> op de premie via de Wet Geens (max premie van € 310 voor belastingvermindering tot € 124).'},
            {t:'Bouwspecifieke geschillen zijn vaak <strong style="color:#FFFFFF;">niet gedekt in standaard rechtsbijstand</strong> — aparte module nodig.'},
            {t:'Wachttijd van 1 tot 3 jaar voor lopende geschillen — <strong style="color:#FFFFFF;">sluit af vóór er een probleem is</strong>.'},
          ].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.55;color:#CBD5E1;" set:html={item.t}></span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wat is het?</span>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 24px;">Juridische bijstand wanneer ondernemen wringt</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Een rechtsbijstandsverzekering betaalt de kosten die je maakt om jouw rechten te verdedigen of een schadevergoeding te eisen — of dat nu via onderhandelingen, bemiddeling of een rechtbank gebeurt. De polis vergoedt het ereloon van je advocaat, de expertisekosten, de gerechtsdeurwaarder en de gerechtelijke procedure zelf.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 36px;">In de bouwsector loop je tegen specifieke risico's aan: een bouwheer die de meerwerken weigert te betalen, een hoofdaannemer die je factuur betwist na faillissement, een schadeclaim van een buurman over scheurvorming, of een strafrechtelijke vervolging na een arbeidsongeval op de werf. Een goed afgestemde rechtsbijstand dekt al die scenario's.</p>
        <div style="display:flex;gap:20px;background:rgba(229,165,36,0.07);border:1px solid rgba(229,165,36,0.22);border-radius:10px;padding:24px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 6px;">Wettelijke basis</p>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;"><strong>Art. 156 Wet Verzekeringen</strong> garandeert vrije keuze van advocaat vanaf het moment dat een gerechtelijke of administratieve procedure start. De <strong>Wet Geens van 22 april 2019</strong> maakte de rechtsbijstand fiscaal aftrekbaar. De <strong>FSMA</strong> houdt toezicht op de verzekeraars.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WANNEER AANSLUITEN -->
<section id="wanneer" style="background:#e5a52414;padding:96px 32px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:64px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wanneer aansluiten?</span>
      <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;color:#64748b;margin-bottom:8px;">Is een rechtsbijstandsverzekering voor jou nodig?</p>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(52px,8vw,96px);line-height:0.9;color:#001F3F;letter-spacing:-4px;">Ja.</div>
      <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:20px;color:#3F5767;margin-top:12px;">Vanaf je eerste factuur loop je risico op betwisting of wanbetaling.</p>
    </div>
    <div class="rb-wanneer-grid">
      {[
        {icon:'cl', title:'Starter, pas zelfstandig',          text:'Sterk aanbevolen. Vanaf je eerste factuur loop je risico op wanbetaling, betwiste opleveringen of contractuele discussies.'},
        {icon:'us', title:'Eenmanszaak met enkele werven',     text:'Aanbevolen. De gemiddelde premie van € 200 tot € 400 weegt licht tegenover één onbetaalde factuur of betwist meerwerk.'},
        {icon:'ft', title:'Vennootschap met personeel',        text:'Sterk aanbevolen. Arbeidsconflicten, geschillen met onderaannemers en strafrechtelijke verdediging na werkongevallen lopen snel op.'},
        {icon:'sh', title:'Stopzetting of overname',           text:'Behouden tot 5 jaar na laatste factuur. Geschillen rond afgeronde werken kunnen jaren later opduiken.'},
      ].map(card=>(
        <div style="background:#FFFFFF;padding:28px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);box-shadow:0 2px 8px rgba(0,31,63,0.05);">
          <div style="background:rgba(229,165,36,0.1);border-radius:10px;padding:12px;display:inline-flex;margin-bottom:18px;">
            {card.icon==='cl'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
            {card.icon==='us'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
            {card.icon==='ft'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
            {card.icon==='sh'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#64748b;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- VOORBEELDEN -->
<section style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In de praktijk</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 20px;">Per beroep: wanneer rechtsbijstand het verschil maakt</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0;">Rechtsbijstand is in België niet wettelijk verplicht voor zelfstandigen of vennootschappen. Toch is ze in de bouw vrijwel onmisbaar zodra je facturen verstuurt, contracten ondertekent of personeel tewerkstelt — en dat is meestal vanaf je eerste werfopdracht. Eén onbetaalde factuur, één betwiste oplevering of één strafrechtelijke vervolging na een werfongeval kan vlot oplopen tot € 10.000 à € 75.000 aan advocaten- en expertkosten. Een polis kost gemiddeld € 200 tot € 400 per jaar, en sinds 2019 is een deel daarvan fiscaal aftrekbaar (40% via belastingvermindering, plafond € 310). Hieronder zes situaties waarin de polis daadwerkelijk tussenkomt.</p>
    </div>
    <ul id="rb-examples-list" style="list-style:none;padding:0;margin:32px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
      {[
        'Dakwerker: bouwheer betwist na 8 maanden de waterdichtheid. De polis betaalt expert en advocaat om de oorzaak vast te stellen.',
        'Metser: onderaannemer levert te late ruwbouwwerken; jij krijgt boetes van de bouwheer. Verhaal op de onderaannemer volledig betaald.',
        'Elektricien: na een korte brand wordt de zaakvoerder strafrechtelijk vervolgd. Verdediging tot € 75.000 dekt het volledige proces.',
        'Loodgieter: klant weigert de eindfactuur van € 8.500. De polis betaalt de invorderingsprocedure tot en met dagvaarding.',
        'Schilder: leverancier levert verkeerde verf; je moet alles overdoen. De polis verhaalt de kosten op de leverancier.',
        'Schrijnwerker: buur start procedure wegens burenhinder. Verdediging valt binnen de standaarddekking.',
      ].map(ex=>(
        <li style="display:flex;gap:10px;align-items:flex-start;background:#F7F4EF;border-radius:8px;padding:12px 16px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{ex}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- DEKKING -->
<section id="dekking" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:1025px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Dekking</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat is wél en niet gedekt?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:580px;margin:0 auto;">Een rechtsbijstand is geen schadeverzekering — ze betaalt de juridische strijd om jouw schade vergoed te krijgen of jouw verdediging te organiseren.</p>
    </div>
    <div class="rb-dekking-grid">
      <div style="background:#FFFFFF;border:2px solid rgba(34,197,94,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(34,197,94,0.08);border-bottom:1px solid rgba(34,197,94,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#15803d;">Wel gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Erelonen van je vrij gekozen advocaat en gerechtsdeurwaarder','Kosten van expertise (technisch, boekhoudkundig, medisch) om je dossier sterk te maken','Strafrechtelijke verdediging na werkongevallen, brand of overtredingen','Burgerlijk verhaal van schade op derden — aansprakelijke leverancier, onderaannemer of bouwheer','Invordering van onbetwiste én betwiste facturen (afhankelijk van de gekozen formule)','Insolvabiliteit van de tegenpartij: tot € 15.000 als de aansprakelijke derde niet kan betalen'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgCheck16g} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div style="background:#FFFFFF;border:2px solid rgba(239,68,68,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(239,68,68,0.06);border-bottom:1px solid rgba(239,68,68,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#b91c1c;">Niet (of beperkt) gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Boetes en schikkingen met het parket','Opzettelijke daden of misdrijven (correctionele opzettelijke inbreuken vallen erbuiten)','Geschillen rond eigen bouw of verbouwing als jij de bouwheer bent','Lopende geschillen op de dag van afsluiten — wachttijd van 1 tot 3 jaar','Oneerlijke concurrentie en intellectuele rechten (auteursrechten, octrooien, merken)','Loon- en sociaalrechtelijke inbreuken door de zaakvoerder zelf'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgX16r} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="rb-plafond-grid" style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);padding:36px 40px;">
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Standaarddekking</span>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:24px;color:#FFFFFF;margin:0 0 12px;">Een ruime envelop voor één geschil</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#CBD5E1;max-width:520px;margin:0;">De marktstandaard voor zelfstandigen en kmo's in de bouw ligt op € 75.000 verdedigings- en gerechtskosten per geschil, aangevuld met een voorschot tot € 20.000 op de schadevergoeding van de tegenpartij. Bij insolvabiliteit van de aansprakelijke derde nog een aanvulling tot € 15.000. Premium-formules gaan hoger.</p>
      </div>
      <div style="text-align:center;flex-shrink:0;">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:6px;">Verdedigingskosten per geschil</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:44px;color:#FFFFFF;letter-spacing:-1px;line-height:1;">€ 75.000</div>
        <div style="font-family:'Outfit',sans-serif;font-size:14px;color:#94a3b8;margin-top:6px;">marktbenchmark voor bouwzelfstandigen</div>
      </div>
    </div>
  </div>
</section>

<!-- AANVULLENDE MODULES -->
<section id="rb-aanvulling" style="background:#3F5767;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="white" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding:100px 32px 0;position:relative;z-index:1;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Aanvullen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Modules die de standaardpolis te kort vindt</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0;">Een basispolis dekt het meeste niet wat in de bouw écht misgaat. Daarom voegen we per dossier specifieke modules toe afhankelijk van je activiteit en omzet.</p>
    </div>
    <div class="rb-aanvulling-grid">
      {[
        {i:'ac',title:'Module Bouwgeschillen',              text:'Dekt geschillen over verborgen gebreken, oplevering, BA-10-aansprakelijkheid en burenhinder die de standaardpolis uitsluit. Onmisbaar voor aannemers met opleveringsdiscussies.'},
        {i:'sh',title:'Invordering onbetwiste facturen',   text:'Snelle invordering van facturen via gerechtsdeurwaarder zonder rechter — gemiddeld 1 maand looptijd. De polis dekt de deurwaarderskosten boven een drempel.'},
        {i:'us',title:'Fiscale rechtsbijstand',            text:'Bijstand bij BTW-controles, aanslag in de personenbelasting of vennootschapsbelasting, en bezwaarschriften. Specifiek relevant in de bouw door de medecontractant-regeling.'},
        {i:'tr',title:'Cybercriminaliteit en phishing',    text:'Verdediging na CEO-fraude of facturatie-phishing. Dekt onderzoekskosten en juridische stappen om bedragen te recupereren.'},
        {i:'br',title:'Sociaalrechtelijke geschillen',     text:'Verdediging bij geschillen met werknemers, ontslagprocedures, discriminatieklachten of sociale-inspectiecontroles. Aanvulling op de basisformule als je personeel hebt.'},
      ].map(card=>(
        <div class="rb-ins-card" style="padding:28px;">
          <div style="background:rgba(229,165,36,0.15);border-radius:10px;padding:10px;display:inline-flex;margin-bottom:16px;">
            {card.i==='ac'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            {card.i==='sh'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {card.i==='us'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
            {card.i==='tr'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>}
            {card.i==='br'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#FFFFFF;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#94A3B8;margin:0;">{card.text}</p>
