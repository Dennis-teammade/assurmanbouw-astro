      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">×</div>
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">2. Gebruik en schade</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:8px;">Profiel + bonus-malus</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#64748b;line-height:1.4;">professioneel, kilometers/jaar, schadeverleden</div>
      </div>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">=</div>
      <div style="background:#3F5767;border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 8px 32px rgba(63,87,103,0.3);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">Jaarpremie</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#FFFFFF;margin-bottom:8px;">Per voertuig of vloot</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#94a3b8;line-height:1.4;">optioneel met combinatiekorting</div>
      </div>
    </div>
    <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:22px;color:#001F3F;text-align:center;margin-bottom:32px;">4 factoren die je premie beïnvloeden</h3>
    <div class="bv-factors-grid">
      {[
        {num:'1',title:'Type voertuig',            text:'Een vrachtwagen heeft een ander risicoprofiel dan een personenwagen of bestelwagen.'},
        {num:'2',title:'Gebruik',                  text:'Professioneel gebruik telt zwaarder dan privé: typisch 3 punten verschil op de bonus-malusschaal.'},
        {num:'3',title:'Schadeverleden (bonus-malus)',text:'Eerdere ongevallen in fout verhogen je premie; schadevrije jaren verlagen ze.'},
