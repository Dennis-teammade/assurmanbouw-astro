---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/islands/FaqAccordion';
import ScrollProgress from '../../components/islands/ScrollProgress';
import StickyNav from '../../components/islands/StickyNav';
import PartnerSlider from '../../components/ui/PartnerSlider';

const navItems = [
  {id:'watis',label:'Wat is het?'},
  {id:'dekking',label:'Dekking'},
  {id:'vloot',label:'Vlootpolis'},
  {id:'faq',label:'FAQ'}
];

const faqItems = [
  {title:'Is omnium verplicht?',content:'Nee. Alleen BA Auto is verplicht. Omnium is een vrijwillige uitbreiding die uw eigen voertuig beschermt bij schade, diefstal of brand. Voor nieuwe of dure bestelwagens is omnium sterk aanbevolen.'},
  {title:'Wat is mini-omnium?',content:'Mini-omnium dekt brand, diefstal, glasbreuk, natuurrampen en aanrijding met dieren — maar niet alle schade bij verkeersongevallen. Omnium dekt alle gevallen inclusief eigen fout.'},
  {title:'Kan ik mijn gereedschap in de bestelwagen verzekeren?',content:'Niet via de voertuigverzekering. Gereedschap en materiaal in de bestelwagen zijn een apart risico en worden gedekt via machinebreuk- of gereedschapverzekering. Assurman combineert dit in één pakket.'},
  {title:'Heb ik voor mijn aanhangwagen een aparte polis nodig?',content:'Aanhangwagens boven 750 kg MTM hebben een eigen nummerplaat en een aparte BA-verzekering nodig. Lichte aanhangwagens vallen onder de BA van het trekkende voertuig.'},
  {title:'Wat is een vlootpolis?',content:'Een vlootpolis dekt al uw bedrijfsvoertuigen samen in één contract. Vanaf 5 voertuigen is dit doorgaans voordeliger en administratief eenvoudiger. U krijgt één polisdocument en één aanspreekpunt.'}
];
---

<BaseLayout
  title="Bedrijfsvoertuigenverzekering voor bouwbedrijven | Assurman"
  description="Verzekering voor bestelwagens, vrachtwagens en werktuigen in de bouwsector. BA, omnium en vlootpolis op maat."
  canonical="/verzekeringen/bedrijfsvoertuigen"
>
  <ScrollProgress client:load />

  <!-- HERO -->
  <section id="hero" style="background:#FFFFFF;padding-top:130px;padding-bottom:80px;overflow:hidden;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Verzekering</p>
        <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,4.5vw,64px);line-height:1.05;color:#001F3F;margin:0 0 24px;">Bedrijfsvoertuigen&shy;verzekering</h1>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:clamp(18px,2vw,24px);color:#E5A524;margin:0 0 24px;line-height:1.3;">Uw vloot beschermd. Van bestelwagen tot vrachtwagen.</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 40px;">De bestelwagen is voor de meeste bouwbedrijven het verlengde van de werkplaats. Een accident, diefstal of schade legt uw activiteit stil. Assurman stelt een vlootpolis samen die past bij uw wagenpark — van één bestelwagen tot een volledige vloot.</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;">
          <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;">Gratis scan aanvragen</a>
          <a href="/maak-afspraak" style="display:inline-block;background:transparent;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;border:2px solid #001F3F;">Afspraak maken</a>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;">
        <img src="/foto-contact-35.png" alt="Bedrijfsvoertuigen verzekering" style="width:100%;max-width:520px;border-radius:8px;object-fit:cover;" loading="eager" />
      </div>
    </div>
  </section>

  <StickyNav client:load navItems={navItems} heroSectionId="hero" />

  <!-- WAT IS HET -->
  <section id="watis" style="background:#F8F9FA;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Wat is het?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">Bescherming voor uw wagenpark</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">
        <div style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:40px;">
          <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 20px;">In het kort</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
            {[
              'BA Auto is wettelijk verplicht voor alle voertuigen op de openbare weg',
              'Omnium of mini-omnium dekt eigen schade bij accident, diefstal of brand',
              'Vlootpolis vanaf 5 voertuigen vaak voordeliger',
              'Gereedschap en materiaal in de bestelwagen apart te verzekeren',
              'Aanhangwagens boven 750 kg MTM apart te verzekeren'
            ].map((item) => (
              <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Open Sans',sans-serif;font-size:16px;color:#FFFFFF;line-height:1.5;">
                <span style="color:#E5A524;font-weight:700;flex-shrink:0;margin-top:2px;">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 24px;">Bedrijfsvoertuigen vragen een specifieke benadering. Een particuliere autoverzekering volstaat niet: het professioneel gebruik, de laadruimte met gereedschap en de hogere kilometers per jaar vereisen een polis op maat.</p>
          <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 24px;">Assurman analyseert uw wagenpark en stelt een pakket samen dat de juiste dekkingen combineert, rekening houdend met het type voertuig, het gebruik en het aantal chauffeurs.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- DEKKING TYPES -->
  <section id="dekking" style="background:#FFFFFF;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Types dekking</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">Welke dekkingen zijn er?</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px;">
        {[
          {title:'BA Auto (verplicht)',badge:'Verplicht',text:'Dekt schade die u toebrengt aan andere weggebruikers: personen en voertuigen. Wettelijk verplicht voor alle voertuigen op de openbare weg.'},
          {title:'Mini-omnium',badge:'Optioneel',text:'Dekt brand, diefstal, glasbreuk, storm, hagel, overstroming en aanrijding met dieren. Niet: eigen schuld bij een accident.'},
          {title:'Omnium (volledige dekking)',badge:'Optioneel',text:'Dekt alles van mini-omnium én eigen schade bij een verkeersongeval, ongeacht wie fout is. Aanbevolen voor nieuwe voertuigen.'},
          {title:'Pechbijstand',badge:'Aanvulling',text:'Tussenkomst bij pech, lege accu of klapband — thuis of onderweg. Essentieel voor bouwers die dagelijks op de baan zijn.'},
          {title:'Rechtsbijstand voertuigen',badge:'Aanvulling',text:'Juridische bijstand bij geschillen na een verkeersongeval: betwiste aansprakelijkheid, verhaal op schuldenaar, verzekering van tegenpartij.'}
        ].map((item) => (
          <div style="background:#FFFFFF;border:1px solid #E5E8ED;border-radius:8px;padding:28px;box-shadow:0 2px 16px rgba(0,31,63,0.06);">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
              <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;margin:0;">{item.title}</p>
              <span style={`font-family:'Outfit',sans-serif;font-weight:700;font-size:11px;padding:4px 10px;border-radius:20px;letter-spacing:0.5px;${item.badge === 'Verplicht' ? 'background:#DC2626;color:#FFFFFF;' : item.badge === 'Optioneel' ? 'background:#E5A524;color:#001F3F;' : 'background:#F0F4F8;color:#3F5767;'}`}>{item.badge}</span>
            </div>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VLOOTPOLIS VS INDIVIDUEEL -->
  <section id="vloot" style="background:#001F3F;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Vlootpolis</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#FFFFFF;margin:0 0 16px;">Vlootpolis vs. individuele polissen</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);margin:0 0 48px;max-width:720px;">Vanaf 5 voertuigen is een vlootpolis doorgaans de meest voordelige en administratief eenvoudigste keuze.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;">
        {[
          {type:'Individuele polissen',pros:['Flexibel per voertuig','Geschikt voor 1 tot 4 wagens','Aparte premie per voertuig'],cons:['Meer administratie','Verschillende vervaldata','Hogere totaalkost bij meerdere wagens']},
          {type:'Vlootpolis',pros:['Één contract voor alle voertuigen','Één vervaldag en factuur','Premievoordeel bij groter wagenpark','Gemakkelijk voertuigen toe te voegen'],cons:['Pas interessant vanaf 5 voertuigen','Vaste polisstructuur']}
        ].map((item) => (
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:36px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#E5A524;margin:0 0 20px;">{item.type}</p>
            <div style="margin-bottom:16px;">
              <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin:0 0 10px;">Voordelen</p>
              {item.pros.map((pro) => (
                <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:rgba(255,255,255,0.85);margin:0 0 6px;display:flex;align-items:flex-start;gap:8px;">
                  <span style="color:#22C55E;flex-shrink:0;">✓</span>{pro}
                </p>
              ))}
            </div>
            <div>
              <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:1px;margin:0 0 10px;">Nadelen</p>
              {item.cons.map((con) => (
                <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:rgba(255,255,255,0.65);margin:0 0 6px;display:flex;align-items:flex-start;gap:8px;">
                  <span style="color:#EF4444;flex-shrink:0;">−</span>{con}
                </p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GOLD CTA -->
  <section style="background:#E9C466;padding:72px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(22px,3vw,36px);color:#001F3F;margin:0 0 8px;">Uw wagenpark correct gedekt</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.6;color:rgba(0,31,63,0.75);margin:0;">Assurman vergelijkt en stelt de juiste vlootpolis samen.</p>
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#001F3F;color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 28px;border-radius:4px;text-decoration:none;white-space:nowrap;">Gratis scan</a>
        <a href="/maak-afspraak" style="display:inline-block;background:transparent;border:2px solid #001F3F;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 28px;border-radius:4px;text-decoration:none;white-space:nowrap;">Afspraak</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" style="background:#FFFFFF;padding:100px 0;">
    <div style="max-width:900px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Veelgestelde vragen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">FAQ bedrijfsvoertuigen</h2>
      <FaqAccordion client:visible items={faqItems} />
    </div>
  </section>

  <!-- PARTNERS -->
  <section style="background:#F8F9FA;padding:60px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="text-align:center;font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#3F5767;margin:0 0 32px;">Onze verzekeringspartners</p>
      <PartnerSlider client:visible />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:#001F3F;padding:100px 0 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px 80px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Klaar om te starten?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,52px);line-height:1.1;color:#FFFFFF;margin:0 0 20px;">Uw vloot correct verzekerd</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);max-width:560px;margin:0 auto 40px;">Van BA verplicht tot omnium en vlootpolis — Assurman regelt het.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Gratis scan starten</a>
        <a href="/maak-afspraak" style="display:inline-block;background:transparent;border:2px solid rgba(255,255,255,0.3);color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Afspraak maken</a>
      </div>
    </div>
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
  </section>
</BaseLayout>
