<!-- MIJN SITUATIE -->
<section id="bv-statuten" style="background:#3F5767;padding:96px 32px;position:relative;overflow:hidden;">
  <div style="max-width:840px;margin:0 auto;position:relative;z-index:1;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Mijn situatie</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Welke aanpak past bij jouw bouwbedrijf?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0 0 40px;">De juiste polis hangt af van hoeveel voertuigen je hebt, wie ermee rijdt en wat je vervoert.</p>

    <div class="bv-stat-panel" data-stat-panel>
      <button class="bv-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik werk alleen, met één eigen bestelwagen</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Eén voertuig, eigen gebruik, met daarin je gereedschap en materiaal. Voor jou ligt de focus op een degelijke combinatie van BA + Omnium + bestuurdersverzekering + materiaalpack.</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
          {['Geef bij de polis aan dat je het voertuig gemengd (privé én professioneel) gebruikt: dat klopt fiscaal én verzekeringstechnisch met je realiteit.','Onderschat het gereedschap in je laadruimte niet. € 3.000 tot € 8.000 aan elektrisch materiaal zit zo bij elkaar: gewone omnium dekt dat niet.'].map(item=>(
            <li style="display:flex;gap:10px;align-items:flex-start;"><svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg><span style="font-family:'Outfit',sans-serif;font-size:15px;color:#CBD5E1;">{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="bv-stat-panel" data-stat-panel>
      <button class="bv-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik heb personeel met eigen servicewagens</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Eén bestelwagen voor jezelf, één of twee voor je medewerkers. De polis moet rekening houden met het feit dat niet altijd dezelfde persoon rijdt.</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
          {['Geef alle vaste én occasionele bestuurders door bij het afsluiten. Niet doen maakt je polis kwetsbaar bij schadegeval.','Bonus-malus is gekoppeld aan het voertuig, niet aan de persoon. Een schadegeval door een werknemer werkt door op de polis van dat voertuig.'].map(item=>(
            <li style="display:flex;gap:10px;align-items:flex-start;"><svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg><span style="font-family:'Outfit',sans-serif;font-size:15px;color:#CBD5E1;">{item}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="bv-stat-panel" data-stat-panel>
      <button class="bv-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Ik heb een wagenpark of vloot</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Met meerdere voertuigen wordt een vlootpolis vaak praktischer dan losse contracten: één centraal beheer, eenvoudig schalen en consistente voorwaarden. De financiële vlootkorting wordt interessant vanaf ongeveer 10 voertuigen. De voordelen:</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
          {['Eén contract, één vervaldag, één gesprekspartner.','Vaak lagere globale premie door schadestatistieken van de hele vloot.','Mogelijkheid om geen vaste bestuurder aan te duiden: handig als voertuigen door verschillende medewerkers worden gebruikt.','Bij grote vloten valt bonus-malus weg; de premie wordt jaarlijks aangepast op basis van schadestatistieken van het wagenpark.'].map(item=>(
            <li style="display:flex;gap:10px;align-items:flex-start;"><svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg><span style="font-family:'Outfit',sans-serif;font-size:15px;color:#CBD5E1;">{item}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- BIJ EEN ONGEVAL -->
<section id="procedure" style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:60px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Bij een ongeval</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat moet je doen als er iets gebeurt?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:520px;margin:0 auto;">Een goede polis is belangrijk, maar een correcte reactie na een ongeval evenzeer. Deze 4 stappen houd je aan.</p>
    </div>
    <div class="bv-procedure-grid">
      <div class="bv-procedure-line" style="position:absolute;top:36px;left:12.5%;right:12.5%;height:2px;background:linear-gradient(to right,#E5A524,rgba(229,165,36,0.2));z-index:0;"></div>
      {[
        {ic:'ph', title:'Beveilig en meld',          text:'Beveilig de plaats van het ongeval, verwittig zo nodig politie en verzorg eerste hulp.'},
        {ic:'ac', title:'Aanrijdingsformulier',       text:'Vul samen met de tegenpartij het Europees aanrijdingsformulier in: handgeschreven of via de app.'},
        {ic:'ft', title:'Aangifte binnen 8 dagen',   text:'Bezorg het formulier aan je verzekeraar binnen de wettelijke termijn van 8 dagen.'},
        {ic:'at', title:'Pechbijstand en herstel',   text:'Bel de pechbijstand voor takeling en vraag een vervangwagen indien voorzien in je polis.'},
      ].map((s,i)=>(
        <div style="padding:0 20px;text-align:center;position:relative;z-index:1;">
          <div style="width:72px;height:72px;border-radius:50%;background:#E5A524;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;box-shadow:0 4px 16px rgba(229,165,36,0.3);">
            {s.ic==='ph'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.79 2.82h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.9a16 16 0 0 0 6.18 6.18l1.24-1.24a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>}
            {s.ic==='ac'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
            {s.ic==='ft'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            {s.ic==='at'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>}
          </div>
          <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#E5A524;margin-bottom:8px;">Stap {i+1}</div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{s.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#64748b;margin:0;">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:840px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Veelgestelde vragen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 12px;">Veelgestelde vragen over bedrijfsvoertuigen</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;margin:0;">14 concrete vragen van bouwondernemers: klik open voor het antwoord.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      {faqItems.map((item,i)=>(
        <div data-faq-item style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.08);border-radius:10px;overflow:hidden;">
          <button data-faq-btn style="width:100%;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;background:none;border:none;cursor:pointer;text-align:left;gap:16px;">
            <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;line-height:1.35;">{item.q}</span>
            <svg data-faq-chevron width="18" height="18" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div data-faq-answer style="display:none;padding:0 24px 20px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#3F5767;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<InsuranceCarousel
  client:only="react"
  cards={insuranceCards}
  sectionLabel="Ook interessant"
  headline="Gerelateerde verzekeringen"
  subheadline="Deze verzekeringen vullen je bedrijfsvoertuigenverzekering aan in een volledig bouwpakket."
  background="#F5F2FF"
/>

<section style="background:#F7F4EF;padding:64px 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;text-align:center;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:36px;">Ondersteund door sterke verzekeringspartners</p>
    <PartnerSlider client:only="react" />
  </div>
</section>

<section style="background:#3F5767;padding-top:120px;padding-bottom:0;position:relative;text-align:center;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;"></div>
  <div style="max-width:896px;margin:0 auto;padding:0 32px;position:relative;z-index:2;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;text-align:center;margin-bottom:20px;">Start met Assurman</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(32px,4vw,48px);line-height:1;color:#FFFFFF;max-width:727px;margin:0 auto 24px;">Zijn jouw bedrijfsvoertuigen correct verzekerd?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:22px;line-height:1.4;color:#CBD5E1;max-width:832px;margin:0 auto 48px;">Werk je in de bouwsector en wil je zeker zijn dat je voertuigen, je gereedschap en je bestuurder correct verzekerd zijn? Wij bekijken met jou wat echt nodig is.</p>
    <div class="bv-final-btns">
      <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;box-shadow:0px 10px 15px -3px rgba(0,0,0,0.1);">{CTA_SCAN.hero} <Fragment set:html={svgArr18} /></a>
      <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.2);">{CTA_AFSPRAAK.advisory}</a>
    </div>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
</section>

</div>

<script>
  const progressBar = document.getElementById('bv-progress-bar') as HTMLElement | null;
  const stickyBtns  = document.querySelectorAll<HTMLElement>('[data-sticky-btn]');
  const sectionIds  = ['watis','verplicht','dekking','vloot','procedure','faq'];

  stickyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.stickyBtn!;
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });

  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const total = doc.scrollHeight - doc.clientHeight;
    if (progressBar) progressBar.style.width = total > 0 ? `${(doc.scrollTop / total) * 100}%` : '0%';
    for (let i = sectionIds.length - 1; i >= 0; i--) {
      const el = document.getElementById(sectionIds[i]);
      if (el && el.getBoundingClientRect().top <= 120) {
        stickyBtns.forEach(b => b.classList.toggle('active', b.dataset.stickyBtn === sectionIds[i]));
        break;
      }
    }
  }, { passive: true });

  const exBtn  = document.getElementById('bv-examples-btn')     as HTMLElement | null;
  const exList = document.getElementById('bv-examples-list')    as HTMLElement | null;
  const exChev = document.getElementById('bv-examples-chevron') as HTMLElement | null;
  if (exBtn && exList && exChev) {
    exBtn.addEventListener('click', () => {
      const open = exList.style.display !== 'none';
      exList.style.display = open ? 'none' : 'grid';
      exChev.style.transform = open ? '' : 'rotate(180deg)';
    });
  }

  const tabBtns     = document.querySelectorAll<HTMLElement>('[data-tab-btn]');
  const tabContents = document.querySelectorAll<HTMLElement>('[data-tab-content]');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.tabBtn!;
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      tabContents.forEach(el => { el.style.display = el.dataset.tabContent === t ? 'block' : 'none'; });
    });
  });

  document.querySelectorAll('[data-stat-panel]').forEach(panel => {
    const btn     = panel.querySelector<HTMLElement>('[data-stat-btn]');
    const content = panel.querySelector<HTMLElement>('[data-stat-content]');
    const chevron = panel.querySelector<HTMLElement>('[data-stat-chevron]');
    if (!btn || !content || !chevron) return;
    btn.addEventListener('click', () => {
      const open = content.style.display !== 'none';
      document.querySelectorAll('[data-stat-panel]').forEach(p => {
        const c  = p.querySelector<HTMLElement>('[data-stat-content]');
        const ch = p.querySelector<HTMLElement>('[data-stat-chevron]');
        if (c)  c.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { content.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });

  document.querySelectorAll('[data-faq-item]').forEach(item => {
    const btn     = item.querySelector<HTMLElement>('[data-faq-btn]');
    const answer  = item.querySelector<HTMLElement>('[data-faq-answer]');
    const chevron = item.querySelector<HTMLElement>('[data-faq-chevron]');
    if (!btn || !answer || !chevron) return;
    btn.addEventListener('click', () => {
      const open = answer.style.display !== 'none';
      document.querySelectorAll('[data-faq-item]').forEach(fi => {
        const a  = fi.querySelector<HTMLElement>('[data-faq-answer]');
        const ch = fi.querySelector<HTMLElement>('[data-faq-chevron]');
        if (a)  a.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { answer.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });
</script>

</BaseLayout>
