---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const faqItems = [
  { q: 'Is een machinebreukverzekering wettelijk verplicht?', a: 'Nee, machinebreuk is een vrijwillige polis. Wel kunnen verhuurders en opdrachtgevers ze contractueel vereisen vóór ze materieel of opdracht vrijgeven.' },
  { q: 'Wat is het verschil met een ABR-polis?', a: 'Een ABR dekt schade aan de bouwwerf en de werken zelf. Machinebreuk dekt schade aan je eigen materieel. Beide polissen vullen elkaar aan op een grote werf.' },
  { q: 'Wordt mijn gereedschap in de bestelwagen ook gedekt?', a: 'Alleen als de polis de waarborg inhoud bestelwagen of een vervoerwaarborg bevat. Vaak vraagt de polis een vaste stallingsplaats \'s nachts.' },
  { q: 'Wat is het verschil tussen nieuwwaarde en dagwaarde?', a: 'Nieuwwaarde vergoedt het bedrag voor een nieuwe vergelijkbare machine. Dagwaarde houdt rekening met leeftijd en afschrijving. De keuze beïnvloedt premie en uitkering.' },
  { q: 'Geldt de polis ook voor diefstal op de werf?', a: 'Alleen als de waarborg diefstal in je polis is opgenomen. Vraag uitdrukkelijk werfdekking, want standaard zit ze er niet altijd in.' },
  { q: 'Wordt gehuurd materieel mee verzekerd?', a: 'Met de uitbreiding gehuurd materieel wel. Veel verhuurders eisen zo\'n dekking vóór ze grote machines vrijgeven.' },
  { q: 'Wat valt onder eigen gebrek?', a: 'Schade door interne oorzaken zoals warmlopen, kortsluiting, metaalmoeheid of slecht functioneren. Polissen sluiten dit vaak uit voor onderdelen ouder dan tien jaar.' },
  { q: 'Hoe wordt mijn premie berekend?', a: 'Op basis van de verzekerde waarde van je materieel, je sector en je gekozen waarborgen. Je eigen risico verlaagt de premie wanneer je het hoger zet.' },
  { q: 'Wat is een typisch eigen risico?', a: 'Bij Belgische polissen ligt dit doorgaans tussen 250 en 1.000 euro per schadegeval. Hoger eigen risico betekent lagere premie.' },
  { q: 'Is mijn polis ook in het buitenland geldig?', a: 'Standaard alleen in België. Met de uitbreiding buitenlanddekking werkt de polis ook in Nederland, Luxemburg en Duitsland.' },
  { q: 'Wat als mijn machine ouder is dan tien jaar?', a: 'Veel polissen sluiten eigen gebrek dan uit. Externe schadeoorzaken zoals val, brand of diefstal blijven wel gedekt.' },
  { q: 'Heb ik machinebreuk nodig naast mijn brandverzekering?', a: 'De brandverzekering dekt enkel schade door brand en aanverwante oorzaken. Machinebreuk vangt eigen gebrek en mechanische schade op die de brandpolis niet dekt.' },
  { q: 'Worden verloren werfdagen mee gedekt?', a: 'Niet standaard. Met de uitbreiding bedrijfsschade na machinebreuk krijg je een vergoeding voor stilstand tijdens herstelling.' },
  { q: 'Wat is het verschil met een werkmaterieelverzekering?', a: 'Werkmaterieelverzekering richt zich vooral op zelfrijdend materieel zoals graafmachines en kranen. Machinebreuk dekt een breder pakket: alle vaste én mobiele machines en gereedschap.' },
];

const beroepTabs = [
  { id: 'dakwerkers',    label: 'Dakwerkers',    link: '/sectoren/dakwerkers',    title: 'Voor dakwerkers',                    text: 'Ladderliften, vacuümtransporten en dakwerkermachines staan vaak in open lucht. Storm en val zijn de twee hoofdoorzaken van schade. Een polis met expliciete stormdekking is voor dakwerkers basis.' },
  { id: 'metsers',       label: 'Metsers',        link: '/sectoren/aannemers',     title: 'Voor metsers en algemene aannemers', text: 'Betonmolens, mengkuipen, hef-toestellen en kleine kranen wisselen tussen werven. Diefstal van werven en breukschade tijdens transport zijn de typische schadegevallen. Combineer machinebreuk met de waarborg vervoer.' },
  { id: 'loodgieters',   label: 'Loodgieters',    link: '/sectoren/loodgieters',   title: 'Voor loodgieters',                   text: 'Persmachines, soldeerapparaten en kleine kranen vormen de kern van je materieel. Eigen gebrek en kortsluiting komen vaker voor dan diefstal. Een polis met dekking voor warmlopen en kortsluiting is essentieel.' },
  { id: 'elektriciens',  label: 'Elektriciens',   link: '/sectoren/elektriciens',  title: 'Voor elektriciens',                  text: 'Meetapparatuur, accuboormachines en kabelhaspels zijn waardevol én klein. Diefstal uit de bestelwagen is de grootste schadepost. Vraag uitdrukkelijk dekking voor inhoud van de bestelwagen.' },
  { id: 'schilders',     label: 'Schilders',      link: '/sectoren/schilders',     title: 'Voor schilders',                     text: 'Airless verfspuiten, hogedrukreinigers en steigerwerk zijn de duurste posten. Vallen en stoten domineren als oorzaak van schade. Diefstal speelt mee bij werven in stedelijk gebied.' },
  { id: 'schrijnwerkers',label: 'Schrijnwerkers', link: '/sectoren/schrijnwerkers',title: 'Voor schrijnwerkers',                text: 'Vlakschaafmachines, zaagbanken en stof-afzuigers staan meestal vast in je atelier. Eigen gebrek en warmlopen zijn de typische schadeoorzaken. Voor het werfmaterieel loont een aparte werfdekking.' },
];

const insuranceCards = [
  { title: 'BA Onderneming',          icon: 'shield',  intro: 'Bescherming wanneer je bedrijf schade veroorzaakt aan derden tijdens de uitbating of beroepsactiviteit.',  bullets: ['Schade aan eigendommen van derden','Letselschade aan derden','Claims rond beroepsfouten','Aansprakelijkheid tijdens werken'],   link: '/verzekeringen/ba-onderneming/',   cta: 'Meer over BA Onderneming' },
  { title: 'Bedrijfsvoertuigen',      icon: 'car',     intro: 'De bestelwagen is onmisbaar op de werf. De juiste dekking houdt je mobiel bij schade, diefstal of pech.',   bullets: ['BA en omnium voor bestelwagens','Bescherming bij diefstal of brand','Snelle afhandeling bij schade','Afstembaar op jouw wagenpark'],  link: '/verzekeringen/bedrijfsvoertuigen/',cta: 'Meer over bedrijfsvoertuigen' },
  { title: 'Rechtsbijstand',          icon: 'scale',   intro: 'Juridische bescherming bij geschillen met klanten, leveranciers of personeel. Je staat niet alleen.',        bullets: ['Hulp bij juridische conflicten','Vrije advocaatkeuze','Tussenkomst bij advocaatkosten','Aanvulling op BA'],                       link: '/verzekeringen/rechtsbijstand',   cta: 'Meer over rechtsbijstand' },
  { title: 'Arbeidsongevallen',       icon: 'users',   intro: 'Wettelijk verplicht vanaf je eerste werknemer. Dekt letsel op de werf en woon-werkverkeer.',                 bullets: ['Verplicht vanaf dag 1','Medische kosten gedekt','Woon-werkverkeer inbegrepen','Aangifte binnen 8 dagen'],                       link: '/verzekeringen/arbeidsongevallen/', cta: 'Meer over arbeidsongevallen' },
];

const schema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const svgCheck16g = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
const svgX16r    = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
const svgArr18   = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout
  title="Machinebreukverzekering voor je bouwbedrijf | Assurman"
  description="Een verbrande motor of gestolen gereedschap legt je werf stil. Een machinebreukverzekering vergoedt herstelling of vervanging. Vraag een scan aan."
  canonical="/verzekeringen/machinebreuk"
  schema={schema}
>

<style is:global>
  .mb-sticky-btn{background:#F7F4EF;border:1px solid rgba(229,165,36,0.2);cursor:pointer;padding:7px 16px;margin:10px 5px;font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border-radius:9999px;transition:background 0.2s,border-color 0.2s;color:#001F3F;}
  .mb-sticky-btn:hover,.mb-sticky-btn.active{background:rgba(229,165,36,0.18);border-color:#E5A524;}
  .mb-sticky-btn .mb-check{color:#94a3b8;flex-shrink:0;transition:color 0.2s;}
  .mb-sticky-btn:hover .mb-check,.mb-sticky-btn.active .mb-check{color:#E5A524;}
  .mb-tab-btn{background:none;border:none;cursor:pointer;padding:14px 24px;white-space:nowrap;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#64748b;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color 0.2s,border-color 0.2s;}
  .mb-tab-btn:hover,.mb-tab-btn.active{color:#E5A524;border-bottom-color:#E5A524;}
  .mb-ins-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);transition:background 0.2s,transform 0.2s;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);}
  .mb-ins-card:hover{background:rgba(255,255,255,0.1);transform:translateY(-4px);}
  .mb-stat-panel{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;margin-bottom:12px;}
  .mb-stat-btn{width:100%;display:flex;align-items:center;gap:14px;background:none;border:none;cursor:pointer;text-align:left;padding:20px 24px;}
  .mb-scan-btn:hover{background:#324554 !important;}
  .mb-badge-pill{display:inline-flex;align-items:center;gap:8px;background:#F5F2FF;border:1px solid rgba(213,196,174,0.2);border-radius:9999px;padding:6px 16px;font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#001F3F;}
</style>

<style>
  .mb-hero-img{position:absolute;top:5%;right:-5px;height:85%;width:auto;max-width:48%;z-index:1;pointer-events:none;}
  .mb-hero-content{max-width:620px;}
  .mb-hero-inner{max-width:1280px;margin:0 auto;padding:64px 32px 80px;position:relative;z-index:2;}
  .mb-hero-btns{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:32px;}
  .mb-watis-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:flex-start;}
  .mb-relevant-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .mb-dekking-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;}
  .mb-waardering-grid{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
  .mb-aanvulling-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .mb-formule{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:64px;flex-wrap:wrap;}
  .mb-factors-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:800px;margin:0 auto 40px;}
  .mb-procedure-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
  .mb-tab-inner{display:flex;gap:32px;align-items:flex-start;border-radius:12px;}
  .mb-final-btns{display:flex;gap:24px;justify-content:center;margin-bottom:80px;flex-wrap:wrap;}
  .mb-sticky-nav-bar{position:sticky;top:72px;z-index:90;background:#FFFFFF;border-bottom:1px solid rgba(0,31,63,0.08);overflow:auto;}
  .mb-sticky-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;gap:0;justify-content:center;flex-wrap:wrap;}
  .mb-container{max-width:1280px;margin:0 auto;padding:0 32px;}
  .brand-why-card{background:#FFFFFF;border-left:4px solid #E5A524;box-shadow:0px 1px 2px rgba(0,0,0,0.05);transition:box-shadow 0.2s,transform 0.2s;}
  .brand-why-card:hover{box-shadow:0 8px 24px rgba(0,0,0,0.1);transform:translateY(-2px);}

  @media (max-width:1023px){
    .mb-container{padding:0 24px;}
    .mb-sticky-inner{padding:0 24px;}
    .mb-watis-grid{grid-template-columns:1fr;gap:32px;}
    .mb-relevant-grid{grid-template-columns:repeat(2,1fr);}
    .mb-aanvulling-grid{grid-template-columns:repeat(2,1fr);}
    .mb-procedure-grid{grid-template-columns:repeat(2,1fr);gap:32px;}
    .mb-factors-grid{grid-template-columns:1fr;}
  }
  @media (max-width:767px){
    .mb-sticky-nav-bar{display:none;}
    .mb-container{padding:0 15px;}
    .mb-hero-content{max-width:100%;}
    .mb-hero-img{display:none;}
    .mb-hero-btns{flex-direction:column;}
    .mb-hero-btns a{width:100%;justify-content:center;text-align:center;}
    #watis{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #relevant{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #dekking{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #premie{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #procedure{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #faq{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #mb-beroep{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #mb-statuten{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #mb-aanvulling{padding-bottom:56px !important;}
    #mb-cta-band{padding-left:15px !important;padding-right:15px !important;padding-bottom:64px !important;}
    #mb-cta-band h2{font-size:clamp(28px,8vw,48px) !important;}
    #mb-cta-band p{font-size:18px !important;}
    .mb-watis-grid{grid-template-columns:1fr;gap:24px;}
    .mb-relevant-grid{grid-template-columns:1fr;}
    .mb-dekking-grid{grid-template-columns:1fr;}
    .mb-waardering-grid{grid-template-columns:1fr;}
    .mb-waardering-grid>div:last-child{text-align:center;padding-top:24px;border-top:1px solid rgba(255,255,255,0.15);}
    .mb-aanvulling-grid{grid-template-columns:1fr;}
    .mb-formule{flex-direction:column;gap:8px;margin-bottom:40px;}
    .mb-factors-grid{grid-template-columns:1fr;}
    .mb-procedure-grid{grid-template-columns:1fr 1fr;gap:32px;}
    .mb-tab-inner{flex-direction:column;gap:20px;padding:24px 20px;}
    .mb-tabs-row{overflow-x:auto;justify-content:flex-start !important;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
    .mb-final-btns{flex-direction:column;align-items:center;}
    .mb-final-btns a{width:100%;max-width:400px;justify-content:center;}
    .mb-cta-deco{display:none;}
    .mb-cta-mask-img{display:none;}
    .mb-procedure-line{display:none !important;}
  }
</style>

<div id="mb-progress-track" style="position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;background:rgba(0,31,63,0.07);">
  <div id="mb-progress-bar" style="height:100%;background:#E5A524;width:0%;transition:width 0.1s linear;"></div>
</div>

<div style="font-family:'Outfit',sans-serif;color:#001F3F;background:#FFFFFF;">

<!-- HERO -->
<section id="mb-hero" style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:100vh;">
  <div class="mb-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-Machinebreuk­verzekering-hero.jpg" alt="Bouwmachines en gereedschap met machinebreukverzekering" />
  </div>
  <div class="mb-hero-inner">
    <div class="mb-hero-content">
      <div class="mb-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman &middot; Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(40px,5vw,64px);line-height:1.08;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">Machinebreuk&#x2011;<br />verzekering</h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,34px);line-height:1.1;color:#E5A524;margin-bottom:20px;">De polis die je machines, gereedschap en werfmaterieel weer aan de praat krijgt.</p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:#001F3F;margin-bottom:28px;max-width:520px;">Een verbrande compressor of gestolen gereedschap uit je bestelwagen legt je werf snel stil. De rekening loopt op terwijl je niet kunt factureren. Een machinebreukverzekering vergoedt herstelling of vervanging zodat je morgen verder werkt.</p>
      <div class="mb-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          {CTA_SCAN.hero}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">{CTA_AFSPRAAK.advisory}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;">Geen verkooppraatjes. Een scan op maat van je materieel en je werven.</p>
    </div>
  </div>
</section>

<!-- STICKY NAV -->
<nav id="mb-sticky-nav" class="mb-sticky-nav-bar">
  <div class="mb-sticky-inner">
    {[{id:'watis',label:'Wat is het?'},{id:'relevant',label:'Wanneer relevant?'},{id:'dekking',label:'Dekking'},{id:'premie',label:'Premie'},{id:'procedure',label:'Schadegeval'},{id:'faq',label:'FAQ'}].map(item=>(
      <button class="mb-sticky-btn" data-sticky-btn={item.id}>
        <svg class="mb-check" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {item.label}
      </button>
    ))}
  </div>
</nav>

<!-- WAT IS HET -->
<section id="watis" style="background:#FFFFFF;padding:96px 32px;">
  <div class="mb-container">
    <div class="mb-watis-grid">
      <div style="background:#3F5767;padding:32px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);">
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In het kort</span>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
          {[
            {t:'Machinebreuk dekt <strong style="color:#FFFFFF;">onverwachte schade aan je machines, gereedschap en werfmaterieel</strong>.'},
            {t:'De polis vergoedt herstelling of vervanging op basis van <strong style="color:#FFFFFF;">nieuwwaarde of dagwaarde</strong>.'},
            {t:'Zowel <strong style="color:#FFFFFF;">eigen gebrek als externe oorzaken</strong> vallen onder de standaarddekking.'},
            {t:'Diefstal en vandalisme zijn vaak <strong style="color:#FFFFFF;">een aparte waarborg</strong> in de polis.'},
            {t:'Niet wettelijk verplicht, maar <strong style="color:#FFFFFF;">verhuurders en opdrachtgevers eisen ze regelmatig</strong>.'},
          ].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.55;color:#CBD5E1;" set:html={item.t}></span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wat is het?</span>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 24px;">De polis voor schade aan je eigen materieel</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Een machinebreukverzekering vergoedt onverwachte schade aan je eigen machines en werfmaterieel. Het gaat om compressoren, generatoren, hef-toestellen, persen, kranen en gereedschap. Schade door eigen gebrek valt onder de polis. Schade door val, brand, kortsluiting of storm ook.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Voor een bouwbedrijf is het materieel meestal het zwaarste actief op de balans. Eén defecte kraan of één leeggehaalde bestelwagen blokkeert je werf. Zonder dekking betaal je herstelling én verloren werfdagen zelf. Een goed afgestemde polis brengt je sneller terug aan de slag.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 36px;">Belangrijk om te weten: een machinebreukpolis is niet hetzelfde als een verzekering Alle Bouwplaatsrisico's. Die laatste dekt schade aan de werf en het bouwwerk zelf. Machinebreuk dekt schade aan jouw materieel. Beide polissen werken complementair op grotere projecten.</p>
        <div style="display:flex;gap:20px;background:rgba(229,165,36,0.07);border:1px solid rgba(229,165,36,0.22);border-radius:10px;padding:24px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 6px;">Wettelijke basis</p>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">De <strong>Wet van 4 april 2014</strong> regelt elke verzekeringsovereenkomst in België. De <strong>FSMA</strong> houdt toezicht op verzekeraars en makelaars. Machinebreuk is geen verplichte polis, maar wordt vaak contractueel geëist door verhuurders of opdrachtgevers.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WANNEER RELEVANT -->
<section id="relevant" style="background:#e5a52414;padding:96px 32px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:64px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wanneer relevant?</span>
      <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;color:#64748b;margin-bottom:8px;">Is een machinebreukverzekering voor jou relevant?</p>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(52px,8vw,96px);line-height:0.9;color:#001F3F;letter-spacing:-4px;">Hangt af<br />van je materieel.</div>
      <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:20px;color:#3F5767;margin-top:12px;">Hoe hoger de waarde van je machines, hoe groter de noodzaak.</p>
    </div>
    <div class="mb-relevant-grid">
      {[
        {icon:'us', title:'Solo met basisgereedschap',    text:'Beperkt risico op één werf tegelijk. Een uitbreiding op de brandverzekering volstaat vaak.'},
        {icon:'ft', title:'Bedrijf met dure machines',    text:'Compressoren, generatoren of hef-toestellen vragen een aparte machinebreukpolis met ruime dekking.'},
        {icon:'sh', title:'Aannemer op meerdere werven',  text:'Wisselende werven verhogen het diefstal- en vandalismerisico. Een polis met werfdekking is aangewezen.'},
        {icon:'cl', title:'Bedrijf met gehuurd materieel',text:'Verhuurders eisen vaak een dekking in nieuwwaarde voor ze grote machines vrijgeven.'},
      ].map(card=>(
        <div style="background:#FFFFFF;padding:28px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);box-shadow:0 2px 8px rgba(0,31,63,0.05);">
          <div style="background:rgba(229,165,36,0.1);border-radius:10px;padding:12px;display:inline-flex;margin-bottom:18px;">
            {card.icon==='us'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
            {card.icon==='ft'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>}
            {card.icon==='sh'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {card.icon==='cl'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#64748b;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- VOORBEELDEN -->
<section style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In de praktijk</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 20px;">Per beroep: zes situaties waarin machinebreuk je redt</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0;">Machinebreuk is geen wettelijke verplichting, maar wel een polis die in de bouw vaak het verschil maakt tussen een tegenvaller van een paar honderd euro en een claim van duizenden euro's. Verhuurders eisen ze contractueel voor ze grote machines vrijgeven, en hoofdaannemers vragen ze steeds vaker op werven met groot materieel. De polis dekt zowel plotse mechanische defecten als externe schade door val, brand, overstroming of vandalisme, ook tijdens transport. Hieronder zes situaties uit de bouw waarin de polis intervenieerde.</p>
    </div>
    <ul id="mb-examples-list" style="list-style:none;padding:0;margin:32px 0 0;display:grid;grid-template-columns:1fr 1fr;gap:10px;">
      {[
        'Dakwerker: een ladderlift waait om tijdens een storm en raakt onherstelbaar beschadigd.',
        'Metser: een betonmolen valt van een aanhanger en breekt in twee.',
        'Loodgieter: een persmachine raakt verbrand door kortsluiting tijdens gebruik.',
        'Elektricien: gereedschap en kabelhaspels worden uit de bestelwagen gestolen vóór de werf.',
        'Schilder: een airless verfspuit valt en raakt onherstelbaar beschadigd.',
        'Schrijnwerker: een vlakschaafmachine in het atelier brandt door door warmlopen.',
      ].map(ex=>(
        <li style="display:flex;gap:10px;align-items:flex-start;background:#F7F4EF;border-radius:8px;padding:12px 16px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{ex}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- DEKKING -->
<section id="dekking" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:1025px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Dekking</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat is wél en niet gedekt?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:580px;margin:0 auto;">Een machinebreukpolis dekt onverwachte schade aan je eigen materieel. De grenzen zitten in de oorzaken en in de keuze van waarborgen.</p>
    </div>
    <div class="mb-dekking-grid">
      <div style="background:#FFFFFF;border:2px solid rgba(34,197,94,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(34,197,94,0.08);border-bottom:1px solid rgba(34,197,94,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#15803d;">Wel gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Eigen gebrek zoals warmlopen, kortsluiting of metaalmoeheid','Externe oorzaken zoals val, stoten of storm','Brand, ontploffing en bliksemschade aan je machines','Schade door menselijke onhandigheid of bedieningsfout','Diefstal en vandalisme, mits de waarborg is opgenomen','Schade tijdens gebruik op de werf en in je atelier'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgCheck16g} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div style="background:#FFFFFF;border:2px solid rgba(239,68,68,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(239,68,68,0.06);border-bottom:1px solid rgba(239,68,68,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#b91c1c;">Niet (of beperkt) gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Slijtage en gewone veroudering van je materieel','Schade door slecht onderhoud of nalatigheid','Defecten in onderdelen ouder dan tien jaar, vaak uitgesloten','Elektronische componenten ouder dan vijf jaar, vaak uitgesloten','Schade tijdens vervoer, tenzij de waarborg vervoer is opgenomen','Bedrijfsschade door stilstand, tenzij apart verzekerd'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgX16r} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mb-waardering-grid" style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);padding:36px 40px;">
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Waardering</span>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:24px;color:#FFFFFF;margin:0 0 12px;">Nieuwwaarde of dagwaarde: jij kiest</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#CBD5E1;max-width:520px;margin:0;">Bij nieuwwaarde krijg je het bedrag voor een nieuwe vergelijkbare machine. Bij dagwaarde houdt de verzekeraar rekening met afschrijving en leeftijd. De keuze beïnvloedt zowel je premie als je uitkering bij totaal verlies.</p>
      </div>
      <div style="text-align:center;flex-shrink:0;">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:6px;">Standaard eigen risico</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:36px;color:#FFFFFF;letter-spacing:-1px;line-height:1;">€ 250 – € 1.000</div>
        <div style="font-family:'Outfit',sans-serif;font-size:14px;color:#94a3b8;margin-top:6px;">per schadegeval, te kiezen</div>
      </div>
    </div>
  </div>
</section>

<!-- AANVULLENDE WAARBORGEN -->
<section id="mb-aanvulling" style="background:#3F5767;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="white" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding:100px 32px 0;position:relative;z-index:1;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Aanvullen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Vijf uitbreidingen die je polis afmaken</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0;">De basisdekking vangt veel op. Sommige risico's zitten enkel mee als je ze expliciet kiest. Hieronder de vijf die voor een bouwbedrijf vaak terugkomen.</p>
    </div>
    <div class="mb-aanvulling-grid">
      {[
        {i:'ac',title:'Diefstal en vandalisme',    text:'Dekking voor verdwenen of beschadigd materieel op de werf én in je bestelwagen.'},
        {i:'tr',title:'Vervoer',                   text:'Schade aan machines tijdens transport tussen je atelier, je werven en je klanten.'},
        {i:'sh',title:'Gehuurd materieel',          text:'Polis loopt mee op materieel dat je tijdelijk huurt voor één project.'},
        {i:'us',title:'Bedrijfsschade na machinebreuk',text:'Vergoeding voor verloren werfdagen en omzetverlies tijdens herstelling van een verzekerde machine.'},
        {i:'br',title:'Buitenlanddekking',          text:'Polis blijft geldig wanneer je tijdelijk werkt in buurlanden.'},
      ].map(card=>(
        <div class="mb-ins-card" style="padding:28px;">
          <div style="background:rgba(229,165,36,0.15);border-radius:10px;padding:10px;display:inline-flex;margin-bottom:16px;">
            {card.i==='ac'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            {card.i==='tr'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>}
            {card.i==='sh'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {card.i==='us'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
            {card.i==='br'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#FFFFFF;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#94A3B8;margin:0;">{card.text}</p>
        </div>
      ))}
      <div style="background:#E5A524;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:32px;display:flex;flex-direction:column;justify-content:center;">
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#001F3F;margin:0 0 12px;">Welke uitbreidingen heb jij echt nodig?</h3>
        <p style="font-family:'Outfit',sans-serif;font-size:15px;color:rgba(0,31,63,0.75);line-height:1.55;margin:0 0 20px;">Doe de scan en zie welke risico's vandaag niet gedekt zijn. We vergelijken jouw materieel met wat verzekeraars vandaag aanbieden.</p>
        <a href={CTA_DESTINATIONS.scan} class="mb-scan-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#3F5767;color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;padding:12px 24px;border-radius:8px;text-decoration:none;transition:background 0.2s;width:100%;">
          {CTA_SCAN.start} <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PREMIE -->
<section id="premie" style="background:#F7F4EF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:56px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Prijs en berekening</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Hoe wordt je premie berekend?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:520px;margin:0 auto;">De premie hangt af van je materieel, je sector en je gekozen waarborgen. Voor een klein bouwbedrijf landt ze meestal tussen 300 en 1.500 euro per jaar.</p>
    </div>
    <div class="mb-formule">
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">1. Verzekerde waarde</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:8px;">Nieuwwaarde of dagwaarde</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#64748b;line-height:1.4;">totaal verzekerd materieel</div>
      </div>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">×</div>
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">2. Premievoet</div>
