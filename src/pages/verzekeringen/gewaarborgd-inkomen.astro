  <div style="max-width:1100px;margin:0 auto;text-align:center;position:relative;z-index:4;padding:0 32px;">
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(36px,4vw,56px);line-height:1.15;color:#FFFFFF;margin-bottom:16px;">Stielman met een fysiek beroep?<br />Wij houden je inkomen recht.</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:22px;line-height:1.4;color:#3F5767;margin-bottom:40px;opacity:0.9;">Start nu in 2 minuten of kies meteen voor persoonlijk advies.</p>
    <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:12px;background:#3F5767;color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 40px;border-radius:10px;text-decoration:none;">{CTA_SCAN.requestNow} <Fragment set:html={svgArr18} /></a>
  </div>
</section>

<!-- PER BEROEP TABS -->
<section id="gi-beroep" style="background:#e5a52414;padding:96px 32px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Per beroep</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Inkomensbescherming in jouw discipline</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:520px;margin:0 auto;">Elke bouwstiel heeft zijn eigen fysieke slijtage en risico's. Hieronder wat een gewaarborgd inkomen concreet voor jouw vak betekent.</p>
    </div>
    <div class="gi-tabs-row" style="display:flex;gap:0;border-bottom:2px solid rgba(0,31,63,0.12);margin-bottom:40px;justify-content:center;">
      {beroepTabs.map((tab,i)=>(<button class={`gi-tab-btn${i===0?' active':''}`} data-tab-btn={tab.id}>{tab.label}</button>))}
    </div>
    {beroepTabs.map((tab,i)=>(
      <div data-tab-content={tab.id} style={`display:${i===0?'block':'none'};max-width:860px;margin:0 auto;`}>
      <div class="gi-tab-inner" style="background:#FFFFFF;border-radius:12px;padding:36px 40px;">
        <div style="background:rgba(229,165,36,0.12);border-radius:12px;padding:18px;flex-shrink:0;">
          <svg width="32" height="32" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </div>
        <div style="flex:1;">
          <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#001F3F;margin:0 0 12px;">{tab.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:17px;line-height:1.65;color:#001F3F;margin:0 0 20px;">{tab.text}</p>
          <a href={tab.link} style="display:inline-flex;align-items:center;gap:6px;font-family:'Open Sans',sans-serif;font-weight:700;font-size:14px;color:#E5A524;text-decoration:none;">Bekijk sectorpagina <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></a>
        </div>
      </div>
      </div>
    ))}
  </div>
</section>

<!-- MIJN SITUATIE ACCORDION -->
<section id="gi-statuten" style="background:#3F5767;padding:96px 32px;position:relative;overflow:hidden;">
  <div style="max-width:840px;margin:0 auto;position:relative;z-index:1;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Mijn situatie</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Welke setup past bij jouw situatie?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0 0 40px;">Drie typische situaties uit de Belgische bouwsector. Vind de jouwe en zie wat dat concreet betekent voor je gewaarborgd inkomen.</p>

    <div class="gi-stat-panel" data-stat-panel>
      <button class="gi-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Zelfstandige in hoofdberoep zonder personeel</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Je werkt alleen of als eenmanszaak en je inkomen hangt volledig van jezelf af. Er is geen werkgever en geen vennootschap die de vaste kosten opvangt. Val je uit, dan stopt je omzet onmiddellijk terwijl je huur, lening en gezinsuitgaven doorlopen.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: een gewaarborgd inkomen is hier je basisvangnet. Kies een verzekerde rente die samen met de RIZIV-uitkering je vaste lasten dekt, en een wachttijd die past bij wat je zelf enkele maanden kunt overbruggen.</p>
      </div>
    </div>

    <div class="gi-stat-panel" data-stat-panel>
      <button class="gi-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Zaakvoerder met een vennootschap</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Je runt een BV en hebt misschien al een polis voor de vaste kosten of de omzet van je bedrijf. Die beschermt je vennootschap, niet jou persoonlijk. Als jij door ziekte of ongeval uitvalt, betaalt zo'n bedrijfspolis je privé-hypotheek en je gezinsuitgaven niet.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: een gewaarborgd inkomen vult dat aan met een persoonlijk vervangingsinkomen. We bekijken samen hoe je dit fiscaal het beste opzet en hoe het aansluit op je bestaande bedrijfsdekkingen, zonder dubbel te verzekeren.</p>
      </div>
    </div>

    <div class="gi-stat-panel" data-stat-panel>
      <button class="gi-stat-btn" data-stat-btn>
        <div style="background:rgba(229,165,36,0.15);border-radius:8px;padding:8px;flex-shrink:0;"><svg width="20" height="20" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg></div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#FFFFFF;flex:1;">Starter zonder gekend jaarinkomen</span>
        <svg data-stat-chevron width="18" height="18" fill="none" stroke="#CBD5E1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div data-stat-content style="display:none;padding:0 24px 24px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0 0 16px;">Je bent net gestart en hebt nog geen volledig boekjaar achter de rug, dus je hebt geen bewezen inkomen om je op te baseren. Toch ben je vanaf dag één blootgesteld aan het risico op uitval, vaak net wanneer je financieel het kwetsbaarst bent.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#CBD5E1;margin:0;">Praktisch: je kunt je doorgaans verzekeren op basis van een geschat startinkomen. Later, wanneer je inkomen bekend is, stem je de verzekerde rente bij. Zo zit je niet onverzekerd in je eerste jaren.</p>
      </div>
    </div>
  </div>
</section>

<!-- BIJ ARBEIDSONGESCHIKTHEID -->
<section id="procedure" style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:60px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Bij arbeidsongeschiktheid</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat doe je als je arbeidsongeschikt wordt?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;max-width:520px;margin:0 auto;">Een correcte en tijdige aangifte bepaalt of en wanneer je uitkering start. Doorloop deze vier stappen zodra je niet meer kunt werken.</p>
    </div>
    <div class="gi-procedure-grid">
      <div class="gi-procedure-line" style="position:absolute;top:36px;left:12.5%;right:12.5%;height:2px;background:linear-gradient(to right,#E5A524,rgba(229,165,36,0.2));z-index:0;"></div>
      {[
        {ic:'ph', title:'Aangifte arbeidsongeschiktheid', text:'Verwittig je ziekenfonds én je makelaar of verzekeraar zo snel mogelijk dat je arbeidsongeschikt bent. De termijn waarbinnen je moet aangeven, staat in je polis.'},
        {ic:'ac', title:'Medisch attest',              text:'Bezorg een medisch getuigschrift van je behandelende arts dat je ongeschiktheid en de vermoedelijke duur bevestigt. Dit is de basis waarop de dekking wordt beoordeeld.'},
        {ic:'ft', title:'Controle',                    text:'De adviserend arts van het ziekenfonds en de raadgevend arts van de verzekeraar bepalen je graad van arbeidsongeschiktheid. Bij een fysieke bouwstiel weegt mee in welke mate je je eigen beroep nog kunt uitoefenen.'},
        {ic:'at', title:'Uitkering',                   text:'Na het verstrijken van je gekozen wachttijd start de maandelijkse uitkering, evenredig met je vastgestelde graad van ongeschiktheid, en loopt door zolang je arbeidsongeschikt blijft.'},
      ].map((s,i)=>(
        <div style="padding:0 20px;text-align:center;position:relative;z-index:1;">
          <div style="width:72px;height:72px;border-radius:50%;background:#E5A524;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;box-shadow:0 4px 16px rgba(229,165,36,0.3);">
            {s.ic==='ph'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
            {s.ic==='ac'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M9 12h6M9 16h6M9 8h2M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>}
            {s.ic==='ft'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>}
            {s.ic==='at'&&<svg width="20" height="20" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
          </div>
          <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:13px;letter-spacing:1px;text-transform:uppercase;color:#E5A524;margin-bottom:8px;">Stap {i+1}</div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{s.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:840px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Veelgestelde vragen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 12px;">Veelgestelde vragen over gewaarborgd inkomen</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#3F5767;margin:0;">12 concrete vragen van bouwondernemers: klik open voor het antwoord.</p>
    </div>
    <div style="display:flex;flex-direction:column;gap:10px;">
      {faqItems.map((item,i)=>(
        <div data-faq-item style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.08);border-radius:10px;overflow:hidden;">
          <button data-faq-btn style="width:100%;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;background:none;border:none;cursor:pointer;text-align:left;gap:16px;">
            <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;line-height:1.35;">{item.q}</span>
            <svg data-faq-chevron width="18" height="18" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="flex-shrink:0;transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div data-faq-answer style="display:none;padding:0 24px 20px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.65;color:#3F5767;margin:0;">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- GERELATEERDE VERZEKERINGEN -->
<InsuranceCarousel
  client:only="react"
  cards={insuranceCards}
  sectionLabel="Ook interessant"
  headline="Gerelateerde verzekeringen"
  subheadline="Deze verzekeringen beschermen jou, je gezin en je bouwbedrijf naast je gewaarborgd inkomen."
  background="#F5F2FF"
/>

<!-- PARTNERS -->
<section style="background:#F7F4EF;padding:64px 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 32px;">
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;text-align:center;letter-spacing:0.06em;text-transform:uppercase;margin-bottom:36px;">Ondersteund door sterke verzekeringspartners</p>
    <PartnerSlider client:only="react" />
  </div>
</section>

<!-- FINAL CTA -->
<section style="background:#3F5767;padding-top:120px;padding-bottom:0;position:relative;text-align:center;">
  <div style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,0.05) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;"></div>
  <div style="max-width:896px;margin:0 auto;padding:0 32px;position:relative;z-index:2;">
    <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;text-align:center;margin-bottom:20px;">Start met Assurman</span>
    <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(32px,4vw,48px);line-height:1;color:#FFFFFF;max-width:727px;margin:0 auto 24px;">Loopt je inkomen door als je morgen uitvalt?</h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:22px;line-height:1.4;color:#CBD5E1;max-width:832px;margin:0 auto 48px;">Werk je als zelfstandige in de bouw en wil je zeker zijn dat je gezin verder kan als jij door ziekte of ongeval niet kunt werken? Wij bekijken met jou wat echt nodig is, zonder verplichting.</p>
    <div class="gi-final-btns">
      <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;box-shadow:0px 10px 15px -3px rgba(0,0,0,0.1);">{CTA_SCAN.hero} <Fragment set:html={svgArr18} /></a>
      <a href={CTA_DESTINATIONS.afspraak} style="display:inline-flex;align-items:center;gap:12px;background:rgba(255,255,255,0.1);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:20px;padding:20px 40px;border-radius:8px;text-decoration:none;border:1px solid rgba(255,255,255,0.2);">{CTA_AFSPRAAK.advisory}</a>
    </div>
  </div>
  <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
</section>

</div>

<script>
  const progressBar = document.getElementById('gi-progress-bar') as HTMLElement | null;
  const stickyBtns  = document.querySelectorAll<HTMLElement>('[data-sticky-btn]');
  const sectionIds  = ['watis','verplicht','dekking','premie','procedure','faq'];

  stickyBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.stickyBtn!;
      const el = document.getElementById(id);
      if (el) window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 80, behavior: 'smooth' });
    });
  });

  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const total = doc.scrollHeight - doc.clientHeight;
    if (progressBar) progressBar.style.width = total > 0 ? `${(doc.scrollTop / total) * 100}%` : '0%';
    for (let i = sectionIds.length - 1; i >= 0; i--) {
      const el = document.getElementById(sectionIds[i]);
      if (el && el.getBoundingClientRect().top <= 120) {
        stickyBtns.forEach(b => b.classList.toggle('active', b.dataset.stickyBtn === sectionIds[i]));
        break;
      }
    }
  }, { passive: true });

  const exBtn  = document.getElementById('gi-examples-btn')     as HTMLElement | null;
  const exList = document.getElementById('gi-examples-list')    as HTMLElement | null;
  const exChev = document.getElementById('gi-examples-chevron') as HTMLElement | null;
  if (exBtn && exList && exChev) {
    exBtn.addEventListener('click', () => {
      const open = exList.style.display !== 'none';
      exList.style.display = open ? 'none' : 'grid';
      exChev.style.transform = open ? '' : 'rotate(180deg)';
    });
  }

  const tabBtns     = document.querySelectorAll<HTMLElement>('[data-tab-btn]');
  const tabContents = document.querySelectorAll<HTMLElement>('[data-tab-content]');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const t = btn.dataset.tabBtn!;
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      tabContents.forEach(el => { el.style.display = el.dataset.tabContent === t ? 'block' : 'none'; });
    });
  });

  document.querySelectorAll('[data-stat-panel]').forEach(panel => {
    const btn     = panel.querySelector<HTMLElement>('[data-stat-btn]');
    const content = panel.querySelector<HTMLElement>('[data-stat-content]');
    const chevron = panel.querySelector<HTMLElement>('[data-stat-chevron]');
    if (!btn || !content || !chevron) return;
    btn.addEventListener('click', () => {
      const open = content.style.display !== 'none';
      document.querySelectorAll('[data-stat-panel]').forEach(p => {
        const c  = p.querySelector<HTMLElement>('[data-stat-content]');
        const ch = p.querySelector<HTMLElement>('[data-stat-chevron]');
        if (c)  c.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { content.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });

  document.querySelectorAll('[data-faq-item]').forEach(item => {
    const btn     = item.querySelector<HTMLElement>('[data-faq-btn]');
    const answer  = item.querySelector<HTMLElement>('[data-faq-answer]');
    const chevron = item.querySelector<HTMLElement>('[data-faq-chevron]');
    if (!btn || !answer || !chevron) return;
    btn.addEventListener('click', () => {
      const open = answer.style.display !== 'none';
      document.querySelectorAll('[data-faq-item]').forEach(fi => {
        const a  = fi.querySelector<HTMLElement>('[data-faq-answer]');
        const ch = fi.querySelector<HTMLElement>('[data-faq-chevron]');
        if (a)  a.style.display   = 'none';
        if (ch) ch.style.transform = '';
      });
      if (!open) { answer.style.display = 'block'; chevron.style.transform = 'rotate(180deg)'; }
    });
  });
</script>

</BaseLayout>
