            {card.icon==='tr'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            {card.icon==='bk'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
            {card.icon==='bd'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>}
            {card.icon==='pg'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- IN DE PRAKTIJK -->
<section id="it-praktijk" style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In de praktijk</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 20px;">Waarom een IPT in de bouw?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0;">Veel aannemers en vakmensen in de bouw werken via een vennootschap. Hun VAPZ is de basis, maar daarbovenop willen ze meer opbouwen zonder hun nettoloon aan te spreken. De IPT is dan precies de formule: de vennootschap betaalt de premie en trekt die af als beroepskost, binnen de 80%-regel.</p>
    </div>
    <div class="it-rules-grid">
      {[
        { title: 'Je vennootschap betaalt', text: 'De premie komt uit je vennootschap, niet uit je privé-zak. Je vennootschap trekt die af als beroepskost, binnen de 80%-regel. Zo bouw je pensioen op met geld dat anders deels naar de fiscus zou gaan.' },
        { title: 'Inhalen met backservice', text: 'Heb je de voorbije jaren weinig of niets opgebouwd? Met een backservice mag je tot 10 jaar voorbije loopbaanjaren mee inbrengen, binnen de 80%-regel. Zo haal je achterstand fiscaal voordelig in.' },
        { title: 'Jouw POZ-equivalent', text: 'Wie geen vennootschap heeft, bouwt op met een POZ. Heb jij wel een vennootschap, dan is de IPT jouw tegenhanger, en doorgaans de krachtigste van de twee omdat je vennootschap de premie draagt.' },
