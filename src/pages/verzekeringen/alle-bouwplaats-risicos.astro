---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/islands/FaqAccordion';
import ScrollProgress from '../../components/islands/ScrollProgress';
import StickyNav from '../../components/islands/StickyNav';
import PartnerSlider from '../../components/ui/PartnerSlider';

const navItems = [
  {id:'watis',label:'Wat is het?'},
  {id:'dekking',label:'Dekking'},
  {id:'wanneer',label:'Wanneer?'},
  {id:'faq',label:'FAQ'}
];

const faqItems = [
  {title:'Wanneer is ABR zinvol?',content:'ABR is vooral interessant bij grotere bouwprojecten, nieuwbouw of renovaties waarbij meerdere aannemers samenwerken. Bij kleine herstellingen is uw BA Onderneming doorgaans voldoende.'},
  {title:'Dekt ABR ook mijn materiaal op de werf?',content:'ABR dekt schade aan het werk in uitvoering (de bouwkundige constructie). Bouwmaterialen die klaarliggen voor verwerking kunnen eveneens gedekt zijn, afhankelijk van de polisvoorwaarden.'},
  {title:'Wat is het verschil met BA Onderneming?',content:'BA Onderneming dekt schade die u aan derden veroorzaakt. ABR dekt schade aan het werk zelf — ongeacht wie er schuldig is. Ze vullen elkaar aan.'},
  {title:'Moet ik per project een ABR afsluiten?',content:'U heeft de keuze. Een werfpolis dekt één specifiek project. Een jaarpolis dekt alle werven die u gedurende het jaar uitvoert. Voor actieve aannemers is een jaarpolis doorgaans voordeliger.'},
  {title:'Dekt ABR ook de periode na oplevering?',content:'Nee. ABR loopt tot aan de oplevering. Schade na oplevering valt onder BA Na Levering (onderdeel van uw BA Onderneming) of onder de tienjarige aansprakelijkheid (BA-10).'}
];
---

<BaseLayout
  title="Alle Bouwplaats Risico's (ABR) | Assurman"
  description="ABR-verzekering dekt schade aan werken in uitvoering op de werf. Voor aannemers en bouwprofessionals in Vlaanderen."
  canonical="/verzekeringen/alle-bouwplaats-risicos"
>
  <ScrollProgress client:load />

  <!-- HERO -->
  <section id="hero" style="background:#FFFFFF;padding-top:130px;padding-bottom:80px;overflow:hidden;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Verzekering</p>
        <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,4.5vw,64px);line-height:1.05;color:#001F3F;margin:0 0 24px;">Alle Bouwplaats Risico's</h1>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:clamp(18px,2vw,24px);color:#E5A524;margin:0 0 24px;line-height:1.3;">Uw werf beschermd. Van fundering tot oplevering.</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 40px;">Een bouwwerf is blootgesteld aan talloze risico's: storm, brand, vandalisme, waterinsijpeling of schade veroorzaakt door derden. De ABR-verzekering (Alle Bouwplaats Risico's) dekt schade aan de werken in uitvoering — ongeacht de oorzaak of de schuldige.</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;">
          <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;">Gratis scan aanvragen</a>
          <a href="/maak-afspraak" style="display:inline-block;background:transparent;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;border:2px solid #001F3F;">Afspraak maken</a>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;">
        <img src="/foto-contact-35.png" alt="Alle Bouwplaats Risicos ABR" style="width:100%;max-width:520px;border-radius:8px;object-fit:cover;" loading="eager" />
      </div>
    </div>
  </section>

  <StickyNav client:load navItems={navItems} heroSectionId="hero" />

  <!-- WAT IS HET -->
  <section id="watis" style="background:#F8F9FA;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Wat is het?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">ABR: dekking voor het werk in uitvoering</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;">
        <div style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:40px;">
          <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 20px;">In het kort</p>
          <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
            {[
              'Dekt schade aan werken in uitvoering',
              'Beschermt tegen weersschade, brand, vandalisme en diefstal op de werf',
              'Kan per project (werfpolis) of voor alle werven (jaarpolis) worden afgesloten',
              'Dekt ook schade door derden op de werf',
              'Aanvulling op BA Onderneming'
            ].map((item) => (
              <li style="display:flex;align-items:flex-start;gap:12px;font-family:'Open Sans',sans-serif;font-size:16px;color:#FFFFFF;line-height:1.5;">
                <span style="color:#E5A524;font-weight:700;flex-shrink:0;margin-top:2px;">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 24px;">De ABR-verzekering is een all-risk dekking voor werken in uitvoering. Ze dekt schade aan de bouwkundige constructie zelf — muren, vloeren, draagstructuur, ingebouwde installaties — door nagenoeg alle externe oorzaken.</p>
          <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 24px;">Het onderscheid met BA Onderneming is cruciaal: BA dekt schade die u toebrengt aan derden. ABR dekt schade aan het werk zelf — ook wanneer niemand aansprakelijk is, zoals bij storm of plotse instorting.</p>
          <div style="background:#FFF8E7;border-left:4px solid #E5A524;padding:24px;border-radius:0 4px 4px 0;">
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#001F3F;margin:0 0 8px;">ABR + BA = volledige bescherming</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">ABR en BA Onderneming vullen elkaar perfect aan. ABR beschermt het werk, BA beschermt u tegenover derden. Samen vormen ze een waterdichte bescherming voor uw bouwactiviteit.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WELKE RISICO'S -->
  <section id="dekking" style="background:#FFFFFF;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Dekking</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">Welke risico's worden gedekt?</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px;margin-bottom:48px;">
        {[
          {title:'Weersschade',text:'Storm, hagel, overstroming, sneeuw- en ijsdruk. Bij grote werven is dit een van de meest voorkomende schadegevallen.'},
          {title:'Brand & ontploffing',text:'Brand op de werf die het werk in uitvoering beschadigt of vernielt. Inclusief blussingsschade.'},
          {title:'Diefstal van bouwmateriaal',text:'Gestolen bouwmaterialen die klaarliggen voor verwerking: bakstenen, isolatie, schrijnwerk, buizen.'},
          {title:'Vandalisme',text:'Moedwillige beschadiging van het werk door derden. Frequenter bij nieuwbouwprojecten op verlaten locaties.'},
          {title:'Schade door derden',text:'Beschadiging van het werk door een andere aannemer, onderaannemer of derde partij op de werf.'},
          {title:'Instorting',text:'Plotse instorting door niet-toerekenbare oorzaken: onverwachte grondgesteldheid, onvoorziene krachten.'}
        ].map((item) => (
          <div style="background:#FFFFFF;border:1px solid #E5E8ED;border-radius:8px;padding:28px;box-shadow:0 2px 16px rgba(0,31,63,0.06);">
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 10px;">{item.title}</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:14px;line-height:1.5;color:#3F5767;margin:0;">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WANNEER INTERESSANT / WERFPOLIS VS JAARPOLIS -->
  <section id="wanneer" style="background:#001F3F;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Werfpolis of jaarpolis?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#FFFFFF;margin:0 0 48px;">Wanneer is ABR interessant?</h2>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-bottom:40px;">
        {[
          {type:'Werfpolis',desc:'Dekt één specifiek project voor de volledige uitvoeringstermijn. Ideaal voor grotere projecten of projecten met een specifiek risicoprofiel.',pros:['Dekking op maat van het project','Premie op basis van projectwaarde','Begint en eindigt met het project']},
          {type:'Jaarpolis',desc:'Dekt alle werven die u gedurende een kalenderjaar uitvoert. Voordeliger voor aannemers die regelmatig actief zijn.',pros:['Één polis voor alle projecten','Administratief eenvoudiger','Kostprijs per project lager']}
        ].map((item) => (
          <div style="background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:36px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#E5A524;margin:0 0 16px;">{item.type}</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:16px;line-height:1.6;color:rgba(255,255,255,0.75);margin:0 0 24px;">{item.desc}</p>
            {item.pros.map((pro) => (
              <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:rgba(255,255,255,0.85);margin:0 0 8px;display:flex;align-items:flex-start;gap:8px;">
                <span style="color:#22C55E;flex-shrink:0;">✓</span>{pro}
              </p>
            ))}
          </div>
        ))}
      </div>
      <div style="background:#E9C466;border-radius:8px;padding:28px 32px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 8px;">ABR is interessant voor...</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#001F3F;margin:0;">Grotere nieuwbouwprojecten, renovaties waarbij meerdere aannemers samenwerken, werven op locaties met specifieke risico's (overstromingsgevoelig terrein, winderige zones) en projecten met een langere uitvoeringstermijn.</p>
      </div>
    </div>
  </section>

  <!-- GOLD CTA -->
  <section style="background:#E9C466;padding:72px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(22px,3vw,36px);color:#001F3F;margin:0 0 8px;">Uw werf volledig beschermd</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.6;color:rgba(0,31,63,0.75);margin:0;">Assurman stelt een ABR-polis op maat van uw projecten samen.</p>
      </div>
      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#001F3F;color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 28px;border-radius:4px;text-decoration:none;white-space:nowrap;">Gratis scan</a>
        <a href="/maak-afspraak" style="display:inline-block;background:transparent;border:2px solid #001F3F;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 28px;border-radius:4px;text-decoration:none;white-space:nowrap;">Afspraak</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" style="background:#FFFFFF;padding:100px 0;">
    <div style="max-width:900px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Veelgestelde vragen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">FAQ Alle Bouwplaats Risico's</h2>
      <FaqAccordion client:visible items={faqItems} />
    </div>
  </section>

  <!-- PARTNERS -->
  <section style="background:#F8F9FA;padding:60px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="text-align:center;font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#3F5767;margin:0 0 32px;">Onze verzekeringspartners</p>
      <PartnerSlider client:visible />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:#001F3F;padding:100px 0 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px 80px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Klaar om te starten?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,52px);line-height:1.1;color:#FFFFFF;margin:0 0 20px;">Uw werf gedekt van begin tot oplevering</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);max-width:560px;margin:0 auto 40px;">ABR + BA Onderneming: de combinatie die élke bouwprofessional nodig heeft.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Gratis scan starten</a>
        <a href="/maak-afspraak" style="display:inline-block;background:transparent;border:2px solid rgba(255,255,255,0.3);color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Afspraak maken</a>
      </div>
    </div>
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
  </section>
</BaseLayout>
