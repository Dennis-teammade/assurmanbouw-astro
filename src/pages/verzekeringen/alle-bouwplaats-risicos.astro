---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InsuranceCarousel from '../../components/islands/InsuranceCarousel';
import PartnerSlider from '../../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../../data/cta-labels';
import BrandChevron from '../../components/BrandChevron.astro';

const faqItems = [
  { q: 'Wat is een verzekering Alle Bouwplaatsrisico\'s (ABR)?', a: 'Een ABR-verzekering dekt schade aan werken in uitvoering: het gebouw dat je aan het bouwen of verbouwen bent, en de materialen op de werf die bestemd zijn voor verwerking. Ze beschermt alle betrokken partijen: opdrachtgever, hoofdaannemer en onderaannemers, voor de duur van de bouwfase.' },
  { q: 'Is een ABR-verzekering wettelijk verplicht?', a: 'Niet altijd, maar voor grotere bouwwerken en bij openbare aanbestedingen wordt ze contractueel vereist. Voor nieuwbouwprojecten boven een bepaalde omvang is ze in de praktijk standaard.' },
  { q: 'Wat is het verschil met BA Onderneming?', a: 'BA Onderneming dekt schade die je veroorzaakt aan derden (mensen of eigendommen buiten de werf). ABR dekt de werken zelf en de materialen op de werf. ABR dekt dus standaard geen aansprakelijkheid tegenover derden: daarvoor blijft je BA Onderneming nodig. Sommige polissen bundelen beide voor de duur van de werf, maar dat moet je uitdrukkelijk vragen.' },
  { q: 'Wat is het verschil met machinebreuk?', a: 'Machinebreuk dekt schade aan jouw eigen machines en gereedschap. ABR dekt schade aan het bouwwerk zelf en de materialen in uitvoering. Op grotere werven zijn beide polissen naast elkaar zinvol.' },
  { q: 'Wie sluit de ABR-polis af, en wat bij meerdere aannemers?', a: 'Dat kan de opdrachtgever zijn (die alle aannemers mee dekt) of de hoofdaannemer. Werken er meerdere aannemers op de werf, dan is één gezamenlijke ABR-polis voor alle partijen doorgaans het eenvoudigst en voordeligst: elke aannemer is mee verzekerd, er is geen overlap en geen discussie over wie welke schade veroorzaakte. Soms wordt ze per aannemer apart afgesloten.' },
  { q: 'Hoelang loopt een ABR-polis en wat is de onderhoudsperiode?', a: 'Een ABR loopt voor de duur van de bouwfase: van de start van de werken tot en met de (voorlopige) oplevering. Daarna bieden veel polissen een onderhoudsperiode: een verlengde dekking van typisch 12 tot 24 maanden die schade dekt die tijdens de onderhoudstermijn wordt vastgesteld en terug te brengen is tot de bouwfase.' },
  { q: 'Dekt ABR ook schade door slecht weer?', a: 'Ja, storm, hevige regenval, hagel en overstromingen vallen doorgaans onder de ABR-dekking. Er geldt wel een wachttijd (soms 24-48 uur na aanvang van slecht weer) en een drempelwaarde.' },
  { q: 'Is er een eigen risico bij ABR?', a: 'Ja, ABR-polissen werken bijna altijd met een eigen risico per schadegeval. De hoogte hangt af van de bouwkost en de gekozen formule. Een hoger eigen risico drukt de premie.' },
  { q: 'Hoe wordt de premie berekend?', a: 'Op basis van de totale bouwkost (inclusief erelonen), de aard van de werken, de bouwperiode en de gekozen plafonds en eigen risico. Typisch 0,1% tot 0,5% van de totale bouwkost, eenmalig voor de volledige bouwperiode.' },
  { q: 'Zijn bestaande gebouwen ook gedekt als ik renoveer?', a: 'Alleen als je dat uitdrukkelijk vraagt. Bestaande constructies (het pand dat je renoveert) zijn standaard niet gedekt en vragen een aparte uitbreiding bestaand gebouw.' },
];

const beroepTabs = [
  { id: 'dakwerkers',    label: 'Dakwerkers',    link: '/sectoren/dakwerkers',    title: 'Voor dakwerkers',                    text: 'Bij nieuwbouw of grotere renovatieprojecten is ABR relevant voor de dakconstructie zelf. Stormschade aan een half afgewerkt dak is het klassieke scenario. Op projecten met meerdere aannemers is een gezamenlijke polis het eenvoudigst.' },
  { id: 'metsers',       label: 'Metsers',        link: '/sectoren/aannemers',     title: 'Voor metsers en algemene aannemers', text: 'Ruwbouwwerken vormen de kern van ABR-projecten. Als hoofdaannemer coördineer je meerdere partijen en ben je verantwoordelijk voor de correcte verzekering van de werf. Een globale ABR-polis voor alle betrokken partijen geeft de meeste zekerheid.' },
  { id: 'loodgieters',   label: 'Loodgieters',    link: '/sectoren/loodgieters',   title: 'Voor loodgieters',                   text: 'Voor leidingwerk en sanitaire installaties in ruwbouw is ABR relevant. Schade aan niet-afgewerkte installatiewerken door storm of brand op de werf valt onder de polis. Controleer of de globale ABR-polis van de hoofdaannemer jou mee dekt.' },
  { id: 'elektriciens',  label: 'Elektriciens',   link: '/sectoren/elektriciens',  title: 'Voor elektriciens',                  text: 'Elektrische installaties in uitvoering vallen onder ABR. Brand of waterschade die de nog niet-aangesloten bekabeling of verdeelkast beschadigt, is een typisch schadeScenario. Op grotere werven is de ABR van de hoofdaannemer bindend.' },
  { id: 'schilders',     label: 'Schilders',      link: '/sectoren/schilders',     title: 'Voor schilders',                     text: 'Schilderwerk in uitvoering op een grotere werf valt doorgaans onder de globale ABR van de hoofdaannemer. Voor stand-alone schilderopdrachten is ABR minder relevant, tenzij de opdrachtgever er contractueel om vraagt.' },
  { id: 'aannemers',     label: 'Algemene aannemers',link: '/sectoren/aannemers', title: 'Voor algemene aannemers',            text: 'Als hoofdaannemer op een groot project ben je verantwoordelijk voor de ABR-dekking van de volledige werf. Een globale polis voor alle partijen is de standaard bij projecten boven 500.000 euro. Ze vereenvoudigt de coordinatie en vermijdt gaten in de dekking.' },
];

const insuranceCards = [
  { title: 'BA Onderneming',  icon: 'shield',  intro: 'Bescherming wanneer je bedrijf schade veroorzaakt aan derden tijdens de uitbating of beroepsactiviteit.',    bullets: ['Schade aan eigendommen van derden','Letselschade aan derden','Claims rond beroepsfouten','Aansprakelijkheid tijdens werken'],   link: '/verzekeringen/ba-onderneming/',   cta: 'Meer over BA Onderneming' },
  { title: 'Machinebreuk',    icon: 'wrench',  intro: 'Professionele machines en gereedschap zijn duur. Een defect of diefstal stopt je werk. Deze dekking niet.', bullets: ['Machines bij breuk of diefstal','Diefstal op werf of in bestelwagen','Vervanging of herstelling','Op maat van je materieel'],            link: '/verzekeringen/machinebreuk',     cta: 'Meer over machinebreuk' },
  { title: 'Rechtsbijstand',  icon: 'scale',   intro: 'Juridische bescherming bij geschillen met klanten, leveranciers of personeel. Je staat niet alleen.',        bullets: ['Hulp bij juridische conflicten','Vrije advocaatkeuze','Tussenkomst bij advocaatkosten','Aanvulling op BA'],                       link: '/verzekeringen/rechtsbijstand',   cta: 'Meer over rechtsbijstand' },
  { title: 'Arbeidsongevallen',icon: 'users',  intro: 'Wettelijk verplicht vanaf je eerste werknemer. Dekt letsel op de werf en woon-werkverkeer.',                  bullets: ['Verplicht vanaf dag 1','Medische kosten gedekt','Woon-werkverkeer inbegrepen','Aangifte binnen 8 dagen'],                              link: '/verzekeringen/arbeidsongevallen/', cta: 'Meer over arbeidsongevallen' },
];

const schema = {
  "@context": "https://schema.org", "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

const svgCheck16g = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`;
const svgX16r    = `<svg style="flex-shrink:0;margin-top:2px;" width="16" height="16" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
const svgArr18   = `<svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>`;
---

<BaseLayout
  title="Alle Bouwplaatsrisico's (ABR) voor aannemers | Assurman"
  description="Een ABR-verzekering dekt schade aan werken in uitvoering. Onmisbaar bij grotere werven of renovaties met meerdere partijen. Vraag een scan aan."
  canonical="/verzekeringen/alle-bouwplaats-risicos/"
  schema={schema}
>

<style is:global>
  .abr-sticky-btn{background:#F7F4EF;border:1px solid rgba(229,165,36,0.2);cursor:pointer;padding:7px 16px;margin:10px 5px;font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;display:inline-flex;align-items:center;gap:8px;white-space:nowrap;border-radius:9999px;transition:background 0.2s,border-color 0.2s;color:#001F3F;}
  .abr-sticky-btn:hover,.abr-sticky-btn.active{background:rgba(229,165,36,0.18);border-color:#E5A524;}
  .abr-sticky-btn .abr-check{color:#94a3b8;flex-shrink:0;transition:color 0.2s;}
  .abr-sticky-btn:hover .abr-check,.abr-sticky-btn.active .abr-check{color:#E5A524;}
  .abr-tab-btn{background:none;border:none;cursor:pointer;padding:14px 24px;white-space:nowrap;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#64748b;border-bottom:2px solid transparent;margin-bottom:-2px;transition:color 0.2s,border-color 0.2s;}
  .abr-tab-btn:hover,.abr-tab-btn.active{color:#E5A524;border-bottom-color:#E5A524;}
  .abr-ins-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);transition:background 0.2s,transform 0.2s;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);}
  .abr-ins-card:hover{background:rgba(255,255,255,0.1);transform:translateY(-4px);}
  .abr-stat-panel{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.1);border-radius:10px;overflow:hidden;margin-bottom:12px;}
  .abr-stat-btn{width:100%;display:flex;align-items:center;gap:14px;background:none;border:none;cursor:pointer;text-align:left;padding:20px 24px;}
  .abr-scan-btn:hover{background:#324554 !important;}
  .abr-badge-pill{display:inline-flex;align-items:center;gap:8px;background:#F5F2FF;border:1px solid rgba(213,196,174,0.2);border-radius:9999px;padding:6px 16px;font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#001F3F;}
</style>

<style>
  .abr-hero-img{position:absolute;top:5%;right:-5px;height:85%;width:auto;max-width:48%;z-index:1;pointer-events:none;}
  .abr-hero-content{max-width:620px;}
  .abr-hero-inner{max-width:1280px;margin:0 auto;padding:64px 32px 80px;position:relative;z-index:2;}
  .abr-hero-btns{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:32px;}
  .abr-watis-grid{display:grid;grid-template-columns:340px 1fr;gap:56px;align-items:flex-start;}
  .abr-wanneer-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .abr-dekking-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:28px;}
  .abr-plafond-grid{display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;}
  .abr-aanvulling-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .abr-rules-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:0 0 40px;}
  .abr-formule{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:64px;flex-wrap:wrap;}
  .abr-factors-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;max-width:800px;margin:0 auto 40px;}
  .abr-procedure-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;}
  .abr-tab-inner{display:flex;gap:32px;align-items:flex-start;border-radius:12px;}
  .abr-final-btns{display:flex;gap:24px;justify-content:center;margin-bottom:80px;flex-wrap:wrap;}
  .abr-sticky-nav-bar{position:sticky;top:72px;z-index:90;background:#FFFFFF;border-bottom:1px solid rgba(0,31,63,0.08);overflow:auto;}
  .abr-sticky-inner{max-width:1280px;margin:0 auto;padding:0 32px;display:flex;gap:0;justify-content:center;flex-wrap:wrap;}
  .abr-container{max-width:1280px;margin:0 auto;padding:0 32px;}
  .brand-why-card{background:#FFFFFF;border-left:4px solid #E5A524;box-shadow:0px 1px 2px rgba(0,0,0,0.05);transition:box-shadow 0.2s,transform 0.2s;}
  .brand-why-card:hover{box-shadow:0 8px 24px rgba(0,0,0,0.1);transform:translateY(-2px);}

  @media (max-width:1023px){
    .abr-container{padding:0 24px;}
    .abr-sticky-inner{padding:0 24px;}
    .abr-watis-grid{grid-template-columns:1fr;gap:32px;}
    .abr-wanneer-grid{grid-template-columns:repeat(2,1fr);}
    .abr-aanvulling-grid{grid-template-columns:repeat(2,1fr);}
    .abr-rules-grid{grid-template-columns:1fr;}
    .abr-procedure-grid{grid-template-columns:repeat(2,1fr);gap:32px;}
    .abr-factors-grid{grid-template-columns:1fr;}
  }
  @media (max-width:767px){
    .abr-sticky-nav-bar{display:none;}
    .abr-container{padding:0 15px;}
    .abr-hero-content{max-width:100%;}
    .abr-hero-img{display:none;}
    .abr-hero-btns{flex-direction:column;}
    .abr-hero-btns a{width:100%;justify-content:center;text-align:center;}
    #watis{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #wanneer{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #dekking{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #premie{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #procedure{padding-left:15px !important;padding-right:15px !important;padding-bottom:56px !important;}
    #faq{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #abr-beroep{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #abr-statuten{padding-left:15px !important;padding-right:15px !important;padding-top:56px !important;padding-bottom:56px !important;}
    #abr-aanvulling{padding-bottom:56px !important;}
    #abr-cta-band{padding-left:15px !important;padding-right:15px !important;padding-bottom:64px !important;}
    #abr-cta-band h2{font-size:clamp(28px,8vw,48px) !important;}
    #abr-cta-band p{font-size:18px !important;}
    .abr-watis-grid{grid-template-columns:1fr;gap:24px;}
    .abr-wanneer-grid{grid-template-columns:1fr;}
    .abr-dekking-grid{grid-template-columns:1fr;}
    .abr-plafond-grid{grid-template-columns:1fr;}
    .abr-plafond-grid>div:last-child{text-align:center;padding-top:24px;border-top:1px solid rgba(255,255,255,0.15);}
    .abr-aanvulling-grid{grid-template-columns:1fr;}
    .abr-formule{flex-direction:column;gap:8px;margin-bottom:40px;}
    .abr-factors-grid{grid-template-columns:1fr;}
    .abr-procedure-grid{grid-template-columns:1fr 1fr;gap:32px;}
    .abr-tab-inner{flex-direction:column;gap:20px;padding:24px 20px;}
    .abr-tabs-row{overflow-x:auto;justify-content:flex-start !important;padding-bottom:4px;-webkit-overflow-scrolling:touch;}
    .abr-final-btns{flex-direction:column;align-items:center;}
    .abr-final-btns a{width:100%;max-width:400px;justify-content:center;}
    .abr-cta-deco{display:none;}
    .abr-cta-mask-img{display:none;}
    .abr-procedure-line{display:none !important;}
  }
</style>

<div id="abr-progress-track" style="position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;background:rgba(0,31,63,0.07);">
  <div id="abr-progress-bar" style="height:100%;background:#E5A524;width:0%;transition:width 0.1s linear;"></div>
</div>

<div style="font-family:'Outfit',sans-serif;color:#001F3F;background:#FFFFFF;">

<!-- HERO -->
<section id="abr-hero" style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:100vh;">
  <div class="abr-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-algemeen-hero.jpg" alt="Bouwwerf met Alle Bouwplaatsrisico's verzekering" />
  </div>
  <div class="abr-hero-inner">
    <div class="abr-hero-content">
      <div class="abr-badge-pill" style="margin-bottom:20px;">
        <span style="width:8px;height:8px;background:#E5A524;border-radius:50%;flex-shrink:0;"></span>
        Assurman &middot; Bouwverzekeringen op maat
      </div>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(40px,5vw,64px);line-height:1.08;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">Alle Bouwplaats&#x2011;<br />risico's (ABR)</h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,34px);line-height:1.1;color:#E5A524;margin-bottom:20px;">Allesomvattende dekking voor schade aan werken in uitvoering.</p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:#001F3F;margin-bottom:28px;max-width:520px;">Een brand die de halve ruwbouw verwoest. Een storm die het dak wegblaast vóór de dakpannen zijn gelegd. Schade aan werken in uitvoering is nooit volledig te vermijden: een ABR-verzekering zorgt dat je werf niet stilligt.</p>
      <div class="abr-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          {CTA_SCAN.hero}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">{CTA_AFSPRAAK.advisory}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#7A6A55;">Geen verplichting. We finaliseren je pakket samen na je intake.</p>
    </div>
  </div>
</section>

<!-- STICKY NAV -->
<nav id="abr-sticky-nav" class="abr-sticky-nav-bar">
  <div class="abr-sticky-inner">
    {[{id:'watis',label:'Wat is het?'},{id:'wanneer',label:'Wanneer nodig?'},{id:'dekking',label:'Dekking'},{id:'premie',label:'Premie'},{id:'procedure',label:'Schadegeval'},{id:'faq',label:'FAQ'}].map(item=>(
      <button class="abr-sticky-btn" data-sticky-btn={item.id}>
        <svg class="abr-check" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        {item.label}
      </button>
    ))}
  </div>
</nav>

<!-- WAT IS HET -->
<section id="watis" style="background:#FFFFFF;padding:96px 32px;">
  <div class="abr-container">
    <div class="abr-watis-grid">
      <div style="background:#3F5767;padding:32px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);">
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In het kort</span>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:16px;">
          {[
            {t:'ABR dekt <strong style="color:#FFFFFF;">schade aan werken in uitvoering</strong>: het gebouw dat je aan het bouwen bent.'},
            {t:'Ze beschermt <strong style="color:#FFFFFF;">alle betrokken partijen</strong>: opdrachtgever, hoofdaannemer en onderaannemers.'},
            {t:'Loopt van <strong style="color:#FFFFFF;">werfstart tot oplevering</strong>, met optionele onderhoudsdekking daarna.'},
            {t:'Dekt brand, storm, vandalisme, instorting en <strong style="color:#FFFFFF;">schade door uitvoeringsfouten</strong>.'},
            {t:'Niet wettelijk verplicht maar <strong style="color:#FFFFFF;">contractueel vereist bij grotere projecten</strong>.'},
          ].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.55;color:#CBD5E1;" set:html={item.t}></span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wat is het?</span>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 24px;">De allesomvattende dekking voor je werf</h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Een ABR-verzekering (Alle Bouwplaatsrisico's) beschermt de werken in uitvoering tegen alle mogelijke schade: brand, storm, instorting, vandalisme, uitvoeringsfouten en meer. Ze dekt het bouwwerk zelf, de materialen op de werf en de bouwkosten die verloren gaan als je van nul moet beginnen.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 20px;">Wat ABR uniek maakt: ze beschermt alle partijen op de werf in één polis. De opdrachtgever, de hoofdaannemer en elke onderaannemer zijn mee gedekt. Dat vermijdt discussies over wie welke schade veroorzaakte: de polis betaalt, de werf draait verder.</p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0 0 36px;">ABR is niet hetzelfde als BA Onderneming (die dekt schade aan derden buiten de werf) en niet hetzelfde als machinebreuk (die dekt jouw machines). ABR dekt het bouwwerk zelf. De drie polissen zijn complementair op een grotere werf.</p>
        <div style="display:flex;gap:20px;background:rgba(229,165,36,0.07);border:1px solid rgba(229,165,36,0.22);border-radius:10px;padding:24px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <div>
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 6px;">Wettelijke basis</p>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#3F5767;margin:0;">De <strong>Wet van 4 april 2014</strong> regelt alle verzekeringsovereenkomsten in België, inclusief ABR. De <strong>FSMA</strong> houdt toezicht op de verzekeraars. ABR is niet wettelijk verplicht maar wordt in de aanbestedingsvoorwaarden van de meeste grote projecten contractueel vereist.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- WANNEER NODIG -->
<section id="wanneer" style="background:#e5a52414;padding:96px 32px;">
  <div style="max-width:1280px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:64px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Wanneer nodig?</span>
      <p style="font-family:'Outfit',sans-serif;font-weight:500;font-size:18px;color:#64748b;margin-bottom:8px;">Wanneer is een ABR-verzekering nodig voor jou?</p>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(52px,8vw,96px);line-height:0.9;color:#001F3F;letter-spacing:-4px;">Bij grotere<br />werven.</div>
      <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:20px;color:#3F5767;margin-top:12px;">En altijd als de opdrachtgever of het contract het vereist.</p>
    </div>
    <div class="abr-wanneer-grid">
      {[
        {icon:'ft', title:'Nieuwbouwproject',          text:'Standaard bij nieuwbouwprojecten boven een bepaalde waarde. Verplicht bij openbare aanbestedingen.'},
        {icon:'cl', title:'Renovatie met architect',   text:'Bij grotere renovatieprojecten waarbij de opdrachtgever risico loopt op de werken in uitvoering.'},
        {icon:'us', title:'Meerdere aannemers op werf',text:'Een gezamenlijke ABR voor alle partijen vermijdt discussies over wie welke schade veroorzaakte.'},
        {icon:'sh', title:'Contractuele verplichting', text:'Bouwheren, promotoren en overheidsopdrachtgevers eisen ABR als voorwaarde voor werfstart.'},
      ].map(card=>(
        <div style="background:#FFFFFF;padding:28px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);box-shadow:0 2px 8px rgba(0,31,63,0.05);">
          <div style="background:rgba(229,165,36,0.1);border-radius:10px;padding:12px;display:inline-flex;margin-bottom:18px;">
            {card.icon==='ft'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>}
            {card.icon==='cl'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>}
            {card.icon==='us'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>}
            {card.icon==='sh'&&<svg width="28" height="28" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#64748b;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- VOORBEELDEN -->
<section style="background:#FFFFFF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">In de praktijk</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 20px;">Wat voor schade dekt ABR in de praktijk?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;margin:0;">ABR werkt anders dan een gewone polis: ze beschermt de werken zelf, niet je aansprakelijkheid. Tot de oplevering ligt het risico op het onafgewerkte bouwwerk bij de aannemer en de bouwheer. Eén brand, storm of instorting kan maanden werk in een klap vernietigen.</p>
    </div>
    <div class="abr-rules-grid">
      {[
        { title: 'Wie draagt het risico?', text: 'Tot de oplevering rust het risico op de onafgewerkte werken bij de aannemer en de bouwheer. Een ABR verschuift dat risico naar de verzekeraar, zodat een schadegeval de werf niet financieel stillegt.' },
        { title: 'Wat maakt ABR uniek?', text: 'Alle partijen op de werf zitten in één polis: bouwheer, hoofdaannemer en onderaannemers. Ze werkt op het alles-risico-principe: schade is gedekt tenzij ze uitdrukkelijk is uitgesloten.' },
        { title: 'Wanneer wordt het geëist?', text: 'Bij nieuwbouw en grotere renovaties boven een bepaalde waarde, en standaard bij openbare aanbestedingen. Bouwheren en promotoren vragen het ABR-bewijs vaak vóór de werf mag starten.' },
      ].map(card => (
        <div style="background:#FFFFFF;padding:24px;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%);box-shadow:0 2px 8px rgba(0,31,63,0.05);border-top:3px solid #E5A524;">
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.6;color:#3F5767;margin:0;">{card.text}</p>
        </div>
      ))}
    </div>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.6;color:#3F5767;text-align:center;max-width:560px;margin:0 auto 20px;">Zo ziet dat eruit op de werf: zes concrete schadegevallen die zonder ABR-dekking maanden vertraging en zware kosten betekenen.</p>
    <div style="display:flex;justify-content:center;">
      <button id="abr-examples-btn" style="display:flex;align-items:center;gap:10px;background:rgba(0,31,63,0.04);border:1px solid rgba(0,31,63,0.1);border-radius:8px;padding:14px 24px;cursor:pointer;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;color:#001F3F;">
        <span>Bekijk 6 concrete voorbeelden uit de bouw</span>
        <svg id="abr-examples-chevron" width="18" height="18" fill="none" stroke="#001F3F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" style="transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>
    <ul id="abr-examples-list" style="list-style:none;padding:0;margin:16px 0 0;display:none;grid-template-columns:1fr 1fr;gap:10px;">
      {[
        'Storm waait een half afgewerkt dak weg vóór de dakpannen zijn gelegd. ABR dekt de herbouwkosten.',
        'Brand in de ruwbouw vernietigt twee verdiepingen betonwerk en bekisting. ABR dekt de wederopbouw.',
        'Verzakking na hevige regenval beschadigt de fundering van een woning in uitvoering.',
        'Vandalisme op een gesloten werf vernielt muuropeningen en ramen die net waren geplaatst.',
        'Stortregenvlaag beschadigt parketwerk en binnenschrijnwerk net voor de oplevering.',
        'Instorting van een niet-gedraagde bekisting beschadigt de kelderverdieping van een appartementsblok.',
      ].map(ex=>(
        <li style="display:flex;gap:10px;align-items:flex-start;background:#F7F4EF;border-radius:8px;padding:12px 16px;">
          <svg style="flex-shrink:0;margin-top:2px;" width="15" height="15" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{ex}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- DEKKING -->
<section id="dekking" style="background:#F7F4EF;padding:96px 32px;">
  <div style="max-width:1025px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Dekking</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Wat is wél en niet gedekt?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:580px;margin:0 auto;">ABR werkt op basis van een alles-risico-principe: schade is gedekt tenzij ze uitdrukkelijk uitgesloten is.</p>
    </div>
    <div class="abr-dekking-grid">
      <div style="background:#FFFFFF;border:2px solid rgba(34,197,94,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(34,197,94,0.08);border-bottom:1px solid rgba(34,197,94,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#15803d;">Wel gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Schade aan werken in uitvoering door brand, storm, water en instorting','Schade door uitvoeringsfouten en nalatigheid van werknemers of aannemers','Vandalisme en inbraak op de werf met schade aan de constructie','Weersinvloeden zoals hagel, sneeuw, overstromingen en vorst','Materialen op de werf die bestemd zijn voor verwerking','Tijdelijke constructies zoals bekisting, steigers en afschermingen'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgCheck16g} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div style="background:#FFFFFF;border:2px solid rgba(239,68,68,0.5);border-radius:1px;overflow:hidden;">
        <div style="background:rgba(239,68,68,0.06);border-bottom:1px solid rgba(239,68,68,0.18);padding:16px 28px;display:flex;align-items:center;gap:10px;">
          <svg width="18" height="18" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#b91c1c;">Niet (of beperkt) gedekt</span>
        </div>
        <ul style="list-style:none;padding:20px 28px;margin:0;display:flex;flex-direction:column;gap:14px;">
          {['Schade aan bestaande gebouwen (zonder uitbreiding bestaand gebouw)','Materialen opgeslagen buiten de werf (magazijn, leverancier)','Machines en gereedschap van aannemers: valt onder machinebreuk','Opzettelijke schade of bedrog door de verzekerde','Normale slijtage en esthetische gebreken','Aansprakelijkheid tegenover derden buiten de werf: valt onder BA Onderneming'].map(item=>(
            <li style="display:flex;gap:12px;align-items:flex-start;">
              <Fragment set:html={svgX16r} />
              <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.5;">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="abr-plafond-grid" style="background:#3F5767;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 28px),calc(100% - 28px) 100%,0% 100%);padding:36px 40px;">
      <div>
        <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Plafond</span>
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:24px;color:#FFFFFF;margin:0 0 12px;">Verzekerd bedrag gelijk aan de totale bouwkost</h3>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#CBD5E1;max-width:520px;margin:0;">Het verzekerd bedrag bij ABR is altijd gelijk aan of hoger dan de totale bouwkost (inclusief erelonen). Bij totaalverlies betaalt de verzekeraar de volledige herbouwkost. Onderverzekering (een te laag verzekerd bedrag) leidt tot proportionele vergoeding: een punt om bij het afsluiten goed op te letten.</p>
      </div>
      <div style="text-align:center;flex-shrink:0;">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:6px;">Verzekerd bedrag</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:36px;color:#FFFFFF;letter-spacing:-1px;line-height:1;">= Totale<br />bouwkost</div>
        <div style="font-family:'Outfit',sans-serif;font-size:14px;color:#94a3b8;margin-top:6px;">inclusief erelonen</div>
      </div>
    </div>
  </div>
</section>

<!-- AANVULLENDE WAARBORGEN -->
<section id="abr-aanvulling" style="background:#3F5767;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="white" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding:100px 32px 0;position:relative;z-index:1;">
    <div style="max-width:640px;margin-bottom:52px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Aanvullen</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#FFFFFF;margin:0 0 16px;">Vijf uitbreidingen die je polis afmaken</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#CBD5E1;margin:0;">De basis ABR dekt de werken. Maar een volledig project vraagt doorgaans extra modules afhankelijk van de omvang en de specifieke risico's.</p>
    </div>
    <div class="abr-aanvulling-grid">
      {[
        {i:'ac',title:'Bestaand gebouw',              text:'Dekt schade aan het pand dat je renoveert. Standaard uitgesloten van ABR. Onmisbaar bij renovatieprojecten in bestaande constructies.'},
        {i:'sh',title:'Aansprakelijkheid (CAR)',      text:'Breidt ABR uit met aansprakelijkheid tegenover derden. Bundelt ABR en BA Onderneming voor de duur van de werf in één contract.'},
        {i:'us',title:'Onderhoudsdekking',            text:'Verlengde dekking na oplevering (typisch 12-24 maanden) voor schade die te herleiden is tot de bouwfase.'},
        {i:'tr',title:'Materialen off-site',          text:'Dekt materialen die bestemd zijn voor de werf maar nog opgeslagen zijn bij leverancier of in het magazijn.'},
        {i:'br',title:'Bedrijfsschade na ABR-schade', text:'Vergoedt omzetverlies of extra kosten als de oplevering vertraging oploopt door een gedekte ABR-schade.'},
      ].map(card=>(
        <div class="abr-ins-card" style="padding:28px;">
          <div style="background:rgba(229,165,36,0.15);border-radius:10px;padding:10px;display:inline-flex;margin-bottom:16px;">
            {card.i==='ac'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>}
            {card.i==='sh'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>}
            {card.i==='us'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>}
            {card.i==='tr'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>}
            {card.i==='br'&&<svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>}
          </div>
          <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#FFFFFF;margin:0 0 10px;">{card.title}</h3>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#94A3B8;margin:0;">{card.text}</p>
        </div>
      ))}
      <div style="background:#E5A524;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%);padding:32px;display:flex;flex-direction:column;justify-content:center;">
        <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#001F3F;margin:0 0 12px;">Volledig op jouw maat</h3>
        <p style="font-family:'Outfit',sans-serif;font-size:15px;color:rgba(0,31,63,0.75);line-height:1.55;margin:0 0 20px;">Niet elk project heeft dezelfde uitbreidingen nodig. Laat ons jouw polis samenstellen in een gratis scan.</p>
        <a href={CTA_DESTINATIONS.scan} class="abr-scan-btn" style="display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#3F5767;color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:15px;padding:12px 24px;border-radius:8px;text-decoration:none;transition:background 0.2s;width:100%;">
          {CTA_SCAN.doIt} <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- PREMIE -->
<section id="premie" style="background:#F7F4EF;padding:0 32px 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;"><BrandChevron color="#E5A524" height="80px" direction="down" /></div>
  <div style="max-width:1280px;margin:0 auto;padding-top:100px;">
    <div style="text-align:center;margin-bottom:56px;">
      <span style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;display:block;margin-bottom:12px;">Prijs &amp; berekening</span>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,3.5vw,48px);line-height:1.05;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">Hoe wordt de premie berekend?</h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#64748b;max-width:520px;margin:0 auto;">De ABR-premie is typisch 0,1% tot 0,5% van de totale bouwkost. Voor een nieuwbouwwoning van 300.000 euro betekent dat doorgaans tussen 300 en 1.500 euro voor de volledige bouwperiode.</p>
    </div>
    <div class="abr-formule">
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">1. Bouwkost</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:8px;">Totale bouwkost</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#64748b;line-height:1.4;">inclusief erelonen en btw</div>
      </div>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">×</div>
      <div style="background:#FFFFFF;border:1px solid rgba(0,31,63,0.1);border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 2px 8px rgba(0,31,63,0.05);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">2. Premievoet</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#001F3F;margin-bottom:8px;">Type werken en risicoprofiel</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#64748b;line-height:1.4;">0,1% tot 0,5% typisch</div>
      </div>
      <div style="font-family:'Outfit',sans-serif;font-weight:900;font-size:40px;color:#E5A524;user-select:none;">=</div>
      <div style="background:#3F5767;border-radius:12px;padding:28px 32px;text-align:center;min-width:200px;box-shadow:0 8px 32px rgba(63,87,103,0.3);">
        <div style="font-family:'Outfit',sans-serif;font-weight:700;font-size:12px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin-bottom:10px;">Projectpremie</div>
        <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:20px;color:#FFFFFF;margin-bottom:8px;">Eénmalig</div>
        <div style="font-family:'Outfit',sans-serif;font-size:13px;color:#94a3b8;line-height:1.4;">voor de volledige bouwperiode</div>
      </div>
    </div>
    <h3 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:22px;color:#001F3F;text-align:center;margin-bottom:32px;">4 factoren die je premie beïnvloeden</h3>
    <div class="abr-factors-grid">
      {[
        {num:'1',title:'Type werken',            text:'Nieuwbouw, renovatie, hoog- of laagbouw: elk heeft een eigen risicoprofiel en premievoet.'},
        {num:'2',title:'Bouwperiode',            text:'Hoe langer de bouwfase, hoe langer de blootstelling en hoe hoger de premie.'},
        {num:'3',title:'Gekozen uitbreidingen',  text:'Extra modules zoals bestaand gebouw of bedrijfsschade verhogen de premie maar verlagen het risico.'},
        {num:'4',title:'Eigen risico',           text:'Een hoger eigen risico drukt de premie maar vergroot je eigen aandeel bij schade.'},
      ].map(f=>(
        <div class="brand-why-card" style="padding:20px 24px;display:flex;gap:18px;align-items:flex-start;">
          <div style="width:36px;height:36px;border-radius:50%;background:#E5A524;display:flex;align-items:center;justify-content:center;flex-shrink:0;"><span style="font-family:'Outfit',sans-serif;font-weight:900;font-size:16px;color:#001F3F;">{f.num}</span></div>
          <div>
            <h4 style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 4px;">{f.title}</h4>
            <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:14px;line-height:1.65;color:#64748b;margin:0;">{f.text}</p>
          </div>
        </div>
      ))}
    </div>
    <div style="max-width:640px;margin:0 auto;">
      <div style="background:rgba(229,165,36,0.10);padding:20px 28px;clip-path:polygon(24px 0%,100% 0%,100% calc(100% - 24px),calc(100% - 24px) 100%,0% 100%,0% 24px);border:1px solid rgba(229,165,36,0.3);">
        <div style="display:flex;gap:14px;align-items:flex-start;">
          <svg style="flex-shrink:0;margin-top:2px;" width="18" height="18" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:15px;line-height:1.65;color:#001F3F;margin:0;"><strong>Fiscaal:</strong> de ABR-premie is fiscaal aftrekbaar als beroepskost. Op de premie is een premietaks van <strong>9,25%</strong> verschuldigd, die ook aftrekbaar is.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CTA BAND -->
<section id="abr-cta-band" style="background:#E9C466;padding:80px 0 100px;position:relative;overflow:hidden;">
  <div class="assurman-mask assurman-mask--cta abr-cta-mask-img" style="position:absolute;top:0;right:-4px;width:380px;pointer-events:none;z-index:1;">
