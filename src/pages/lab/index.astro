---
// ── LAB: overzichtspagina ─────────────────────────────────────────────────
// Lijst van alle /lab/*-testpagina's onder elkaar, handig om snel iets op te
// zoeken of te bespreken met Benoit. Route: /lab/ · noindex · niet in nav.
import BaseLayout from '../../layouts/BaseLayout.astro';

// Beschrijvingen zijn voor Benoit en Maaike, niet voor onszelf. Dus geen
// techniek in de zichtbare tekst: geen framework-, plugin- of systeemnamen.
const labPages = [
  {
    href: '/lab/home',
    title: 'Homepagina met de nieuwe vormgeving',
    beschrijving: 'Het bovenste blok van de homepagina in een nieuwe stijl, met de sectie eronder erbij zodat je de overgang ziet.',
  },
  {
    href: '/lab/sector',
    title: 'Sectorpagina met de nieuwe vormgeving',
    beschrijving: 'Dezelfde stijl toegepast op een pagina voor een beroep, in dit geval dakwerkers.',
  },
  {
    href: '/lab/verzekering',
    title: 'Verzekeringspagina met de nieuwe vormgeving',
    beschrijving: 'Dezelfde stijl op een pagina over een polis, in dit geval arbeidsongevallen.',
  },
  {
    href: '/lab/verzekeringsscan',
    title: 'De bijgewerkte verzekeringsscan',
    beschrijving: 'De scan volledig herwerkt: 19 beroepen en 18 verzekeringen, met vragen op maat van de stiel die je kiest. Je krijgt meteen te zien welke dekkingen bij jouw activiteit horen.',
  },
  {
    href: '/lab/assistent',
    title: 'De AI-assistent',
    beschrijving: 'De assistent op een gewone pagina, zodat je ziet hoe die aanvoelt voor iemand die op de site komt.',
  },
];
---

<BaseLayout
  title="Testomgeving | Assurman"
  description="Pagina's die we aan het uitproberen zijn. Niet publiek."
  canonical="/lab/"
  noindex={true}
>
  <section style="background:#FFFFFF;padding:140px 0 80px;">
    <div style="max-width:900px;margin:0 auto;padding:0 32px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Testomgeving</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,44px);color:#001F3F;margin:0 0 40px;">Wat we aan het uitproberen zijn</h1>

      <div style="display:flex;flex-direction:column;gap:1px;background:rgba(0,31,63,0.08);">
        {labPages.map((page) => (
          <a
            href={page.href}
            style="display:block;background:#FFFFFF;padding:24px 28px;text-decoration:none;transition:background 0.15s;"
          >
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 6px;">
              {page.title}
            </p>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">
              {page.beschrijving}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
