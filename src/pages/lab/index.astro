---
// ── LAB: overzichtspagina ─────────────────────────────────────────────────
// Lijst van alle /lab/*-testpagina's onder elkaar, handig om snel iets op te
// zoeken of te bespreken met Benoit. Route: /lab/ · noindex · niet in nav.
import BaseLayout from '../../layouts/BaseLayout.astro';

const labPages = [
  {
    href: '/lab/home',
    title: 'Home — hero-deco',
    beschrijving: 'Homepage-hero met concentrische mask-deco (v1-kleuren) + de echte 2de sectie, om de overgang te testen.',
  },
  {
    href: '/lab/sector',
    title: 'Sectorpagina — hero-deco',
    beschrijving: 'Eerste 3 secties van een sectorpagina (dakwerkers) met de hero-deco toegepast, incl. sectie-overgang.',
  },
  {
    href: '/lab/verzekering',
    title: 'Verzekeringspagina — hero-deco',
    beschrijving: 'Eerste secties van een verzekeringspagina (arbeidsongevallen) met de hero-deco, test van wit-op-wit-overgang.',
  },
  {
    href: '/lab/verzekeringsscan',
    title: 'Verzekeringsscan — native versie',
    beschrijving: 'Native React-scan op basis van de eigen 19-sectoren + 18-verzekeringen-databron, i.p.v. de GHL AI Studio-iframe.',
  },
  {
    href: '/lab/assistent',
    title: 'AI-assistent — widget test',
    beschrijving: 'Kloon van de contactpagina, enkel om de GHL chat-widget te tonen in een realistische paginacontext.',
  },
];
---

<BaseLayout
  title="LAB — overzicht | Assurman"
  description="Interne testomgeving, niet publiek geïndexeerd."
  canonical="/lab/"
  noindex={true}
>
  <section style="background:#FFFFFF;padding:140px 0 80px;">
    <div style="max-width:900px;margin:0 auto;padding:0 32px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Intern · niet geïndexeerd</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,44px);color:#001F3F;margin:0 0 40px;">Lab — overzicht</h1>

      <div style="display:flex;flex-direction:column;gap:1px;background:rgba(0,31,63,0.08);">
        {labPages.map((page) => (
          <a
            href={page.href}
            style="display:block;background:#FFFFFF;padding:24px 28px;text-decoration:none;transition:background 0.15s;"
          >
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:18px;color:#001F3F;margin:0 0 6px;">
              {page.title} <span style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#9AABB7;">{page.href}</span>
            </p>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">
              {page.beschrijving}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
