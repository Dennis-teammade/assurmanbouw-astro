---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollProgress from '../components/islands/ScrollProgress';
import PartnerSlider from '../components/ui/PartnerSlider';
---

<style>
  .oa-container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }
  .oa-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .oa-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .oa-story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .oa-values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  /* ── Team rows ── */
  .oa-team-row { display: flex; gap: 28px; justify-content: center; margin-bottom: 28px; flex-wrap: wrap; }
  .oa-team-row:last-child { margin-bottom: 0; }
  .oa-team-card { flex: 0 0 210px; }

  /* ── Team box (hover-reveal gold gradient) ── */
  .team-box { border-radius: 150px; background: #fff; position: relative; overflow: hidden; text-align: center; padding: 28px 18px 22px; box-shadow: 0 2px 10px rgba(0,31,63,0.07); }
  .team-box::before { position: absolute; content: ''; left: 0; top: 0; width: 0; height: 100%; border-radius: 150px; box-shadow: inset 0 0 25px rgba(0,0,0,0.20); transition: all 0.35s ease; background-image: linear-gradient(to right, #e9c466 0%, #E5A524 100%); }
  .team-box:hover::before { width: 100%; }
  .team-box:hover .team-img-wrap { padding: 0; }
  .team-box:hover .team-desc h3,
  .team-box:hover .team-desc .team-rol { color: #fff; }
  .team-box:hover .team-social li a { background: #fff; background-image: none; color: #3F5767; }
  .team-box:hover .team-social li a:hover { background: #1d1d1d; color: #fff; }

  /* ── Circular image wrapper ── */
  .team-img-wrap { position: relative; width: 148px; height: 148px; margin: 0 auto 18px; overflow: hidden; border-radius: 50%; padding: 10px; transition: all 0.5s ease; box-shadow: inset 0 0 20px rgba(0,0,0,0.15); }
  .team-img-wrap img { border-radius: 50%; width: 100%; height: 100%; object-fit: cover; display: block; transition: all 500ms ease; }

  /* ── Team text ── */
  .team-desc { position: relative; }
  .team-desc h3 { font-family: 'Outfit', sans-serif; font-weight: 900; font-size: 17px; color: #001F3F; margin: 0 0 4px; line-height: 1.2; transition: color 0.3s; }
  .team-desc .team-rol { font-family: 'Open Sans', sans-serif; font-weight: 700; font-size: 11px; color: #3F5767; text-transform: uppercase; letter-spacing: 0.8px; margin: 0; transition: color 0.3s; }

  /* ── Social icons ── */
  .team-social { list-style: none; padding: 0; margin: 14px 0 0; display: flex; justify-content: center; gap: 8px; }
  .team-social li { display: inline-block; }
  .team-social li a { position: relative; width: 34px; height: 34px; background-image: linear-gradient(to right, #3F5767 0%, #3F5767 100%); display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; color: #fff; text-decoration: none; transition: all 0.3s ease; }
  .team-social li a:hover { background: #001F3F; background-image: none; }

  .oa-cta-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  @media (max-width: 1023px) {
    .oa-container { padding: 0 24px; }
    .oa-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    .oa-story-grid { grid-template-columns: 1fr; gap: 40px; }
    .oa-values-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 639px) {
    .oa-container { padding: 0 15px; }
    .oa-values-grid { grid-template-columns: 1fr; }
    .oa-team-card { flex: 0 0 calc(50% - 14px); }
    .oa-cta-btns { flex-direction: column; align-items: center; }
    .oa-cta-btns a { width: 100%; max-width: 360px; justify-content: center; }
  }
</style>

<BaseLayout
  title="Over Assurman | Specialist in bouwverzekeringen"
  description="Assurman is een onafhankelijke verzekeringsmakelaar gespecialiseerd in de bouwsector in West- en Oost-Vlaanderen."
  canonical="/over-assurman"
>
  <ScrollProgress client:load />

  <!-- ═══ HERO ═══ -->
  <section style="background:#FFFFFF;position:relative;overflow:hidden;min-height:680px;">
    <div class="oa-container" style="padding-top:var(--hero-gap);padding-bottom:80px;">
      <div class="oa-hero-grid">

        <!-- Links: tekst -->
        <div>
          <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Over ons</p>
          <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,4.5vw,64px);line-height:1.05;letter-spacing:-1px;color:#001F3F;margin:0 0 24px;">Specialist in bouwverzekeringen</h1>
          <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 32px;">Assurman is een onafhankelijke verzekeringsmakelaar met meer dan 15 jaar ervaring in de bouwsector. We werken voor bouwprofessionals in West- en Oost-Vlaanderen: van zelfstandige dakwerker tot aannemersbedrijf met meerdere ploegen.</p>
          <a href="/gratis-verzekeringsscan/" style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:17px;padding:16px 32px;border-radius:8px;text-decoration:none;">
            Start gratis scan
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>

        <!-- Rechts: stats -->
        <div class="oa-stats-grid">
          {[
            {stat:'Bouw', label:'Met passie & expertise'},
            {stat:'15+',  label:'Jaar sectorervaring'},
            {stat:'20+',  label:'Verzekeringspartners'},
            {stat:'5/5',  label:'Klanttevredenheid'},
          ].map((item) => (
            <div style="background:rgba(229,165,36,0.08);border:1px solid rgba(229,165,36,0.25);clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 16px),calc(100% - 16px) 100%,0% 100%);padding:28px;text-align:center;">
              <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:36px;color:#E5A524;margin:0 0 6px;">{item.stat}</p>
              <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:#3F5767;margin:0;">{item.label}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ ONS VERHAAL ═══ -->
  <section style="background:#FFFFFF;padding:100px 0;">
    <div class="oa-container">
      <div class="oa-story-grid">

        <div>
          <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Ons verhaal</p>
          <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,44px);line-height:1.1;color:#001F3F;margin:0 0 24px;">Geboren uit de bouwsector</h2>
          <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0 0 20px;">Assurman is ontstaan vanuit een duidelijke vaststelling: de bouwsector heeft specifieke verzekeringsbehoeften die een generalist niet correct kan invullen. Een dakwerker heeft andere risico's dan een kantoorhouder. Een aannemer met meerdere ploegen heeft andere noden dan een zelfstandige loodgieter.</p>
          <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0 0 20px;">Door uitsluitend te focussen op bouwprofessionals, kennen we de sector van binnenuit: de verplichte verzekeringen, de typische risico's, de meest competitieve maatschappijen en de valkuilen bij polissen die niet goed zijn afgestemd.</p>
          <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0;">Assurman werkt als onafhankelijk makelaar: we zijn niet gebonden aan één verzekeraar. Dat geeft ons de vrijheid om altijd de beste optie te zoeken voor onze klanten.</p>
        </div>

        <div>
          <div style="background:#F7F4EF;border-radius:12px;padding:40px;margin-bottom:24px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:22px;color:#001F3F;margin:0 0 12px;">FSMA-erkend makelaar</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:16px;line-height:1.6;color:#3F5767;margin:0 0 16px;">Assurman is erkend door de FSMA (Financiële Diensten en Markten Autoriteit) als verzekeringsmakelaar. Dit betekent dat we gebonden zijn aan strikte gedragsregels en dat je belangen wettelijk beschermd zijn.</p>
            <div style="background:#3F5767;border-radius:6px;padding:16px 20px;display:inline-block;">
              <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;color:#E9C466;margin:0;">FSMA-erkenningsnummer</p>
              <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:rgba(255,255,255,0.8);margin:4px 0 0;">0805.250.547</p>
            </div>
          </div>
          <div style="background:#FFF8E7;border-left:4px solid #E5A524;padding:24px;border-radius:0 8px 8px 0;">
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:15px;color:#001F3F;margin:0 0 8px;">Onafhankelijk advies</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">Als onafhankelijk makelaar zijn we niet gebonden aan één verzekeraar. We vergelijken meer dan 20 erkende maatschappijen en kiezen altijd het product dat het best aansluit bij je situatie.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══ WAARDEN ═══ -->
  <section style="background:#F7F4EF;padding:100px 0;">
    <div class="oa-container">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;text-align:center;">Onze waarden</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,44px);line-height:1.1;color:#001F3F;margin:0 0 48px;text-align:center;">Waarom bouwers kiezen voor Assurman</h2>
      <div class="oa-values-grid">
        {[
          {
            title: 'Onafhankelijk',
            iconPath: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
            text: "Geen binding met één verzekeraar. We vergelijken en kiezen altijd het beste aanbod voor je situatie, niet het meest winstgevende voor ons.",
          },
          {
            title: 'Specialisatie bouw',
            iconPath: 'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z',
            text: "Uitsluitend actief voor bouwprofessionals. We kennen de verplichte verzekeringen, de typische risico's en de beste polissen per sector.",
          },
          {
            title: 'Snel & helder',
            iconPath: 'M13 2L3 14h9l-1 9 10-12h-9l1-9z',
            text: 'Geen weken wachten op een offerte. Geen onbegrijpelijk jargon. Assurman werkt snel en communiceert helder.',
          },
          {
            title: 'Meegroeiend',
            iconPath: 'M22 7L13.5 15.5l-5-5L2 17M22 7h-6M22 7v6',
            text: 'Je bouwbedrijf groeit. Je verzekeringen groeien mee. Assurman reviewt jaarlijks of je dekkingen nog passend zijn.',
          },
        ].map((item) => (
          <div style="background:#FFFFFF;clip-path:polygon(0% 0%,100% 0%,100% calc(100% - 20px),calc(100% - 20px) 100%,0% 100%);padding:36px;box-shadow:0 2px 16px rgba(0,31,63,0.05);">
            <div style="width:48px;height:48px;background:rgba(229,165,36,0.12);border-radius:10px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
              <svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={item.iconPath}/></svg>
            </div>
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:20px;color:#001F3F;margin:0 0 12px;">{item.title}</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TEAM ═══ -->
  <section style="background:#FFFFFF;padding:100px 0;">
    <div class="oa-container">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;text-align:center;">Ons team</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,44px);line-height:1.1;color:#001F3F;margin:0 0 52px;text-align:center;">De mensen achter Assurman</h2>

      <!-- Rij 1: eigenaren -->
      <div class="oa-team-row">
        {[
          { voornaam:'Benoit', naam:'Keerman',   rol:'Eigenaar & oprichter' },
          { voornaam:'Maaike', naam:'De Grande', rol:'Eigenaar & office manager' },
        ].map((member) => (
          <div class="oa-team-card">
            <div class="team-box">
              <div class="team-img-wrap">
                <img src={`/Team-assurman-${member.voornaam}.jpg`} alt={`${member.voornaam} ${member.naam}`} width="300" height="300" />
              </div>
              <div class="team-desc">
                <h3>{`${member.voornaam} ${member.naam}`}</h3>
                <p class="team-rol">{member.rol}</p>
              </div>
              <ul class="team-social">
                <li>
                  <a href="tel:003250361693" aria-label="Bel ons">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.79 2.82h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.9a16 16 0 0 0 6.18 6.18l1.24-1.24a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  </a>
                </li>
                <li>
                  <a href={`mailto:${member.voornaam.toLowerCase()}@assurman.be`} aria-label={`Mail ${member.voornaam}`}>
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Rij 2: experten -->
      <div class="oa-team-row">
        {[
          { voornaam:'Axelle',   naam:'De Cuyper',  rol:'Vennoot: Expert verzekeringen' },
          { voornaam:'Danitsja', naam:'Deneve',     rol:'Expert verzekeringen' },
          { voornaam:'Sabine',   naam:'Beernaerts', rol:'Expert schade' },
        ].map((member) => (
          <div class="oa-team-card">
            <div class="team-box">
              <div class="team-img-wrap">
                <img src={`/Team-assurman-${member.voornaam}.jpg`} alt={`${member.voornaam} ${member.naam}`} width="300" height="300" />
              </div>
              <div class="team-desc">
                <h3>{`${member.voornaam} ${member.naam}`}</h3>
                <p class="team-rol">{member.rol}</p>
              </div>
              <ul class="team-social">
                <li>
                  <a href="tel:003250361693" aria-label="Bel ons">
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.88 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.79 2.82h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.9a16 16 0 0 0 6.18 6.18l1.24-1.24a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  </a>
                </li>
                <li>
                  <a href={`mailto:${member.voornaam.toLowerCase()}@assurman.be`} aria-label={`Mail ${member.voornaam}`}>
                    <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ═══ KLANTERVARINGEN (zelfde reviews-sectie als op /werkwijze) ═══ -->
  <section style="background:#FBF8FF;padding:100px 0 100px;">
    <div class="oa-container">
      <div style="text-align:center;margin-bottom:56px;">
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:12px;">Klantervaringen</p>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3.2vw,42px);line-height:1.1;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">
          Bouwprofessionals over hun samenwerking met Assurman
        </h2>
        <p style="font-family:'Outfit',sans-serif;font-size:18px;color:#64748B;max-width:560px;margin:0 auto;">
          Niets zegt meer dan de ervaring van de mensen voor wie we elke dag werken. Lees hieronder hun eigen woorden.
        </p>
      </div>
      <iframe
        class="lc_reviews_widget"
        src="https://reputationhub.site/reputation/widgets/review_widget/CZvuwnma5HR0BBq9wPYn?widgetId=69e88c0cc5c871fdf4cf5ef2"
        frameborder="0"
        scrolling="no"
        style="min-width:100%;width:100%;display:block;border:none;"
        title="Klantreviews Assurman"
      ></iframe>
      <script src="https://reputationhub.site/reputation/assets/review-widget.js" async></script>
      <p style="font-family:'Open Sans',sans-serif;font-size:13px;color:#94A3B8;text-align:center;margin-top:24px;">
        Reviews worden rechtstreeks getoond vanuit Google. Onbewerkt en geverifieerd.
      </p>
    </div>
  </section>

  <!-- ═══ PARTNERS ═══ -->
  <section style="background:#FFFFFF;padding:60px 0;">
    <div class="oa-container">
      <p style="text-align:center;font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#3F5767;margin:0 0 32px;">Onze verzekeringspartners</p>
      <PartnerSlider client:visible />
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section style="background:#3F5767;padding:100px 0 0;text-align:center;position:relative;overflow:hidden;">
    <div class="oa-container" style="padding-bottom:80px;position:relative;z-index:1;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Gratis en vrijblijvend</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,52px);line-height:1.1;color:#FFFFFF;margin:0 0 20px;">Maak kennis met Assurman</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);max-width:560px;margin:0 auto 40px;">Start met de gratis risicoscan of plan een afspraak. Geen verplichtingen, wel expertise.</p>
      <div class="oa-cta-btns">
        <a href="/gratis-verzekeringsscan/" style="display:inline-flex;align-items:center;gap:10px;background:#E5A524;color:#001F3F;font-family:'Open Sans',sans-serif;font-weight:700;font-size:17px;padding:18px 36px;border-radius:8px;text-decoration:none;">
          Gratis scan starten
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href="/maak-afspraak" style="display:inline-flex;align-items:center;gap:10px;background:transparent;border:2px solid rgba(255,255,255,0.3);color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:17px;padding:18px 36px;border-radius:8px;text-decoration:none;">Afspraak maken</a>
      </div>
    </div>
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
  </section>

</BaseLayout>
