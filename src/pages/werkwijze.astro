---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandChevron from '../components/BrandChevron.astro';
import FaqAccordion from '../components/islands/FaqAccordion';
import PartnerSlider from '../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../data/cta-labels';

const steps = [
  {
    num: '01',
    title: 'Korte intake',
    duration: '2 minuten',
    align: 'left' as const,
    what: 'Je geeft kort aan wie je bent en wat je doet: je beroep, het type werven waar je op staat, en wat je zeker wil verzekeren. Dat kan via ons online formulier of tijdens een eerste telefonisch contact.',
    gainLabel: null,
    bullets: null,
    why: 'Geen papieren vragenlijsten, geen dikke dossiers. We starten met wat echt relevant is om te weten of en hoe we je kunnen helpen.',
  },
  {
    num: '02',
    title: 'Risico-scan op maat',
    duration: 'Wij doen het werk',
    align: 'right' as const,
    what: "We bekijken jouw situatie grondig: type werven (renovatie, nieuwbouw, onderhoud), materiaalwaarde, bestelwagen, team, eventuele onderaannemers, en de typische risico's binnen jouw stiel. Heb je al lopende polissen? Dan nemen we die mee in de scan.",
    gainLabel: 'Specifiek bekeken',
    bullets: [
      { b: 'Onderverzekering:', r: ' ben je voldoende gedekt voor wat er werkelijk op het spel staat?' },
      { b: 'Dubbele dekking:', r: ' betaal je nu voor zaken die al in een andere polis zitten?' },
      { b: 'Blinde vlekken:', r: " welke risico's vallen vandaag buiten je dekking?" },
      { b: 'Wettelijke verplichtingen:', r: ' voldoe je aan alles wat in België vereist is?' },
    ],
    why: "In de bouwsector zitten de grootste financiële risico's vaak in details: een onderaannemer die valt, materiaal dat gestolen wordt, een werf die stilligt na schade. Een generieke polis ziet die details niet. Wij wel.",
  },
  {
    num: '03',
    title: 'Voorstel met modules',
    duration: 'Transparant & vergelijkbaar',
    align: 'left' as const,
    what: "Je krijgt een helder voorstel opgebouwd uit modules die bij jouw situatie passen. Denk aan BA uitbating, alle bouwplaatsrisico's (ABR), dekking voor gereedschap en bestelwagen, rechtsbijstand, arbeidsongevallen. Je ziet per module wat het dekt, wat het kost en waarom het voor jou relevant is.",
    gainLabel: 'Hoe we werken',
    bullets: [
      { b: 'Enkel wat nuttig is:', r: ' geen opties die alleen de premie opdrijven' },
      { b: 'Transparante opbouw:', r: ' je ziet wat elke module doet' },
      { b: 'Onafhankelijk advies:', r: ' we vergelijken meerdere verzekeraars' },
      { b: 'Modulair:', r: ' je start met een kernpakket en breidt uit wanneer nodig' },
    ],
    why: 'Enkel wat nuttig is, geen opties die alleen de premie opdrijven. Onafhankelijk advies, we vergelijken meerdere verzekeraars. Een voorstel dat je rustig kan doornemen en waarover je vragen mag stellen zonder je ergens toe te verbinden.',
  },
  {
    num: '04',
    title: 'Afstemming & activatie',
    duration: 'Actief binnen 24 tot 48u',
    align: 'right' as const,
    what: 'We nemen het voorstel samen door, beantwoorden je vragen, en passen aan waar nodig. Eens alles klopt, zorgen wij voor de administratieve afhandeling met de verzekeraar. Jij hoeft niet zelf te bellen, geen formulieren te mailen, geen dossiers op te volgen.',
    gainLabel: null,
    bullets: null,
    why: "Je bent verzekerd, met een dossier dat klopt. Je krijgt een helder overzicht van wat je hebt en bij wie je terecht kan bij schade. En je weet dat wij blijven meedenken, niet alleen op dag één.",
  },
];

const proofpoints = [
  {
    stat: '15+ jaar',
    title: 'Lokaal verankerd',
    body: 'Assurman is geen anoniem online platform. We kennen de West- en Oost-Vlaamse bouwmarkt van binnenuit: de werven, de verzekeraars, de valkuilen. Korte lijnen, bereikbaar advies.',
    iconPath: 'M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18ZM6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2M10 6h4M10 10h4M10 14h4M10 18h4',
  },
  {
    stat: '500+',
    title: 'Gespecialiseerd in bouw',
    body: "Geen generalisten die ook bouw erbij doen. Onze expertise ligt specifiek in de bouwsector: dakwerkers, elektriciens, aannemers, loodgieters, schrijnwerkers, schilders.",
    iconPath: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 8 0 4 4 0 0 0-8 0M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
  },
  {
    stat: '20+',
    title: 'Onafhankelijk advies',
    body: 'Wij zijn niet gebonden aan één maatschappij. We vergelijken het aanbod en kiezen wat bij jou past, op basis van dekking én prijs. Jij krijgt de polis die past, niet de polis die wij moeten verkopen.',
    iconPath: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  },
  {
    stat: 'Meegroeiend',
    title: 'Modulair en meegroeiend',
    body: 'Je start klein, je breidt uit wanneer je groeit. Meer personeel, grotere werven, meer materiaal? Je polis groeit mee zonder dat je telkens opnieuw van nul moet beginnen.',
    iconPath: 'M22 7L13.5 15.5l-5-5L2 17M22 7h-6M22 7v6',
  },
];

const naActivatieItems = [
  { label: 'Jaarlijkse polis-check', desc: 'We controleren elk jaar of je dekking nog overeenkomt met je activiteiten en groei.' },
  { label: 'Rechtstreeks contact bij schade', desc: 'Jij belt ons. Wij nemen het dossier op en begeleiden het contact met de verzekeraar.' },
  { label: 'Polis groeit mee met je bedrijf', desc: 'Meer personeel, een tweede bestelwagen, grotere werven? We passen mee aan.' },
];

const faqItems = [
  {
    title: 'Wat is het verschil tussen de scan en de intake?',
    content: 'De online scan duurt 2 tot 3 minuten: je beantwoordt een paar gerichte vragen en krijgt direct een eerste beeld van jouw dekkingssituatie. De intake is een ander verhaal — dat is een grondige analyse door een van onze specialisten, met diepgaande kennis van de bouwsector. Hij bekijkt al je lopende polissen, checkt wat echt noodzakelijk is, wat ontbreekt en bij welke maatschappijen je zit. Die analyse mondt uit in een concreet verslag met advies op maat. Is je huidige dekking in orde? Dan zeggen we dat ook gewoon.',
  },
  {
    title: 'Moet ik al mijn huidige polissen al bij de hand hebben?',
    content: 'Voor de online scan is dat niet nodig — die geeft je snel een eerste indicatie zonder voorbereiding. Voor de intake door onze specialist zijn je lopende polissen wél heel waardevol. Zo kunnen we exact zien wat je al goed hebt geregeld, waar lacunes zitten en of je ergens dubbel betaalt. Heb je ze niet digitaal bij de hand? Geen probleem — onze specialist vraagt ze gericht op, ook rechtstreeks bij je huidige verzekeraar als dat sneller gaat.',
  },
  {
    title: 'Wat als ik nu al ergens verzekerd ben?',
    content: 'Dan is dat net interessant voor de intake. Onze expert bekijkt eerlijk wat je hebt en vergelijkt dat met wat optimaal is voor jouw specifieke situatie als bouwondernemer. Als je goed zit, zeggen we dat ook — zonder je te pushen naar iets nieuws. Pas als er echt ruimte voor verbetering is, bezorgen we je een concreet voorstel. Wij begeleiden dan de overstap op het juiste moment, zodat je nooit zonder dekking zit en niet dubbel betaalt.',
  },
  {
    title: 'Wat kost de scan en de intake?',
    content: 'Zowel de online scan als de grondige intake door onze specialist zijn volledig gratis en vrijblijvend. Je betaalt enkel de premie van de verzekeraar waarvoor je uiteindelijk kiest. Geen verborgen dossierkosten, geen adviesfacturen, geen verplichtingen achteraf.',
  },
  {
    title: 'Ben ik verplicht om na de scan of intake iets af te sluiten?',
    content: 'Absoluut niet. De scan geeft je een eerste beeld, de intake geeft je een grondig en eerlijk advies — maar jij beslist altijd zelf wat je ermee doet. Ons doel is dat je met volledige kennis van zaken beslist, niet dat je tot iets wordt gedwongen. Als jouw huidige situatie goed is, zul je dat van ons horen.',
  },
  {
    title: 'Hoe snel ben ik verzekerd na de afstemming?',
    content: 'Zodra het voorstel goedgekeurd is, kan je dekking meestal binnen 24 tot 48 uur actief zijn. In spoedsituaties — bv. een nieuwe werf die morgen start — kunnen we vaak nog sneller schakelen. Dat stemmen we in stap 4 concreet af.',
  },
  {
    title: 'Wat gebeurt er later als mijn bedrijf verandert?',
    content: 'Koop je een tweede bestelwagen, neem je personeel aan, verander je van type werven? Neem gewoon contact op. We passen je polis aan zodat ze mee evolueert met je bedrijf. Je start niet telkens opnieuw van nul — onze specialist kent jouw dossier al.',
  },
  {
    title: 'Wat doen jullie bij schade — moet ik zelf met de verzekeraar bellen?',
    content: 'Nee. Je belt of mailt naar ons. Wij nemen het dossier op, begeleiden het contact met de verzekeraar en zorgen dat jij je kan focussen op je werf in plaats van op administratie. Dat is precies het verschil tussen een polis afsluiten en een makelaar hebben die jouw dossier kent.',
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content },
  })),
};
---

<BaseLayout
  title="Onze werkwijze — Zo verzekert Assurman bouwondernemers"
  description="Ontdek hoe Assurman bouwondernemers verzekert: intake in 2 minuten, risico-scan op maat, modulair voorstel en persoonlijke afstemming. Geen gedoe, wel controle."
  canonical="/werkwijze"
  schema={schema}
>

<style>
  .ww-container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

  /* Hero */
  .ww-hero-img { position: absolute; top: 5%; right: -5px; height: 85%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .ww-hero-content { max-width: 52%; padding-top: 40px; }
  .ww-hero-btns { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }

  /* Steps */
  .ww-step-even { display: grid; grid-template-columns: 1fr 1.6fr; gap: 64px; align-items: center; }
  .ww-step-odd  { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: center; }

  /* Step number animation */
  .ww-step-num {
    transition: color 0.9s ease, text-shadow 0.9s ease;
    color: rgba(229,165,36,0.14);
  }
  .ww-step-num.ww-lit {
    color: rgba(229,165,36,0.55);
    text-shadow: 0 0 60px rgba(229,165,36,0.25);
  }

  /* Stats */
  .ww-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

  /* Na activatie */
  .ww-activatie-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }

  /* Final CTA buttons */
  .ww-final-btns { display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px; }

  @media (max-width: 1023px) {
    .ww-hero-img { display: none; }
    .ww-hero-content { max-width: 100%; }
    .ww-step-even, .ww-step-odd { grid-template-columns: 1fr; gap: 32px; }
    .ww-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .ww-activatie-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  @media (max-width: 767px) {
    .ww-hero-btns { flex-direction: column; }
    .ww-hero-btns a { width: 100%; justify-content: center; }
    .ww-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; }
    .ww-final-btns { flex-direction: column; align-items: center; }
    .ww-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .ww-container { padding: 0 15px; }
  }
</style>

<!-- ══════════════════════════════════════════════
     SECTIE 1: HERO
     ══════════════════════════════════════════════ -->
<section style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:600px;">
  <div class="ww-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-werkwijze-hero.jpg" alt="Assurman verzekeringsadviseur bespreekt bouwverzekering op locatie" />
  </div>
  <div class="ww-container" style="padding-top:48px;padding-bottom:72px;position:relative;z-index:2;">
    <div class="ww-hero-content">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:16px;">Onze Werkwijze</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(34px,4.5vw,60px);line-height:1.06;letter-spacing:-1px;color:#001F3F;margin:0 0 8px;">
        Een verzekering die past.
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(22px,3vw,38px);line-height:1.15;letter-spacing:-0.5px;color:#E5A524;margin:0 0 20px;">
        Zonder papierwerk, zonder verrassingen.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:18px;line-height:1.65;color:#001F3F;max-width:520px;margin:0 0 32px;">
        In 4 duidelijke stappen gaan we van eerste intake tot actieve dekking. Afgestemd op jouw werfrealiteit, niet op een standaardpakket. Ontdek hoe we werken, en waarom bouwondernemers in West- en Oost-Vlaanderen voor deze aanpak kiezen.
      </p>
      <div class="ww-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          Start je gratis scan (2 min)
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">Plan adviesgesprek</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-size:13px;color:#64748B;margin:0;">
        Geen verplichting. Geen verborgen kosten. Jij beslist.
      </p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 2: QUOTE BAND (geen chevron)
     ══════════════════════════════════════════════ -->
<section style="background:rgba(229,165,36,0.07);padding:64px 32px;border-top:1px solid rgba(229,165,36,0.15);border-bottom:1px solid rgba(229,165,36,0.15);">
  <div style="max-width:760px;margin:0 auto;">
    <div style="display:flex;align-items:flex-start;gap:20px;">
      <svg width="56" height="56" viewBox="0 0 24 24" fill="#E5A524" style="opacity:0.4;flex-shrink:0;margin-top:4px;">
        <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z" />
        <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z" />
      </svg>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:20px;line-height:1.7;color:#001F3F;margin:0;">
        Een verzekering afsluiten mag geen gok zijn. Bij Assurman werken we volgens een vast proces dat ervoor zorgt dat jouw dekking klopt bij jouw werfrealiteit, vanaf dag één. Geen standaardpakketten, geen ruis. Wel duidelijkheid over wat je hebt, waarom je het hebt, en wat het je oplevert.
      </p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 3: 4 STAPPEN (geen chevron bovenaan)
     ══════════════════════════════════════════════ -->
<section style="background:#FFFFFF;padding:100px 0 80px;">
  <div class="ww-container">
    <!-- Header -->
    <div style="text-align:center;margin-bottom:72px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:12px;">Onze Aanpak</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,46px);line-height:1.1;letter-spacing:-0.5px;color:#001F3F;margin:0 0 16px;">
        Van intake tot actieve dekking in 4 stappen
      </h2>
      <p style="font-family:'Outfit',sans-serif;font-size:18px;color:#64748B;max-width:560px;margin:0 auto;">
        Je hoeft niet alles meteen perfect te weten. We begeleiden je stap voor stap en zorgen dat elke stap concreet iets oplevert.
      </p>
    </div>

    <!-- Steps -->
    <div style="display:flex;flex-direction:column;gap:48px;">
      {steps.map((step) => (
        <div class={step.align === 'left' ? 'ww-step-even' : 'ww-step-odd'}>

          {/* Left slot: even=number, odd=content */}
          {step.align === 'left' ? (
            /* Step number — left aligned */
            <div style="text-align:left;">
              <div class="ww-step-num" style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(64px,8vw,110px);line-height:1;letter-spacing:-4px;">
                {step.num}
              </div>
              <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:28px;color:#001F3F;margin-top:-16px;margin-bottom:8px;letter-spacing:-0.3px;">
                {step.title}
              </div>
              <div style="display:inline-flex;align-items:center;background:rgba(229,165,36,0.10);border-radius:20px;padding:6px 14px;font-family:'Open Sans',sans-serif;font-weight:600;font-size:13px;color:#8B6A1A;">
                {step.duration}
              </div>
            </div>
          ) : (
            /* Content box — odd step, left position */
            <div style="background:#F8F9FB;padding:40px 44px;border-right:4px solid #E5A524;">
              <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Wat gebeurt er?</p>
              <p style="font-family:'Outfit',sans-serif;font-size:16px;line-height:1.7;color:#001F3F;margin:0 0 20px;">{step.what}</p>
              {step.bullets && step.gainLabel && (
                <>
                  <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">{step.gainLabel}</p>
                  <ul style="list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:10px;">
                    {step.bullets.map((b) => (
                      <li style="display:flex;gap:10px;align-items:flex-start;">
                        <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.55;"><strong>{b.b}</strong>{b.r}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 8px;">Waarom zo?</p>
              <p style="font-family:'Outfit',sans-serif;font-size:15px;line-height:1.65;color:#64748B;margin:0;">{step.why}</p>
            </div>
          )}

          {/* Right slot: even=content, odd=number */}
          {step.align === 'left' ? (
            /* Content box — even step, right position */
            <div style="background:#F8F9FB;padding:40px 44px;border-left:4px solid #E5A524;">
              <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Wat gebeurt er?</p>
              <p style="font-family:'Outfit',sans-serif;font-size:16px;line-height:1.7;color:#001F3F;margin:0 0 20px;">{step.what}</p>
              {step.bullets && step.gainLabel && (
                <>
                  <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">{step.gainLabel}</p>
                  <ul style="list-style:none;padding:0;margin:0 0 20px;display:flex;flex-direction:column;gap:10px;">
                    {step.bullets.map((b) => (
                      <li style="display:flex;gap:10px;align-items:flex-start;">
                        <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span style="font-family:'Outfit',sans-serif;font-size:15px;color:#001F3F;line-height:1.55;"><strong>{b.b}</strong>{b.r}</span>
                      </li>
                    ))}
                  </ul>
                </>
              )}
              <p style="font-family:'Open Sans',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:#E5A524;margin:0 0 8px;">Waarom zo?</p>
              <p style="font-family:'Outfit',sans-serif;font-size:15px;line-height:1.65;color:#64748B;margin:0;">{step.why}</p>
            </div>
          ) : (
            /* Step number — right aligned */
            <div style="text-align:right;">
              <div class="ww-step-num" style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(64px,8vw,110px);line-height:1;letter-spacing:-4px;">
                {step.num}
              </div>
              <div style="font-family:'Outfit',sans-serif;font-weight:800;font-size:28px;color:#001F3F;margin-top:-16px;margin-bottom:8px;letter-spacing:-0.3px;">
                {step.title}
              </div>
