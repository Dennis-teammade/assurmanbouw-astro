---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/islands/FaqAccordion';
import ScrollProgress from '../components/islands/ScrollProgress';
import PartnerSlider from '../components/ui/PartnerSlider';

const steps = [
  {
    nr: '01',
    title: 'Korte intake',
    subtitle: '2 minuten',
    desc: 'We starten met een korte vragenlijst over uw bedrijf: welke activiteiten u uitvoert, hoeveel personeel u heeft, welke voertuigen en machines u gebruikt. Geen uitgebreide formulieren, geen tijdsverlies.',
    bullets: [],
    image: null
  },
  {
    nr: '02',
    title: 'Risico-scan op maat',
    subtitle: 'Wij doen het werk',
    desc: 'Op basis van uw intake voert Assurman een grondige risico-analyse uit. We kijken naar wat u heeft, wat u mist en waar u mogelijk dubbel verzekerd bent.',
    bullets: [
      'Analyse van bestaande polissen (indien beschikbaar)',
      'Vergelijking met sectorspecifieke normen voor bouwbedrijven',
      'Identificatie van blinde vlekken en onderverzekering',
      'Screenen op dubbele dekkingen die kosten opleveren'
    ],
    image: null
  },
  {
    nr: '03',
    title: 'Voorstel met modules',
    subtitle: 'Transparant & vergelijkbaar',
    desc: 'U ontvangt een helder voorstel in modules. U ziet precies welke verzekeringen aanbevolen zijn, wat ze dekken en wat ze kosten. U kiest wat u wil activeren.',
    bullets: [
      'Modulair voorstel: u kiest wat u wil',
      'Prijs per module duidelijk weergegeven',
      'Vergelijking van 20+ verzekeringsmaatschappijen',
      'Schriftelijke toelichting per dekking'
    ],
    image: null
  },
  {
    nr: '04',
    title: 'Afstemming & activatie',
    subtitle: 'Actief binnen 24 tot 48u',
    desc: 'Na uw goedkeuring activeren we de polissen. U ontvangt uw attesten en polisnummers snel — zodat u zonder vertraging aan de slag kunt op uw werf.',
    bullets: [],
    image: null
  }
];

const faqItems = [
  {title:'Hoe lang duurt de intake?',content:'De initiële intake duurt 2 tot 5 minuten via ons online formulier. Daarna contacteert Assurman u voor een persoonlijk gesprek van circa 20 minuten om de risico-analyse af te ronden.'},
  {title:'Is er een adviesgesprek verplicht?',content:'Nee. U kunt starten via de online scan. Als u verkiest om meteen een gesprek in te plannen, kan dat via de afsprakentool. Assurman past zich aan uw voorkeur aan.'},
  {title:'Hoe snel ontvang ik een voorstel?',content:'Na de intake en risico-scan ontvangt u doorgaans binnen 1 tot 2 werkdagen een voorstel op maat. Urgente dossiers (start van werken) worden prioritair behandeld.'},
  {title:'Kan ik bestaande polissen meenemen?',content:'Ja. Assurman bekijkt uw bestaande polissen en integreert ze in het overzicht. Waar verlenging of optimalisatie mogelijk is, adviseert Assurman proactief.'},
  {title:'Moet ik de bestaande verzekeraar zelf opzeggen?',content:'Nee. Assurman regelt de opzegging van uw bestaande polissen op het correcte moment — zodat u nooit zonder dekking zit en ook niet dubbel betaalt.'},
  {title:'Wat als ik maar één verzekering nodig heb?',content:'Dat is helemaal in orde. Assurman werkt ook voor enkelvoudige polissen. De risico-scan geeft u een volledig beeld, maar u beslist altijd zelf wat u activeert.'},
  {title:'Werkt Assurman enkel voor bouwbedrijven?',content:'Ja. Assurman is uitsluitend gespecialiseerd in de bouwsector. Deze focus maakt dat Assurman de juiste risicos kent, de juiste polissen vergelijkt en de juiste vragen stelt.'},
  {title:'Wat na de activatie van mijn polissen?',content:'Assurman blijft uw aanspreekpunt voor schadeaangiften, poliswijzigingen, attesten en vragen. U contacteert één persoon die uw dossier kent — geen callcenter, geen tijdsverlies.'}
];
---

<BaseLayout
  title="Onze werkwijze — Zo verzekert Assurman bouwondernemers"
  description="Ontdek hoe Assurman bouwondernemers verzekert: intake in 2 minuten, risico-scan op maat, modulair voorstel en persoonlijke afstemming."
  canonical="/werkwijze"
>
  <ScrollProgress client:load />

  <!-- HERO -->
  <section style="background:#FFFFFF;padding-top:130px;padding-bottom:80px;overflow:hidden;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Werkwijze</p>
        <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,4.5vw,64px);line-height:1.05;color:#001F3F;margin:0 0 24px;">Een verzekering die past.</h1>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:clamp(18px,2vw,24px);color:#E5A524;margin:0 0 24px;line-height:1.3;">Zonder papierwerk, zonder verrassingen.</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:#3F5767;margin:0 0 40px;">Assurman werkt uitsluitend voor bouwbedrijven. Onze aanpak is helder: korte intake, grondige analyse, modulair voorstel en snelle activatie. Geen jargon, geen tijdsverspilling.</p>
        <div style="display:flex;gap:16px;flex-wrap:wrap;">
          <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;">Start gratis scan</a>
          <a href="/maak-afspraak" style="display:inline-block;background:transparent;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;border:2px solid #001F3F;">Afspraak plannen</a>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;">
        <img src="/foto-benoit-assurman-verzeerkingen_optimized.png" alt="Benoît Assurman verzekeringsspecialist" style="width:100%;max-width:520px;border-radius:8px;object-fit:cover;" loading="eager" />
      </div>
    </div>
  </section>

  <!-- INTRO QUOTE BAND -->
  <section style="background:rgba(229,165,36,0.07);padding:64px 0;border-top:1px solid rgba(229,165,36,0.15);border-bottom:1px solid rgba(229,165,36,0.15);">
    <div style="max-width:800px;margin:0 auto;padding:0 24px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,2.5vw,30px);line-height:1.4;color:#001F3F;margin:0 0 16px;">"Een goede verzekering is er een die u vergeet — omdat ze er is wanneer het nodig is."</p>
      <p style="font-family:'Open Sans',sans-serif;font-size:16px;color:#3F5767;margin:0;">Assurman — specialist in bouwverzekeringen</p>
    </div>
  </section>

  <!-- 4 STEPS -->
  <section style="background:#FFFFFF;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;text-align:center;">Hoe werkt het?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 72px;text-align:center;">In 4 stappen volledig verzekerd</h2>
      <div style="display:flex;flex-direction:column;gap:80px;">
        {steps.map((step, i) => (
          <div style={`display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;${i % 2 === 1 ? 'direction:rtl;' : ''}`}>
            <div style={i % 2 === 1 ? 'direction:ltr;' : ''}>
              <div style="display:flex;align-items:center;gap:20px;margin-bottom:24px;">
                <div style="width:64px;height:64px;background:#E5A524;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                  <span style="font-family:'Outfit',sans-serif;font-weight:900;font-size:20px;color:#001F3F;">{step.nr}</span>
                </div>
                <div>
                  <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:24px;color:#001F3F;margin:0;">{step.title}</p>
                  <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;color:#E5A524;margin:0;">{step.subtitle}</p>
                </div>
              </div>
              <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0 0 24px;">{step.desc}</p>
              {step.bullets.length > 0 && (
                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
                  {step.bullets.map((b) => (
                    <li style="display:flex;align-items:flex-start;gap:10px;font-family:'Open Sans',sans-serif;font-size:16px;color:#001F3F;">
                      <span style="color:#E5A524;font-weight:700;flex-shrink:0;margin-top:2px;">✓</span>
                      {b}
                    </li>
                  ))}
                </ul>
              )}
            </div>
            <div style={`background:#F8F9FA;border-radius:12px;height:280px;display:flex;align-items:center;justify-content:center;${i % 2 === 1 ? 'direction:ltr;' : ''}`}>
              <span style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(80px,12vw,140px);color:#E5A524;opacity:0.12;">{step.nr}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GOLD CTA BAND -->
  <section style="background:#E9C466;padding:72px 0;overflow:hidden;position:relative;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr auto;gap:48px;align-items:center;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(24px,3.5vw,42px);line-height:1.1;color:#001F3F;margin:0 0 12px;">Geen gedoe. Wel controle.</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.6;color:rgba(0,31,63,0.75);margin:0 0 28px;">U beheert uw bouwbedrijf. Assurman beheert uw verzekeringen.</p>
        <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#001F3F;color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:16px 32px;border-radius:4px;text-decoration:none;">Start de gratis scan</a>
      </div>
      <div style="opacity:0.15;">
        <img src="/foto-benoit-assurman-verzeerkingen_optimized.png" alt="" style="width:220px;border-radius:8px;" aria-hidden="true" />
      </div>
    </div>
  </section>

  <!-- TRUST BAND -->
  <section style="background:#001F3F;padding:72px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;text-align:center;">
        {[
          {stat:'15+',label:'Jaar',sub:'Lokaal verankerd'},
          {stat:'500+',label:'Klanten',sub:'Gespecialiseerd in bouw'},
          {stat:'20+',label:'Partners',sub:'Onafhankelijk advies'},
          {stat:'Meegroeiend',label:'',sub:'Modulair pakket'}
        ].map((item) => (
          <div style="padding:24px;">
            <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,48px);color:#E5A524;margin:0;">{item.stat}</p>
            {item.label && <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#FFFFFF;margin:4px 0 2px;">{item.label}</p>}
            <p style="font-family:'Open Sans',sans-serif;font-size:14px;color:rgba(255,255,255,0.6);margin:4px 0 0;">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section style="background:#F8F9FA;padding:80px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;text-align:center;">Wat klanten zeggen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,42px);line-height:1.1;color:#001F3F;margin:0 0 40px;text-align:center;">Gewaardeerd door bouwprofessionals</h2>
      <iframe
        class="lc_reviews_widget"
        src="https://reputationhub.site/reputation/widgets/review_widget/CZvuwnma5HR0BBq9wPYn?widgetId=69e88c0cc5c871fdf4cf5ef2"
        frameborder="0"
        scrolling="no"
        style="min-width:100%;width:100%;display:block;border:none;"
        title="Klantreviews Assurman"
      ></iframe>
      <script src="https://reputationhub.site/reputation/assets/review-widget.js" async></script>
    </div>
  </section>

  <!-- NA ACTIVATIE -->
  <section style="background:#FFFFFF;padding:100px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;">
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Na activatie</p>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3.5vw,44px);line-height:1.1;color:#001F3F;margin:0 0 24px;">Uw aanspreekpunt blijft Assurman</h2>
        <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0 0 24px;">Na de activatie van uw polissen is Assurman uw blijvend aanspreekpunt. U belt of mailt met één persoon die uw dossier kent — geen callcenter, geen doorverwijzingen.</p>
        <p style="font-family:'Open Sans',sans-serif;font-size:17px;line-height:1.7;color:#3F5767;margin:0;">Bij schade begeleidt Assurman u door de aangifte en de procedure. Wij verdedigen uw belangen bij de verzekeraar en volgen het dossier op tot afsluiting.</p>
      </div>
      <div style="display:flex;flex-direction:column;gap:20px;">
        {[
          {title:'Eén aanspreekpunt',text:'Geen callcenter. Assurman kent uw dossier en uw bedrijf van bij het begin.'},
          {title:'Schadebegeleiding',text:'Bij een schadeaangifte staat Assurman u bij van begin tot einde. U hoeft niet zelf te onderhandelen.'},
          {title:'Jaarlijkse review',text:'Assurman bekijkt jaarlijks of uw dekkingen nog aansluiten bij de groei van uw bedrijf.'}
        ].map((card) => (
          <div style="background:#F8F9FA;border-radius:8px;padding:28px;border-left:4px solid #E5A524;">
            <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:17px;color:#001F3F;margin:0 0 8px;">{card.title}</p>
            <p style="font-family:'Open Sans',sans-serif;font-size:15px;line-height:1.6;color:#3F5767;margin:0;">{card.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section style="background:#F8F9FA;padding:100px 0;">
    <div style="max-width:900px;margin:0 auto;padding:0 24px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 12px;">Veelgestelde vragen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;color:#001F3F;margin:0 0 48px;">FAQ over onze werkwijze</h2>
      <FaqAccordion client:visible items={faqItems} />
    </div>
  </section>

  <!-- PARTNERS -->
  <section style="background:#FFFFFF;padding:60px 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p style="text-align:center;font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#3F5767;margin:0 0 32px;">Onze verzekeringspartners</p>
      <PartnerSlider client:visible />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section style="background:#001F3F;padding:100px 0 0;">
    <div style="max-width:1200px;margin:0 auto;padding:0 24px 80px;text-align:center;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin:0 0 16px;">Klaar om te starten?</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,4vw,52px);line-height:1.1;color:#FFFFFF;margin:0 0 20px;">Start vandaag met de risico-scan</h2>
      <p style="font-family:'Open Sans',sans-serif;font-size:18px;line-height:1.7;color:rgba(255,255,255,0.75);max-width:560px;margin:0 auto 40px;">In 2 minuten ziet u waar uw dekking staat. Gratis, vrijblijvend, zonder verplichtingen.</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/gratis-verzekeringsscan" style="display:inline-block;background:#E5A524;color:#001F3F;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Gratis scan starten</a>
        <a href="/maak-afspraak" style="display:inline-block;background:transparent;border:2px solid rgba(255,255,255,0.3);color:#FFFFFF;font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;padding:18px 36px;border-radius:4px;text-decoration:none;">Afspraak maken</a>
      </div>
    </div>
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display:block;width:100%;height:60px;"><polygon points="0,60 1440,20 1440,60" fill="#FFFFFF" /></svg>
  </section>
</BaseLayout>
