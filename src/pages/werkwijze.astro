---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandChevron from '../components/BrandChevron.astro';
import FaqAccordion from '../components/islands/FaqAccordion';
import PartnerSlider from '../components/ui/PartnerSlider';
import { CTA_SCAN, CTA_AFSPRAAK, CTA_DESTINATIONS } from '../data/cta-labels';

const steps = [
  {
    nr: '01',
    title: 'Korte intake',
    subtitle: '2 minuten',
    desc: 'Je start met een korte vragenlijst over jouw bedrijf: welke activiteiten je uitvoert, hoeveel personeel je hebt, welke voertuigen en machines je gebruikt. Geen uitgebreide formulieren, geen tijdsverlies.',
    bullets: [],
  },
  {
    nr: '02',
    title: 'Risico-scan op maat',
    subtitle: 'Wij doen het werk',
    desc: 'Op basis van jouw intake voert Assurman een grondige risico-analyse uit. We kijken naar wat je hebt, wat je mist en waar je mogelijk dubbel verzekerd bent.',
    bullets: [
      'Analyse van bestaande polissen (indien beschikbaar)',
      'Vergelijking met sectorspecifieke normen voor bouwbedrijven',
      'Identificatie van blinde vlekken en onderverzekering',
      'Screenen op dubbele dekkingen die kosten opleveren',
    ],
  },
  {
    nr: '03',
    title: 'Voorstel met modules',
    subtitle: 'Transparant & vergelijkbaar',
    desc: 'Je ontvangt een helder voorstel in modules. Je ziet precies welke verzekeringen aanbevolen zijn, wat ze dekken en wat ze kosten. Jij kiest wat je wil activeren.',
    bullets: [
      'Modulair voorstel: jij kiest wat je wil',
      'Prijs per module duidelijk weergegeven',
      'Vergelijking van 20+ verzekeringsmaatschappijen',
      'Schriftelijke toelichting per dekking',
    ],
  },
  {
    nr: '04',
    title: 'Afstemming & activatie',
    subtitle: 'Actief binnen 24 tot 48u',
    desc: 'Na jouw goedkeuring activeren we de polissen. Je ontvangt jouw attesten en polisnummers snel — zodat je zonder vertraging aan de slag kunt op jouw werf.',
    bullets: [],
  },
];

const faqItems = [
  { title: 'Hoe lang duurt de intake?', content: 'De initiële intake duurt 2 tot 5 minuten via ons online formulier. Daarna contacteert Assurman je voor een persoonlijk gesprek van circa 20 minuten om de risico-analyse af te ronden.' },
  { title: 'Is er een adviesgesprek verplicht?', content: 'Nee. Je kan starten via de online scan. Als je verkiest om meteen een gesprek in te plannen, kan dat via de afsprakentool. Assurman past zich aan jouw voorkeur aan.' },
  { title: 'Hoe snel ontvang ik een voorstel?', content: 'Na de intake en risico-scan ontvang je doorgaans binnen 1 tot 2 werkdagen een voorstel op maat. Urgente dossiers (start van werken) worden prioritair behandeld.' },
  { title: 'Kan ik bestaande polissen meenemen?', content: 'Ja. Assurman bekijkt jouw bestaande polissen en integreert ze in het overzicht. Waar verlenging of optimalisatie mogelijk is, adviseert Assurman proactief.' },
  { title: 'Moet ik de bestaande verzekeraar zelf opzeggen?', content: 'Nee. Assurman regelt de opzegging van jouw bestaande polissen op het correcte moment — zodat je nooit zonder dekking zit en ook niet dubbel betaalt.' },
  { title: 'Wat als ik maar één verzekering nodig heb?', content: 'Dat is helemaal in orde. Assurman werkt ook voor enkelvoudige polissen. De risico-scan geeft je een volledig beeld, maar jij beslist altijd zelf wat je activeert.' },
  { title: 'Werkt Assurman enkel voor bouwbedrijven?', content: 'Ja. Assurman is uitsluitend gespecialiseerd in de bouwsector. Deze focus maakt dat Assurman de juiste risico\'s kent, de juiste polissen vergelijkt en de juiste vragen stelt.' },
  { title: 'Wat na de activatie van mijn polissen?', content: 'Assurman blijft jouw aanspreekpunt voor schadeaangiften, poliswijzigingen, attesten en vragen. Je contacteert één persoon die jouw dossier kent — geen callcenter, geen tijdsverlies.' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.title,
    "acceptedAnswer": { "@type": "Answer", "text": f.content },
  })),
};
---

<BaseLayout
  title="Onze werkwijze — Zo verzekert Assurman bouwondernemers"
  description="Ontdek hoe Assurman bouwondernemers verzekert: intake in 2 minuten, risico-scan op maat, modulair voorstel en persoonlijke afstemming."
  canonical="/werkwijze"
  schema={schema}
>

<style>
  .ww-container { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

  /* Hero */
  .ww-hero-img { position: absolute; top: 5%; right: -5px; height: 85%; width: auto; max-width: 48%; z-index: 1; pointer-events: none; }
  .ww-hero-content { max-width: 52%; padding-top: 40px; }
  .ww-hero-btns { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }

  /* CTA band image */
  .ww-cta-img { position: absolute; top: 0; right: -60px; height: 90%; width: auto; pointer-events: none; z-index: 1; }

  /* Steps */
  .ww-steps-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .ww-steps-grid--reverse { direction: rtl; }
  .ww-steps-grid--reverse > * { direction: ltr; }

  /* Stats */
  .ww-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }

  /* Na activatie */
  .ww-activatie-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }

  /* Final CTA buttons */
  .ww-final-btns { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px; }

  @media (max-width: 1023px) {
    .ww-hero-img { display: none; }
    .ww-hero-content { max-width: 100%; }
    .ww-steps-grid { grid-template-columns: 1fr; gap: 32px; }
    .ww-steps-grid--reverse { direction: ltr; }
    .ww-stats-grid { grid-template-columns: repeat(2, 1fr); }
    .ww-activatie-grid { grid-template-columns: 1fr; gap: 40px; }
    .ww-cta-img { display: none; }
  }
  @media (max-width: 767px) {
    .ww-hero-btns { flex-direction: column; }
    .ww-hero-btns a { width: 100%; justify-content: center; }
    .ww-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .ww-final-btns { flex-direction: column; align-items: center; }
    .ww-final-btns a { width: 100%; max-width: 400px; justify-content: center; }
    .ww-container { padding: 0 15px; }
  }
</style>

<!-- ══════════════════════════════════════════════
     SECTIE 1: HERO
     ══════════════════════════════════════════════ -->
<section style="background:#FFFFFF;padding-top:140px;position:relative;overflow:hidden;min-height:520px;">
  <div class="ww-hero-img assurman-mask assurman-mask--hero">
    <img src="/verzekeringen-bouwsector-werkwijze-hero.jpg" alt="Assurman verzekeringsadviseur bespreekt bouwverzekering op locatie" />
  </div>
  <div class="ww-container" style="padding-top:40px;padding-bottom:80px;position:relative;z-index:2;">
    <div class="ww-hero-content">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:16px;">Onze aanpak</p>
      <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-1.5px;color:#001F3F;margin-bottom:8px;">
        Een verzekering die past.
      </h1>
      <p style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(20px,3vw,34px);line-height:1.1;letter-spacing:-0.5px;color:#E5A524;margin-bottom:24px;">
        Zonder papierwerk, zonder verrassingen.
      </p>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.65;color:#3F5767;margin-bottom:32px;max-width:500px;">
        Assurman werkt uitsluitend voor bouwbedrijven. Onze aanpak is helder: korte intake, grondige analyse, modulair voorstel en snelle activatie. Geen jargon, geen tijdsverspilling.
      </p>
      <div class="ww-hero-btns">
        <a href={CTA_DESTINATIONS.scan} class="brand-btn-primary brand-btn-primary--lg">
          {CTA_SCAN.request}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a href={CTA_DESTINATIONS.afspraak} class="brand-btn-secondary">{CTA_AFSPRAAK.advisory}</a>
      </div>
      <p style="font-family:'Open Sans',sans-serif;font-weight:400;font-size:14px;color:#001F3F;opacity:0.75;">
        Geen verplichting. We finaliseren je pakket samen na je intake.
      </p>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 2: QUOTE BAND
     ══════════════════════════════════════════════ -->
<section style="background:rgba(229,165,36,0.07);padding:0 0 72px;position:relative;overflow:hidden;border-top:1px solid rgba(229,165,36,0.15);border-bottom:1px solid rgba(229,165,36,0.15);">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;">
    <BrandChevron color="#E5A524" height="80px" direction="down" />
  </div>
  <div class="ww-container" style="max-width:860px;padding-top:100px;">
    <div style="display:flex;gap:24px;align-items:flex-start;">
      <svg style="flex-shrink:0;margin-top:4px;" width="32" height="32" viewBox="0 0 24 24" fill="#E5A524" opacity="0.4"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"/></svg>
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:clamp(16px,2vw,20px);line-height:1.65;color:#001F3F;margin-bottom:16px;">
          Een verzekering afsluiten mag geen gok zijn. Bij Assurman volgen we een vast proces dat ervoor zorgt dat jouw dekking klopt bij jouw werfrealiteit. Echt bij jou. Geen rollerpasdekking, geen luizen. Wij kijken heel naar jouw situatie, waarom je het nodig hebt en wat het je geeft.
        </p>
        <p style="font-family:'Open Sans',sans-serif;font-size:14px;font-weight:700;color:#E5A524;letter-spacing:0.5px;margin:0;">Assurman — specialist in bouwverzekeringen</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 3: 4 STAPPEN
     ══════════════════════════════════════════════ -->
<section style="background:#FFFFFF;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;">
    <BrandChevron color="#E5A524" height="80px" direction="down" />
  </div>
  <div class="ww-container" style="padding-top:100px;">
    <div style="text-align:center;margin-bottom:64px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:12px;">Onze aanpak</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(28px,3.5vw,48px);line-height:1.1;letter-spacing:-0.5px;color:#001F3F;margin-bottom:16px;">
        Van intake tot actieve dekking in 4 stappen
      </h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,18px);line-height:1.6;color:#3F5767;max-width:560px;margin:0 auto;">
        Een helder traject van A tot Z. Jij kiest het tempo, wij zorgen voor de inhoud.
      </p>
    </div>

    <div style="display:flex;flex-direction:column;gap:0;">
      {steps.map((step, i) => (
        <>
          <div class={`ww-steps-grid${i % 2 === 1 ? ' ww-steps-grid--reverse' : ''}`} style="padding:48px 0;">
            <!-- Number + label -->
            <div style="position:relative;">
              <span style={`font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(100px,14vw,160px);line-height:1;color:#E5A524;opacity:0.08;position:absolute;top:-20px;${i % 2 === 1 ? 'right:0;' : 'left:-16px;'};user-select:none;pointer-events:none;`}>{step.nr}</span>
              <div style="position:relative;z-index:1;padding-top:16px;">
                <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:8px;">{step.nr}</p>
                <h3 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(24px,2.5vw,36px);line-height:1.1;color:#001F3F;margin-bottom:8px;">{step.title}</h3>
                <p style="font-family:'Outfit',sans-serif;font-weight:600;font-size:14px;color:#E5A524;margin:0;">{step.subtitle}</p>
              </div>
            </div>
            <!-- Content -->
            <div>
              <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,17px);line-height:1.7;color:#3F5767;margin-bottom:20px;">{step.desc}</p>
              {step.bullets.length > 0 && (
                <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
                  {step.bullets.map((b) => (
                    <li style="display:flex;align-items:flex-start;gap:12px;">
                      <svg style="flex-shrink:0;margin-top:3px;" width="16" height="16" fill="none" stroke="#E5A524" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                      <span style="font-family:'Outfit',sans-serif;font-size:15px;line-height:1.5;color:#001F3F;">{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          {i < steps.length - 1 && (
            <div style="display:flex;justify-content:center;padding:8px 0;pointer-events:none;opacity:0.35;">
              <svg width="24" height="24" fill="none" stroke="#E5A524" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 4: CTA BAND
     ══════════════════════════════════════════════ -->
<section style="background:#E9C466;padding:80px 0 80px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-30px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;">
    <BrandChevron color="white" height="100px" direction="down" />
  </div>
  <!-- Masked CTA image -->
  <div class="ww-cta-img assurman-mask assurman-mask--cta" style="z-index:1;">
    <img src="/verzekeringen-bouwsector-werkwijze-cta.jpg" alt="Bouwprofessionals aan het werk op de werf" />
  </div>
  <!-- Decorative right chevron -->
  <div style="position:absolute;right:-130px;top:40%;transform:translateY(-50%);pointer-events:none;z-index:2;">
    <BrandChevron color="white" height="240px" direction="left" />
  </div>
  <div class="ww-container" style="text-align:center;position:relative;z-index:4;">
    <h2 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,4.5vw,56px);line-height:1.1;color:#FFFFFF;margin-bottom:16px;">
      Geen gedoe.<br />Wel controle.
    </h2>
    <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(16px,2vw,20px);line-height:1.5;color:rgba(0,31,63,0.75);margin-bottom:32px;">
      Wij beheren jouw verzekeringen zodat jij je kan focussen op jouw werk.
    </p>
    <a href={CTA_DESTINATIONS.scan} style="display:inline-flex;align-items:center;gap:12px;background:#3F5767;color:#FFFFFF;font-family:'Open Sans',sans-serif;font-weight:700;font-size:18px;padding:18px 40px;border-radius:10px;text-decoration:none;">
      {CTA_SCAN.requestNow}
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 5: STATS / TRUST
     ══════════════════════════════════════════════ -->
<section style="background:#FFFFFF;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;">
    <BrandChevron color="#E5A524" height="80px" direction="down" />
  </div>
  <div class="ww-container" style="padding-top:100px;">
    <div style="text-align:center;margin-bottom:56px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:12px;">Waarom Assurman</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,42px);line-height:1.1;color:#001F3F;margin:0;">
        Zo weet je dat je bij ons goed zit
      </h2>
    </div>
    <div class="ww-stats-grid">
      {[
        {
          stat: '15+',
          label: 'Jaar',
          sub: 'Lokaal verankerd in de bouwsector',
          iconPath: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM12 6v6l4 2',
        },
        {
          stat: '500+',
          label: 'Klanten',
          sub: 'Gespecialiseerd in bouwbedrijven',
          iconPath: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 8 0 4 4 0 0 0-8 0M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
        },
        {
          stat: '20+',
          label: 'Partners',
          sub: 'Onafhankelijk vergelijken en adviseren',
          iconPath: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM9 22V12h6v10',
        },
        {
          stat: 'Meegroeiend',
          label: '',
          sub: 'Modulair pakket dat meeschaalt met jouw bedrijf',
          iconPath: 'M22 7L13.5 15.5l-5-5L2 17M22 7h-6M22 7v6',
        },
      ].map((item) => (
        <div style="text-align:center;padding:32px 24px;background:#F9FAFB;border-radius:12px;">
          <div style="width:48px;height:48px;background:rgba(229,165,36,0.12);border-radius:10px;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;">
            <svg width="22" height="22" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={item.iconPath}/></svg>
          </div>
          <p style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(28px,3.5vw,44px);color:#001F3F;margin:0;line-height:1;">{item.stat}</p>
          {item.label && <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:4px 0 8px;">{item.label}</p>}
          <p style="font-family:'Open Sans',sans-serif;font-size:13px;line-height:1.5;color:#3F5767;margin:item.label ? '0' : '8px 0 0';">{item.sub}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 6: TESTIMONIALS
     ══════════════════════════════════════════════ -->
<section style="background:#F8F9FA;padding:0 0 80px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;">
    <BrandChevron color="#E5A524" height="80px" direction="down" />
  </div>
  <div class="ww-container" style="padding-top:100px;">
    <div style="text-align:center;margin-bottom:48px;">
      <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:12px;">Klantenervaringen</p>
      <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3vw,42px);line-height:1.1;color:#001F3F;margin-bottom:12px;">
        Wat bouwondernemers over onze aanpak zeggen
      </h2>
      <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:16px;line-height:1.6;color:#3F5767;max-width:540px;margin:0 auto;">
        Onze aanpak spreekt voor zich. Vraag het maar aan onze klanten.
      </p>
    </div>
    <iframe
      class="lc_reviews_widget"
      src="https://reputationhub.site/reputation/widgets/review_widget/CZvuwnma5HR0BBq9wPYn?widgetId=69e88c0cc5c871fdf4cf5ef2"
      frameborder="0"
      scrolling="no"
      style="min-width:100%;width:100%;display:block;border:none;"
      title="Klantreviews Assurman"
    ></iframe>
    <script src="https://reputationhub.site/reputation/assets/review-widget.js" async></script>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     SECTIE 7: NA ACTIVATIE
     ══════════════════════════════════════════════ -->
<section style="background:#FFFFFF;padding:0 0 96px;position:relative;overflow:hidden;">
  <div style="position:absolute;top:-25px;left:50%;transform:translateX(-50%);pointer-events:none;z-index:3;">
    <BrandChevron color="#E5A524" height="80px" direction="down" />
  </div>
  <div class="ww-container" style="padding-top:100px;">
    <div class="ww-activatie-grid">
      <!-- Left: text -->
      <div>
        <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;margin-bottom:12px;">Na activatie</p>
        <h2 style="font-family:'Outfit',sans-serif;font-weight:800;font-size:clamp(26px,3.5vw,44px);line-height:1.1;color:#001F3F;margin-bottom:24px;">
          Na activatie? Dan begint het echte werk.
        </h2>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,17px);line-height:1.7;color:#3F5767;margin-bottom:20px;">
          Na de activatie van jouw polissen ben je niet meer alleen. Assurman blijft jouw aanspreekpunt voor schadeaangiften, poliswijzigingen, attesten en vragen.
        </p>
        <p style="font-family:'Outfit',sans-serif;font-weight:400;font-size:clamp(15px,1.5vw,17px);line-height:1.7;color:#3F5767;margin-bottom:0;">
          Bij schade begeleiden we je door de aangifte en de procedure. Wij verdedigen jouw belangen bij de verzekeraar en volgen het dossier op tot afsluiting. Geen callcenter, geen doorverwijzingen.
        </p>
      </div>
      <!-- Right: 3 cards -->
      <div style="display:flex;flex-direction:column;gap:16px;">
        {[
          {
            title: 'Eén aanspreekpunt, altijd',
            text: 'Assurman kent jouw dossier en jouw bedrijf. Je belt of mailt met één persoon die weet waarover het gaat.',
            iconPath: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z',
          },
          {
            title: 'Schadebegeleiding van A tot Z',
            text: 'Bij een schadeaangifte staat Assurman je bij van begin tot einde. Je hoeft niet zelf te onderhandelen met de verzekeraar.',
            iconPath: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
          },
          {
            title: 'Jaarlijkse review inbegrepen',
            text: 'Assurman bekijkt jaarlijks of jouw dekkingen nog aansluiten bij de groei en wijzigingen in jouw bedrijf.',
            iconPath: 'M19 4H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zM16 2v4M8 2v4M3 10h18',
          },
        ].map((card) => (
          <div style="background:#F9FAFB;border-radius:10px;padding:24px;border-left:4px solid #E5A524;display:flex;gap:16px;align-items:flex-start;">
            <div style="width:40px;height:40px;background:rgba(229,165,36,0.1);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="18" height="18" fill="none" stroke="#E5A524" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d={card.iconPath}/></svg>
            </div>
            <div>
              <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:16px;color:#001F3F;margin:0 0 6px;">{card.title}</p>
              <p style="font-family:'Open Sans',sans-serif;font-size:14px;line-height:1.6;color:#3F5767;margin:0;">{card.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

