---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Gratis verzekeringsscan — Ontdek waar jouw dekking tekortschiet"
  description="In 2 minuten een heldere scan van je bouwverzekeringen: onderverzekering, dubbele dekking en blinde vlekken. Gratis en vrijblijvend."
  canonical="/gratis-verzekeringsscan"
>

<style>
  .scan-iframe {
    width: 100%;
    height: 1400px;
    border: 0;
    display: block;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .scan-iframe { height: 1800px; }
  }
</style>

<section style="background:#F9FAFB;padding-top:180px;padding-bottom:80px;min-height:100vh;">
  <div style="max-width:720px;margin:0 auto;padding:0 32px;">

    <!-- Label -->
    <p style="font-family:'Outfit',sans-serif;font-weight:700;font-size:13px;letter-spacing:1.4px;text-transform:uppercase;color:#E5A524;text-align:center;margin:0 0 20px;">
      Gratis &amp; vrijblijvend
    </p>

    <!-- H1 -->
    <h1 style="font-family:'Outfit',sans-serif;font-weight:900;font-size:clamp(32px,5vw,56px);line-height:1.08;letter-spacing:-1px;color:#001F3F;text-align:center;margin:0 0 56px;">
      Ontdek in 2 minuten<br />waar jouw dekking tekortschiet
    </h1>

    <!-- Iframe -->
    <iframe
      class="scan-iframe"
      src="https://bouw-risicoscan.vibepreview.com"
      title="Bouw Risicoscan"
      loading="lazy"
      scrolling="no"
      frameborder="0"
    ></iframe>

  </div>
</section>

</BaseLayout>
